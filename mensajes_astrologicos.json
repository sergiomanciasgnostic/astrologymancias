// mensajes_astrologicos.js
// Archivo externo de mensajes — NO modificar estructura, solo textos d: y g:

// ════════════════════════════════════════════════════
// INTERPRETACIONES
// ════════════════════════════════════════════════════
window._INTERPRETACIONES = {
  planets: {
 'Sol-Aries': {d: 'Tu Sol en Aries habla de una identidad que necesita moverse, crear y liderar. Eres de las personas que aprenden haciendo, que necesitan sentir que avanzan. En tu vida, los momentos de mayor plenitud llegan cuando tomas la iniciativa sin esperar permiso. El reto que el cosmos puso en tu camino es aprender a sostener lo que empiezas.', g: 'Gnósticamente, tu chispa divina se expresa a través de la acción valiente. No viniste a este mundo a observar desde los márgenes: viniste a abrir caminos. Cuando actúas desde el alma y no desde el ego, tu energía se convierte en un faro para quienes aún no encontraron su dirección. El gnóstico en Aries aprende que el verdadero liderazgo nace cuando la llama interior ilumina sin destruir. Tu misión: encender caminos, no consumirlos.'},
 'Sol-Tauro': {d: 'Tu Sol en Tauro habla de una identidad que se construye con paciencia y solidez. Eres de las personas que necesitan sentir seguridad para florecer, que valoran lo concreto y lo duradero por encima de lo efímero. En tu vida, los momentos de mayor plenitud llegan cuando lo que construyes con esfuerzo empieza a dar frutos. El reto que el cosmos puso en tu camino es soltar el miedo a perder lo que tanto te costó ganar.', g: 'El gnóstico en Tauro descubre que la belleza sensorial es un lenguaje de lo sagrado. Tu misión: demostrar que el cielo puede habitar la tierra.'},
  'Sol-Géminis': {d: 'Tu Sol en Géminis habla de una identidad que vive en el movimiento, las ideas y la conexión con otros. Eres de las personas que necesitan variedad mental para sentirse vivos, que pueden ver múltiples perspectivas de una misma situación con una facilidad que pocos tienen. En tu vida, los momentos de mayor plenitud llegan cuando tu mente está activa y tus palabras logran tender puentes entre personas o ideas que parecían incompatibles. El reto que el cosmos puso en tu camino es aprender a profundizar sin huir cuando las cosas se vuelven incómodas.', g: 'La mente gnóstica en Géminis es una herramienta de revelación: conecta lo que parece separado. Tu desafío es elegir cuál de tus voces habla la verdad más profunda. Tu misión: tejer conocimiento vivo entre almas que no saben que están conectadas.'},
 'Sol-Cáncer': {d: 'Tu Sol en Cáncer habla de una identidad profundamente ligada al mundo emocional y a quienes amas. Eres de las personas que sienten todo con una intensidad que otros no comprenden, que tienen una memoria emocional poderosa y una capacidad natural de cuidar y sostener a quienes los rodean. En tu vida, los momentos de mayor plenitud llegan cuando te sientes en casa — sea un lugar, una persona o una situación donde puedes ser tú sin defensas. El reto que el cosmos puso en tu camino es aprender a cuidarte con la misma entrega con que cuidas a los demás.', g: 'El gnóstico en Cáncer comprende que la sensibilidad no es debilidad sino acceso directo a los planos sutiles. Tu misión: sanar el linaje, transformar el dolor heredado en luz transmisible.'},
  'Sol-Leo': {d: 'Tu Sol en Leo habla de una identidad que necesita expresarse, crear y dejar huella. Eres de las personas que tienen una presencia natural que los demás notan, una generosidad genuina cuando actúas desde el corazón y una necesidad profunda de que lo que haces tenga sentido y reconocimiento. En tu vida, los momentos de mayor plenitud llegan cuando creas algo que lleva tu sello y lo compartes sin miedo. El reto que el cosmos puso en tu camino es aprender a distinguir cuándo brillas para dar y cuándo brillas para recibir aprobación.', g: 'El Sol en Leo vive en su domicilio natural: aquí la luz solar se conoce a sí misma. Eres el canal más directo de la expresión creadora del cosmos. Tu identidad brilla cuando creas, lidera y ama con generosidad real. El ego no es el enemigo del gnóstico en Leo — es la herramienta que, purificada, se convierte en vehículo de lo divino. Cuando dejas de brillar para ser aplaudido y empiezas a brillar para iluminar, cumples tu misión cósmica. Tu misión: ser sol para los que viven en sombra.'},
 'Sol-Virgo': {d: 'Tu Sol en Virgo habla de una identidad que se realiza a través del detalle, el servicio y la mejora constante. Eres de las personas que ven lo que otros no ven, que tienen una capacidad natural para organizar, analizar y encontrar la forma más eficiente de hacer las cosas. En tu vida, los momentos de mayor plenitud llegan cuando lo que haces es útil de verdad y está bien hecho. El reto que el cosmos puso en tu camino es aprender a valorar lo que ya eres sin esperar ser perfecto primero.', g: 'El gnóstico en Virgo descubre que el análisis llevado a su extremo revela el patrón divino detrás del caos. La autocrítica es una escalera — puedes subir por ella o quedar atrapado en el primer peldaño. Tu misión: sanar con precisión y servir con amor.'},
'Sol-Libra': {d: 'Tu Sol en Libra habla de una identidad que se construye en relación con los demás. Eres de las personas que tienen un sentido natural de la justicia, que perciben el desequilibrio antes que nadie y que buscan instintivamente la armonía en cada situación. En tu vida, los momentos de mayor plenitud llegan cuando tus relaciones son auténticas y equitativas. El reto que el cosmos puso en tu camino es aprender a tomar decisiones desde tu propio centro sin necesitar que todos estén de acuerdo.', g: 'El gnóstico en Libra comprende que la dualidad no es el problema — es la enseñanza. Cada relación es un maestro disfrazado. La indecisión no es cobardía sino la negativa del alma a elegir antes de entender completamente. Tu misión: ser instrumento de justicia en un mundo desequilibrado, sin perder tu propio eje en el proceso.'},
'Sol-Escorpio': {d: 'Tu Sol en Escorpio habla de una identidad que se construye en las profundidades, no en la superficie. Eres de las personas que sienten con una intensidad que pocos comprenden, que tienen una capacidad natural para ver debajo de las apariencias y que no temen enfrentarse a lo que otros evitan. En tu vida, los momentos de mayor plenitud llegan cuando atraviesas una transformación y emerges más consciente de quién eres. El reto que el cosmos puso en tu camino es aprender a soltar el control y confiar en el proceso de cambio.', g: 'El gnóstico en Escorpio no teme la oscuridad — la habita, la conoce y la trasciende. El poder que buscas no es control sobre otros sino maestría sobre tu propia sombra. Tu misión: mostrar que lo que destruye también puede regenerar, si la voluntad es pura.'},
 'Sol-Sagitario': {d: 'Tu Sol en Sagitario habla de una identidad que necesita expansión, sentido y libertad para florecer. Eres de las personas que se asfixian cuando la vida se vuelve demasiado pequeña o rutinaria, que tienen una fe natural en que siempre hay algo más grande esperando ser descubierto. En tu vida, los momentos de mayor plenitud llegan cuando aprendes algo que cambia tu forma de ver el mundo o cuando compartes lo que sabes con otros. El reto que el cosmos puso en tu camino es aprender a comprometerte con lo que ya tienes sin sentir que te estás perdiendo algo mejor.', g: 'El gnóstico en Sagitario comprende que cada viaje externo es un mapa del viaje interior. La libertad que anhelas no es ausencia de compromiso — es el compromiso con algo tan grande que ninguna jaula puede contenerlo. Tu misión: ser portador de fuego filosófico que enciende la sed de conocimiento.'},
'Sol-Capricornio': {d: 'Tu Sol en Capricornio habla de una identidad que se construye a través del esfuerzo, la responsabilidad y la visión a largo plazo. Eres de las personas que no esperan que las cosas lleguen solas, que tienen una capacidad natural para estructurar, planificar y sostener proyectos donde otros abandonan. En tu vida, los momentos de mayor plenitud llegan cuando el trabajo duro se traduce en algo concreto y duradero. El reto que el cosmos puso en tu camino es aprender a disfrutar el camino sin posponer la vida hasta llegar a la cima.', g: 'El gnóstico en Capricornio comprende que la ambición purificada es devoción en acción. La montaña que escala no es de piedra sino de consciencia. La frialdad aparente esconde un fuego interno que arde durante décadas. Tu misión: construir estructuras que sirvan al alma colectiva, no solo al éxito personal.'},
'Sol-Acuario': {d: 'Tu Sol en Acuario habla de una identidad que piensa diferente, siente diferente y ve el mundo desde un ángulo que pocos comprenden. Eres de las personas que se adelantan a su tiempo, que tienen una capacidad natural para identificar lo que no funciona en el sistema y imaginar algo mejor. En tu vida, los momentos de mayor plenitud llegan cuando formas parte de algo que trasciende tu historia personal. El reto que el cosmos puso en tu camino es aprender a conectar emocionalmente con las personas individuales, no solo con la humanidad en abstracto.', g: 'El gnóstico en Acuario comprende que la humanidad es un organismo único que aún no ha despertado a sí mismo. La desconexión emocional es el precio de ver demasiado lejos. Tu misión: ser el puente entre el mundo que es y el mundo que podría ser, sin perderte en la abstracción.'},
'Sol-Piscis': {d: 'Tu Sol en Piscis habla de una identidad que vive entre dos mundos: el visible y el invisible. Eres de las personas que perciben lo que no se dice, que sienten la emoción de una habitación antes de entrar y que tienen una compasión natural que a veces las deja sin fronteras. En tu vida, los momentos de mayor plenitud llegan cuando lo que creas o compartes toca algo profundo en otra persona. El reto que el cosmos puso en tu camino es aprender a estar presente en la realidad concreta sin perder tu sensibilidad.', g: 'El gnóstico en Piscis vive en la frontera entre el mundo y los planos sutiles. La evasión es el mayor peligro: cuando no integras la visión mística en la vida concreta, te disuelves sin haber creado. Tu misión: encarnar lo divino en la materia cotidiana con compasión y presencia.'},
  'Luna-Aries': {d: 'Emocionalmente eres de fuego rápido y llama corta. No guardas, no acumulas, no finges calma cuando no la tienes — y eso, aunque a veces incomoda a otros, es una forma de honestidad emocional que pocos se permiten. Tu paz interior no llega esperando sino moviéndote. El reto está en aprender que no toda batalla emocional necesita ganarse hoy.', g: 'El gnóstico en ti comprende que la ira no siempre es destructiva: a veces es la única respuesta honesta ante la injusticia. Aprendes a distinguir el impulso que libera del impulso que daña. Necesitas espacio para ser el primero, para liderar tu propia vida emocional sin pedir permiso.'},
'Luna-Tauro': {d: 'Lo que sientes lo sientes profundo y lo sientes largo. No eres de emociones que pasan como nubes — las tuyas se asientan, se quedan, construyen raíces. Esa lealtad emocional es uno de tus dones más grandes, aunque a veces te cuesta más de lo que debería soltar lo que ya no te pertenece. Tu seguridad no se negocia: la construyes ladrillo a ladrillo y con razón.', g: 'El gnóstico en ti aprende que el apego a lo material puede ser una forma velada de miedo a la pérdida. La verdadera estabilidad no está en las posesiones sino en la conexión con tu cuerpo como templo sagrado. El placer consciente es tu camino espiritual.'},
'Luna-Géminis': {d: 'Procesas lo que sientes pensándolo, hablándolo, escribiéndolo. Para ti, una emoción sin palabras es casi una emoción sin forma. Cambias de estado con una velocidad que puede desconcertar a quienes te rodean, pero es porque tu mundo interior vive en movimiento constante. El verdadero reto no es entender lo que sientes — es permitirte sentirlo antes de explicarlo.', g: 'El gnóstico en ti comprende que la mente y el corazón no son enemigos — son un matrimonio sagrado que debes aprender a casar. El desafío es bajar del pensamiento al sentimiento puro, sin explicarlo todo. Tus emociones son mensajes, no problemas a resolver.'},
'Luna-Cáncer': {d: 'Sientes todo: lo tuyo, lo ajeno, lo que no se dice, lo que quedó pendiente hace años. Tienes una memoria emocional extraordinaria y una capacidad de cuidar a otros que pocas personas poseen de forma tan natural. El punto ciego está en que a veces cuidas tanto hacia afuera que te olvidas de que tú también necesitas ser cuidado.', g: 'El gnóstico en ti aprende que la empatía sin límites puede convertirse en prisión. La protección del hogar interior — ese espacio donde nadie entra sin invitación — es tu mayor trabajo espiritual. Nutres al mundo, pero primero debes nutrirte a ti mismo.'},
'Luna-Leo': {d: 'Necesitas sentir que importas, que lo que das es visto, que el afecto que ofreces vuelve hacia ti con la misma calidez. Eso no es vanidad — es una necesidad emocional tan legítima como cualquier otra. Cuando te sientes reconocido, tu generosidad no tiene límite. Cuando no, algo en ti se apaga de una forma que cuesta explicar. El trabajo más profundo que tienes por delante es aprender a darte esa luz sin esperar que venga siempre de afuera.', g: 'El gnóstico en Leo lunar comprende que la necesidad de atención es el niño interior que no recibió suficiente luz. Cuando aprendes a darte ese reconocimiento internamente, dejas de depender del aplauso ajeno y empiezas a brillar desde la abundancia.'},
'Luna-Virgo': {d: 'Te calmas siendo útil. Cuando el entorno está en orden, tú estás en orden — y cuando no lo está, algo dentro de ti se tensa sin que puedas evitarlo. Tienes un estándar emocional muy alto, sobre todo contigo mismo, y esa voz crítica interna trabaja horas extra aunque nadie te lo haya pedido. El reto más honesto que tienes es aprender a descansar sin sentir que estás fallando en algo.', g: 'El gnóstico en ti descubre que la hipercrítica interna es la voz del miedo disfrazada de excelencia. Cuando organizas el mundo exterior, en realidad intentas calmar el mundo interior. El descanso no es abandono — es confianza. Tu misión emocional: aprender que eres suficiente incluso cuando el entorno está en desorden.'},
'Luna-Libra': {d: 'Las emociones te pesan menos cuando estás en buena compañía. La soledad prolongada no te sienta bien — no porque seas dependiente, sino porque tu mundo interior se activa y se enriquece en el intercambio con otros. El problema aparece cuando para mantener la armonía empiezas a silenciar lo que realmente sientes. Ese precio, pagado demasiadas veces, termina costando más de lo que imaginas.', g: 'El gnóstico en ti aprende que la paz que tanto buscas en las relaciones debe primero nacer dentro de ti. La diplomacia excesiva puede ser una forma de negarte a ti mismo. Cuando aprendes a sostener tus propias emociones sin necesitar la validación externa, las relaciones se vuelven encuentro real en lugar de espejo compensatorio.'},
'Luna-Escorpio': {d: 'Sientes en capas que la mayoría de las personas nunca llega a explorar. Hay una intensidad en tu mundo emocional que no siempre muestras, pero que está siempre ahí — registrando, procesando, recordando. Guardas más de lo que dices, perdonas más tarde de lo que aparentas y confías en muy pocos, pero cuando lo haces es para siempre. El dolor que no se nombra es el que más pesa en ti.', g: 'El gnóstico en ti aprende que la vulnerabilidad controlada no es debilidad: es el pasaje hacia la verdadera intimidad. Nadie puede amarte realmente si no te conoce. El proceso de desvelar tu mundo interior es el camino alquímico que convierte la herida en poder regenerador.'},
'Luna-Sagitario': {d: 'Cuando la vida se siente demasiado estrecha, tú lo notas antes que nadie — en el cuerpo, en el humor, en las ganas de salir corriendo hacia cualquier lugar que no sea este. No es irresponsabilidad: es que tu mundo emocional respira cuando tiene espacio. Los vínculos que mejor te funcionan son los que no intentan reducirte sino los que se expanden contigo.', g: 'El gnóstico en ti descubre que el humor es tu escudo sagrado y que la filosofía es tu medicina. El compromiso emocional no tiene que significar encierro: puede ser la aventura más grande si eliges a alguien que viaje contigo hacia el infinito. Tu riqueza emocional es la capacidad de encontrar significado en cualquier experiencia.'},
'Luna-Capricornio': {d: 'Aprendiste pronto que no todo lo que sientes tiene que mostrarse, y esa lección te dio una solidez que pocos tienen. Pero también tiene un costo: a veces te distancias tanto de tus propias emociones que ni tú mismo sabes bien qué estás sintiendo. La fortaleza que proyectas es real, pero debajo hay una profundidad emocional que merece ser habitada, no solo administrada.', g: 'El gnóstico en ti comprende que el control emocional es una forma de sobrevivencia aprendida, no de fortaleza real. La verdadera madurez emocional no es suprimir — es sentir con estructura. Cuando te permites el llanto, la ternura y el miedo sin juzgarte, descubres un poder interior que ninguna coraza puede dar.'},
'Luna-Acuario': {d: 'Observas tus propias emociones casi como si fueran de otra persona — con curiosidad, con distancia, a veces con más análisis que presencia. Eso te da una claridad que otros no tienen, pero también puede dejarte un poco solo en los momentos donde lo que se necesita no es comprensión sino simplemente estar. El reto está en no usar la mente como refugio cuando el corazón pide algo diferente.', g: 'El gnóstico en ti comprende que este distanciamiento es una protección ante la intensidad de sentir en un mundo tan poco evolucionado. Tu amor es universal pero a veces se olvida de lo particular. El desafío: bajar de la abstracción al corazón concreto de las personas que tienes delante. El amor humano es también sagrado.'},
'Luna-Piscis': {d: 'Absorbes el ambiente emocional de cualquier espacio en el que entras sin poder evitarlo. Lo que otros sienten te llega, te afecta, te queda. Esa capacidad de conexión profunda es un don poco común, pero tiene un precio: necesitas saber cuándo lo que sientes es tuyo y cuándo lo estás cargando de prestado. Sin esa distinción, el mundo puede volverse demasiado pesado.', g: 'El gnóstico en ti aprende que la compasión sin discernimiento puede disolverte. Necesitas rituales de limpieza energética, espacios de soledad sagrada y la capacidad de decir "esto no es mío". Tu sensibilidad mística es una antena cósmica — pero las antenas también necesitan estar a tierra.'},
 'Mercurio-Aries': {d: 'Tu mente va más rápido que tus palabras y tus palabras van más rápido que la paciencia de quienes te escuchan. Tienes una claridad mental envidiable para cortar lo innecesario e ir directo al punto, pero a veces llegas a la conclusión antes de que el otro haya terminado de hablar. El reto no es frenar tu mente — es darle al otro el tiempo que necesita para estar donde tú ya estás.', g: 'El gnóstico en ti aprende que la velocidad mental es un don solo cuando va acompañada de escucha real. Tus ideas son pioneras, a veces brillantes, siempre apasionadas. Desafío: terminar lo que empiezas mentalmente antes de lanzar el próximo pensamiento al mundo.'},
'Mercurio-Tauro': {d: 'No eres de los que cambian de opinión a la primera — y eso no es terquedad, es que tu mente necesita tiempo para procesar, verificar y hacer suyo el conocimiento antes de aceptarlo. Aprendes mejor con las manos, con la práctica, con la repetición que construye certeza. Lo que entiendes de verdad no se te olvida. Lo que te dicen sin darte tiempo de asimilarlo, entra por un oído y sale por el otro.', g: 'El gnóstico en ti descubre que la memoria sensorial es una forma de sabiduría ancestral. Desafío: cuando la realidad cambia, soltar la certeza anterior sin sentirlo como una pérdida de identidad.'},
'Mercurio-Géminis': {d: 'Tu mente no descansa — y en el fondo tampoco quieres que lo haga. Puedes sostener tres conversaciones simultáneas, cambiar de tema sin perder el hilo y encontrar conexiones entre ideas que para otros no tienen nada que ver. El problema no es la velocidad sino la profundidad: a veces rozas la superficie de diez cosas en lugar de atravesar una hasta el fondo.', g: 'El gnóstico en ti comprende que el conocimiento sin profundización se convierte en ruido. Tienes acceso a muchas puertas pero debes atreverte a atravesar al menos una hasta el fondo. Tu misión mental: usar la velocidad para revelar, no para distraer.'},
'Mercurio-Cáncer': {d: 'Recuerdas las conversaciones que te marcaron con una precisión que asombra. Tu mente no procesa la información de forma neutral — la filtra siempre a través de cómo te hizo sentir, de quién la dijo y en qué momento de tu vida llegó. Esa memoria emocional es una forma de inteligencia poco valorada pero extraordinariamente precisa cuando aprendes a confiar en ella.', g: 'El gnóstico en ti aprende a distinguir el recuerdo que nutre del que encadena. La intuición es tu instrumento más preciso — cuando la razón y el sentimiento trabajan juntos, tu mente se convierte en un órgano de percepción extraordinaria.'},
'Mercurio-Leo': {d: 'Cuando hablas, algo en la sala cambia. Tienes una forma natural de narrar, de hacer que las ideas suenen importantes, de que la gente quiera seguir escuchándote. Ese don comunicativo es real y poderoso — el único punto ciego es cuando el deseo de brillar en la conversación pesa más que el deseo de encontrar la verdad en ella.', g: 'El gnóstico en ti descubre que el ego puede infiltrarse en el pensamiento: cuando más te importa tener razón que encontrar la verdad, la mente se vuelve territorio del demiurgo. Cuando subordinas el ego al servicio de la comunicación sagrada, tu palabra se convierte en herramienta de transformación colectiva.'},
'Mercurio-Virgo': {d: 'Ves lo que no cuadra antes que nadie. Un dato fuera de lugar, una inconsistencia en el argumento, un detalle que todos pasaron por alto — tu mente los detecta de forma casi automática. Esa precisión es un talento extraordinario, aunque a veces el perfeccionismo mental se convierte en el mayor obstáculo para terminar lo que empezaste.', g: 'El gnóstico en ti comprende que el análisis llevado a su límite toca la perfección divina del logos. Pero la parálisis por análisis es la sombra: cuando esperas la solución perfecta, la vida pasa. Tu misión mental: usar la precisión al servicio de la acción, no como sustituto de ella.'},
'Mercurio-Libra': {d: 'Puedes ver el argumento del otro tan bien como el propio — y eso que parece una virtud diplomática a veces te deja paralizado frente a una decisión simple. Tu mente busca el punto justo, la palabra que no ofenda, la postura que incluya todas las perspectivas. Nadie se siente juzgado hablando contigo, y eso es un don que muy pocos tienen.', g: 'El gnóstico en ti aprende que la indecisión crónica puede ser una forma de evitar la responsabilidad de elegir. La belleza de tu mente es que nadie se siente juzgado por ella. Tu misión: usar esa imparcialidad para mediar, construir puentes y formular verdades que todos puedan escuchar sin ponerse a la defensiva.'},
'Mercurio-Escorpio': {d: 'No te conformas con la versión oficial de nada. Tu mente excava, busca la motivación detrás de la motivación, detecta lo que no se dice con la misma facilidad con que otros leen lo que sí se dice. Esa capacidad de ver debajo de la superficie es uno de tus activos más poderosos — y también puede volverse una carga cuando la aplicas sin descanso a cada interacción.', g: 'El gnóstico en ti comprende que este poder perceptivo es sagrado: ver lo que otros ocultan es una responsabilidad, no un arma. Desafío: usar la agudeza mental para sanar y revelar verdades liberadoras, no para controlar o manipular a través del conocimiento.'},
'Mercurio-Sagitario': {d: 'Los detalles te aburren cuando no forman parte de algo más grande. Tu mente necesita el para qué antes de poder concentrarse en el cómo. Piensas en marcos amplios, en principios generales, en la historia larga de las cosas — y eso te da una perspectiva que pocos tienen, aunque a veces te cueste aterrizar en lo concreto.', g: 'El gnóstico en ti aprende que la visión panorámica necesita también la lupa de los detalles. La tendencia a la exageración es el precio de la grandeza de miras. Tu misión mental: convertir las intuiciones filosóficas en sistemas de pensamiento concretos que otros puedan transitar.'},
'Mercurio-Capricornio': {d: 'No hablas por hablar. Cada palabra que dices tiene un propósito y cada idea que compartes ha pasado antes por un filtro interno de utilidad y solidez. Tu mente construye con paciencia, piensa a largo plazo y prefiere la solución que dura sobre la que brilla. El reto está en no cerrarle la puerta a las ideas que todavía no tienen forma práctica — algunas de las más valiosas llegan así.', g: 'El gnóstico en ti comprende que la mente capricorniana puede volverse esclava del pragmatismo y perder el acceso a la intuición y la poesía. Cuando integras la visión práctica con la sensibilidad espiritual, tu pensamiento se vuelve un instrumento de construcción sagrada.'},
'Mercurio-Acuario': {d: 'Tus ideas llegan antes de que el mundo esté listo para recibirlas — y eso puede ser tan estimulante como solitario. Piensas en sistemas, en patrones colectivos, en lo que podría ser en lugar de lo que es. La originalidad no es un esfuerzo para ti: es simplemente tu forma natural de procesar la realidad. El desafío está en traducir esa visión a un lenguaje que los demás puedan seguir sin perderse.', g: 'El gnóstico en ti comprende que vivir en el futuro puede hacerte invisible en el presente. Tu mayor desafío comunicativo: traducir la visión revolucionaria a un lenguaje que las personas de hoy puedan recibir sin sentirse amenazadas.'},
'Mercurio-Piscis': {d: 'Tu mente no piensa en línea recta — piensa en espiral, en imágenes, en sensaciones que luego buscan palabra. Tienes acceso a una forma de conocimiento que no viene de los libros sino de algo más difícil de nombrar. El reto está en confiar en esa intuición sin perderte en ella, y en aprender a comunicar lo que percibes a personas que solo aceptan lo que pueden verificar.', g: 'El gnóstico en ti comprende que la intuición puede ser más precisa que la lógica, siempre que aprendas a distinguirla del deseo y el miedo. Tu misión mental: aprender el lenguaje de los símbolos y usarlo para comunicar verdades que las palabras comunes no pueden contener.'},
 'Venus-Aries': {d: 'Cuando algo te atrae, lo sabes de inmediato — no hay duda, no hay análisis, solo ese impulso que llega antes que cualquier pensamiento. Amas con urgencia y con una honestidad que puede ser tan refrescante como intimidante. El problema no es la intensidad con que empiezas sino aprender a quedarte cuando la novedad se asienta y lo que queda es simplemente la otra persona.', g: 'El gnóstico en ti aprende que el amor que solo vive en la llama inicial no es amor pleno — es chispa sagrada esperando convertirse en fuego sostenido. La lealtad no es prisión: es el crisol donde el amor se purifica. Desafío: aprender a amar también cuando la novedad se ha ido y queda solo la presencia real.'},
'Venus-Tauro': {d: 'No amas rápido, pero cuando lo haces es para largo. Tienes una capacidad de construir afecto de forma paciente, física y completamente entregada que muy pocos pueden igualar. Tu amor se expresa en lo concreto: en estar, en tocar, en hacer que el otro se sienta seguro. El reto está en reconocer cuándo lo que llamas lealtad se ha convertido en resistencia a soltar algo que ya terminó.', g: 'El gnóstico en ti comprende que la sensualidad sagrada es un lenguaje del espíritu encarnado. El cuerpo es templo y el placer consciente es oración. Desafío: el apego que confunde posesión con amor. Lo que amas no te pertenece — te es dado temporalmente para que florezcas junto a ello.'},
'Venus-Géminis': {d: 'Antes de que el cuerpo sienta algo, la mente ya está ahí. Una conversación que te desafía, un humor que te sorprende, una mente que va rápido — eso te enamora más que cualquier atractivo físico. Necesitas variedad y movimiento en el amor, no porque no puedas comprometerte, sino porque la monotonía emocional es para ti una forma de muerte lenta.', g: 'El gnóstico en ti aprende que la variedad que buscas en el amor refleja la multiplicidad de tu alma, no la incapacidad de comprometerte. El desafío: elegir profundidad cuando la superficie ofrece más entretenimiento. Un amor que te desafía intelectualmente y te da libertad puede ser el más duradero.'},
'Venus-Cáncer': {d: 'Amas con memoria, con historia, con la acumulación de todos los momentos compartidos que guardas con más cuidado que nadie. Buscas en el amor un lugar seguro — no una jaula, sino ese espacio raro donde puedes ser completamente tú sin defenderte. El punto ciego está en que a veces el miedo a perder ese refugio te hace aferrarte más de lo que la situación merece.', g: 'El gnóstico en ti comprende que el amor maternal y protector que ofreces es sagrado pero puede convertirse en control cuando el miedo al abandono toma el timón. Desafío: amar desde la abundancia de quien ya se siente completo, no desde la necesidad de ser completado.'},
'Venus-Leo': {d: 'Amas con todo y esperas lo mismo de vuelta — no por capricho sino porque para ti el amor que no se demuestra es un amor a medias. Tienes una generosidad afectiva poco común cuando te sientes correspondido, y una herida igualmente grande cuando sientes que tu entrega no es reconocida. La diferencia entre el amor que te eleva y el que te agota está en con quién eliges quedarte.', g: 'El gnóstico en ti comprende que el amor leonino en su forma más elevada no busca aplausos sino comunión genuina. Cuando dejas de actuar el amor y empiezas a vivirlo desde la autenticidad, te vuelves magnético de una manera que ninguna performance puede igualar. Desafío: el ego herido que convierte el amor en competencia.'},
'Venus-Virgo': {d: 'Tu forma de amar no siempre tiene palabras — tiene acciones. Organizas, cuidas, resuelves, recuerdas los detalles que el otro ni sabe que mencionó. Esa atención minuciosa es una forma de amor profundo que no todo el mundo sabe ver. El problema aparece cuando el estándar que te exiges a ti mismo lo empiezas a aplicar al otro, y lo que era cuidado se convierte en crítica.', g: 'El gnóstico en ti aprende que el amor también necesita palabras, gestos y presencia no funcional. Desafío: la hipercrítica que erosiona lo que construyes con servicio. El amor perfecto no existe — el amor real sí, con sus imperfecciones integradas.'},
'Venus-Libra': {d: 'El amor para ti no es solo emoción — es también estética, equilibrio y reciprocidad. Buscas una conexión donde ambos den y ambos reciban en proporciones que se sientan justas. Tienes un radar muy fino para detectar cuando algo está desequilibrado en una relación, aunque a veces el miedo al conflicto te lleva a aguantar ese desequilibrio más de lo que deberías.', g: 'El gnóstico en ti comprende que la búsqueda del amor perfecto puede ser un espejo de la búsqueda de la propia completitud. Cuando dejas de proyectar el ideal en el otro y lo cultivas en ti, atraes relaciones de genuina reciprocidad. Desafío: la dependencia que se disfraza de armonía.'},
'Venus-Escorpio': {d: 'No entiendes el amor a medias. Para ti o hay entrega real o no hay nada — y esa intensidad puede ser lo más transformador que alguien experimenta en su vida o lo más difícil de sostener, dependiendo de quién esté al otro lado. Percibes las intenciones antes de que se declaren y recuerdas cada traición con una precisión que el tiempo no borra fácilmente.', g: 'El gnóstico en ti comprende que esta intensidad no es posesividad patológica — es el alma buscando la fusión que trasciende el ego. Los celos son señales de miedo, no de amor. La transformación mutua es el regalo más raro que esta Venus puede dar: dos personas que se hacen mejores al haberse encontrado. Desafío: soltar el control y confiar en que lo real no necesita ser retenido por la fuerza.'},
'Venus-Sagitario': {d: 'El amor que no te deja crecer no es amor para ti — es una jaula con buena decoración. Buscas en la pareja a alguien que también tenga sus propios horizontes, sus propias preguntas, su propia vida que valga la pena vivir. La rutina afectiva te apaga. Lo que te enciende es compartir descubrimientos, reírse de lo inesperado y sentir que juntos van hacia algo más grande.', g: 'El gnóstico en ti aprende que el compromiso no es la muerte de la libertad — es la creación de un espacio sagrado donde dos almas crecen juntas hacia el infinito. Desafío: la huida ante la profundidad emocional disfrazada de amor a la libertad.'},
'Venus-Capricornio': {d: 'No te enamoras de cualquiera ni con facilidad — y cuando lo haces, lo tomas en serio. Para ti el amor es también una decisión, una construcción, algo que requiere tiempo y coherencia para volverse real. Eso te hace un compañero extraordinariamente confiable. El reto está en no evaluar tanto antes de sentir, porque a veces lo más valioso llega sin avisar y sin cumplir ningún criterio previo.', g: 'El gnóstico en ti aprende que la contención emocional que te protege también puede aislar. El amor no es solo un contrato — es también gracia, ternura y presencia no planificada. Desafío: permitirte el amor espontáneo sin evaluarlo antes de sentirlo.'},
'Venus-Acuario': {d: 'Necesitas que la persona que amas también sea tu amigo, tu igual, alguien con quien puedas hablar de cualquier cosa sin sentirte juzgado. La atracción sin conexión mental no te sostiene. A veces amas a la humanidad con más facilidad de la que amas a la persona concreta que tienes enfrente, y ese es el espacio donde más trabajo tienes por delante.', g: 'El gnóstico en ti comprende que el amor universal debe aprender también a ser particular: la persona concreta frente a ti necesita ser vista, no solo la humanidad abstracta. Desafío: bajar del ideal al encuentro real.'},
'Venus-Piscis': {d: 'Amas sin llevar la cuenta, sin poner condiciones, con una apertura que pocas personas se permiten. Eso es un don extraordinario que puede hacer que quienes te quieren se sientan verdaderamente vistos y aceptados. El riesgo es que esa misma apertura te deja vulnerable a quienes no tienen la misma honestidad contigo, y el discernimiento — saber a quién darle ese nivel de entrega — es el aprendizaje más importante de tu vida afectiva.', g: 'El gnóstico en ti comprende que la capacidad de amor incondicional es un don divino que necesita ser protegido por el discernimiento. No toda persona que llega a tu vida merece ese nivel de apertura. Desafío: amar plenamente sin disolverse en el otro, mantener el hilo que te conecta con tu propio centro mientras te entregas.'},
  'Marte-Aries': {d: 'Actúas antes de que el miedo tenga tiempo de hablar. Esa capacidad de lanzarte sin paralizarte es uno de tus activos más poderosos en un mundo donde la mayoría espera el momento perfecto que nunca llega. El reto no es contener esa energía sino aprender a dirigirla — porque no todas las batallas merecen tu fuego, y las que sí lo merecen te necesitan completo y enfocado.', g: 'El gnóstico en ti aprende que la violencia y el valor son hermanos: uno destruye, el otro libera. Tu desafío es canalizar esa energía marcial hacia batallas que valen la pena. Cuando luchas por algo más grande que tu ego, te conviertes en un instrumento de la voluntad divina.'},
'Marte-Tauro': {d: 'No eres de los que explotan al primer obstáculo — eres de los que absorben, resisten y siguen avanzando cuando todos los demás ya se rindieron. Tu fuerza no hace ruido pero es de las que mueven montañas. Lo que sí necesitas vigilar es la ira que guardas sin decir: callada, acumulada, hasta que un día sale de una forma que no esperabas ni tú.', g: 'El gnóstico en ti comprende que la ira acumulada es veneno de acción lenta. Necesitas aprender a liberar la tensión antes de que explote. Tu fuerza es extraordinaria — tu desafío es no confundir la resistencia con la perseverancia ni la terquedad con la fuerza de carácter.'},
'Marte-Géminis': {d: 'Tu arma es la palabra y la velocidad mental. Puedes desarmar un argumento, construir una estrategia o cambiar de táctica en segundos, con una agilidad que pocos pueden seguir. El problema no es la energía sino hacia dónde va: dispersa en diez direcciones simultáneas pierde la mitad de su potencia. Cuando logras sostener el foco, eres imparable.', g: 'El gnóstico en ti aprende que la mente sin dirección es el mayor enemigo de la acción efectiva. La dispersión es tu sombra marcial: empiezas diez proyectos y terminas dos. Cuando canalizas esa energía mental hacia una dirección sostenida, te vuelves un comunicador poderoso capaz de mover mentes y corazones.'},
'Marte-Cáncer': {d: 'No peleas abiertamente — pero cuando algo amenaza lo que amas, aparece una ferocidad en ti que sorprende incluso a quienes te conocen bien. Tu energía se activa por protección, no por conquista, y eso le da una profundidad emocional que pocos tipos de coraje tienen. El reto está en aprender a actuar desde el coraje y no desde el miedo, que a veces se parecen demasiado.', g: 'El gnóstico en ti aprende que la agresividad pasiva es la expresión no integrada de esta energía. Cuando actúas desde el coraje emocional en lugar del miedo emocional, tu voluntad se vuelve un instrumento de protección sagrada.'},
'Marte-Leo': {d: 'Cuando tienes una causa en la que crees, no hay nadie más comprometido ni más visible en la batalla. Actúas con una convicción que arrastra a otros y con una dignidad que te impide rendirte cuando te observan. El punto ciego está en asegurarte de que lo que defiendes con tanto fervor es realmente la causa — y no el lugar que ocupas en ella.', g: 'El gnóstico en ti comprende que el ego puede secuestrar incluso la energía marcial más noble. Cuando luchas por algo más grande que tu reconocimiento personal, tu valor se transforma en heroísmo genuino. Tu desafío: subordinar el orgullo al propósito.'},
'Marte-Virgo': {d: 'Tu forma de actuar es metódica, detallada y orientada a hacer las cosas bien antes que rápido. Tienes una capacidad de trabajo sostenido que pocos igualan cuando el proyecto te importa. El problema aparece cuando el perfeccionismo se convierte en un freno: esperando que todo esté listo, a veces no sale nada. La acción imperfecta que existe siempre supera al plan perfecto que nunca se ejecuta.', g: 'El gnóstico en ti aprende que el perfeccionismo puede ser una forma de control ante la incertidumbre. La acción imperfecta que transforma supera a la planificación perfecta que paraliza. Tu misión marcial: ejecutar aunque el plan no sea perfecto.'},
'Marte-Libra': {d: 'No buscas el conflicto — de hecho harías casi cualquier cosa para evitarlo. Pero cuando la injusticia es demasiado evidente para ignorarla, hay en ti una determinación elegante y firme que sorprende a quienes solo te conocían en modo diplomático. El reto está en no esperar tanto para actuar: a veces la paz que preservas callándote cuesta más de lo que vale.', g: 'El gnóstico en ti aprende que el conflicto honesto es más sagrado que la paz falsa. Tu mayor fortaleza: cuando decides actuar desde la claridad y no desde la complacencia, eres el guerrero de la justicia más elegante del zodiaco.'},
'Marte-Escorpio': {d: 'No muestras tus cartas. Observas, calculas, esperas el momento exacto — y cuando actúas, ya tienes todo pensado con una precisión que puede resultar desconcertante para quienes operan de forma más impulsiva. Tu voluntad es de las más poderosas del zodiaco, pero necesita dirección consciente: la misma energía que te hace imparable puede volverse destructiva si la alimentas desde el rencor.', g: 'El gnóstico en ti comprende que este poder transformador es sagrado cuando se usa para el crecimiento y peligroso cuando se vuelve venganza. Tu voluntad puede atravesar cualquier obstáculo. Desafío: distinguir la determinación de la obsesión y el poder personal del control sobre otros.'},
'Marte-Sagitario': {d: 'Te lanzas con una fe que a veces no tiene ningún respaldo lógico — y a veces eso produce milagros. Tu energía es expansiva, entusiasta y contagiosa cuando tienes una visión que te mueve. El reto clásico que tienes es el final: empezar es fácil, sostener el fuego hasta terminar lo que empezaste con tanto fervor ya es otra historia.', g: 'El gnóstico en ti aprende que la fe ciega no reemplaza la preparación consciente. Tu fuego marcial puede encender movimientos enteros cuando se canaliza con sabiduría. Desafío: terminar las batallas que empiezas con tanto fervor antes de correr hacia la siguiente.'},
'Marte-Capricornio': {d: 'Trabajas con una disciplina y una visión a largo plazo que la mayoría no puede sostener. No necesitas motivación externa — tienes una brújula interna que te mantiene en movimiento aunque nadie esté mirando. Esa capacidad de construir con paciencia hacia objetivos que otros ni se atreven a imaginar es uno de tus dones más sólidos. El reto está en no dejar que la meta haga invisible a las personas que van contigo en el camino.', g: 'El gnóstico en ti comprende que la ambición purificada es voluntad divina en acción. Desafío: la frialdad que puede volverse deshumanizante cuando el objetivo eclipsa a las personas en el camino.'},
'Marte-Acuario': {d: 'Luchas por ideas, por sistemas, por un futuro que la mayoría todavía no puede visualizar. Tu energía no es personal — es colectiva, y eso le da una fuerza diferente a la de quien pelea solo por lo propio. Lo que necesitas vigilar es que la frialdad estratégica con que ejecutas no te desconecte de las personas reales que hay detrás de los ideales que defiendes.', g: 'El gnóstico en ti comprende que la revolución sin empatía puede replicar las estructuras que pretende demoler. Tu mayor potencial marcial: cuando subordinas la acción rebelde al servicio genuino de la evolución colectiva.'},
'Marte-Piscis': {d: 'Tu forma de actuar no es directa ni predecible — y eso confunde a quienes esperan que la fuerza siempre haga ruido. Te mueves por intuición, por sensación, por algo que a veces no puedes explicar pero que te lleva exactamente donde necesitas estar. El reto está en no usar esa fluidez como excusa para evitar los conflictos que sí necesitan ser enfrentados.', g: 'El gnóstico en ti aprende que la voluntad espiritual es la más poderosa de todas cuando está bien dirigida. Desafío: la evasión del conflicto necesario y la dificultad para sostener la acción cuando el entorno emocional cambia.'},
'Júpiter-Aries': {d: 'Tu expansión llega cuando actúas sin esperar que todo esté perfecto. Las mejores oportunidades de tu vida han aparecido — o van a aparecer — justo cuando decidiste lanzarte antes de tener todas las respuestas. Esa capacidad de moverte con fe es tu mayor capital. El reto está en aprender a distinguir cuándo es valentía genuina y cuándo es impulsividad disfrazada de coraje.', g: 'El gnóstico en ti aprende que la suerte es en gran parte el nombre que los cautos le dan a la valentía. Tu fe en ti mismo es tu mayor capital expansivo. Desafío: el exceso de confianza que no distingue entre el impulso del alma y el capricho del ego.'},
'Júpiter-Tauro': {d: 'La abundancia no llega a tu vida de golpe — llega acumulándose, capa sobre capa, con la misma paciencia con que construyes todo lo que vale la pena. Tienes una relación natural con lo material que cuando está bien orientada se convierte en prosperidad real y duradera. Lo que necesitas vigilar es que el disfrute no se vuelva exceso y que la comodidad no se convierta en resistencia al cambio.', g: 'El gnóstico en ti aprende que la materialidad bien vivida es una forma de espiritualidad encarnada. Desafío: la indulgencia que confunde el placer sagrado con el exceso que adormece.'},
'Júpiter-Géminis': {d: 'Tu expansión llega por los caminos menos esperados: una conversación, una conexión, un dato que alguien comparte en el momento justo. Tienes una capacidad natural para aprender de cualquier fuente y para transmitir lo que sabes de formas que otros entienden. El reto está en no quedarte solo en la superficie de muchas cosas y atreverte a profundizar en algunas.', g: 'El gnóstico en ti aprende que la sabiduría real exige profundidad, no solo amplitud. Desafío: la dispersión intelectual que toca todo sin transformar nada.'},
'Júpiter-Cáncer': {d: 'Creces cuando te permites confiar — en tu intuición, en las personas que amas, en el proceso que no siempre puedes controlar. Tu expansión tiene raíces emocionales: cuando el mundo interior está en orden, el exterior responde. La generosidad con que cuidas a otros tiende a volverte multiplicada de formas que no siempre puedes predecir pero que rara vez te fallan.', g: 'El gnóstico en ti comprende que el amor familiar y la memoria sagrada son las raíces desde las que se eleva el árbol más fructífero. Desafío: el exceso de apego que impide soltar lo que ya cumplió su ciclo.'},
'Júpiter-Leo': {d: 'Cuando te permites ocupar el espacio que te corresponde sin disculparte por ello, algo en tu vida se expande de forma natural. Tienes una capacidad de inspirar a otros que, bien usada, se convierte en una fuente de abundancia genuina. El punto ciego está en asegurarte de que lo que proyectas hacia afuera tiene un respaldo real adentro — el brillo que no viene del alma se apaga solo.', g: 'El gnóstico en ti aprende que el don de inspirar a otros es una responsabilidad sagrada. Desafío: el ego inflado que confunde reconocimiento con mérito real.'},
'Júpiter-Virgo': {d: 'Tu expansión llega a través del trabajo bien hecho, del servicio genuino y de la atención a los detalles que otros pasan por alto. No eres de los que esperan que la suerte caiga del cielo — construyes las condiciones para que las cosas funcionen, y eso tiene su propia forma de abundancia. El reto está en no dejar que el perfeccionismo te haga rechazar oportunidades que llegan imperfectas pero reales.', g: 'El gnóstico en ti aprende que la excelencia y la humildad no son contradictorias. Desafío: el perfeccionismo que bloquea el aprovechamiento de oportunidades que llegan imperfectas.'},
'Júpiter-Libra': {d: 'Las puertas más importantes de tu vida se han abierto — o se van a abrir — a través de otras personas. Las alianzas que construyes con honestidad y equidad tienen una forma de multiplicarse que va más allá de lo estratégico. Tu expansión está profundamente ligada a la calidad de tus vínculos: cuando las relaciones son genuinas, todo lo demás tiende a fluir.', g: 'El gnóstico en ti aprende que las relaciones que construyes con consciencia son inversiones kármicas. Desafío: la expansión que depende demasiado de la aprobación ajena para materializarse.'},
'Júpiter-Escorpio': {d: 'Tu crecimiento más profundo llega después de las crisis, no antes. Hay en ti una capacidad de transformar las pérdidas en recursos y los finales en puntos de partida que es uno de tus dones más extraordinarios, aunque rara vez lo reconoces como tal en el momento en que ocurre. La abundancia que te corresponde no está en la superficie — está en las profundidades que otros no se atreven a explorar.', g: 'El gnóstico en ti aprende que el verdadero poder no se acumula — se transforma. Desafío: el uso del conocimiento profundo como herramienta de control en lugar de liberación.'},
'Júpiter-Sagitario': {d: 'Tienes una fe que abre puertas que la lógica sola no puede abrir. No siempre puedes explicar por qué confías en que algo va a salir bien — pero esa confianza, cuando es genuina, tiene una forma de hacerse realidad que quienes te observan desde afuera llaman suerte. Lo que necesitas cuidar es que la generosidad y el entusiasmo no te lleven a prometer más de lo que puedes sostener.', g: 'El gnóstico en ti aprende que la verdad que predicas debe ser también la que vives. Desafío: el exceso de todo — promesas, gastos, dogmatismos — que dilapida la gracia.'},
'Júpiter-Capricornio': {d: 'Tu expansión no es rápida ni llamativa — es sólida y duradera. Construyes con una paciencia que la mayoría no tiene y llegas a lugares que otros no alcanzan precisamente porque no te rendiste cuando la ruta se puso difícil. El reto está en no limitar tanto el sueño por miedo al fracaso: a veces te pones un techo antes de que el cosmos haya terminado de mostrarte hasta dónde puedes llegar.', g: 'El gnóstico en ti aprende que la restricción jupiteriana en Capricornio es una enseñanza sobre el verdadero mérito. Desafío: el pensamiento limitado que no se permite soñar en grande porque teme el fracaso.'},
'Júpiter-Acuario': {d: 'Creces cuando tu trabajo sirve a algo más grande que tus intereses personales. Hay en ti una visión de lo que podría ser — en tu entorno, en tu comunidad, en el mundo — que cuando encuentra el canal adecuado se convierte en una fuente de expansión genuina. El reto está en aterrizar esa visión en pasos concretos, porque las ideas que se quedan en abstracto no transforman nada.', g: 'El gnóstico en ti aprende que las ideas revolucionarias necesitan también raíces prácticas para transformar el mundo. Desafío: el idealismo desconectado que no puede aterrizarse en acción concreta.'},
'Júpiter-Piscis': {d: 'Tu expansión llega cuando te rindes — no por derrota sino por confianza. Cuando dejas de intentar controlar el resultado y te permites fluir con lo que el momento pide, aparecen aperturas que ninguna planificación habría podido generar. Tienes un acceso natural a la sincronicidad que otros buscan durante años. El reto está en no usar esa fluidez como excusa para evitar la estructura que también necesitas.', g: 'El gnóstico en ti comprende que la fe sin forma es el mayor de los poderes cuando está purificada. Desafío: el escapismo que disuelve la voluntad en lugar de elevarla.'},
'Saturno-Aries': {d: 'El coraje no te llegó gratis — tuviste que ganártelo atravesando momentos donde lo más fácil habría sido quedarte quieto. En los primeros años de tu vida probablemente sentiste que actuar tenía un costo demasiado alto, que el impulso siempre llegaba acompañado de un freno invisible. Con el tiempo aprendes que esa fricción no era un obstáculo sino el entrenamiento que hace que tu valentía sea real y no solo reactiva.', g: 'El gnóstico en ti aprende que el karma de Aries es aprender a ser valiente desde la madurez, no desde la reacción. Cuando integras la disciplina saturnina con el fuego ariético, te conviertes en el líder más confiable del zodiaco.'},
'Saturno-Tauro': {d: 'La relación con los recursos — el dinero, la estabilidad, el valor propio — ha sido una de las lecciones más constantes de tu vida. No es que no puedas tener seguridad material: es que el cosmos te ha pedido que la construyas con tus propias manos, sin atajos y sin depender de lo que venga de afuera. Lo que edificas con ese esfuerzo tiene una solidez que las cosas que llegan fácil nunca tendrán.', g: 'El gnóstico en ti aprende que el verdadero valor no se compra ni se acumula — se construye internamente con trabajo y dignidad. Con el tiempo, la solidez que edificas se vuelve inquebrantable.'},
'Saturno-Géminis': {d: 'Hubo momentos en tu vida donde expresarte no fue fácil — donde las palabras no salían, donde sentiste que tu mente no era suficientemente rápida o clara. Esa dificultad no era una señal de limitación sino el proceso de aprender a pensar y comunicar con una precisión que los que hablan sin filtro nunca desarrollan. Con el tiempo, lo que dices tiene un peso que las palabras fáciles no tienen.', g: 'El gnóstico en ti aprende que la palabra precisa y considerada tiene más poder que mil palabras vacías. Con madurez, te conviertes en el pensador más riguroso y el comunicador más honesto.'},
'Saturno-Cáncer': {d: 'Algo en tu historia temprana — en el hogar, en la figura que debía nutrirse — dejó una marca que todavía reconoces cuando baja la guardia. No es un defecto tuyo: es una herida que el cosmos puso en tu camino como materia prima de algo más profundo. Las personas que crecieron sin recibir lo que necesitaban y aun así aprendieron a darlo son las que saben exactamente lo que vale.', g: 'El gnóstico en ti aprende que esta herida emocional es la semilla de la mayor fortaleza compasiva. Cuando sanas tu relación con el nutrimiento, puedes ofrecer a otros lo que tú no recibiste.'},
'Saturno-Leo': {d: 'Brillar no siempre te resultó natural — o si lo fue, vino acompañado de una voz interna que lo cuestionaba. El miedo al ridículo, a ocupar demasiado espacio, a que el reconocimiento no llegue o no dure son parte del aprendizaje que este Saturno pone sobre la mesa. Con el tiempo descubres que la expresión que nace desde un lugar auténtico no necesita permiso de nadie.', g: 'El gnóstico en ti aprende que el ego purificado no necesita ser suprimido — necesita ser santificado. Con madurez, te conviertes en el líder más responsable y generoso, uno que no lidera por vanidad sino por vocación.'},
'Saturno-Virgo': {d: 'El estándar que te pones a ti mismo es alto — a veces demasiado. Hay una voz interna que registra cada error con una precisión que ningún crítico externo podría igualar. Esa exigencia, bien encauzada, produce un trabajo de una calidad extraordinaria. Mal encauzada, te paraliza justo antes de que lo que construiste salga al mundo. El trabajo más importante que tienes es aprender a ser tan compasivo contigo como lo eres con los demás.', g: 'El gnóstico en ti aprende que la excelencia al servicio del amor tiene un valor espiritual enorme, mientras que la perfección al servicio del miedo es una trampa del demiurgo. La gracia está en el trabajo bien hecho con humildad.'},
'Saturno-Libra': {d: 'Las relaciones han sido tu escuela más exigente. No porque no sepas conectar sino porque el cosmos te ha pedido que aprendas a vincularte desde un lugar de equilibrio real — no de complacencia, no de dependencia, sino de equidad genuina. Cada vínculo difícil que atravesaste te enseñó algo sobre ti mismo que ninguna relación fácil habría podido darte.', g: 'El gnóstico en ti aprende que cada relación difícil es un maestro disfrazado y que la equidad genuina exige primero ser justo con uno mismo. Con tiempo, construyes vínculos que son pilares sólidos.'},
'Saturno-Escorpio': {d: 'Has atravesado cosas que habrían doblegado a otros. Pérdidas, transformaciones que no pediste, momentos donde todo lo que creías sólido dejó de serlo de golpe. No saliste ileso — pero sí saliste. Y lo que sobrevivió a esas pruebas en ti es de una solidez que no se compra ni se hereda: se forja en la oscuridad con la única herramienta que no te pueden quitar, que es tu propia voluntad.', g: 'El gnóstico en ti aprende que cada destrucción saturnina en Escorpio es una iniciación. Lo que sobrevive a estas pruebas es indestructible. Tu fortaleza psicológica es producto de haber habitado la oscuridad sin ser devorado.'},
'Saturno-Sagitario': {d: 'La búsqueda de sentido ha sido una constante en tu vida — y también una exigencia. No te basta con creer algo: necesitas que lo que crees pueda sostenerse cuando la vida lo pone a prueba. Esa rigurosidad filosófica puede haber sido incómoda en los años donde todos los demás parecían tener certezas fáciles. Con el tiempo se convierte en la base de una sabiduría que no es heredada sino conquistada.', g: 'El gnóstico en ti aprende que la sabiduría real requiere disciplina intelectual y la valentía de vivir coherentemente con lo que se cree. Con tiempo, te conviertes en maestro auténtico.'},
'Saturno-Capricornio': {d: 'La responsabilidad llegó pronto a tu vida — a veces antes de que estuvieras listo para recibirla. Tienes una relación con el esfuerzo y la construcción que es casi instintiva, y una exigencia interna que no descansa fácilmente. Lo que construyes tiene la marca del trabajo real. El reto está en recordar que el valor de lo que edificas no depende solo de lo que logras sino de quién eres mientras lo logras.', g: 'El gnóstico en ti aprende que el mayor logro no es la cima profesional sino la integridad con la que se escala. Cuando el éxito y la ética se alinean, tu obra se convierte en legado.'},
'Saturno-Acuario': {d: 'Tienes una visión de cómo deberían ser las cosas que choca constantemente con cómo son. Esa tensión ha sido uno de los motores más constantes de tu vida — y también una de sus frustraciones más recurrentes. La lección que Saturno te pone aquí no es abandonar la visión sino aprender a construirla ladrillo a ladrillo, con la paciencia que los cambios reales requieren y que el entusiasmo solo no puede sostener.', g: 'El gnóstico en ti aprende que la reforma duradera nace de la disciplina interior, no del carisma. Cuando combinas la visión del futuro con la paciencia del constructor, te vuelves un agente de cambio real.'},
'Saturno-Piscis': {d: 'Lo espiritual y lo práctico han tenido una conversación complicada en tu vida. Hay en ti una sensibilidad y una apertura a los planos sutiles que es real y valiosa, pero el cosmos te ha pedido que eso no quede solo en experiencia interior sino que encuentre una forma concreta de existir en el mundo. La mística que no se encarna en algo tangible tiende a disolverse — y tú sabes eso mejor que nadie.', g: 'El gnóstico en ti aprende que la mística sin estructura puede disolverse en confusión o ilusión. Tu karma: aprender a encarnar lo espiritual en lo cotidiano con disciplina y discernimiento, sin perder la conexión con los planos sutiles.'},
 'Urano-Aries': {d: 'Hay en ti una necesidad de ser auténtico que no negocia fácilmente con las expectativas ajenas. No es rebeldía por costumbre — es que algo en ti reconoce cuándo está viviendo una vida que no le pertenece y se incomoda hasta que algo cambia. Esa capacidad de reinventarte cuando el molde ya no te sirve es uno de tus recursos más valiosos, aunque a quienes te rodean a veces les cueste seguirte el ritmo.', g: 'El gnóstico en ti comprende que la revolución más poderosa es la interior: cuando transformas tu propia consciencia, el entorno cambia inevitablemente.'},
'Urano-Tauro': {d: 'Tu generación está reescribiendo lo que significa tener seguridad en un mundo donde las certezas materiales ya no son lo que eran. En tu vida personal eso se traduce en cambios que llegan sin aviso en todo lo que creías sólido — y en la capacidad, que vas desarrollando con el tiempo, de encontrar estabilidad en lugares donde antes no la hubieras buscado.', g: 'El gnóstico en ti aprende que la verdadera estabilidad no reside en lo acumulado sino en la relación consciente con la materia como expresión sagrada del espíritu.'},
'Urano-Géminis': {d: 'Tu mente no funciona de forma convencional y en el fondo tampoco quieres que lo haga. Hay en ti una forma de conectar ideas que resulta sorprendente para otros — asociaciones inesperadas, saltos de pensamiento que parecen caóticos pero que llevan a algún lugar real. Esa originalidad mental es un activo cuando encuentras el contexto donde puede desplegarse sin tener que justificarse.', g: 'El gnóstico en ti comprende que las ideas más disruptivas son también las más necesarias cuando el mundo mental colectivo se ha vuelto jaula.'},
'Urano-Cáncer': {d: 'La idea de hogar y familia que heredaste no siempre encajó con lo que sentías que necesitabas. Tu generación cuestionó esas estructuras desde adentro, y en tu vida personal eso probablemente se tradujo en rupturas que en su momento dolieron pero que con perspectiva abrieron espacio a algo más auténtico. El hogar real que vas construyendo no se parece al que te mostraron de modelo.', g: 'El gnóstico en ti aprende que el verdadero hogar no es un lugar sino un estado del ser que nadie puede quitar.'},
'Urano-Leo': {d: 'Tu forma de expresarte y de crear tiene algo que no se puede imitar fácilmente — una originalidad que no es buscada sino natural. Cuando te permites salir del molde de lo que se espera de ti en lo creativo, aparece algo que sorprende incluso a quienes te conocen bien. El reto está en no usar esa originalidad solo para diferenciarte sino para decir algo que realmente valga la pena decir.', g: 'El gnóstico en ti comprende que el ego disruptivo puede ser instrumento de revelación cuando se pone al servicio de algo más que el reconocimiento personal.'},
'Urano-Virgo': {d: 'Tienes un ojo extraordinario para ver lo que no funciona en un sistema — los errores que otros normalizan, las ineficiencias que todos dan por sentadas. Esa capacidad analítica con un toque disruptivo puede ser muy valiosa cuando está bien dirigida. Lo que a veces cuesta es no quedarse solo en el diagnóstico y dar el paso hacia la solución, aunque sea imperfecta.', g: 'El gnóstico en ti aprende que la perfección del sistema no garantiza la libertad del alma.'},
'Urano-Libra': {d: 'Las relaciones convencionales nunca te han terminado de convencer del todo. Buscas vínculos que tengan espacio para la autenticidad, para el cambio, para que ambas personas puedan seguir siendo quienes son sin tener que sacrificarse. Eso puede hacer que algunos vínculos lleguen de forma inesperada y otros terminen cuando menos lo anticipas — pero los que se sostienen tienen una calidad diferente.', g: 'El gnóstico en ti aprende que la libertad en el amor no es ausencia de compromiso sino presencia plena sin jaulas.'},
'Urano-Escorpio': {d: 'Tu generación no le tiene miedo a lo que otros prefieren no nombrar. En tu vida personal eso se traduce en una capacidad de transformación que puede ser tan intensa como liberadora — atraviesas cambios que sacuden hasta los cimientos y al otro lado aparece una versión tuya que el proceso anterior no habría podido producir.', g: 'El gnóstico en ti comprende que la iniciación verdadera siempre es disruptiva.'},
'Urano-Sagitario': {d: 'Las verdades prestadas no te duran mucho. Necesitas llegar a tus propias conclusiones filosóficas, espirituales y vitales a través de la experiencia directa — no de lo que te dijeron que debías creer. Esa libertad de pensamiento puede hacerte incómodo en contextos donde se espera conformidad, pero te da una autenticidad intelectual poco común.', g: 'El gnóstico en ti aprende que la búsqueda de verdad genuina exige desaprender antes de poder ver.'},
'Urano-Capricornio': {d: 'Tu generación llegó al mundo con una misión implícita: cuestionar las estructuras de poder que ya no sirven y proponer algo diferente desde adentro. En tu vida personal eso puede traducirse en una ambición que no encaja con los caminos establecidos — no porque rechaces la disciplina sino porque el sistema que encontraste cuando llegaste ya no era suficiente.', g: 'El gnóstico en ti aprende que el poder real se gana con integridad, no con subversión sin propósito.'},
'Urano-Acuario': {d: 'Perteneces a una generación que llegó con una visión del futuro instalada de fábrica. En tu vida personal eso se manifiesta como una capacidad casi innata para ver más allá de las limitaciones del presente — lo que podría ser, lo que debería cambiar, lo que otros todavía no pueden imaginar. El reto está en no vivir tan adelantado que te vuelvas invisible en el tiempo que te toca habitar.', g: 'El gnóstico en ti comprende que la libertad más alta no es ausencia de estructura sino la estructura elegida conscientemente.'},
'Urano-Piscis': {d: 'Tienes acceso a una forma de percepción que no siempre puedes explicar con palabras — intuiciones que llegan de repente, revelaciones que aparecen en los momentos menos esperados. Tu generación está borrando las fronteras entre lo que se puede medir y lo que simplemente se sabe. En tu vida personal eso puede ser tan desconcertante como extraordinario, dependiendo de cuánto hayas aprendido a confiar en esa antena.', g: 'El gnóstico en ti aprende que el caos espiritual también puede ser iniciación cuando se vive con consciencia y discernimiento.'},
  'Neptuno-Aries': {d: 'Perteneces a una generación que llegó al mundo cuestionando qué significa ser uno mismo cuando todo a tu alrededor te define por lo que perteneces. En tu vida personal eso se traduce en una búsqueda de identidad que va más allá de los roles heredados — una necesidad de saber quién eres cuando nadie te está mirando y ninguna tribu te está validando.', g: 'El gnóstico en ti aprende que la ilusión de identidad puede ser el primer velo que debe caer para encontrar el yo real.'},
'Neptuno-Tauro': {d: 'Tu generación aprendió — a veces de la forma más dura — que la seguridad material puede desaparecer de la noche a la mañana. En tu vida personal eso puede haberse traducido en una relación compleja con el dinero y las posesiones: nunca del todo segura, nunca del todo clara. La lección que el cosmos pone aquí es que la abundancia que no depende de lo que tienes es la única que nadie te puede quitar.', g: 'El gnóstico en ti descubre que la realidad sensorial es tanto el gran maestro como el gran engaño.'},
'Neptuno-Géminis': {d: 'Tu generación vivió en un mundo donde la información empezaba a multiplicarse más rápido de lo que podía ser procesada. En tu vida personal eso se manifiesta como una mente que tiene acceso a muchas cosas pero que a veces no sabe bien en qué confiar. Aprender a distinguir lo que realmente sabes de lo que simplemente circula en tu cabeza es uno de los trabajos más importantes que tienes.', g: 'El gnóstico en ti aprende a distinguir la revelación genuina del ruido mental.'},
'Neptuno-Cáncer': {d: 'Llevas una memoria emocional que a veces no es completamente tuya — patrones del hogar, del linaje, de generaciones que no procesaron lo que les tocó y te lo dejaron a ti sin querer. En tu vida personal eso puede aparecer como una nostalgia sin objeto claro o como un vínculo con el pasado familiar que nutre y pesa a la vez. Saber qué vale la pena conservar y qué vale la pena soltar es tu trabajo más profundo.', g: 'El gnóstico en ti aprende que la verdadera nutrición viene del espíritu, no solo del origen familiar.'},
'Neptuno-Leo': {d: 'Tu generación creció en un mundo donde la imagen empezaba a confundirse con la identidad. En tu vida personal eso puede haberse traducido en momentos donde no sabías bien si lo que mostrabas era lo que realmente eras — o en una sensibilidad especial para detectar cuando otros tampoco lo saben. La grandeza que buscas no necesita escenario para ser real.', g: 'El gnóstico en ti aprende que la grandeza verdadera no necesita audiencia.'},
'Neptuno-Virgo': {d: 'Hay en ti una búsqueda de pureza — en el trabajo, en los hábitos, en la forma de servir — que a veces roza lo imposible. Tu generación llegó al mundo queriendo mejorar las cosas desde adentro, con una dedicación casi espiritual a hacerlo bien. El reto está en no perder de vista que la perfección es una dirección, no un destino, y que el servicio dado con amor imperfecto siempre supera al que se retiene esperando ser perfecto.', g: 'El gnóstico en ti aprende que el amor al detalle puede ser una forma de acercarse a lo sagrado cuando la intención es genuina.'},
'Neptuno-Libra': {d: 'Tu generación idealizó el amor y las relaciones de una forma que la realidad cotidiana rara vez pudo sostener. En tu vida personal eso puede haberse traducido en decepciones relacionales profundas — o en una capacidad de amar con una belleza y una entrega que pocas personas se permiten. La diferencia entre la ilusión y el amor real no siempre es obvia, pero aprenderla es uno de los regalos más valiosos que este Neptuno puede darte.', g: 'El gnóstico en ti aprende que la verdadera paz se construye con honestidad, no con ilusión compartida.'},
'Neptuno-Escorpio': {d: 'Tu generación no miró para otro lado ante la oscuridad — la exploró, la nombró, la llevó a la superficie con una valentía que las generaciones anteriores no tenían. En tu vida personal eso se traduce en una capacidad de ir a los lugares difíciles sin paralizarte, de sostener conversaciones que otros evitan y de encontrar algo valioso incluso en las experiencias más sombrias.', g: 'El gnóstico en ti aprende que profundizar en la oscuridad sin perder el hilo de luz es la iniciación más alta.'},
'Neptuno-Sagitario': {d: 'Tu generación llegó al mundo cuestionando las verdades absolutas y buscando algo más vivo que los dogmas heredados. En tu vida personal eso se manifiesta como una espiritualidad propia — construida de experiencias, de preguntas, de tradiciones mezcladas con honestidad — que no cabe del todo en ninguna caja pero que es genuinamente tuya. La trampa está en quedarse buscando indefinidamente sin nunca aterrizar en nada.', g: 'El gnóstico en ti aprende que ninguna forma contiene toda la verdad — todas apuntan al mismo misterio.'},
'Neptuno-Capricornio': {d: 'Tu generación vio derrumbarse instituciones que parecían inquebrantables. En tu vida personal eso puede haberse traducido en una relación escéptica con las estructuras de autoridad — una dificultad para confiar en los sistemas tal como existen y una búsqueda de algo más sólido en qué apoyarse. Lo que construyes desde la integridad tiene una permanencia que lo construido desde el poder nunca tendrá.', g: 'El gnóstico en ti aprende que lo único permanente es lo que está construido sobre verdad espiritual real.'},
'Neptuno-Acuario': {d: 'Tu generación creció en el momento en que la humanidad empezó a estar conectada de formas que nunca antes había imaginado — y también empezó a confundir esa conexión con comunidad real. En tu vida personal eso puede traducirse en una capacidad genuina de sentirte parte de algo colectivo, pero también en la necesidad de aprender a distinguir cuándo esa pertenencia es auténtica y cuándo es solo ruido compartido.', g: 'El gnóstico en ti aprende a distinguir la conexión auténtica de la ilusión de comunidad virtual.'},
'Neptuno-Piscis': {d: 'Perteneces a una generación llamada a encarnar algo que la mayoría todavía no puede nombrar bien: una forma de compasión que no es solo personal sino que tiene una dimensión colectiva y espiritual. En tu vida personal eso puede manifestarse como una porosidad al sufrimiento ajeno que es tan real como agotadora, y como una búsqueda de lo trascendente que no siempre encuentra forma pero que nunca del todo se silencia.', g: 'El gnóstico en ti comprende que la disolución del ego en lo divino es el mayor logro y el mayor riesgo: la diferencia entre el místico y el perdido es el discernimiento.'},
'Pluton-Aries': {d: 'Hay algo en ti que no acepta rendirse. Cuando el mundo te empuja, algo más profundo que el orgullo se despierta y empuja de vuelta. Naciste con una fuerza que puede asustar incluso a quienes te aman — y tu camino es aprender a dirigirla sin destruirte en el intento.', g: 'El gnóstico en ti aprende que la destrucción que no puede evitarse puede al menos ser sagrada cuando sirve al renacimiento. Aries es el guerrero que muere y resucita en cada batalla — no porque sea invencible, sino porque ha comprendido que su verdadera naturaleza no puede ser herida. El fuego que arrasa el campo es el mismo que fertiliza la tierra para la próxima siembra.'},
'Pluton-Tauro': {d: 'Tu relación con lo que posees va mucho más allá del dinero. Sientes las pérdidas en el cuerpo, las acumulaciones en el alma. Has aprendido — o aprenderás — que aferrarse demasiado fuerte termina por romper lo que más se ama.', g: 'El gnóstico en ti aprende que nada que sea verdaderamente valioso puede ser destruido — solo transformado. La materia no es el enemigo del espíritu: es su campo de iniciación. Tauro recuerda lo que las tradiciones espirituales olvidan: que el cuerpo también es sagrado, y que aprender a soltar no es renunciar al mundo sino dejar de ser prisionero de él.'},
'Pluton-Géminis': {d: 'Tu mente no descansa. Ve patrones donde otros ven caos, mentiras donde otros ven verdades cómodas. Tienes el don y la carga de nombrar lo que incomoda — y eso te ha costado más de una vez el precio de la soledad.', g: 'El gnóstico en ti aprende que la palabra más poderosa es la que nombra lo que nadie se atrevía a decir. El Logos no es decoración — es el arma del alma despierta. Géminis en su profundidad más oscura conoce los dos lados de cada verdad: sabe que la misma lengua que libera puede encadenar, y elige con sabiduría cuándo hablar y cuándo guardar silencio como custodia de lo sagrado.'},
'Pluton-Cáncer': {d: 'Llevas adentro heridas que no son completamente tuyas — vienen de más atrás, de quienes te criaron y de quienes los criaron a ellos. Tu sensibilidad no es debilidad: es la antena con la que detectas lo que otros fingen que no existe.', g: 'El gnóstico en ti aprende que el alma nunca pierde su verdadera morada. Los hogares físicos se destruyen; el hogar interior es inexpugnable para quienes saben encontrarlo. Cáncer carga con la memoria del linaje — no como cadena sino como mapa: saber de dónde vienes es el primer paso para comprender a dónde estás destinado a ir.'},
'Pluton-Leo': {d: 'Necesitas brillar — y eso no es vanidad, es una necesidad del alma. Plutón en Leo pone a prueba ese brillo con sombras enormes: el ego inflado, el poder mal usado, la admiración que corrompe. Tu grandeza real nació justo después de tu mayor caída.', g: 'El gnóstico en ti comprende que el poder verdadero nace de la transformación del ego, no de su inflación. La luz que no ha pasado por la oscuridad no ilumina — encandila. Leo iniciado no busca ser adorado: se convierte en el sol que calienta sin pedir nada a cambio, que brilla porque es su naturaleza y no porque necesite testigos.'},
'Pluton-Virgo': {d: 'Tienes un ojo clínico para los defectos — los del mundo y los tuyos propios. Esa exigencia puede volverse tu mayor fortaleza o tu peor tormento. Lo que buscas perfeccionar en el exterior es casi siempre el reflejo de algo que quieres sanar adentro.', g: 'El gnóstico en ti aprende que el cuerpo físico es un templo sagrado que merece una atención tan rigurosa como la que damos al espíritu. Servir con consciencia es uno de los caminos más directos hacia la gnosis. Virgo comprende lo que pocos aceptan: que la perfección no es el destino sino el sendero, y que cada imperfección reconocida honestamente es un escalón hacia la luz.'},
'Pluton-Libra': {d: 'Tus relaciones nunca son superficiales — aunque lo parezcan. Algo en ti busca en el otro una especie de espejo total, y cuando ese espejo se rompe, la sacudida es profunda. Has transformado quién eres a través de quién amaste y quién te lastimó.', g: 'El gnóstico en ti aprende que las relaciones verdaderas son aquellas que te hacen más libre, no menos. El vínculo que exige que te pierdas a ti mismo no es amor — es una trampa del Arcontado. Libra en su iniciación más alta descubre que la justicia verdadera no viene de los tribunales del mundo sino del equilibrio que cada alma alcanza cuando deja de buscar en el otro lo que solo puede encontrar en sí misma.'},
'Pluton-Escorpio': {d: 'Conoces la oscuridad de cerca — no como concepto, sino como experiencia vivida. Hay partes de ti que la mayoría de la gente preferiría no mirar, y sin embargo las miraste. Eso te dio una profundidad que no se compra y no se finge.', g: 'El gnóstico en ti comprende que haber nacido en este tiempo es una iniciación en sí misma — viniste a transformar lo que otros no podían ni mirar. La muerte no te aterra porque ya moriste y resucitaste más de una vez en vida. Escorpio es el único signo que conoce los tres rostros del misterio: la serpiente que arrastra, el águila que asciende y el fénix que elige arder para renacer con consciencia plena.'},
'Pluton-Sagitario': {d: 'Tienes hambre de verdad — una verdad que no quepa en ninguna iglesia ni en ningún dogma. Lo cuestionas todo, a veces hasta el punto de quedarte sin suelo bajo los pies. Pero esa caída libre también es vuelo si aprendes a confiar en lo que encontraste adentro.', g: 'El gnóstico en ti aprende que la verdad que libera siempre estuvo disponible — solo estaba enterrada bajo capas de poder institucionalizado. Buscar afuera es el primer paso; encontrar adentro es el destino. Sagitario iniciado comprende que la flecha más importante no apunta hacia el horizonte sino hacia el centro de uno mismo — y que el viajero que ha recorrido el mundo sin recorrerse a sí mismo no ha llegado a ningún lugar verdadero.'},
'Pluton-Capricornio': {d: 'Ves cómo se sostienen las estructuras del mundo — y ves también sus grietas. Naciste con una conciencia aguda del poder: quién lo tiene, cómo se usa, qué cuesta. Tu desafío es construir algo duradero sin convertirte en aquello que alguna vez criticaste.', g: 'El gnóstico en ti comprende que todo sistema que no sirve al alma humana está destinado a colapsar. Tu misión no es escalar la pirámide — es recordar por qué fue construida y para quién debería serlo. Capricornio en su despertar más profundo no acumula poder para sí mismo: se convierte en el arquitecto de estructuras que permanecen porque fueron construidas sobre verdad y no sobre miedo.'},
'Pluton-Acuario': {d: 'Sientes que el mundo necesita ser reinventado — y que tú formas parte de esa reinvención. Hay en ti una tensión entre pertenecer y diferenciarte, entre el colectivo que te llama y la individualidad que te define. El futuro te atrae porque el presente te queda chico.', g: 'El gnóstico en ti aprende que la revolución tecnológica sin evolución espiritual es el camino más rápido hacia una nueva forma de esclavitud. La verdadera fraternidad humana no se construye con algoritmos — se construye con almas despiertas. Acuario iniciado sabe que la rebelión más radical no es política ni tecnológica: es la del alma que decide despertar en medio de un mundo que ha confundido la información con el conocimiento y la conexión digital con el amor verdadero.'},
'Pluton-Piscis': {d: 'Hay una parte de ti que siente todo demasiado — los dolores del mundo, las corrientes invisibles, lo que no se dice pero se respira. Esa porosidad es un don antiguo. Tu reto es no disolverse en el mar de todo lo que sientes y encontrar la orilla desde donde servir.', g: 'El gnóstico comprende que esta posición anuncia el mayor despertar colectivo o el mayor engaño espiritual — la diferencia la hará el discernimiento de cada alma individual. Sentir no es suficiente: hay que discernir qué viene de la Luz y qué viene del abismo. Piscis en su iniciación final comprende que la disolución del ego no es el fin del camino sino su umbral — y que solo quien ha aprendido a no perderse en el océano puede guiar a otros de regreso a la orilla.'},

    // ── NODO NORTE ──
'NNode-Aries': {d: 'Hay en ti una valentía que todavía no te has permitido usar del todo. Vienes cargando el hábito de esperar, de consultar, de asegurarte antes de moverte — y esa espera te ha costado más de lo que imaginas. Tu crecimiento real comienza cuando te lanzas sin red, cuando lideras sin que nadie te lo pida y cuando confías en tu impulso antes de que la duda tenga tiempo de hablar.', g: 'El gnóstico en ti reconoce que durante demasiadas vidas esperó señales del pleroma antes de moverse. El fuego de Aries es la voluntad pura del espíritu actuando sin mediadores. Cada vez que actúas desde tu verdad sin buscar aprobación, disuelves un eslabón de la cadena que el demiurgo llama prudencia. Tu liberación no está en el permiso que nadie te dará — está en el paso que decides dar tú solo.'},
'NNode-Tauro': {d: 'Tu alma conoce los extremos — las transformaciones abruptas, los giros radicales, la intensidad como modo de vida. Pero en esta encarnación el cosmos te pide algo más difícil que todo eso: quedarte. Construir despacio. Confiar en lo simple. Aprender que un cuerpo bien habitado y un hogar real son formas de espiritualidad tan profundas como cualquier viaje interior.', g: 'El gnóstico en ti aprende que la materia no es el enemigo del espíritu — es su hogar temporal y sagrado. Tu alma aprendió a moverse entre mundos invisibles; ahora debe aprender a habitar este con gratitud y presencia. Encontrar lo sagrado en lo ordinario es la gnosis más difícil de todas, y la más completa. El placer consciente, el contacto con la tierra, la belleza concreta: son caminos tan válidos hacia el pleroma como la meditación más elevada.'},
'NNode-Géminis': {d: 'Has cargado durante mucho tiempo con la certeza como si fuera una virtud. Pero tu crecimiento real no está en tener razón — está en aprender a hacer las preguntas correctas. Tienes una mente capaz de tender puentes entre mundos que parecen opuestos, de encontrar el hilo que conecta lo que otros ven separado. Esa capacidad es tu mayor don y todavía no la has usado a pleno.', g: 'El gnóstico en ti da el paso del dogma a la gnosis viva. El demiurgo ama las certezas absolutas porque paralizan la búsqueda. Tu liberación pasa por la disposición a cuestionarlo todo — incluyendo tus propias convicciones espirituales más preciadas. La verdad que no sobrevive la pregunta no merece llamarse verdad. Tu misión es convertirte en puente y traductor de los mensajes que el cosmos envía continuamente y que muy pocos saben leer.'},
'NNode-Cáncer': {d: 'Has pasado vidas construyendo imperios hacia afuera mientras el mundo interior esperaba. En esta encarnación el cosmos te pide que gires la mirada: que aprendas a sentir sin vergüenza, a crear lazos reales, a reconocer que la ternura no es debilidad sino una forma de poder que el mundo necesita con urgencia. Tu hogar interior es el territorio más importante que te queda por explorar.', g: 'El gnóstico en ti reconoce el retorno a la Sophía interior — la sabiduría compasiva que nunca abandona. El demiurgo prefiere almas que construyen hacia afuera y descuidan el templo interno. Tu liberación pasa por sanar el linaje emocional, por ser el primero en tu árbol que se permite sentir con consciencia y transmitir amor sin condiciones. La gnosis emocional es tan profunda como la intelectual, y mucho más rara.'},
'NNode-Leo': {d: 'Durante mucho tiempo encontraste seguridad en el anonimato — diluirte en el grupo, no destacar demasiado, mantener un perfil que no incomodara a nadie. Pero hay una luz en ti que no puede seguir apagada. Tu crecimiento está en aprender a brillar sin disculparte por ello, a crear desde el corazón y a entender que tu presencia genuina no opaca a nadie — los ilumina.', g: 'El gnóstico en ti comprende que el alma tiene una firma luminosa única que el pleroma espera ver manifestada. Suprimir esa luz por miedo al ego es confundir la humildad con la extinción. Tu misión es distinguir el ego que busca reconocimiento del yo solar que crea porque no puede no crear. Cuando brillas desde el alma y no desde la inseguridad, te conviertes en un faro que ayuda a otros a recordar su propia naturaleza luminosa.'},
'NNode-Virgo': {d: 'Tienes una tendencia a pensar en grande, a proyectar, a imaginar el cuadro completo — y eso tiene su belleza. Pero tu crecimiento real está en el detalle, en el proceso, en el trabajo concreto que convierte los sueños en algo que puede tocarse. Aprender a servir de forma práctica y a encontrar lo sagrado en los actos más pequeños es tu camino de esta vida.', g: 'El gnóstico en ti aprende la gnosis de la encarnación: lo espiritual debe volverse carne, detalle, rutina sagrada. El demiurgo seduce con visiones grandiosas que nunca se materializan. Tu liberación pasa por el trabajo consciente y humilde, por la maestría que solo viene de la repetición con presencia. Cada acto de servicio ejecutado con amor es un acto de resistencia contra el mundo de la ilusión.'},
'NNode-Libra': {d: 'Has aprendido a bastarte a ti mismo — y eso es una fortaleza real. Pero llevada demasiado lejos se convierte en un muro. En esta encarnación el cosmos te pide que aprendas el arte más difícil: el otro. Considerar, negociar, construir alianzas genuinas donde no haya un dominante ni un dominado — donde dos mundos se encuentren sin que ninguno tenga que desaparecer.', g: 'El gnóstico en ti aprende a verse en el espejo del otro sin perder su centro. La unión sagrada no es fusión — es encuentro de dos luces que se iluminan mutuamente sin extinguirse. Tu camino de liberación pasa por crear relaciones que sean escuelas de consciencia: donde cada intercambio eleva, donde el conflicto se resuelve con verdad y no con poder, donde el amor es elección renovada y no hábito adormecido.'},
'NNode-Escorpio': {d: 'Conoces bien el valor de la seguridad — lo que cuesta construirla, lo que da tenerla. Pero hay partes de la vida que no pueden habitarse sin soltar esa seguridad primero. Tu crecimiento está en aprender a morir simbólicamente cuando sea necesario, a confiar en el vacío, a descubrir que lo que surge de las profundidades es siempre más verdadero que lo que se construyó para no tener que bajar a ellas.', g: 'El gnóstico en ti reconoce la llamada a la iniciación profunda. Tu alma evitó durante demasiado tiempo las cámaras subterráneas del ser — allí donde vive el verdadero poder espiritual. El demiurgo promete seguridad a cambio de superficialidad. Tu liberación pasa por renunciar a esa seguridad falsa y descender, como Inanna, a los inframundos del alma. Lo que muere en ese descenso no eras tú — era solo la ilusión de ti.'},
'NNode-Sagitario': {d: 'Tu mente es precisa, analítica, exigente con los hechos — y eso tiene un valor real. Pero hay territorios que esa precisión no puede alcanzar. Tu crecimiento está en aprender a confiar en lo que no puede verificarse, a lanzarte hacia el horizonte aunque no veas el camino completo, a reconocer que la verdad más profunda no siempre puede ser medida ni demostrada.', g: 'El gnóstico en ti da el paso del conocimiento al saber vivo, de la información a la sabiduría. El demiurgo ama los datos porque impiden la fe. Tu liberación pasa por recuperar la capacidad de maravillarte, de sentir que el cosmos tiene un propósito que incluye tu vida. Cada peregrinación que emprendas — interior o exterior — te acerca al fuego del pleroma que ningún mapa puede describir pero que el alma reconoce cuando lo encuentra.'},
'NNode-Capricornio': {d: 'Has buscado contención y seguridad en los demás — en la familia, en figuras que nutrieran lo que tú mismo no te dabas. En esta encarnación el cosmos te pide que te conviertas en tu propia autoridad. Que construyas con paciencia. Que dejes algo duradero en el mundo — no porque alguien te lo pida, sino porque decidiste que así sería.', g: 'El gnóstico en ti comprende que la autoridad espiritual más genuina es la que se construye desde adentro hacia afuera. No necesitas un maestro externo que te valide: necesitas la disciplina de ser fiel a tu propio espíritu. El demiurgo seduce con la necesidad de pertenecer. Tu liberación pasa por construir desde la integridad, sabiendo que lo que edificas con consciencia y amor sobrevive a la muerte del cuerpo.'},
'NNode-Acuario': {d: 'Has brillado en solitario — y lo has hecho bien. Pero hay un paso más grande esperándote: sumar tu talento a algo que te trascienda. Aprender a trabajar en equipo genuino, a ser parte de una causa sin necesitar ser su protagonista, a descubrir que tu contribución tiene más peso cuando no lleva tu nombre escrito encima.', g: 'El gnóstico en ti da el paso de la gnosis individual a la gnosis colectiva. La liberación no es solo personal — tiene una dimensión comunitaria y planetaria. Tu misión es aportar tu chispa única al fuego colectivo sin intentar ser la única llama. El pleroma no es un destino solitario: es la reunión de todas las chispas que se reconocen mutuamente como parte del mismo fuego original.'},
'NNode-Piscis': {d: 'Tienes una mente que analiza, que ordena, que necesita entender antes de confiar. Y esa mente te ha servido bien — hasta cierto límite. Más allá de ese límite hay dimensiones de la vida que solo se abren cuando sueltas el control. Tu crecimiento está en aprender a rendirte ante lo que no puede ser comprendido racionalmente, a fluir, a descubrir que la entrega no es pérdida sino expansión.', g: 'El gnóstico en ti escucha la llamada de regreso al océano del pleroma. Tu alma ha vivido demasiado tiempo en la orilla, midiendo el agua antes de entrar. Tu liberación pasa por aprender a disolverse en lo divino sin perderte — a saber que cuando el alma se entrega completamente al espíritu, no desaparece sino que se convierte en lo que siempre fue. La compasión sin discernimiento es el riesgo; la compasión con sabiduría es el don más elevado de este nodo.'},

    // ── NODO SUR ──
'SNode-Aries': {d: 'Sabes actuar rápido, decidir solo y salir adelante sin depender de nadie — eso no es un defecto, es un talento forjado en muchas vidas. Pero en esta encarnación ese mismo impulso puede jugarte en contra: cuando te lanzas por puro instinto o ignoras al otro en tu carrera hacia adelante, estás repitiendo un patrón que ya aprendiste suficientemente bien. Tu crecimiento está justo donde más te cuesta: en considerar, en esperar, en dejar que alguien más también lidere.', g: 'El gnóstico en ti reconoce el karma del guerrero que confundió la voluntad del ego con la voluntad del espíritu. Tu alma aprendió el poder de la acción directa — ahora debe aprender que el verdadero coraje incluye la vulnerabilidad de necesitar al otro. El demiurgo usa tu autosuficiencia para mantenerte aislado de la red de consciencia colectiva. Tu liberación no pasa por renunciar al fuego sino por ponerlo al servicio de algo mayor que tú.'},
'SNode-Tauro': {d: 'Tienes un talento natural para crear seguridad — material, emocional, cotidiana. Sabes construir, sostener y disfrutar de lo concreto con una maestría que muchos envidiarían. Pero esa misma habilidad puede volverse una trampa: quedarte en la comodidad conocida cuando la vida te está llamando a soltar y transformarte. En esta encarnación, el apego — a las cosas, a las rutinas, a lo que ya funciona — es tu mayor obstáculo disfrazado de virtud.', g: 'El gnóstico en ti reconoce el karma del alma que aprendió a amar la materia y luego confundió el templo con el tesoro. La tierra es sagrada, pero no es el hogar final del espíritu. Tu liberación pasa por honrar lo material sin aferrarte a ello, por comprender que la verdadera estabilidad no reside en lo acumulado sino en la confianza en el ciclo de muerte y renacimiento que el demiurgo llama pérdida y el pleroma llama transformación.'},
'SNode-Géminis': {d: 'Tu mente es ágil, versátil y capaz de conectar con casi cualquier persona o idea — ese es un don real que viene de lejos. Pero hay un lado oscuro en esa agilidad: la facilidad para saltar a la siguiente idea brillante justo cuando la vida te pide quedarte con una sola y profundizar. En esta encarnación, la dispersión intelectual no es curiosidad — es la forma elegante en que evitas comprometerte con una verdad que te exigiría transformarte de verdad.', g: 'El gnóstico en ti reconoce el karma del mensajero que transmite verdades ajenas sin habitar ninguna propia. Tu alma conoce muchos idiomas del espíritu pero rara vez se detuvo a escuchar el silencio donde vive la gnosis directa. Tu liberación no pasa por saber más — pasa por profundizar en lo que ya sabes hasta que se convierta en experiencia viva del pleroma y no solo en conocimiento elegante.'},
'SNode-Cáncer': {d: 'Sabes cuidar como pocos — sentir lo que el otro necesita antes de que lo pida, sostener emocionalmente, crear vínculos que duran. Ese talento viene de vidas enteras al servicio del clan y el hogar. Pero en esta encarnación ese mismo don puede convertirse en cadena: el apego a la familia, a los roles de cuidador, al pasado emocional puede impedirte construir algo propio en el mundo. Tu misión no es dejar de amar — es aprender que cuidar tu propio camino también es una forma de amor.', g: 'El gnóstico en ti reconoce el karma del alma que aprendió la compasión pero no aprendió a soltarla cuando el apego se convirtió en cadena. El amor sin límites puede ser la trampa más dulce del demiurgo. Tu liberación pasa por honrar el amor que sabes dar sin quedarte preso en él, reconociendo que cuidar tu propia misión en el mundo es también una forma de amor — quizás la más difícil y la más necesaria.'},
'SNode-Leo': {d: 'Tienes un carisma natural que no necesita esfuerzo — entras a un espacio y algo cambia. Ese don viene de vidas enteras siendo el centro, el líder, la figura alrededor de la cual giraba el mundo de los demás. Pero en esta encarnación ese mismo brillo puede ser tu límite: el deseo de reconocimiento, de protagonismo, de ser visto puede mantenerte atado a un patrón que ya fue suficientemente vivido. El cosmos te llama a brillar para otros, no para ti.', g: 'El gnóstico en ti reconoce el karma del alma que confundió la luz del ego con la luz del espíritu. Tu alma sabe brillar — ahora debe aprender que la luz más poderosa es la que ilumina sin necesitar ser reconocida como fuente. El demiurgo alimenta el ego con aplausos para mantenerte mirándote a ti mismo. Tu liberación pasa por redirigir esa luz hacia el colectivo con la misma intensidad con que antes la dirigías hacia tu propio brillo.'},
'SNode-Virgo': {d: 'Tienes un ojo que detecta lo que falla antes de que nadie más lo vea — y una capacidad de trabajo y análisis que pocos pueden igualar. Ese talento viene de vidas enteras perfeccionando, sirviendo, corrigiendo. Pero en esta encarnación esa misma precisión puede volverse tu cárcel: el perfeccionismo, la autocrítica constante y la dificultad para ver el cuadro completo pueden mantenerte atrapado en los detalles de una vida que te está pidiendo visión panorámica y fe.', g: 'El gnóstico en ti reconoce el karma del alma que sirvió al logos del demiurgo con tanta devoción que olvidó el pleroma del que proviene. Tu liberación no pasa por dejar de ser preciso sino por poner esa precisión al servicio de una visión más amplia. El análisis sin fe es una jaula inteligente. La gnosis no puede verificarse con los instrumentos del intelecto — necesita también la rendición del corazón ante lo que no puede ser medido.'},
'SNode-Libra': {d: 'Sabes crear armonía donde hay conflicto, escuchar todas las perspectivas y hacer que los demás se sientan considerados — ese es un talento real que viene de muchas vidas como mediador y diplomático. Pero en esta encarnación ese mismo don puede sabotearte: la indecisión, la necesidad de aprobación y la tendencia a definirte a través de los demás pueden impedirte desarrollar la autonomía que esta vida te está pidiendo con urgencia.', g: 'El gnóstico en ti reconoce el karma del alma que buscó el equilibrio en el exterior cuando la verdadera armonía solo existe en el interior. Tu liberación pasa por dejar de buscar en el otro la validación de tu propio valor. Cuando te encuentras a ti mismo sin necesitar el espejo del otro, las relaciones que atraes cambian radicalmente — dejan de ser espejos de dependencia y se convierten en encuentros genuinos entre almas que se eligen libremente.'},
'SNode-Escorpio': {d: 'Lees a las personas y las situaciones a una profundidad que puede resultar intimidante — ves lo que otros ocultan, percibes lo que no se dice, conoces el peso de los secretos. Ese poder viene de vidas enteras habitando las sombras y los misterios. Pero en esta encarnación esa misma intensidad puede ser tu obstáculo: la desconfianza crónica, el control y la tendencia al secreto pueden mantenerte en espirales que ya recorriste suficientemente.', g: 'El gnóstico en ti reconoce el karma del alma que aprendió los misterios del inframundo pero los guardó celosamente en lugar de usarlos para liberar a otros. Tu liberación pasa por compartir lo que sabes con generosidad, por usar el poder que las sombras te dieron como herramienta de sanación y no de control. El gnóstico que emerge de Escorpio ya no teme la muerte — y por eso puede vivir con una libertad que los que aún la temen nunca comprenderán.'},
'SNode-Sagitario': {d: 'Tienes una visión amplia, filosófica, capaz de encontrar el significado detrás de cualquier experiencia — ese don viene de vidas enteras buscando la verdad y enseñando lo que encontraste. Pero en esta encarnación esa misma amplitud puede ser tu evasión: saltar de una verdad a otra, predicar sin practicar, preferir el horizonte a la realidad concreta que ya tienes frente a ti. Tu crecimiento está en detenerte, no en seguir buscando.', g: 'El gnóstico en ti reconoce el karma del buscador que se enamoró más del camino que del destino. Tu alma conoce muchas verdades del cosmos — ahora debe aprender a encarnar una sola con toda su profundidad. El demiurgo seduce con la promesa de que la próxima verdad será la definitiva. Tu liberación pasa por detenerte, por habitar lo que ya sabes con plena consciencia, y por descubrir que el pleroma no está en el próximo horizonte sino exactamente aquí.'},
'SNode-Capricornio': {d: 'Sabes trabajar, construir y asumir responsabilidad con una disciplina que pocos tienen — ese talento viene de vidas enteras siendo el pilar sobre el que los demás se apoyaban. Pero en esta encarnación ese mismo patrón puede ser tu prisión: el trabajo compulsivo, la rigidez y la dificultad para recibir amor y descansar pueden mantenerte construyendo imperios externos mientras el mundo interior permanece deshabitado y en silencio.', g: 'El gnóstico en ti reconoce el karma del alma que sirvió a las estructuras del demiurgo con tanta fidelidad que olvidó el flujo del pleroma. Tu liberación pasa por aprender que no todo se construye — algunas cosas se reciben. Que no toda autoridad se gana — la autoridad del espíritu es innata. Que el descanso no es abandono sino confianza en que el cosmos sabe lo que hace incluso cuando tú no estás controlando el proceso.'},
'SNode-Acuario': {d: 'Tienes una mente capaz de ver lo que otros todavía no pueden imaginar — visionaria, innovadora, comprometida con causas que van más allá del interés personal. Ese don viene de vidas enteras trabajando por ideales colectivos. Pero en esta encarnación ese mismo vuelo puede ser tu distancia: la frialdad emocional, la desconexión de lo íntimo y la tendencia a relacionarte más con ideas que con personas pueden mantenerte en una soledad elegante pero estéril.', g: 'El gnóstico en ti reconoce el karma del alma que amó a la humanidad en abstracto pero tuvo dificultad para amar a la persona concreta frente a ella. Tu liberación pasa por bajar del ideal a lo particular, por descubrir que el pleroma se manifiesta también — y quizás especialmente — en el encuentro íntimo con un solo ser humano que te ve y al que tú ves completamente. La revolución más profunda siempre comienza en el corazón de alguien.'},
'SNode-Piscis': {d: 'Sientes lo invisible, percibes lo sutil y te mueves entre mundos con una naturalidad que para otros resulta incomprensible — ese don viene de vidas enteras como místico y habitante de los planos sutiles. Pero en esta encarnación esa misma porosidad puede ser tu evasión: escapar de la realidad concreta, confundir la ilusión con la visión y evitar la responsabilidad de encarnar plenamente en este mundo que también es sagrado.', g: 'El gnóstico en ti reconoce el karma del alma que alcanzó la disolución en el pleroma pero no pudo sostenerla en la densidad de la materia. Tu liberación no pasa por más meditación o más visiones — pasa por traer esa luz a la vida concreta con paciencia y precisión. El gnóstico maduro sabe que la compasión más elevada no huye del mundo sino que lo habita completamente, con todos sus pesares, sabiendo que es también una manifestación imperfecta pero real del espíritu.'},

    // ── PARTE DE LA FORTUNA ──
'Fortuna-Aries': {d: 'Tu prosperidad no se planifica — se conquista. Cuando dudas demasiado, cuando esperas el momento perfecto, cuando pides permiso antes de actuar, la fortuna pasa de largo. Pero cuando te lanzas, cuando eres el primero, cuando confías en ese impulso que surge antes de que la mente tenga tiempo de cuestionarlo — el mundo se abre. Tu abundancia vive en el atrevimiento genuino, no en la estrategia.', g: 'El gnóstico en ti comprende que tu flujo de gracia está conectado a la expresión más pura de la voluntad espiritual: el acto que no espera permiso del mundo. El demiurgo convierte esta energía en impulso ciego; el iniciado la convierte en acción sagrada que abre caminos donde no los había. Tu prosperidad más profunda no es solo material — es la sensación de vivir alineado con tu chispa original, esa que el pleroma encendió antes de que el mundo te dijera quién debías ser.'},
'Fortuna-Tauro': {d: 'Tu abundancia no llega de golpe — madura despacio, como la fruta que cae cuando está lista y no cuando se la arranca. Tienes un don natural para sostener, para construir con paciencia, para apreciar lo que ya tienes antes de correr hacia lo siguiente. Cuando vives en ese ritmo — presente, enraizado, agradecido — la prosperidad fluye hacia ti de formas que no siempre puedes anticipar pero que siempre puedes reconocer.', g: 'El gnóstico en ti aprende que la verdadera fortuna no se acumula — se habita. El demiurgo usa la escasez para generar miedo y el exceso para generar apego. Cada momento de presencia plena en el cuerpo, cada contacto consciente con la tierra, cada placer vivido con gratitud es una comunión con el pleroma que se manifiesta en la densidad perfecta de la materia. Tratar el mundo material como el templo sagrado que en verdad es — esa es tu gnosis más concreta y más poderosa.'},
'Fortuna-Géminis': {d: 'Tu fortuna vive en el movimiento — de ideas, de palabras, de conexiones. Cuando compartes lo que sabes, cuando tiendes puentes entre mundos que parecen incompatibles, cuando usas la mente y la palabra para crear intercambios genuinos, la abundancia aparece. No la busques en la quietud ni en la especialización extrema — tu prosperidad es móvil, adaptable y se multiplica cada vez que conectas lo que estaba separado.', g: 'El gnóstico en ti descubre que su mayor gracia fluye cuando se convierte en mensajero del espíritu — en alguien que traduce verdades profundas a lenguajes que otros pueden recibir. El demiurgo usa la mente para dispersar y confundir. El iniciado la usa para revelar la unidad detrás de la multiplicidad. Tu prosperidad más genuina es la que surge cuando una idea que compartes cambia la consciencia de alguien — ese es el intercambio más rico que puedes realizar.'},
'Fortuna-Cáncer': {d: 'Tu bienestar más profundo tiene raíces emocionales — crece en los momentos en que cuidas y eres cuidado, en que creates espacios donde otros se sienten seguros, en que te permites sentir sin censurarte. Tu fortuna no es fría ni calculada: es nutricia, intuitiva y se alimenta de presencia real. Cuando tu mundo interior está en paz, algo en el exterior responde con una abundancia que no puede explicarse solo con lógica.', g: 'El gnóstico en ti comprende que la sensibilidad no es vulnerabilidad — es una antena espiritual de primer orden. El demiurgo convierte la permeabilidad emocional en herida a explotar. El iniciado en Cáncer descubre que sentir profundamente es una forma de percibir el pleroma. Tu mayor prosperidad nace cuando tu vida interior es tan rica que desborda naturalmente hacia los que te rodean como luz nutricia y sanadora.'},
'Fortuna-Leo': {d: 'Tu abundancia llega cuando te permites ser visto — cuando no te disculpas por tu luz, cuando creas con pasión genuina y cuando lideras desde el corazón sin esperar que alguien te dé permiso para ocupar el espacio que te corresponde. El reconocimiento que buscas llega cuando deja de ser la meta y se convierte en la consecuencia natural de dar lo mejor de ti. Tu fortuna necesita audiencia — no para el ego, sino porque tu luz está hecha para irradiar.', g: 'El gnóstico en ti comprende que tu prosperidad más auténtica surge cuando creas no para ser reconocido sino porque el alma no puede no crear. Cada obra nacida desde ese lugar es un fragmento de luz divina materializado. El demiurgo usa la necesidad de aprobación para mantenerte dependiente de otros. El iniciado en Leo aprende que la verdadera creatividad no pide aplausos — los recibe como consecuencia, y los agradece sin necesitarlos para seguir creando.'},
'Fortuna-Virgo': {d: 'Tu fortuna no es espectacular — es sólida, construida ladrillo a ladrillo con dedicación y presencia. Llega a través del servicio concreto, de la maestría que se forja con repetición consciente, de la atención amorosa a los detalles que otros ignoran. El orgullo silencioso del trabajo bien hecho es tu mayor tesoro. Cuando lo que haces está impregnado de intención real, el cosmos responde con una abundancia proporcional a tu integridad.', g: 'El gnóstico en ti aprende que el trabajo cotidiano puede ser práctica sagrada. El demiurgo usa la rutina para adormecer; el iniciado la usa para despertar. Cada acto de servicio ejecutado con plena consciencia es una grieta en el velo de la ilusión — un momento donde el logos divino se manifiesta a través de tus manos. Tu prosperidad más profunda es la paz del ser que sabe que su trabajo tiene valor porque fue hecho con amor y presencia.'},
'Fortuna-Libra': {d: 'Tu bienestar florece en compañía — pero solo en la compañía correcta. Las relaciones de reciprocidad real, donde ambas partes dan y reciben con la misma generosidad, son tu mayor fuente de abundancia. Cuando colaboras desde la equidad genuina, cuando creas armonía a tu alrededor y cuando tus vínculos están construidos sobre el respeto mutuo, la prosperidad llega de formas que no podrías haber generado solo.', g: 'El gnóstico en ti descubre que su gracia fluye cuando las relaciones que construye se convierten en escuelas de consciencia mutua. El demiurgo usa el amor para crear dependencia; el iniciado lo usa para crear libertad. Tu prosperidad más genuina emerge en los vínculos donde dos almas se reconocen como fragmentos del mismo pleroma y se ayudan mutuamente a recordar su naturaleza. La belleza que generas en el mundo — física, relacional o artística — es tu ofrenda al espíritu.'},
'Fortuna-Escorpio': {d: 'Tu abundancia emerge de lugares que otros evitarían mirar. Las crisis, las pérdidas, los momentos de regeneración que destruyen lo que ya no servía — esos son los portales por donde entra tu mayor prosperidad. No porque seas masoquista, sino porque tienes la capacidad de extraer oro real de la oscuridad. Lo que te destruye superficialmente suele ser exactamente lo que abre el camino hacia algo más verdadero y más tuyo.', g: 'El gnóstico en ti comprende que su gracia fluye en los mismos territorios que el mundo llama peligrosos: la muerte simbólica, el contacto con los recursos invisibles del alma, la transformación que no pide tu consentimiento. El demiurgo usa el miedo a la pérdida para mantenerte aferrado a lo conocido. El iniciado en Escorpio aprende que cada pérdida auténtica es una liberación disfrazada — y que el cosmos diseñó esas iniciaciones específicamente para ti.'},
'Fortuna-Sagitario': {d: 'Tu bienestar necesita horizonte — espacio para expandirse, para explorar, para seguir la fe cuando la lógica no alcanza a justificarlo. La abundancia llega cuando te mueves: en los viajes, en el estudio, en la búsqueda genuina de significado y en la generosidad con que compartes lo que encuentras. Lo que te restringe o te ata a lo ya conocido bloquea el flujo natural de tu prosperidad. Tu fortuna vive en el movimiento hacia algo más grande.', g: 'El gnóstico en ti aprende que su gracia fluye cuando busca la verdad como acto de devoción al pleroma y no como acumulación de conocimientos para el ego. El demiurgo promete la verdad definitiva en el próximo libro o el próximo maestro. El iniciado en Sagitario descubre que la verdad no se encuentra — se vive. Tu prosperidad más profunda emerge cuando tu filosofía y tu vida son la misma cosa, cuando no hay distancia entre lo que crees y lo que encarnas con cada elección cotidiana.'},
'Fortuna-Capricornio': {d: 'Tu abundancia no llega rápido ni fácil — pero cuando llega, nadie puede quitártela porque fue construida con integridad real. La disciplina sostenida, el trabajo que no busca atajos, el respeto que se gana con coherencia a lo largo del tiempo: esas son tus fuentes de prosperidad más sólidas. El mundo te toma en serio porque tú te tomas en serio. Y ese activo no lo devalúa ninguna crisis.', g: 'El gnóstico en ti comprende que su gracia fluye cuando la ambición está purificada de ego y orientada al servicio. El demiurgo usa la ambición para esclavizar; el iniciado la convierte en vocación sagrada. Cuando construyes desde la integridad — cuando tu obra existe para dejar el mundo mejor de lo que lo encontraste — el cosmos responde con una prosperidad que trasciende lo material. Tu legado no son tus logros sino la calidad de consciencia con que los edificaste.'},
'Fortuna-Acuario': {d: 'Tu abundancia llega por caminos que nadie anticiparía — a través de redes inesperadas, de ideas que parecían demasiado radicales, de conexiones que el azar tejió de formas que la lógica no puede explicar del todo. Cuando pones tu singularidad al servicio de algo más grande que tú, cuando contribuyes a una visión colectiva sin necesitar ser su protagonista, la prosperidad aparece de formas que sorprenden incluso a quien las recibe.', g: 'El gnóstico en ti comprende que su gracia fluye cuando se convierte en canal de la visión del pleroma para el tiempo presente. El demiurgo usa las revoluciones para crear nuevas jaulas; el iniciado las usa para abrir espacios de libertad real. Tu prosperidad más genuina emerge cuando tus ideas más radicales están al servicio de la evolución colectiva — cuando no buscas ser el más brillante de la sala sino el que más contribuye a que todos en ella despierten un poco más.'},
'Fortuna-Piscis': {d: 'Tu abundancia llega cuando sueltas el control — y eso es lo más difícil y lo más poderoso que puedes hacer. Las prácticas espirituales, el arte que surge de los planos sutiles, el servicio que no pide nada a cambio: esos son tus mejores imanes de prosperidad. La fortuna entra por los espacios que la entrega abre, no por los que la voluntad fuerza. Cuanto más confías en el flujo, más generoso se vuelve contigo.', g: 'El gnóstico en ti descubre que su gracia fluye cuando el ego se disuelve suficientemente para que el pleroma pueda actuar a través de él. El demiurgo usa la confusión psíquica para desorientarte; el iniciado aprende a distinguir la ilusión de la visión genuina. Tu prosperidad más profunda no se mide en bienes materiales sino en la riqueza del contacto con lo sagrado — en la frecuencia con que el velo se adelgaza y puedes percibir, aunque sea por instantes, la luz del origen que todo lo sostiene.'},
'Vertex-Aries': {d: 'Hay encuentros en tu vida que no se anuncian — simplemente ocurren, y después ya nada vuelve a ser lo mismo. Una persona que irrumpe cuando menos lo esperas y despierta en ti algo que llevabas dormido: una decisión que no podías tomar, una valentía que no sabías que existía, un comienzo que habías postergado demasiado. El destino no llama suave a tu puerta — la echa abajo.', g: 'El gnóstico en ti reconoce que el alma acordó antes de nacer ser sacudida por encuentros que no piden permiso. El fuego del pleroma no llega templado — llega como Aries: primero, directo e inevitable. Cuando alguien activa este punto de tu carta, sientes que el universo cumple un acuerdo que se firmó mucho antes de que nacieras. No es casualidad. Nunca lo fue.'},
'Vertex-Tauro': {d: 'Los encuentros que te transforman huelen a tierra mojada, a algo que puede tocarse. No llegan con grandes discursos — llegan con presencia. Una persona que simplemente está, que no necesita demostrar nada, que te ancla cuando todo lo demás se mueve. Tu destino se esconde en lo concreto: en una mano que se tiende, en una belleza que detiene el tiempo, en la súbita certeza de que esto — esto — es real.', g: 'El gnóstico en ti reconoce que el alma eligió ser tocada por lo eterno precisamente donde el mundo espiritual menos lo busca: en la materia. Los encuentros destinados son comuniones disfrazadas de momentos ordinarios. Lo que sientes cuando alguien activa tu Vértex no es atracción — es memoria. El cielo recordándote, a través de un cuerpo, que también él habita la tierra.'},
'Vertex-Géminis': {d: 'Tu destino llega hablando. Una frase dicha sin intención que reordena todo lo que creías saber. Un extraño en un lugar improbable que nombra exactamente lo que tú no podías articular. Un texto, una voz, un mensaje que llega en el momento en que la pregunta era más urgente. No subestimes las conversaciones — algunas de ellas son el cosmos hablándote directamente.', g: 'El gnóstico en ti reconoce que el Logos no es solo un concepto — es un mensajero que el pleroma envía disfrazado de palabra cotidiana. Los grandes iniciadores de tu vida no siempre llegaron con ceremonias: a veces fueron una sola oración que atravesó todas tus defensas y encendió algo que ya no pudo volver a apagarse. La palabra viva es tu portal.'},
'Vertex-Cáncer': {d: 'Hay personas que entran en tu vida y sientes, antes de conocerlas del todo, que ya las conocías. Algo en ellas huele a hogar — a un hogar que quizás nunca tuviste físicamente pero que reconoces en algún lugar más antiguo que la memoria. Tu destino se activa en los momentos de ternura inesperada, en los vínculos que sanan sin proponérselo, en el amor que no pide explicación porque simplemente es.', g: 'El gnóstico en ti reconoce que los encuentros destinados en Cáncer activan la memoria del alma — esa que precede al nacimiento y que el cuerpo guarda cifrada en la emoción. La Sophía no siempre habla desde las alturas: a veces habla desde los brazos de alguien que te sostiene en el momento exacto. Cuando alguien activa tu Vértex, no es que hayas llegado a algún lugar nuevo — es que por fin regresaste.'},
'Vertex-Leo': {d: 'Hay una mirada que cambia todo. La de alguien que te ve — no la versión reducida que ofreces al mundo, sino la versión completa que tú mismo apenas te permites reconocer. Esos encuentros no son frecuentes, pero son absolutamente inconfundibles: llegan cargados de intensidad, de creatividad, de una sensación de que algo en ti que estaba dormido acaba de despertar y no tiene ninguna intención de volver a dormirse.', g: 'El gnóstico en ti reconoce que el alma eligió ser despertada por el amor que ilumina — no el amor que depende, sino el que revela. Cada encuentro que activa tu Vértex en Leo es un espejo del pleroma: te devuelve la imagen de tu chispa original antes de que el mundo la cubriera de dudas. Ser visto así, aunque sea una sola vez, es suficiente para recordar quién eres.'},
'Vertex-Virgo': {d: 'Tu destino no suele llegar disfrazado de gran acontecimiento. Llega en la figura de alguien que aparece justo cuando el caos era demasiado, que hace exactamente lo que necesitabas sin que lo pidieras, que reordena algo en tu vida con una precisión que ningún azar podría explicar. Los encuentros que te transforman son discretos, concretos, útiles — y por eso mismo, imposibles de ignorar para quien sabe ver.', g: 'El gnóstico en ti reconoce que el espíritu también actúa a través de la precisión y el servicio. Los mensajeros del pleroma no siempre son figuras luminosas — a veces son personas que simplemente hacen lo correcto en el momento correcto con una exactitud que solo el cosmos pudo haber calculado. Cuando alguien activa tu Vértex, el orden aparece donde había ruido — y ese orden tiene el sabor inconfundible de lo sagrado.'},
'Vertex-Libra': {d: 'Hay encuentros que te devuelven a ti mismo a través del otro. Una persona que llega cuando el desequilibrio era insostenible y que sin proponérselo — o quizás proponiéndoselo desde un nivel que ninguno de los dos comprende del todo — restablece algo que habías perdido. No es amor ordinario lo que sientes: es el reconocimiento de un acuerdo antiguo que finalmente, después de tanto tiempo, entra en vigencia.', g: 'El gnóstico en ti reconoce que el Vértex en Libra es la puerta de los contratos del alma — esos que se firman entre encarnaciones y que el mundo llama casualidad. La persona correcta no llega cuando tú estás listo: llega cuando el desequilibrio es tan preciso que solo su presencia puede restaurar el centro. Lo que sientes no es enamoramiento — es geometría cósmica reconociéndose a sí misma.'},
'Vertex-Escorpio': {d: 'Los encuentros que te marcan no son suaves. Entran por donde más te resistes — en las capas que no muestras, en los silencios donde guardas lo que nadie ha visto, en las zonas de sombra que creías perfectamente selladas. Y sin embargo algo en ti los reconoce antes de que la mente tenga tiempo de protegerse. No hay negociación posible con este tipo de encuentro. Solo descenso, y lo que emerge del otro lado.', g: 'El gnóstico en ti reconoce que el alma acordó antes de nacer enfrentar iniciaciones que no pueden evitarse — solo atravesarse. El Vértex en Escorpio es la puerta de los misterios que no se estudian sino que se viven. Cuando alguien lo activa, no hay distancia posible: el alma reconoce que este encuentro era inevitable desde antes del primer recuerdo, y que lo que muere en él nunca fue realmente tú.'},
'Vertex-Sagitario': {d: 'Tu destino llega expandiendo. Una persona que te muestra un horizonte que no sabías que existía, una experiencia que desbarata todo lo que creías saber y te deja sin suelo — pero también sin techo — bajo las estrellas. Los encuentros que te transforman no tienen la forma de una respuesta: tienen la forma de una pregunta tan buena que tu vida entera se reorganiza para intentar contestarla.', g: 'El gnóstico en ti reconoce que la sabiduría del pleroma no se transmite en libros — se transmite en encuentros. Los grandes maestros de tu vida no siempre tuvieron ese título: a veces fueron un viajero, una crisis, una verdad dicha sin cuidado que sin embargo llegó exactamente donde tenía que llegar. Cuando alguien activa tu Vértex, el cosmos no te da respuestas — te da la pregunta correcta. Y eso vale infinitamente más.'},
'Vertex-Capricornio': {d: 'Los encuentros que te marcan tienen peso, forma, propósito. Llegan personas que no están de paso — que vienen a construir algo contigo, a compartir una responsabilidad que ninguno podría cargar solo. No siempre son encuentros fáciles ni cálidos al principio. Pero tienen una seriedad que el alma reconoce: esto no es un vínculo que el tiempo borrará. Esto tiene la solidez de algo que debía existir.', g: 'El gnóstico en ti reconoce que el alma eligió encarnar un propósito que excede una sola vida — y que ciertos encuentros llegan para ayudar a materializarlo. El Vértex en Capricornio no convoca al amor romántico sino al amor como misión compartida: dos consciencias que el cosmos reunió no por sentimiento sino por función. Cuando alguien lo activa, sientes que el tiempo se reorganiza. Que de repente todo lo anterior tenía sentido porque conducía a esto.'},
'Vertex-Acuario': {d: 'Tu destino llega de formas que no encajan en ningún molde conocido. Una comunidad que te reconoce antes de que tú mismo lo hayas hecho. Una causa que te elige tanto como tú la eliges a ella. Alguien que ve en ti el futuro que aún no has terminado de creer. Los encuentros que te transforman no son íntimos en el sentido convencional — son eléctricos, colectivos, y te dejan con la sensación de que algo en la historia del mundo acaba de moverse.', g: 'El gnóstico en ti reconoce que el alma eligió despertar a través del reconocimiento entre portadores de luz que aún no sabían que lo eran. El Vértex en Acuario convoca encuentros entre chispas del mismo fuego original que se reúnen para recordar juntas de dónde vienen. Cuando alguien lo activa, no sientes que encontraste a una persona — sientes que encontraste una prueba de que el pleroma tiene un plan, y que tú formas parte de él.'},
'Vertex-Piscis': {d: 'Hay encuentros en tu vida que no pueden contarse del todo porque parte de ellos ocurre en un lugar donde las palabras no llegan. Llegan en sincronicidades que desafían cualquier explicación racional, en sueños que resultan ser presagios, en momentos de rendición tan profunda que el velo entre lo visible y lo invisible se vuelve casi transparente. No siempre son encuentros con personas. A veces son encuentros con dimensiones enteras de ti mismo que estaban esperando el momento exacto para mostrarse.', g: 'El gnóstico en ti reconoce que el Vértex en Piscis es el punto más poroso del mapa natal — donde el alma está más cerca de recordar su origen. Los mensajeros del pleroma en este signo no necesitan cuerpo: pueden ser un sueño, una música, una presencia que se siente sin verse. Cuando alguien o algo activa este punto, la ilusión de separación se disuelve por un instante — y en ese instante, sin que puedas explicar por qué, recuerdas todo.'},
  },
  houses: {
   // Aries
'1_Aries': { 
        d: 'Tu identidad se proyecta con una fuerza arrolladora y una necesidad vital de autoafirmación. Posees una presencia física enérgica y un espíritu pionero que te impulsa a tomar la iniciativa en cada situación, mostrándote ante el mundo como un líder natural que no teme abrir nuevos caminos.', 
        g: 'Representas la irrupción del pneuma en el plano de la manifestación con la fuerza del rayo. Esta posición indica que tu personalidad es el vehículo de una voluntad solar pura, destinada a romper las inercias de la materia para que la chispa divina inicie su proceso de autorrealización consciente.' 
    },
    '2_Aries': { 
        d: 'Buscas la seguridad material a través de la acción directa y la competitividad, valorando la independencia financiera como una forma de libertad personal. Tu relación con el dinero es dinámica e impulsiva, tendiendo a generar recursos con rapidez y a gastarlos con la misma energía con la que los obtienes.', 
        g: 'Tu sentido del valor está ligado a la conquista de la sustancia. En este plano, la materia se convierte en el campo de batalla donde el espíritu debe aprender a dominar los recursos sin quedar atrapado por ellos, utilizando la abundancia como una herramienta de poder para la Gran Obra.' 
    },
    '3_Aries': { 
        d: 'Te comunicas con una franqueza punzante y una agilidad mental que no tolera rodeos, expresando tus ideas con valentía y rapidez. Tu entorno cercano y tus estudios se ven marcados por una curiosidad inquieta que te lleva a aprender de forma autodidacta y a defender tus opiniones con un entusiasmo contagioso.', 
        g: 'La mente se convierte en una espada de luz que corta los velos de la confusión. Tu proceso cognitivo es un acto de voluntad que busca la verdad directa, permitiendo que el logos se manifieste en tu palabra como una fuerza transformadora que despierta la conciencia de quienes te escuchan.' 
    },
    '4_Aries': { 
        d: 'En tu hogar y en tu vida privada, manifiestas una necesidad de liderazgo y una atmósfera dinámica que puede ser tan protectora como exigente. Tus raíces familiares están marcadas por figuras fuertes o pioneras, impulsándote a crear un refugio personal donde tú seas quien tome las decisiones y dirija el rumbo.', 
        g: 'El fundamento de tu ser está construido sobre un fuego sagrado que arde en el centro de tu templo íntimo. Esta posición indica que tu herencia espiritual es la del guerrero que protege el hogar del alma, transmutando el linaje kármico en una base de fuerza para la ascensión individual.' 
    },
    '5_Aries': { 
        d: 'Expresas tu creatividad y tu capacidad de amar de una forma apasionada, lúdica y profundamente competitiva. En el romance y el disfrute, buscas la conquista y la novedad constante, proyectando un carisma vibrante que celebra la vida como una aventura donde tú eres el protagonista indiscutible.', 
        g: 'Tu capacidad creadora es un reflejo del Demiurgo en su aspecto más dinámico y original. El placer y el arte son para ti ritos de autoexpresión divina, donde la chispa espiritual se deleita en su propia potencia, manifestando la belleza a través de un acto de voluntad que ignora el miedo al juicio.' 
    },
    '6_Aries': { 
        d: 'Abordas tus responsabilidades diarias y tu salud con un enfoque proactivo y una disciplina que prefiere la acción rápida sobre la rutina lenta. Posees una gran vitalidad física que requiere de retos constantes para no frustrarse, siendo un trabajador incansable cuando se trata de tareas que dependen de tu iniciativa.', 
        g: 'El servicio se convierte en una disciplina de purificación a través del esfuerzo consciente. Tu trabajo cotidiano es la transmutación de la energía vital en orden, donde cada tarea realizada con determinación actúa como un ejercicio de maestría sobre el cuerpo y los elementos que lo componen.' 
    },
    '7_Aries': { 
        d: 'Buscas parejas y socios que reflejen fuerza, independencia y un espíritu emprendedor, aunque esto a menudo genera chispas de rivalidad en tus vínculos. Aprendes a conocerte a través del espejo de la confrontación, integrando tu identidad al equilibrar tu deseo de mando con las necesidades del otro.', 
        g: 'En el espejo del otro, te encuentras con tu propio impulso marcial. Esta casa es el campo de la reconciliación de los opuestos, donde el espíritu debe aprender a amar sin perder su soberanía, comprendiendo que el adversario externo es solo una proyección de la lucha interna por la armonía.' 
    },
    '8_Aries': { 
        d: 'Vives los procesos de transformación y crisis de manera frontal y decidida, enfrentando tus miedos más profundos con una valentía que te permite renacer con rapidez. Tu sexualidad y tu manejo de los recursos compartidos son intensos, buscando siempre una profundidad que requiere de una entrega total y activa.', 
        g: 'Representas la muerte mística del ego en el fuego de la transmutación. Tu camino hacia el conocimiento oculto pasa por la destrucción valerosa de las viejas formas, permitiendo que el pneuma resurja de las cenizas del deseo material con un poder regenerado y una voluntad inquebrantable.' 
    },
    '9_Aries': { 
        d: 'Tu búsqueda de la verdad y tus ideales se expanden a través de la aventura, los viajes y una filosofía de vida que valora la libertad de pensamiento por encima de todo. Posees una fe combativa y pionera, sintiéndote atraído por conocimientos que te permitan explorar fronteras mentales y geográficas inexploradas.', 
        g: 'Tu mente superior es un explorador de los planos celestes. La búsqueda de la gnosis es para ti una expedición sagrada, donde la fe se convierte en un arma de conquista espiritual que te permite ascender por las jerarquías del conocimiento con la audacia de quien se sabe hijo de la luz.' 
    },
    '10_Aries': { 
        d: 'Proyectas una imagen pública de autoridad, ambición y liderazgo, destacando en tu carrera por ser quien toma los riesgos y abre nuevos mercados. Tu vocación está ligada a la conquista de metas elevadas, donde tu reputación se construye sobre la base de tus logros individuales y tu capacidad de mando.', 
        g: 'Tu destino social es la manifestación de la soberanía del espíritu en el mundo de los hombres. Esta posición indica que tu obra exterior debe ser un testimonio de la voluntad divina, actuando como un faro de acción consciente que guía a la sociedad hacia nuevas etapas de evolución y justicia.' 
    },
    '11_Aries': { 
        d: 'En tus grupos sociales y amistades, eres quien aporta la chispa de la iniciativa y motiva a los demás hacia objetivos comunes con un idealismo vibrante. Valoras la lealtad y la libertad dentro de los colectivos, prefiriendo rodearte de personas independientes que no teman luchar por causas innovadoras.', 
        g: 'Tu relación con la fraternidad universal es la del guerrero que defiende el ideal común. Formas parte de la milicia espiritual que busca la liberación de la humanidad, utilizando tu fuerza para proteger a los buscadores de la verdad y para sembrar las semillas de una nueva conciencia colectiva.' 
    },
    '12_Aries': { 
        d: 'Posees una fuerza interna inmensa que a menudo mantienes oculta, enfrentando tus batallas espirituales más intensas en la soledad de tu mundo subconsciente. Tienes una gran capacidad para el sacrificio desinteresado, aunque tus impulsos reprimidos pueden actuar como enemigos invisibles si no los integras.', 
        g: 'Representas la lucha silenciosa de la chispa divina en las prisiones del olvido. Tu camino de liberación final requiere que conquistes tu propio abismo interno, transmutando el impulso de lucha en una paz inefable que disuelve el karma acumulado y permite el retorno del espíritu a su fuente original.' 
    },
   // Tauro
'1_Tauro': { 
        d: 'Proyectas una imagen de estabilidad, paciencia y una fuerte conexión con los placeres sensoriales. Tu presencia física es sólida y calmada, transmitiendo una seguridad natural que prefiere la perseverancia y el ritmo pausado antes que la prisa, valorando enormemente la armonía estética y el bienestar material.', 
        g: 'Representas la fijación de la luz espiritual en la sustancia densa. Tu personalidad actúa como un santuario de paz en el mundo material, indicando que tu camino es la sacralización de la forma, donde el pneuma aprende a habitar el cuerpo y la tierra con una serenidad que refleja la abundancia divina.' 
    },
    '2_Tauro': { 
        d: 'Tu sentido del valor personal está profundamente ligado a la acumulación de recursos tangibles y a la búsqueda de una seguridad económica inamovible. Disfrutas de la belleza de las posesiones y tiendes a gestionar tus finanzas con una prudencia pragmática, buscando siempre una estabilidad que te permita vivir con confort.', 
        g: 'La sustancia se convierte en el cristal donde se refleja tu valor espiritual. En esta casa, la materia es vista como un don divino que debe ser administrado con sabiduría alquímica, comprendiendo que la verdadera riqueza es un estado de conciencia que atrae la providencia mediante el agradecimiento y el equilibrio.' 
    },
    '3_Tauro': { 
        d: 'Posees una forma de pensar lógica, práctica y una comunicación deliberada que prefiere la calidad de las palabras sobre la cantidad. En tus estudios y entorno cercano, buscas conocimientos que tengan una aplicación real y duradera, manteniendo opiniones firmes que solo cambian tras una reflexión profunda y basada en hechos.', 
        g: 'Tu palabra posee el peso de la tierra sagrada y la belleza de la forma articulada. El logos se manifiesta en ti como una fuerza constructiva, donde el pensamiento no es una abstracción, sino una semilla que busca germinar en la realidad para manifestar la armonía de las leyes superiores.' 
    },
    '4_Tauro': { 
        d: 'En tu hogar, buscas crear un refugio de paz, confort y belleza sensorial que sea el centro de tu seguridad emocional. Tus raíces familiares son fuertes y valoras las tradiciones que aportan estabilidad, esforzándote por construir un entorno doméstico sólido donde la abundancia y la tranquilidad sean la norma constante.', 
        g: 'El fundamento de tu ser es el Templo de la Naturaleza. Esta posición indica que tu herencia espiritual es la estabilidad del alma que ha encontrado su centro en la materia purificada, convirtiendo el hogar en un espacio ritual donde se honra la continuidad de la vida y la presencia de lo divino en lo cotidiano.' 
    },
    '5_Tauro': { 
        d: 'Expresas tu creatividad a través de las formas tangibles, el arte y el disfrute pausado de los placeres de la vida. En el amor, eres leal, posesivo y profundamente físico, buscando romances que ofrezcan estabilidad y una belleza clásica que puedas tocar, ver y sentir con todos tus sentidos.', 
        g: 'Tu capacidad creadora es un acto de amor hacia la manifestación divina. El placer y el arte son para ti vías de retorno a la armonía original del Edén, donde la chispa espiritual se deleita en la belleza de la creación, manifestando la luz a través de formas que inspiran serenidad y gratitud.' 
    },
    '6_Tauro': { 
        d: 'Abordas tus tareas diarias y tu salud con una constancia admirable, prefiriendo rutinas que te permitan trabajar a tu propio ritmo y con métodos probados. Posees una resistencia física notable y una actitud práctica hacia el bienestar, cuidando tu cuerpo como un recurso valioso que requiere mantenimiento y placer.', 
        g: 'El servicio cotidiano es una meditación en la constancia y el cuidado de la obra divina. Tu trabajo es la preservación del equilibrio en lo pequeño, donde la disciplina se convierte en un rito de purificación de la materia, transformando la inercia en una labor sagrada que sostiene la vida.' 
    },
    '7_Tauro': { 
        d: 'Buscas relaciones y socios que te aporten seguridad, lealtad y una presencia física reconfortante, valorando la estabilidad por encima de la emoción turbulenta. Aprendes a valorarte a través del compromiso duradero, buscando un equilibrio donde el afecto se traduzca en una construcción compartida y armoniosa.', 
        g: 'En el espejo del vínculo, encuentras la necesidad de paz y comunión con la sustancia. Esta casa representa el matrimonio místico con la alteridad, donde el alma aprende a reconocer la belleza del espíritu en el otro, consolidando una unión que refleja la estabilidad eterna de las leyes cósmicas.' 
    },
    '8_Tauro': { 
        d: 'Vives las transformaciones personales de manera lenta pero profunda, buscando seguridad incluso en medio de las crisis más intensas. Tu relación con la sexualidad y los recursos compartidos es intensamente física y posesiva, buscando una estabilidad emocional que sobreviva a cualquier proceso de cambio radical.', 
        g: 'Representas la transmutación de la materia pesada en oro espiritual a través del despojo consciente. Tu camino hacia el conocimiento oculto pasa por comprender que nada se posee realmente, permitiendo que el espíritu se libere del apego a la forma para encontrar la esencia inmutable que reside en el abismo.' 
    },
    '9_Tauro': { 
        d: 'Tu filosofía de vida y tus creencias se asientan sobre valores sólidos, tradicionales y una fe que necesita verse reflejada en la belleza del mundo natural. Te atraen los viajes que ofrecen confort y el aprendizaje de sabidurías antiguas que han resistido la prueba del tiempo, buscando verdades que sean prácticas.', 
        g: 'Tu mente superior busca la sabiduría en las leyes inmutables de la creación. La búsqueda de la gnosis es para ti un camino de reconocimiento de la presencia divina en la Tierra, donde la fe se manifiesta como una certeza inamovible en la armonía del universo y la justicia de las leyes naturales.' 
    },
    '10_Tauro': { 
        d: 'Proyectas una imagen profesional de fiabilidad, perseverancia y un éxito construido paso a paso con gran determinación. Tu vocación suele estar ligada a la gestión de recursos, el arte o la estética, donde tu reputación se basa en tu capacidad para crear resultados tangibles, bellos y duraderos.', 
        g: 'Tu destino social es la manifestación de la abundancia del espíritu en la estructura del mundo. Esta posición indica que tu obra exterior debe ser un testimonio de la solidez y la belleza divinas, actuando como un pilar que sostiene y embellece la realidad para el bienestar de la colectividad.' 
    },
    '11_Tauro': { 
        d: 'En tus grupos sociales, eres la presencia estable y confiable que busca la armonía y el disfrute compartido de los logros materiales. Valoras las amistades de larga duración y los proyectos colectivos que tienen una base sólida y objetivos productivos, aportando un sentido de paz y lealtad al grupo.', 
        g: 'Tu relación con la fraternidad universal se basa en el sustento y la protección del ideal común. Formas parte de la red espiritual que nutre y da forma a los sueños de la humanidad, utilizando tu estabilidad para asegurar que las semillas de la nueva conciencia tengan una tierra fértil donde germinar.' 
    },
    '12_Tauro': { 
        d: 'Posees una reserva de fuerza y paz interna que mantienes en secreto, encontrando tu mayor consuelo en el contacto silencioso con la naturaleza o el arte privado. Puedes tener miedos inconscientes relacionados con la pérdida material, pero tu espíritu posee la capacidad de encontrar una calma inalterable en la soledad.', 
        g: 'Representas la quietud del alma que descansa en la fuente antes de la manifestación. Tu camino de liberación final requiere que disuelvas el apego a la materia en el silencio del espíritu, transmutando la inercia en una paz inefable que reconoce que la verdadera seguridad reside en el retorno a lo absoluto.' 
    },
   // Geminis
'1_Geminis': { 
        d: 'Proyectas una personalidad curiosa, versátil y dotada de una gran agilidad mental que te permite adaptarte a cualquier situación con facilidad. Tu presencia es comunicativa y juvenil, mostrándote ante el mundo como un buscador constante de información que valora la variedad de experiencias y el intercambio de ideas por encima de la rigidez.', 
        g: 'Representas la dualidad del logos manifestándose en la conciencia humana. Tu personalidad actúa como un puente entre los planos, indicando que tu camino es la integración de los opuestos a través del conocimiento, donde el pneuma utiliza la palabra y el intelecto para descifrar los símbolos del mundo material.' 
    },
    '2_Geminis': { 
        d: 'Tu sentido del valor personal y tus recursos económicos dependen de tu ingenio, tu capacidad de comunicación y tu habilidad para diversificar tus fuentes de ingresos. Tiendes a ver el dinero como un medio de intercambio de información y experiencias, gestionando tus finanzas con una mentalidad ágil y adaptable.', 
        g: 'La sustancia se vuelve volátil y mental bajo tu influencia. En esta casa, aprendes que la verdadera riqueza reside en la flexibilidad del espíritu y en la capacidad de transmutar las ideas en recursos, comprendiendo que la abundancia divina fluye a través de la circulación constante del conocimiento.' 
    },
    '3_Geminis': { 
        d: 'Posees una mente extraordinariamente activa y una capacidad de aprendizaje que se nutre de la multiplicidad de intereses y el contacto social constante. Te comunicas de forma elocuente y rápida, siendo un conector natural entre personas e ideas dentro de tu entorno cercano, estudios y viajes cortos.', 
        g: 'Tu palabra es la expresión viva del Mercurio filosófico, mediador entre lo alto y lo bajo. El logos se fragmenta en mil ideas para explorar cada rincón de la creación, permitiendo que tu mente actúe como un transmisor de verdades que despiertan la chispa intelectual en el tejido de lo cotidiano.' 
    },
    '4_Geminis': { 
        d: 'En tu hogar predomina una atmósfera estimulante y comunicativa, donde el intercambio de ideas es fundamental para tu seguridad emocional. Tus raíces familiares suelen estar marcadas por el movimiento o la intelectualidad, buscando crear un refugio privado que funcione como un centro de estudio o debate constante.', 
        g: 'El fundamento de tu ser es la movilidad del pensamiento sagrado. Esta posición indica que tu herencia espiritual es la capacidad de encontrar el centro en medio del cambio, convirtiendo el hogar en un espacio de tránsito donde el alma se nutre de la diversidad para fortalecer su identidad ante el cosmos.' 
    },
    '5_Geminis': { 
        d: 'Expresas tu creatividad a través de las palabras, el juego intelectual y la experimentación constante en tus aficiones. En el amor, buscas el estímulo mental y la variedad, viviendo los romances con una ligereza juvenil y una curiosidad que celebra la comunicación como la forma más alta de placer.', 
        g: 'Tu capacidad creadora es un juego de espejos del espíritu. El arte y el goce son para ti ritos de exploración del dualismo cósmico, donde la chispa divina se divierte combinando formas y conceptos para manifestar la belleza a través de la inteligencia y la armonía de los opuestos.' 
    },
    '6_Geminis': { 
        d: 'Abordas tus responsabilidades diarias con una actitud mental y multitarea, necesitando variedad para no aburrirte en el trabajo o en tu cuidado personal. Posees una habilidad natural para los detalles técnicos y la organización lógica, viendo la salud como un equilibrio que depende de la agilidad nerviosa y mental.', 
        g: 'El servicio cotidiano es una disciplina de atención consciente y discernimiento. Tu trabajo es la clasificación y transmisión de la armonía en lo pequeño, donde el esfuerzo se convierte en un ejercicio de agilidad espiritual que purifica la materia a través de la claridad del pensamiento aplicado.' 
    },
    '7_Geminis': { 
        d: 'Buscas relaciones y socios que desafíen tu intelecto y que compartan tu necesidad de comunicación y movimiento constante. Aprendes a conocerte a través del diálogo y el intercambio de puntos de vista, buscando vínculos que funcionen como un espejo intelectual donde la curiosidad sea el lazo principal.', 
        g: 'En el espejo del otro, encuentras a tu gemelo espiritual y la necesidad de comunicación mística. Esta casa representa el diálogo entre las almas, donde el pneuma aprende que la unión verdadera nace de la resonancia de las ideas y la comprensión mutua de las leyes que rigen la dualidad.' 
    },
    '8_Geminis': { 
        d: 'Vives los procesos de transformación y crisis a través del análisis mental y la búsqueda de información que explique tus cambios profundos. Tu relación con lo oculto y los recursos compartidos es curiosa y racional, tratando de descifrar los misterios de la vida y la muerte mediante el intelecto.', 
        g: 'Representas la transmutación de la mente inferior en sabiduría superior a través de la indagación en el abismo. Tu camino hacia el conocimiento secreto pasa por el estudio de los símbolos y la palabra perdida, permitiendo que el espíritu se libere de la ignorancia mediante la comprensión de la dualidad.' 
    },
    '9_Geminis': { 
        d: 'Tu filosofía de vida es ecléctica y se expande mediante el estudio constante, los idiomas y la exploración de diferentes corrientes de pensamiento. Te atraen los viajes que estimulan tu mente y los conocimientos que te permiten conectar diversas culturas, buscando una verdad que sea dinámica y plural.', 
        g: 'Tu mente superior es un viajero entre las esferas del conocimiento. La búsqueda de la gnosis es para ti una recopilación de verdades universales, donde la fe se manifiesta como una comprensión lógica del orden cósmico y la capacidad de traducir los misterios divinos al lenguaje de los hombres.' 
    },
    '10_Geminis': { 
        d: 'Proyectas una imagen pública de versatilidad, elocuencia y una carrera profesional que suele implicar la comunicación o la mediación. Tu vocación está ligada a tu capacidad para manejar información y adaptarte a las tendencias, donde tu reputación se basa en tu agilidad mental y tu talento social.', 
        g: 'Tu destino social es la manifestación del Logos en la estructura del mundo. Esta posición indica que tu obra exterior debe ser un vehículo de información y claridad, actuando como un mensajero de la conciencia que conecta los diferentes niveles de la sociedad con la verdad del espíritu.' 
    },
    '11_Geminis': { 
        d: 'En tus grupos sociales, eres el conector que facilita el flujo de noticias y el intercambio de ideas entre amigos y colectivos. Valoras las amistades intelectuales y los proyectos grupales que fomentan la libre expresión, aportando una mentalidad abierta y una red de contactos siempre activa.', 
        g: 'Tu relación con la fraternidad universal es la del transmisor de la luz intelectual. Formas parte de la red de comunicación espiritual que une a los buscadores, utilizando tu palabra para difundir las semillas de la nueva conciencia y para crear puentes de entendimiento entre los hombres.' 
    },
    '12_Geminis': { 
        d: 'Posees una mente subconsciente sumamente activa que procesa información en sueños o estados de soledad, a veces generando una inquietud nerviosa oculta. Tu espíritu busca la paz a través del silencio mental, aunque tu mayor desafío es acallar la dualidad interna para encontrar la verdad única.', 
        g: 'Representas la disolución de la multiplicidad en la unidad del silencio sagrado. Tu camino de liberación final requiere que trasciendas el ruido de las mil palabras para escuchar el Verbo Único, transmutando la curiosidad externa en una visión interna que reconoce la fuente original de todo logos.' 
    },
   // Cancer
'1_Cancer': { 
        d: 'Proyectas una personalidad sensible, protectora y con una fuerte conexión emocional que se percibe a través de tu aura acogedora. Tu presencia es receptiva y cautelosa, mostrándote ante el mundo con una armadura que protege un interior tierno, valorando la familia, las raíces y la seguridad de los lazos afectivos por encima de todo.', 
        g: 'Representas la encarnación del alma en la matriz del mundo, actuando como un receptáculo de las aguas lunares. Tu personalidad es el espejo del pneuma que busca nutrir la chispa divina, indicando que tu camino es la purificación de las emociones para convertir tu cuerpo en un templo donde la luz del espíritu se sienta segura.' 
    },
    '2_Cancer': { 
        d: 'Tu sentido del valor personal está íntimamente ligado a la seguridad emocional que te brindan tus posesiones y tu estabilidad financiera. Tiendes a ahorrar con un instinto de protección hacia tus seres queridos, viendo el dinero como un refugio que garantiza el sustento y la continuidad de tu clan o familia.', 
        g: 'La sustancia es vista como el alimento sagrado que sostiene la vida. En esta casa, aprendes que la verdadera riqueza es la capacidad de nutrir y ser nutrido por la providencia divina, comprendiendo que los recursos materiales son un reflejo del cuidado del espíritu sobre su manifestación en la materia.' 
    },
    '3_Cancer': { 
        d: 'Te comunicas con una gran carga emocional y una memoria retentiva que atesora las vivencias del pasado y las anécdotas familiares. En tu entorno cercano y estudios, buscas conocimientos que te den una sensación de pertenencia, expresando tus ideas de forma subjetiva y protectora hacia quienes consideras cercanos.', 
        g: 'Tu palabra fluye desde las profundidades del inconsciente, cargada con la fuerza del sentimiento sagrado. El logos se manifiesta en ti como un lenguaje de cuidado y memoria, permitiendo que tu mente actúe como un hilo que une el pasado con el presente a través de la transmisión de la sabiduría ancestral.' 
    },
    '4_Cancer': { 
        d: 'En tu hogar, buscas la máxima nutrición emocional, creando un espacio íntimo que es un verdadero útero de protección y calidez. Tus raíces familiares son el pilar de tu existencia, sintiendo una conexión profunda con tus ancestros y esforzándote por mantener viva la llama de la tradición y el cuidado mutuo.', 
        g: 'El fundamento de tu ser es el Origen Primordial. Esta posición indica que tu herencia espiritual es la conexión con la Gran Madre cósmica, convirtiendo el hogar en un espacio ritual de retorno a la fuente, donde el alma se fortalece al reconocer su pertenencia a la corriente eterna de la vida divina.' 
    },
    '5_Cancer': { 
        d: 'Expresas tu creatividad de forma sensible y maternal, poniendo el corazón en cada obra o afición que realizas. En el amor, buscas una conexión profunda y nutritiva que te haga sentir seguro, viviendo los romances con una entrega emocional que busca crear lazos duraderos y, a menudo, una familia propia.', 
        g: 'Tu capacidad creadora es un acto de dar vida desde el amor incondicional. El arte y el goce son para ti ritos de gestación del espíritu, donde la chispa divina se manifiesta a través de la ternura y la protección, creando formas de belleza que abrazan y sanan la conciencia de quienes las perciben.' 
    },
    '6_Cancer': { 
        d: 'Abordas tus responsabilidades diarias con una actitud de cuidado y servicio hacia los demás, convirtiendo tu ambiente laboral en una segunda familia. Tu salud está fuertemente ligada a tu estado emocional, necesitando una rutina que respete tus ciclos internos y que te permita sentirte útil y protegido.', 
        g: 'El servicio cotidiano es una disciplina de nutrición del mundo material. Tu trabajo es la preservación de la vida en sus detalles más íntimos, donde el esfuerzo se convierte en un rito de purificación del alma a través del cuidado constante de la obra divina en los seres y en el propio cuerpo.' 
    },
    '7_Cancer': { 
        d: 'Buscas parejas y socios que te ofrezcan seguridad emocional, protección y una calidez que te haga sentir "en casa". Aprendes a conocerte a través de la vulnerabilidad compartida en tus vínculos, buscando una unión donde el compromiso se base en la lealtad afectiva y en el apoyo mutuo incondicional.', 
        g: 'En el espejo del otro, encuentras la necesidad de pertenencia y el reflejo del alma nutricia. Esta casa representa el matrimonio místico de las emociones, donde el pneuma aprende que la unión verdadera es la fusión de dos sensibilidades que se reconocen como parte de la misma esencia divina.' 
    },
    '8_Cancer': { 
        d: 'Vives las transformaciones personales con una intensidad emocional profunda, sintiendo las crisis como procesos de muerte y renacimiento interno muy íntimos. Tu relación con lo oculto y los recursos compartidos está marcada por un instinto de protección, buscando desentrañar los misterios del alma con cautela.', 
        g: 'Representas la inmersión del alma en las aguas de la transmutación psíquica. Tu camino hacia el conocimiento oculto pasa por la sanación de las heridas ancestrales y la liberación del karma emocional, permitiendo que el espíritu resurja de las profundidades con una sabiduría basada en el perdón y la compasión.' 
    },
    '9_Cancer': { 
        d: 'Tu filosofía de vida está impregnada de valores familiares y una fe que busca la seguridad espiritual en la conexión con lo divino maternal. Te atraen los viajes que te permitan reconectar con tus raíces o con lugares que tengan un significado emocional profundo, buscando una verdad que te abrace.', 
        g: 'Tu mente superior es un buscador del Hogar Celeste. La búsqueda de la gnosis es para ti un peregrinaje hacia el origen del espíritu, donde la fe se manifiesta como una certeza emocional en la guía de las jerarquías superiores y la protección constante de la luz divina sobre sus hijos.' 
    },
    '10_Cancer': { 
        d: 'Proyectas una imagen pública de autoridad protectora y una carrera profesional que suele estar ligada al cuidado, la nutrición o la gestión de necesidades sociales. Tu vocación está imbuida de un sentido de responsabilidad hacia la comunidad, donde tu reputación se basa en tu empatía y lealtad.', 
        g: 'Tu destino social es la manifestación de la maternidad espiritual en la estructura del mundo. Esta posición indica que tu obra exterior debe ser un refugio para los demás, actuando como una figura que nutre y sostiene el crecimiento de la conciencia colectiva desde un liderazgo basado en el corazón.' 
    },
    '11_Cancer': { 
        d: 'En tus grupos sociales, eres la "madre" o el "padre" que se preocupa por el bienestar de todos, creando lazos de amistad que se sienten como una verdadera familia. Valoras los proyectos colectivos que tienen un fin humanitario o protector, aportando una sensibilidad que une a las personas emocionalmente.', 
        g: 'Tu relación con la fraternidad universal es la del guardián de la llama de la unidad. Formas parte de la red de almas que protegen el ideal de la paz, utilizando tu sensibilidad para crear lazos de hermandad mística que trascienden las fronteras y sanan el tejido social de la humanidad.' 
    },
    '12_Cancer': { 
        d: 'Posees un mundo interior rico en sentimientos y memorias que guardas bajo llave, encontrando tu mayor fuerza en la soledad y la introspección emocional. Tu espíritu busca la paz a través de la disolución del ego en el amor universal, aunque puedes enfrentar miedos inconscientes de abandono.', 
        g: 'Representas la quietud del alma que se funde en el océano de la conciencia infinita. Tu camino de liberación final requiere que trasciendas el apego al pequeño yo para entregarte al abrazo del Absoluto, transmutando el sentimiento individual en una paz inefable que reconoce que todo es Uno.' 
    },
// Leo
    '1_Leo': { 
        d: 'Proyectas una personalidad radiante, magnética y dotada de una gran autoconfianza que te sitúa de forma natural en el centro de atención. Tu presencia es noble y expresiva, mostrándote ante el mundo con una generosidad y una vitalidad que inspiran a otros, valorando el reconocimiento y la lealtad como pilares de tu identidad.', 
        g: 'Representas la encarnación del Sol espiritual en el centro de la personalidad. Tu presencia es el reflejo del pneuma que ha despertado a su propia soberanía, indicando que tu camino es la manifestación del Cristo interior a través de una voluntad creadora que brilla sin necesidad de oscurecer a los demás.' 
    },
    '2_Leo': { 
        d: 'Tu sentido del valor personal se fortalece a través del éxito y la capacidad de adquirir bienes que reflejen tu estatus y tu creatividad. Gestionas tus recursos con generosidad y orgullo, buscando una seguridad financiera que te permita vivir con esplendor y que respalde tu necesidad de autoexpresión y lujo.', 
        g: 'La sustancia es vista como el oro alquímico que debe ser puesto al servicio de la gloria del espíritu. En esta casa, aprendes que la verdadera riqueza es la capacidad de generar abundancia desde el corazón, comprendiendo que los recursos materiales son un regalo del Padre que debe circular con nobleza.' 
    },
    '3_Leo': { 
        d: 'Te comunicas con una elocuencia dramática y un estilo apasionado que busca captar la atención y motivar a quienes te rodean. En tu entorno cercano y estudios, destacas por una mente creativa y orgullosa de sus ideas, expresándote de forma cálida y autoritaria, siempre con un toque de distinción personal.', 
        g: 'Tu palabra es la expresión del Verbo Solar que ilumina las tinieblas del intelecto. El logos se manifiesta en ti como un lenguaje de poder y belleza, permitiendo que tu mente actúe como un canal de la sabiduría divina que se comunica con una autoridad que nace de la certeza interna del espíritu.' 
    },
    '4_Leo': { 
        d: 'En tu hogar, buscas crear un entorno digno y vibrante donde tú seas el corazón que late y organiza la vida familiar. Tus raíces suelen estar marcadas por figuras de gran orgullo o prestigio, esforzándote por construir un refugio privado que sea un testimonio de tu linaje y un centro de alegría constante.', 
        g: 'El fundamento de tu ser es el Trono del Corazón. Esta posición indica que tu herencia espiritual es la nobleza del alma que reconoce su origen regio, convirtiendo el hogar en un espacio sagrado donde se cultiva la lealtad absoluta y se protege la llama de la identidad divina contra la inercia del mundo.' 
    },
    '5_Leo': { 
        d: 'Expresas tu creatividad con una fuerza desbordante, buscando siempre el aplauso y la celebración de tu talento único. En el amor, eres apasionado, leal y romántico de una forma casi teatral, viviendo cada romance y afición como una oportunidad para brillar y para dar rienda suelta a tu gran corazón generoso.', 
        g: 'Tu capacidad creadora es el acto puro de la emanación divina. El arte y el juego son para ti ritos de glorificación de la vida, donde la chispa espiritual se deleita en su propia luz, manifestando la belleza a través de obras que son testimonios vivos de la potencia solar que habita en tu interior.' 
    },
    '6_Leo': { 
        d: 'Abordas tus responsabilidades diarias con un sentido del deber orgulloso, necesitando que tu trabajo sea valorado y que te permita destacar. Posees una gran vitalidad y una actitud de liderazgo incluso en las tareas más humildes, viendo la salud como un estado de equilibrio que depende de tu alegría y vigor físico.', 
        g: 'El servicio cotidiano es una disciplina de realeza en la acción. Tu trabajo es la transmutación de la materia a través de la voluntad consciente, donde cada tarea se convierte en un rito de perfección que refleja la luz del espíritu en el servicio desinteresado pero consciente de su propia dignidad.' 
    },
    '7_Leo': { 
        d: 'Buscas parejas y socios que posean una personalidad fuerte, brillante y que te hagan sentir orgulloso de estar a su lado. Aprendes a equilibrar tu ego a través de tus vínculos, buscando una unión basada en la admiración mutua y la lealtad, donde el compromiso sea un pacto de honor entre dos seres soberanos.', 
        g: 'En el espejo del otro, encuentras la necesidad de reconocimiento y el reflejo del Sol místico. Esta casa representa el matrimonio sagrado de las voluntades, donde el pneuma aprende que la unión verdadera nace del respeto por la chispa divina en el prójimo, integrando el amor con la soberanía personal.' 
    },
    '8_Leo': { 
        d: 'Vives las transformaciones personales con un dramatismo profundo, enfrentando las crisis como desafíos a tu identidad que te obligan a renacer con más fuerza. Tu relación con lo oculto y los recursos compartidos es intensa y valiente, buscando el dominio sobre tus miedos mediante una voluntad inquebrantable.', 
        g: 'Representas la transmutación del Rey en el fuego del abismo para alcanzar la inmortalidad. Tu camino hacia el conocimiento oculto pasa por el sacrificio del orgullo egoico, permitiendo que el espíritu resurja de la oscuridad con una autoridad que no nace del mundo, sino de la victoria sobre la muerte.' 
    },
    '9_Leo': { 
        d: 'Tu filosofía de vida es elevada, noble y se expande a través de una fe que celebra la grandeza de lo divino en todas sus formas. Te atraen los viajes majestuosos y el estudio de conocimientos que otorguen prestigio y sabiduría, buscando una verdad que sea luminosa y que enaltezca la dignidad humana.', 
        g: 'Tu mente superior es un buscador de la Luz Eterna. La búsqueda de la gnosis es para ti un ascenso hacia las jerarquías solares, donde la fe se manifiesta como una visión de la armonía cósmica y la capacidad de irradiar la verdad divina con una convicción que disuelve las sombras de la duda.' 
    },
    '10_Leo': { 
        d: 'Proyectas una imagen pública de autoridad natural, éxito y una carrera profesional que te sitúa en puestos de visibilidad o mando. Tu vocación está ligada a tu necesidad de dejar una huella creativa en el mundo, donde tu reputación se basa en tu integridad y tu capacidad para liderar con el corazón.', 
        g: 'Tu destino social es la manifestación de la luz del espíritu en la cumbre de la montaña del mundo. Esta posición indica que tu obra exterior debe ser un ejemplo de soberanía consciente, actuando como un faro de nobleza que guía a los hombres hacia la realización de su propio potencial divino.' 
    },
    '11_Leo': { 
        d: 'En tus grupos sociales, eres la figura central que aporta calidez, motivación y un sentido de propósito noble a los proyectos colectivos. Valoras las amistades leales y los círculos de personas con talento, aportando un idealismo que busca el bienestar común sin renunciar a la distinción personal.', 
        g: 'Tu relación con la fraternidad universal es la del protector de la luz colectiva. Formas parte de la hermandad de los hijos del Sol, utilizando tu magnetismo para unir a los buscadores de la verdad en un solo corazón que late con el deseo de liberar a la humanidad a través de la belleza.' 
    },
    '12_Leo': { 
        d: 'Posees una reserva de creatividad y orgullo interno que mantienes en silencio, encontrando tu mayor fuerza en la conexión privada con tu propia esencia divina. Tu espíritu busca la paz a través de la entrega del ego a una voluntad superior, aunque puedes enfrentar miedos inconscientes de no ser visto.', 
        g: 'Representas la quietud del Monarca que se retira al santuario interior. Tu camino de liberación final requiere que trasciendas la necesidad de aplauso externo para encontrar el gozo en la sola presencia del espíritu, transmutando el orgullo en una humildad radiante que reconoce que toda luz viene del Absoluto.' 
    },

    // Virgo
    '1_Virgo': { 
        d: 'Proyectas una personalidad analítica, discreta y dotada de un gran sentido práctico que busca el perfeccionamiento constante en todo lo que haces. Tu presencia es pulcra y observadora, mostrándote ante el mundo con una modestia que oculta una inteligencia aguda, valorando la utilidad, el orden y la eficiencia por encima de la ostentación.', 
        g: 'Representas la purificación del pneuma a través del discernimiento sagrado. Tu personalidad actúa como un filtro que busca separar lo real de lo ilusorio, indicando que tu camino es la alquimia de la mente, donde la chispa divina aprende a manifestarse con precisión y pureza en el plano de la materia.' 
    },
    '2_Virgo': { 
        d: 'Tu sentido del valor personal está ligado a tu capacidad para gestionar tus recursos con meticulosidad, ahorro y un enfoque muy realista. Buscas la seguridad financiera a través del trabajo detallado y la eficiencia, viendo el dinero como una herramienta práctica que debe ser administrada para garantizar el orden y el bienestar.', 
        g: 'La sustancia es vista como una obra que debe ser perfeccionada. En esta casa, aprendes que la verdadera riqueza es la maestría sobre los pequeños detalles de la manifestación, comprendiendo que el equilibrio material es el resultado de una conciencia que sabe organizar la energía con rectitud divina.' 
    },
    '3_Virgo': { 
        d: 'Posees una mente lógica, crítica y una capacidad de comunicación que destaca por su precisión y claridad en los detalles. En tu entorno cercano y estudios, eres metódico y curioso de forma técnica, expresando tus ideas con una modestia que busca siempre ser útil y aportar soluciones prácticas a cualquier problema.', 
        g: 'Tu palabra es la expresión del logos analítico que ordena el caos mental. El pensamiento se manifiesta en ti como una herramienta de clasificación sagrada, permitiendo que tu mente actúe como un transmisor de verdades prácticas que ayudan a purificar el entendimiento de quienes buscan la claridad.', 
    },
    '4_Virgo': { 
        d: 'En tu hogar, buscas crear un ambiente de orden, limpieza y funcionalidad que sea el refugio perfecto para tu tranquilidad mental. Tus raíces suelen estar marcadas por la disciplina o el sentido del deber, esforzándote por mantener una vida privada organizada donde el cuidado de la salud y el servicio mutuo sean fundamentales.', 
        g: 'El fundamento de tu ser es el Templo del Servicio Silencioso. Esta posición indica que tu herencia espiritual es la humildad del alma que ha aprendido a encontrar la divinidad en la pureza de lo cotidiano, convirtiendo el hogar en un espacio ritual de orden donde se honra la perfección de la obra creadora.', 
    },
    '5_Virgo': { 
        d: 'Expresas tu creatividad a través de habilidades técnicas, el detalle minucioso y aficiones que requieren de un aprendizaje constante. En el amor, eres cauteloso y prefieres demostrar tu afecto mediante actos de servicio prácticos, viviendo los romances con una actitud analítica que busca la pureza y la perfección en el vínculo.', 
        g: 'Tu capacidad creadora es un rito de perfeccionamiento de la forma. El arte y el goce son para ti ejercicios de disciplina mística, donde la chispa espiritual se manifiesta a través de la atención plena, creando belleza mediante el dominio técnico y el respeto por las leyes que rigen la armonía de la materia.', 
    },
    '6_Virgo': { 
        d: 'Abordas tus responsabilidades diarias con una eficiencia total, destacando en el trabajo por tu atención al detalle y tu necesidad de ser útil. Tu salud es una prioridad constante que gestionas mediante rutinas meticulosas y una dieta equilibrada, viendo el cuerpo como una máquina de precisión que requiere cuidado técnico.', 
        g: 'El servicio cotidiano es tu vía principal de ascenso espiritual. Tu trabajo es la purificación de la materia mediante el discernimiento, donde cada acto de orden se convierte en una oración de humildad que transmuta la inercia del demiurgo en una labor consagrada a la perfección de la luz divina.', 
    },
    '7_Virgo': { 
        d: 'Buscas relaciones y socios que aporten orden, inteligencia práctica y un sentido del deber compartido, valorando la fiabilidad sobre la pasión desmedida. Aprendes a perfeccionarte a través de tus vínculos, buscando una unión donde la crítica constructiva y el apoyo en las tareas diarias sean el lazo que mantiene la armonía.', 
        g: 'En el espejo del otro, encuentras la necesidad de rectitud y el reflejo del alma servidora. Esta casa representa el compromiso místico con la utilidad sagrada, donde el pneuma aprende que la unión verdadera nace de la colaboración en la Gran Obra, purificando el amor de todo egoísmo a través del servicio mutuo.', 
    },
    '8_Virgo': { 
        d: 'Vives las transformaciones personales de manera analítica, tratando de entender los procesos de crisis mediante el estudio de sus causas y efectos. Tu relación con lo oculto y los recursos compartidos es prudente, buscando desentrañar los misterios de la vida a través de una técnica de introspección muy detallada.', 
        g: 'Representas la transmutación del alma a través de la purga de lo innecesario. Tu camino hacia el conocimiento oculto pasa por el análisis de las sombras y la eliminación de las impurezas psíquicas, permitiendo que el espíritu se libere de la densidad mediante una autocrítica sagrada que busca la esencia pura.', 
    },
    '9_Virgo': { 
        d: 'Tu filosofía de vida es práctica y se expande mediante el estudio de temas científicos, técnicos o sistemas de pensamiento organizados. Te atraen los viajes que implican aprendizaje o servicio, buscando una verdad que sea demostrable y que pueda ser aplicada para mejorar la realidad de forma concreta y ordenada.', 
        g: 'Tu mente superior es un buscador de la Ley del Orden Universal. La búsqueda de la gnosis es para ti un proceso de estudio meticuloso de los símbolos sagrados, donde la fe se manifiesta como una comprensión de la perfección técnica del cosmos y la capacidad de servir a la luz con un intelecto purificado.', 
    },
    '10_Virgo': { 
        d: 'Proyectas una imagen pública de competencia, seriedad y una carrera profesional basada en la especialización y el servicio eficiente. Tu vocación está ligada a tu capacidad para organizar y mejorar sistemas, donde tu reputación se construye sobre tu fiabilidad y tu talento para resolver problemas complejos.', 
        g: 'Tu destino social es la manifestación del orden divino en la estructura del mundo material. Esta posición indica que tu obra exterior debe ser un ejemplo de humildad y perfección técnica, actuando como un servidor de la conciencia que organiza la realidad para que la luz del espíritu pueda fluir con claridad.', 
    },
    '11_Virgo': { 
        d: 'En tus grupos sociales, eres quien aporta el análisis crítico y la organización necesaria para que los proyectos colectivos funcionen con eficacia. Valoras las amistades basadas en el respeto intelectual y el intercambio de favores prácticos, aportando un sentido del deber que asegura el éxito del grupo.', 
        g: 'Tu relación con la fraternidad universal es la del técnico de la nueva conciencia. Formas parte de la red de almas que trabajan en la purificación del tejido social, utilizando tu discernimiento para separar la paja del trigo en los ideales colectivos y para construir una hermandad basada en la verdad práctica.', 
    },
    '12_Virgo': { 
        d: 'Posees una mente subconsciente que procesa constantemente preocupaciones sobre el orden y la salud, encontrando tu mayor paz en la soledad productiva o el retiro silencioso. Tu espíritu busca la liberación a través de la purificación de los miedos irracionales, aunque puedes enfrentar una autocrítica oculta agotadora.', 
        g: 'Representas la quietud del alma que se somete al último proceso de purga antes de la unidad. Tu camino de liberación final requiere que trasciendas el análisis mental para entregarte a la pureza del ser, transmutando la preocupación en una paz inefable que reconoce que, en el espíritu, todo es perfecto.', 
    },
// Libra
    '1_Libra': { 
        d: 'Proyectas una personalidad armoniosa, diplomática y con un refinado sentido de la estética que atrae a los demás de forma natural. Tu presencia es equilibrada y sociable, mostrándote ante el mundo con una amabilidad que busca siempre el punto de encuentro y la belleza en las formas, valorando la justicia y la compañía por encima del conflicto.', 
        g: 'Representas la encarnación de la Balanza Cósmica en la conciencia individual. Tu personalidad actúa como un espejo de la armonía del Pleroma, indicando que tu camino es la integración de la belleza y la justicia, donde el pneuma aprende a equilibrar las fuerzas duales de la existencia para manifestar la paz del espíritu.' 
    },
    '2_Libra': { 
        d: 'Tu sentido del valor personal está ligado a la posesión de objetos bellos, el arte y la búsqueda de una seguridad financiera que te permita vivir en un entorno estético. Tiendes a gestionar tus recursos de manera compartida o buscando el equilibrio, viendo el dinero como un medio para crear armonía y disfrutar de las relaciones sociales.', 
        g: 'La sustancia es vista como el ornamento sagrado de la vida. En esta casa, aprendes que la verdadera riqueza es la armonía de la materia, comprendiendo que el flujo de los recursos es un reflejo de la justicia divina que otorga a cada alma lo necesario para embellecer su camino hacia la unidad.' 
    },
    '3_Libra': { 
        d: 'Te comunicas con una elegancia natural y un estilo persuasivo que busca siempre evitar la discordia y promover el entendimiento mutuo. En tu entorno cercano y estudios, destacas por una mente que valora el intercambio social y la justicia en las ideas, expresándote de forma diplomática y con un gran gusto por el debate intelectual refinado.', 
        g: 'Tu palabra es la expresión del logos armonizador. El pensamiento se manifiesta en ti como un puente de entendimiento entre las almas, permitiendo que tu mente actúe como un transmisor de verdades que buscan la conciliación de los opuestos a través de la belleza del lenguaje y la rectitud del pensamiento.' 
    },
    '4_Libra': { 
        d: 'En tu hogar, buscas crear un ambiente de paz, refinamiento y equilibrio decorativo que sea el refugio perfecto para tus relaciones más íntimas. Tus raíces familiares suelen estar marcadas por la búsqueda de la armonía social o la estética, esforzándote por mantener una vida privada donde la justicia y el buen gusto sean la base de la convivencia.', 
        g: 'El fundamento de tu ser es el Centro del Equilibrio. Esta posición indica que tu herencia espiritual es la paz del alma que ha encontrado la armonía en su santuario interior, convirtiendo el hogar en un espacio ritual donde se honra la unión de las polaridades y se cultiva la belleza como una forma de oración.' 
    },
    '5_Libra': { 
        d: 'Expresas tu creatividad a través del arte, la moda o cualquier forma de belleza que pueda ser compartida y admirada. En el amor, eres un romántico idealista que busca la armonía perfecta y el compañerismo, viviendo los romances con una elegancia que celebra el cortejo y la estética del vínculo afectivo.', 
        g: 'Tu capacidad creadora es el rito de la proporción áurea. El arte y el goce son para ti vías de retorno a la armonía original, donde la chispa divina se manifiesta a través de la creación de formas equilibradas que elevan la vibración del entorno y reflejan la perfección estética del espíritu inefable.' 
    },
    '6_Libra': { 
        d: 'Abordas tus responsabilidades diarias buscando el equilibrio y la cooperación, trabajando mejor en equipo o en ambientes donde reine la armonía estética. Tu salud está muy ligada al equilibrio de tus relaciones y a tu entorno, necesitando una rutina que no sea estresante y que te permita mantener la paz mental y física.', 
        g: 'El servicio cotidiano es una disciplina de armonización del mundo. Tu trabajo es la mediación entre las fuerzas que componen la realidad, donde cada acto de justicia y orden se convierte en un rito de purificación que prepara a la materia para recibir la luz del espíritu a través de la belleza del servicio.' 
    },
    '7_Libra': { 
        d: 'Buscas parejas y socios que reflejen tu necesidad de armonía, belleza y refinamiento, siendo el compromiso el eje central de tu evolución personal. Aprendes a conocerte profundamente a través del espejo de la relación, buscando una unión donde la justicia, la igualdad y la paz sean el lazo indestructible que une a las almas.', 
        g: 'En el espejo del otro, encuentras la unidad perdida y el reflejo de la armonía cósmica. Esta casa representa el matrimonio místico de las polaridades, donde el pneuma aprende que la unión verdadera es la superación de la dualidad a través del amor consciente y la belleza compartida.' 
    },
    '8_Libra': { 
        d: 'Vives las transformaciones personales buscando siempre un equilibrio justo incluso en medio de las crisis emocionales más profundas. Tu relación con lo oculto y los recursos compartidos está marcada por la necesidad de acuerdos armoniosos, tratando de resolver los misterios de la vida mediante la cooperación y el desapego elegante.', 
        g: 'Representas la transmutación del alma a través de la balanza mística. Tu camino hacia el conocimiento oculto pasa por la integración de las sombras mediante el amor y la justicia, permitiendo que el espíritu se libere de los lazos kármicos al encontrar el punto de equilibrio entre el deseo y la renuncia.' 
    },
    '9_Libra': { 
        d: 'Tu filosofía de vida se basa en la búsqueda de la justicia universal, la paz y la belleza en todas las corrientes de pensamiento. Te atraen los viajes que implican contacto cultural refinado y estudios que promuevan la armonía social, buscando una verdad que sea estéticamente perfecta y moralmente equilibrada.', 
        g: 'Tu mente superior es un buscador de la Ley de la Armonía Divina. La búsqueda de la gnosis es para ti un ascenso hacia la comprensión de la justicia suprema, donde la fe se manifiesta como una visión de la belleza del orden cósmico y la capacidad de actuar como mediador entre el cielo y la tierra.' 
    },
    '10_Libra': { 
        d: 'Proyectas una imagen pública de diplomacia, encanto y una carrera profesional que suele estar vinculada a la justicia, el arte o las relaciones públicas. Tu vocación está ligada a tu capacidad para crear consensos y belleza, donde tu reputación se basa en tu integridad ética y tu talento para la armonización social.', 
        g: 'Tu destino social es la manifestación de la armonía del espíritu en la estructura de la civilización. Esta posición indica que tu obra exterior debe ser un ejemplo de justicia y equilibrio, actuando como un embajador de la luz que promueve la paz y la belleza en el tejido de la realidad humana.' 
    },
    '11_Libra': { 
        d: 'En tus grupos sociales, eres el mediador que busca siempre la armonía y la participación equitativa de todos en los proyectos comunes. Valoras las amistades refinadas y los círculos que luchan por causas justas, aportando un sentido del equilibrio que mantiene la cohesión y el idealismo dentro del grupo.', 
        g: 'Tu relación con la fraternidad universal es la del arquitecto de la paz. Formas parte de la red de almas que trabajan por la armonía de la humanidad, utilizando tu diplomacia para unir a los buscadores de la verdad en una hermandad basada en el respeto mutuo y la belleza del ideal compartido.' 
    },
    '12_Libra': { 
        d: 'Posees una reserva de paz interna y un sentido de la justicia mística que mantienes en secreto, encontrando tu mayor consuelo en la contemplación silenciosa de la belleza. Tu espíritu busca la liberación a través de la disolución de los conflictos internos, aunque puedes enfrentar miedos inconscientes a la soledad.', 
        g: 'Representas la quietud del alma que se funde en la armonía absoluta del silencio. Tu camino de liberación final requiere que trasciendas la necesidad de aprobación externa para encontrar la paz en la sola presencia del espíritu, transmutando el deseo de compañía en una unión inefable con la fuente original de toda belleza.' 
    },

    // Escorpio
    '1_Escorpio': { 
        d: 'Proyectas una personalidad intensa, magnética y dotada de un aura de misterio que no deja a nadie indiferente. Tu presencia es penetrante y reservada, mostrándote ante el mundo con una fuerza interna inmensa que parece percibir lo que está oculto tras las apariencias, valorando la autenticidad y la transformación profunda.', 
        g: 'Representas la encarnación del fuego transmutador en la conciencia individual. Tu personalidad actúa como un catalizador de crisis evolutivas, indicando que tu camino es la alquimia del alma, donde el pneuma aprende a descender a las profundidades de la materia para rescatar la luz de la chispa divina de entre las sombras.' 
    },
    '2_Escorpio': { 
        d: 'Tu sentido del valor personal está ligado a la capacidad de regenerar tus recursos y a un manejo muy reservado e intenso de tus finanzas. Buscas la seguridad material a través de inversiones estratégicas y un control total sobre tus posesiones, viendo el dinero como una forma de poder que garantiza tu independencia y supervivencia.', 
        g: 'La sustancia es vista como la piedra filosofal que debe ser transmutada. En esta casa, aprendes que la verdadera riqueza es el poder del espíritu para transformar la carencia en abundancia mediante el dominio de las energías ocultas, comprendiendo que los recursos son un vehículo de influencia sagrada en el plano denso.' 
    },
    '3_Escorpio': { 
        d: 'Posees una mente penetrante, investigadora y una capacidad de comunicación que no teme abordar temas tabú o profundos. En tu entorno cercano y estudios, buscas la verdad que se esconde bajo la superficie, expresándote de forma incisiva y con un magnetismo verbal que busca transformar la conciencia de quienes te escuchan.', 
        g: 'Tu palabra es la expresión del logos transmutador. El pensamiento se manifiesta en ti como una sonda que penetra los velos de la ignorancia, permitiendo que tu mente actúe como un transmisor de verdades profundas que desafían la inercia mental y despiertan el conocimiento oculto en el tejido de lo cotidiano.' 
    },
    '4_Escorpio': { 
        d: 'En tu hogar, buscas una privacidad absoluta y una intensidad emocional que une a la familia de forma inquebrantable. Tus raíces familiares suelen estar marcadas por secretos, luchas de poder o grandes transformaciones, esforzándote por crear un refugio que sea un espacio de regeneración profunda y lealtad total.', 
        g: 'El fundamento de tu ser es el Abismo Sagrado. Esta posición indica que tu herencia espiritual es la fuerza del alma que ha sobrevivido a la oscuridad, convirtiendo el hogar en un espacio ritual de muerte y renacimiento donde se protege la llama de la verdad contra las ilusiones del mundo exterior.' 
    },
    '5_Escorpio': { 
        d: 'Expresas tu creatividad de forma apasionada, intensa y a menudo ligada a temas de transformación o misterio. En el amor, buscas una fusión total de alma y cuerpo, viviendo los romances con una entrega absoluta que no admite medias tintas y que celebra la intensidad emocional como la única forma real de placer.', 
        g: 'Tu capacidad creadora es el acto de dar vida a través del fuego del deseo transmutado. El arte y el goce son para ti ritos de inmersión en la energía vital, donde la chispa divina se manifiesta a través de la pasión pura, creando belleza mediante la revelación de lo que el ego intenta mantener oculto.' 
    },
    '6_Escorpio': { 
        d: 'Abordas tus responsabilidades diarias con una entrega total y una capacidad de trabajo regeneradora que te permite enfrentar las tareas más difíciles. Tu salud está íntimamente ligada a la gestión de tu energía emocional, necesitando una rutina que te permita soltar tensiones profundas y regenerar tu vigor físico constantemente.', 
        g: 'El servicio cotidiano es una disciplina de purificación por el fuego del esfuerzo. Tu trabajo es la eliminación de las impurezas en la obra de la vida, donde cada acto de entrega se convierte en un rito de muerte del pequeño yo, transmutando la labor diaria en un ejercicio de poder espiritual sobre la inercia de la materia.' 
    },
    '7_Escorpio': { 
        d: 'Buscas parejas y socios que reflejen tu necesidad de intensidad, lealtad absoluta y transformación mutua, evitando los vínculos superficiales. Aprendes a conocer tu propia sombra a través del espejo de la relación, buscando una unión donde la crisis y el renacimiento sean el motor que fortalece el lazo entre las almas.', 
        g: 'En el espejo del otro, encuentras al guardián de tus propios misterios. Esta casa representa el matrimonio místico de las profundidades, donde el pneuma aprende que la unión verdadera nace de la transparencia total y de la capacidad de morir al ego para renacer como un solo ser en la luz del espíritu.' 
    },
    '8_Escorpio': { 
        d: 'Vives los procesos de transformación, crisis y muerte con una intensidad volcánica, siendo tú mismo un agente de cambio profundo para quienes te rodean. Tu relación con la sexualidad y los recursos compartidos es sagrada y poderosa, buscando la regeneración total a través de la entrega a lo desconocido.', 
        g: 'Representas la soberanía sobre el umbral de la muerte y el renacimiento místico. Tu camino hacia el conocimiento oculto es el de la iniciación directa en los misterios del abismo, permitiendo que el espíritu se libere de las cadenas kármicas al transmutar el deseo ciego en voluntad divina invicta.' 
    },
    '9_Escorpio': { 
        d: 'Tu filosofía de vida es profunda, inquisitiva y se expande mediante el estudio de los misterios, la psicología o las ciencias ocultas. Te atraen los viajes que implican una transformación interna y conocimientos que desafíen tus creencias, buscando una verdad que sea cruda, auténtica y regeneradora.', 
        g: 'Tu mente superior es un buscador de la Sabiduría Oculta del Pleroma. La búsqueda de la gnosis es para ti un descenso consciente a los estratos más profundos de la verdad, donde la fe se manifiesta como la capacidad de ver la luz incluso en el corazón de las tinieblas y de transmutar el dogma en conocimiento vivo.' 
    },
    '10_Escorpio': { 
        d: 'Proyectas una imagen pública de poder silencioso, ambición y una carrera profesional que suele implicar la investigación, la sanación o el manejo de crisis. Tu vocación está ligada a tu capacidad para transformar estructuras, donde tu reputación se basa en tu resiliencia y tu talento para regenerar lo que otros consideran perdido.', 
        g: 'Tu destino social es la manifestación del poder transmutador del espíritu en la cumbre del mundo. Esta posición indica que tu obra exterior debe ser un testimonio de la fuerza regeneradora de la luz, actuando como un cirujano de la conciencia que corta lo muerto para que la vida divina pueda fluir de nuevo.' 
    },
    '11_Escorpio': { 
        d: 'En tus grupos sociales, eres la presencia intensa que busca la lealtad total y la transformación de los ideales colectivos desde su raíz. Valoras las amistades profundas y los círculos que trabajan por cambios radicales en la sociedad, aportando una voluntad inquebrantable que no teme enfrentar la sombra del grupo.', 
        g: 'Tu relación con la fraternidad universal es la del guardián del fuego de la redención. Formas parte de la hermandad de los transformadores, utilizando tu magnetismo para purificar los ideales de los buscadores de la verdad y para construir una hermandad basada en la autenticidad total y la entrega mutua.', 
    },
    '12_Escorpio': { 
        d: 'Posees un mundo subconsciente de una intensidad abrumadora que guardas en el más absoluto secreto, enfrentando tus batallas espirituales más crudas en soledad. Tu espíritu busca la liberación a través de la muerte del deseo, aunque puedes enfrentar miedos inconscientes de ser dominado por fuerzas invisibles.', 
        g: 'Representas la quietud del alma que ha vencido a la muerte en el silencio del abismo. Tu camino de liberación final requiere que entregues tus últimos secretos a la luz del espíritu, transmutando el dolor acumulado en una paz inefable que reconoce que la vida y la muerte son solo velos de la eternidad.' 
    },

    // Sagitario
    '1_Sagitario': { 
        d: 'Proyectas una personalidad optimista, aventurera y dotada de un carisma expansivo que inspira confianza y alegría en los demás. Tu presencia es dinámica y abierta, mostrándote ante el mundo como un buscador de horizontes que valora la libertad, la verdad y la exploración constante de nuevas fronteras físicas y mentales.', 
        g: 'Representas la flecha del espíritu lanzada hacia el infinito. Tu personalidad actúa como un vehículo de la fe solar, indicando que tu camino es la expansión de la conciencia, donde el pneuma aprende a trascender los límites de la materia mediante la búsqueda incesante de la sabiduría superior y la luz del Absoluto.' 
    },
    '2_Sagitario': { 
        d: 'Tu sentido del valor personal está ligado a la libertad que te otorgan tus recursos y a una actitud generosa y a veces arriesgada hacia tus finanzas. Buscas la seguridad material para poder viajar y expandir tus conocimientos, viendo el dinero como una energía que debe circular para financiar tu búsqueda de la verdad.', 
        g: 'La sustancia es vista como el combustible sagrado para el viaje del alma. En esta casa, aprendes que la verdadera riqueza es la abundancia del espíritu que confía en la providencia divina, comprendiendo que los recursos materiales son un don del Padre que se multiplica cuando se pone al servicio de la expansión de la luz.' 
    },
    '3_Sagitario': { 
        d: 'Te comunicas con una franqueza entusiasta y un estilo filosófico que busca siempre elevar el nivel de la conversación. En tu entorno cercano y estudios, destacas por una mente curiosa que busca el significado profundo de las cosas, expresándote de forma pedagógica y con un gran gusto por el intercambio de ideales.', 
        g: 'Tu palabra es la expresión del logos expansivo que siembra la verdad. El pensamiento se manifiesta en ti como un fuego que ilumina la mente de los otros, permitiendo que tu intelecto actúe como un transmisor de leyes universales que elevan el entendimiento cotidiano hacia planos de conciencia superiores.' 
    },
    '4_Sagitario': { 
        d: 'En tu hogar, buscas una atmósfera de libertad, espacio y una conexión con culturas o filosofías lejanas que amplíen tu horizonte emocional. Tus raíces familiares suelen estar marcadas por viajes o una fuerte ética moral, esforzándote por crear un refugio que funcione como un centro de sabiduría y alegría expansiva.', 
        g: 'El fundamento de tu ser es el Templo del Espíritu Viajero. Esta posición indica que tu herencia espiritual es la libertad del alma que no se ata a la tierra, convirtiendo el hogar en un espacio ritual de apertura al cosmos, donde se honra la verdad divina como la única base inamovible de la existencia privada.' 
    },
    '5_Sagitario': { 
        d: 'Expresas tu creatividad de forma exuberante, buscando el placer en la aventura, el deporte o el estudio de temas que eleven tu espíritu. En el amor, eres idealista y aventurero, buscando una pareja que sea un compañero de viaje y de búsqueda intelectual, viviendo los romances con un entusiasmo que celebra la libertad del corazón.', 
        g: 'Tu capacidad creadora es el acto de celebrar la gloria divina a través del juego y la expansión. El arte y el goce son para ti ritos de conexión con la alegría del Pleroma, donde la chispa espiritual se manifiesta a través de la risa y el descubrimiento, creando belleza mediante la exaltación de la vida sagrada.' 
    },
    '6_Sagitario': { 
        d: 'Abordas tus responsabilidades diarias con un espíritu optimista, necesitando que tu trabajo tenga un propósito elevado o que te permita aprender cosas nuevas constantemente. Tu salud se beneficia de la actividad al aire libre y de una actitud positiva, viendo el cuidado del cuerpo como una disciplina que apoya tu libertad de movimiento.', 
        g: 'El servicio cotidiano es una disciplina de enseñanza práctica. Tu trabajo es la manifestación de la fe en la acción, donde cada tarea realizada con alegría se convierte en un rito de purificación del alma, transmutando el esfuerzo diario en un ejercicio de expansión de la luz divina en los detalles de la existencia material.' 
    },
    '7_Sagitario': { 
        d: 'Buscas parejas y socios que sean maestros, guías o compañeros de aventura que compartan tu sed de conocimiento y libertad. Aprendes a expandir tu horizonte a través del espejo de la relación, buscando una unión basada en la honestidad total y en una visión compartida del mundo que trascienda lo cotidiano.', 
        g: 'En el espejo del otro, encuentras al compañero de la senda mística. Esta casa representa el matrimonio sagrado de los ideales, donde el pneuma aprende que la unión verdadera es la fusión de dos vuelos que buscan el mismo sol, integrando el amor humano con la búsqueda incesante de la verdad divina.' 
    },
    '8_Sagitario': { 
        d: 'Vives las transformaciones personales con una fe inquebrantable en que cada crisis es una oportunidad para el crecimiento espiritual. Tu relación con lo oculto y los recursos compartidos es abierta y filosófica, tratando de comprender los misterios de la muerte a través de una visión optimista de la trascendencia del alma.', 
        g: 'Representas la transmutación de la oscuridad en sabiduría a través del fuego de la fe. Tu camino hacia el conocimiento oculto pasa por la comprensión de las leyes superiores que rigen el cambio, permitiendo que el espíritu se libere del miedo a la muerte al reconocer que el alma es un viajero eterno en la luz divina.' 
    },
    '9_Sagitario': { 
        d: 'Tu filosofía de vida es tu mayor tesoro y se expande mediante los viajes largos, la educación superior y la búsqueda de la verdad absoluta. Posees una fe misionera que te impulsa a explorar todas las religiones y culturas, buscando una verdad que unifique la diversidad del mundo en un solo sentido superior.', 
        g: 'Tu mente superior es el Centauro que apunta al centro de la Galaxia espiritual. La búsqueda de la gnosis es para ti un regreso al hogar a través del conocimiento de lo sagrado, donde la fe se manifiesta como la visión directa del orden divino y la capacidad de actuar como un pontífice entre los hombres y el Absoluto.' 
    },
    '10_Sagitario': { 
        d: 'Proyectas una imagen pública de sabiduría, ética y una carrera profesional que suele estar vinculada a la enseñanza, la ley o el comercio internacional. Tu vocación está ligada a tu necesidad de inspirar a otros, donde tu reputación se basa en tu integridad moral y tu capacidad para mostrar caminos de éxito y expansión.', 
        g: 'Tu destino social es la manifestación de la justicia divina en la cima del mundo. Esta posición indica que tu obra exterior debe ser un ejemplo de verdad y libertad, actuando como un guía de la conciencia colectiva que muestra a la humanidad los horizontes más elevados de su evolución espiritual.' 
    },
    '11_Sagitario': { 
        d: 'En tus grupos sociales, eres el optimista que aporta visión y grandes ideales a los proyectos colectivos, motivando a los amigos hacia causas humanitarias o filosóficas. Valoras las amistades internacionales e intelectuales, aportando una mentalidad abierta que rompe fronteras y une a las personas en la búsqueda común.', 
        g: 'Tu relación con la fraternidad universal es la del heraldo de la nueva esperanza. Formas parte de la red de almas que expanden el ideal de la libertad espiritual, utilizando tu visión para unir a los buscadores de la verdad en una hermandad global que celebra la diversidad como un reflejo de la unidad divina.', 
    },
    '12_Sagitario': { 
        d: 'Posees una fe interna inmensa y una conexión silenciosa con la guía divina que te sostiene en los momentos de soledad. Tu espíritu busca la paz a través de la expansión de la conciencia en el infinito, aunque puedes enfrentar miedos inconscientes de perder tu libertad personal o de ser limitado por dogmas.', 
        g: 'Representas la quietud del alma que viaja por los espacios siderales del espíritu. Tu camino de liberación final requiere que trasciendas todas las creencias externas para encontrar la verdad única en el silencio del ser, transmutando la búsqueda externa en una paz inefable que reconoce que el destino final es la luz.' 
    },
// Capricornio
    '1_Capricornio': { 
        d: 'Proyectas una personalidad seria, responsable y dotada de una gran autoridad natural que inspira respeto inmediato. Tu presencia es sobria y disciplinada, mostrándote ante el mundo como alguien autosuficiente que valora el esfuerzo, el tiempo y la construcción de un destino sólido basado en la integridad y el realismo.', 
        g: 'Representas la encarnación del rigor y la ley en la estructura de la personalidad. Tu presencia es el reflejo del pneuma que acepta el peso de la materia para dominarla, indicando que tu camino es la maestría sobre el tiempo y el karma, convirtiendo tu identidad en un templo de piedra inamovible donde se custodia la luz del espíritu.' 
    },
    '2_Capricornio': { 
        d: 'Tu sentido del valor personal está ligado a la construcción de una seguridad material tangible, duradera y basada en el mérito propio. Gestionas tus recursos con una prudencia extrema y una ambición silenciosa, viendo el dinero como una herramienta de estatus y estabilidad que requiere de una planificación a largo plazo.', 
        g: 'La sustancia es vista como la piedra angular del templo. En esta casa, aprendes que la verdadera riqueza es el resultado de la perseverancia del espíritu en la materia, comprendiendo que el dominio sobre los recursos es una prueba de responsabilidad ante las leyes de la manifestación divina.' 
    },
    '3_Capricornio': { 
        d: 'Te comunicas con una parquedad reflexiva y un estilo estructurado que busca la utilidad y la precisión en cada palabra. En tu entorno cercano y estudios, destacas por una mente disciplinada y realista, expresándote de forma autoritaria y seria, valorando el conocimiento que tiene una aplicación práctica y profesional.', 
        g: 'Tu palabra es la expresión del logos ordenador que da forma a la realidad. El pensamiento se manifiesta en ti como una ley que define los límites de lo posible, permitiendo que tu mente actúe como un transmisor de verdades sólidas que estructuran la conciencia y combaten el caos de la ignorancia.' 
    },
    '4_Capricornio': { 
        d: 'En tu hogar, buscas crear un ambiente de orden, respeto por la jerarquía y una estabilidad que resista la prueba del tiempo. Tus raíces familiares suelen estar marcadas por la disciplina, la tradición o el deber, esforzándote por construir un refugio privado que sea un símbolo de tu éxito y de la continuidad de tu linaje.', 
        g: 'El fundamento de tu ser es la Roca de la Tradición Sagrada. Esta posición indica que tu herencia espiritual es la fuerza del alma que sostiene el peso del mundo, convirtiendo el hogar en un espacio ritual de silencio y severidad donde se protege la llama del espíritu mediante la rectitud de la conducta.' 
    },
    '5_Capricornio': { 
        d: 'Expresas tu creatividad de forma controlada y productiva, buscando aficiones que requieran maestría o que tengan un valor duradero. En el amor, eres reservado y cauteloso, buscando romances que ofrezcan una estabilidad seria y un compromiso real, viviendo el placer con una sobriedad que valora la calidad sobre la cantidad.', 
        g: 'Tu capacidad creadora es el acto de dar forma eterna a la luz del espíritu. El arte y el goce son para ti ritos de perfeccionamiento y disciplina, donde la chispa divina se manifiesta a través de la obra bien hecha, creando belleza mediante el respeto a las leyes de la proporción y la resistencia.' 
    },
    '6_Capricornio': { 
        d: 'Abordas tus responsabilidades diarias con una ética de trabajo incansable y una necesidad de eficiencia que no admite errores. Tu salud se beneficia de la disciplina y el orden, viendo el cuidado del cuerpo como una obligación necesaria para cumplir con tus ambiciones y mantener tu capacidad de esfuerzo constante.', 
        g: 'El servicio cotidiano es una disciplina de ascenso a través del cumplimiento del deber. Tu trabajo es la transmutación de la inercia en estructura, donde cada tarea realizada con rigor se convierte en un peldaño hacia la liberación del alma mediante la maestría sobre las condiciones de la vida material.' 
    },
    '7_Capricornio': { 
        d: 'Buscas parejas y socios que reflejen seriedad, ambición y una madurez que te aporte seguridad a largo plazo. Aprendes a suavizar tu reserva a través del compromiso, buscando una unión basada en el respeto mutuo y en la construcción de objetivos comunes que otorguen un lugar sólido en la sociedad.', 
        g: 'En el espejo del otro, encuentras la ley de la responsabilidad y el reflejo del Anciano de los Días. Esta casa representa el pacto sagrado de las almas que deciden construir juntas la obra del espíritu, integrando el amor con el deber y la lealtad inquebrantable a las leyes divinas.' 
    },
    '8_Capricornio': { 
        d: 'Vives las transformaciones personales con una resistencia estoica, enfrentando las crisis como pruebas necesarias para fortalecer tu carácter y tu posición. Tu relación con lo oculto y los recursos compartidos es prudente y profunda, buscando el dominio sobre los misterios de la vida mediante el estudio y la disciplina.', 
        g: 'Representas la transmutación del alma a través de la prueba del tiempo y el frío del abismo. Tu camino hacia el conocimiento oculto pasa por el despojo de lo superfluo y el enfrentamiento con el Guardián del Umbral, permitiendo que el espíritu se libere al dominar las leyes del karma y la muerte.' 
    },
    '9_Capricornio': { 
        d: 'Tu filosofía de vida es estructurada, tradicional y se expande mediante el estudio de la ley, la historia o las ciencias exactas. Te atraen los viajes que tengan un propósito educativo o profesional y conocimientos que hayan sido validados por el tiempo, buscando una verdad que sea sólida y que sirva de guía moral.', 
        g: 'Tu mente superior es el Guardián de las Leyes Cósmicas. La búsqueda de la gnosis es para ti un ascenso por la escala de la sabiduría antigua, donde la fe se manifiesta como el reconocimiento del orden inmutable del universo y la capacidad de actuar como un instructor de la rectitud espiritual.' 
    },
    '10_Capricornio': { 
        d: 'Proyectas una imagen pública de éxito consolidado, autoridad suprema y una carrera profesional que suele situarte en la cima de tu campo. Tu vocación está ligada a tu necesidad de alcanzar la maestría absoluta, donde tu reputación se basa en tu integridad, tu perseverancia y tus logros tangibles y duraderos.', 
        g: 'Tu destino social es la manifestación de la Ley Divina en la cumbre del mundo material. Esta posición indica que tu obra exterior debe ser un testimonio de la voluntad del espíritu encarnado en el orden, actuando como un pilar que sostiene la civilización con justicia y rectitud.' 
    },
    '11_Capricornio': { 
        d: 'En tus grupos sociales, eres la figura de autoridad y experiencia que aporta estructura y objetivos realistas a los proyectos colectivos. Valoras las amistades influyentes y los círculos que trabajan por el progreso social ordenado, aportando una lealtad que se demuestra a través del tiempo y los hechos.', 
        g: 'Tu relación con la fraternidad universal es la del protector del ideal sagrado. Formas parte de la jerarquía de almas que aseguran que el conocimiento espiritual se mantenga puro y estructurado, utilizando tu influencia para construir una hermandad basada en el respeto a las leyes del espíritu.' 
    },
    '12_Capricornio': { 
        d: 'Posees una reserva de fuerza interna y un sentido del deber místico que mantienes en secreto, enfrentando tus miedos a la soledad o al fracaso en la privacidad de tu espíritu. Tu alma busca la paz a través de la aceptación del destino, aunque puedes enfrentar una melancolía oculta ligada al peso del mundo.', 
        g: 'Representas la quietud del alma que ha cumplido su misión en la materia. Tu camino de liberación final requiere que entregues la carga del deber a la luz del espíritu, transmutando el rigor en una paz inefable que reconoce que la verdadera autoridad reside en el retorno al Absoluto.' 
    },

    // Acuario
    '1_Acuario': { 
        d: 'Proyectas una personalidad original, independiente y dotada de un carisma inusual que desafía las convenciones sociales. Tu presencia es eléctrica y desapegada, mostrándote ante el mundo como un visionario que valora la libertad absoluta y la innovación, proyectando una identidad que actúa como un catalizador de cambios para el colectivo.', 
        g: 'Representas la irrupción del rayo de Urano en la conciencia individual. Tu personalidad es el vehículo de la inteligencia liberadora que busca romper las prisiones del demiurgo, indicando que tu camino es la revolución del ser: manifestar una identidad que no pertenece a este mundo, sino a la libertad futura del Pleroma.' 
    },
    '2_Acuario': { 
        d: 'Tu sentido del valor personal está ligado a la libertad intelectual y a un manejo de los recursos que suele ser innovador, inusual o vinculado a la tecnología. Ves el dinero como un medio para financiar tu independencia y tus proyectos humanitarios, gestionando tus finanzas con una mentalidad que valora el futuro sobre la tradición.', 
        g: 'La sustancia es vista como energía en circulación constante. En esta casa, aprendes que la verdadera riqueza es la capacidad de conectarte con la abundancia universal a través de la innovación, comprendiendo que los recursos materiales son herramientas para la liberación del espíritu y el progreso de la humanidad.' 
    },
    '3_Acuario': { 
        d: 'Te comunicas con una originalidad sorprendente y un estilo vanguardista que busca romper los esquemas mentales preestablecidos. En tu entorno cercano y estudios, destacas por una mente brillante e inventiva, expresándote de forma desapegada y lógica, con un gran interés por las ideas que promueven la libertad social.', 
        g: 'Tu palabra es la expresión del logos revolucionario. El pensamiento se manifiesta en ti como una frecuencia que sintoniza con la red de conciencia colectiva, permitiendo que tu mente actúe como un transmisor de verdades futuras que despiertan la chispa de la genialidad y la rebeldía sagrada en los demás.' 
    },
    '4_Acuario': { 
        d: 'En tu hogar, buscas una atmósfera de libertad, modernidad y una falta de convencionalismos que te permita ser tú mismo sin restricciones. Tus raíces familiares suelen estar marcadas por la excentricidad o la ruptura con lo tradicional, esforzándote por crear un refugio privado que sea un laboratorio de ideas y amistad.', 
        g: 'El fundamento de tu ser es el Hogar del Futuro. Esta posición indica que tu herencia espiritual es el desapego de las formas antiguas, convirtiendo el hogar en un espacio ritual de experimentación consciente donde se honra la fraternidad universal por encima de los lazos de sangre.' 
    },
    '5_Acuario': { 
        d: 'Expresas tu creatividad de forma inusual, experimentando con nuevas tecnologías o formas de arte que desafían el gusto común. En el amor, eres independiente y valoras la amistad por encima de la pasión posesiva, viviendo los romances con una libertad que celebra la originalidad y la conexión mental entre las almas.', 
        g: 'Tu capacidad creadora es el acto de manifestar el genio divino. El arte y el juego son para ti ritos de liberación de la forma, donde la chispa espiritual se manifiesta a través de lo inesperado, creando belleza mediante la ruptura de los cánones y la exaltación de la libertad absoluta del ser.' 
    },
    '6_Acuario': { 
        d: 'Abordas tus responsabilidades diarias con una actitud innovadora, necesitando que tu trabajo sea estimulante y que te otorgue autonomía. Tu salud se beneficia de métodos alternativos y de un enfoque mental equilibrado, viendo el cuidado del cuerpo como un sistema de energía que debe estar libre de bloqueos y tensiones nerviosas.', 
        g: 'El servicio cotidiano es una disciplina de colaboración con la evolución colectiva. Tu trabajo es la aplicación de la inteligencia sagrada en lo pequeño, donde cada tarea se convierte en un rito de modernización de la materia, transmutando el esfuerzo diario en una labor que libera al hombre de la carga de la inercia.' 
    },
    '7_Acuario': { 
        d: 'Buscas parejas y socios que sean originales, independientes y que compartan tu visión humanitaria o tu amor por la libertad. Aprendes a equilibrar tu individualidad a través de tus vínculos, buscando una unión basada en la igualdad total y en una complicidad mental que trascienda las normas tradicionales del compromiso.', 
        g: 'En el espejo del otro, encuentras al camarada espiritual y el reflejo de la libertad compartida. Esta casa representa el matrimonio místico de las mentes libres, donde el pneuma aprende que la unión verdadera es la colaboración voluntaria de dos chispas que buscan iluminar el futuro de la humanidad.' 
    },
    '8_Acuario': { 
        d: 'Vives las transformaciones personales a través de cambios repentinos y liberadores que rompen tus esquemas emocionales más profundos. Tu relación con lo oculto y los recursos compartidos es desapegada e investigadora, buscando comprender los misterios de la vida mediante una visión científica y vanguardista del espíritu.', 
        g: 'Representas la transmutación del alma a través de la alquimia eléctrica. Tu camino hacia el conocimiento oculto pasa por la desprogramación de los instintos primordiales y la liberación de la mente de los miedos colectivos, permitiendo que el espíritu se eleve mediante la comprensión de las leyes de la energía pura.' 
    },
    '9_Acuario': { 
        d: 'Tu filosofía de vida es progresista, universal y se expande mediante el estudio de temas sociales, tecnológicos o sistemas de pensamiento utópicos. Te atraen los viajes a lugares inusuales y conocimientos que promuevan la fraternidad global, buscando una verdad que sea inclusiva, racional y profundamente libre.', 
        g: 'Tu mente superior es el Visionario de la Nueva Era. La búsqueda de la gnosis es para ti un contacto con la Mente Universal, donde la fe se manifiesta como la certeza en el progreso de la conciencia y la capacidad de actuar como un mensajero de la libertad divina que rompe las cadenas del dogma.' 
    },
    '10_Acuario': { 
        d: 'Proyectas una imagen pública de innovador, rebelde con causa y una carrera profesional que suele estar vinculada a la tecnología, la ciencia o los movimientos sociales. Tu vocación está ligada a tu necesidad de cambiar el mundo, donde tu reputación se basa en tu originalidad y tu compromiso con el futuro colectivo.', 
        g: 'Tu destino social es la manifestación de la luz liberadora en la estructura de la nueva humanidad. Esta posición indica que tu obra exterior debe ser un ejemplo de vanguardia, actuando como un líder de la conciencia que guía a la sociedad hacia modelos de vida más libres, justos y espirituales.' 
    },
    '11_Acuario': { 
        d: 'En tus grupos sociales, eres el motor de la innovación y la fraternidad, uniendo a personas diversas bajo un ideal de libertad y progreso común. Valoras las amistades independientes y los colectivos humanitarios, aportando una visión que rompe fronteras y que busca la liberación de todos los seres humanos.', 
        g: 'Tu relación con la fraternidad universal es la del núcleo de la red espiritual. Formas parte de la hermandad de los hombres libres, utilizando tu genio para conectar a los buscadores de la verdad en un tejido de conciencia global que prepara el retorno de la humanidad a la unidad del Pleroma.' 
    },
    '12_Acuario': { 
        d: 'Posees un mundo interior poblado de visiones utópicas y una conexión con la conciencia colectiva que mantienes en la privacidad de tu intuición. Tu espíritu busca la paz a través de la despersonalización del ego, aunque puedes enfrentar miedos inconscientes a la exclusión social o a ser absorbido por la masa.', 
        g: 'Representas la quietud del alma que se disuelve en la red de la luz infinita. Tu camino de liberación final requiere que trasciendas la identidad individual para reconocerte como parte del todo universal, transmutando el desapego en una paz inefable que reconoce que la verdadera libertad es la unión con lo Absoluto.' 
    },

    // Piscis
    '1_Piscis': { 
        d: 'Proyectas una personalidad sensible, mística y con un aura difusa y encantadora que parece absorber las energías de tu entorno. Tu presencia es compasiva y esquiva, mostrándote ante el mundo como un ser intuitivo que valora la conexión espiritual y la imaginación, viviendo tu identidad como un flujo constante entre la realidad y el sueño.', 
        g: 'Representas la disolución del ego en las aguas del océano primordial. Tu personalidad actúa como un velo transparente entre las dimensiones, indicando que tu camino es el retorno a la unidad a través de la entrega absoluta, donde el pneuma aprende a habitar la forma sin ser atrapado por ella, reflejando el amor infinito del Absoluto.' 
    },
    '2_Piscis': { 
        d: 'Tu sentido del valor personal es inmaterial y tu relación con el dinero suele ser idealista o desorganizada, fluyendo con la corriente de tus necesidades emocionales. Ves los recursos como algo transitorio que debe ser compartido, buscando la seguridad en la fe y en la confianza de que el universo proveerá lo necesario para tu bienestar.', 
        g: 'La sustancia es vista como una ilusión necesaria que debe ser espiritualizada. En esta casa, aprendes que la verdadera riqueza es la abundancia del alma que se entrega a la voluntad divina, comprendiendo que los recursos materiales son un don de la gracia que fluye hacia aquellos que han renunciado al apego posesivo.' 
    },
    '3_Piscis': { 
        d: 'Te comunicas con una sensibilidad poética y un estilo intuitivo que prefiere las metáforas y las imágenes sobre la lógica fría. En tu entorno cercano y estudios, destacas por una mente soñadora y empática, expresándote de forma inspirada y sutil, captando las verdades que se encuentran en el silencio y entre líneas.', 
        g: 'Tu palabra es la expresión del logos místico que evoca lo inefable. El pensamiento se manifiesta en ti como un sentimiento que penetra el corazón de los otros, permitiendo que tu mente actúe como un transmisor de verdades espirituales que disuelven las fronteras del intelecto y despiertan la compasión universal.' 
    },
    '4_Piscis': { 
        d: 'En tu hogar, buscas una atmósfera de paz, espiritualidad y una calma que te permita retirarte del ruido del mundo. Tus raíces familiares suelen estar marcadas por la sensibilidad, el sacrificio o una profunda fe, esforzándote por crear un refugio privado que sea un santuario de sanación y conexión mística.', 
        g: 'El fundamento de tu ser es el Océano del Alma. Esta posición indica que tu herencia espiritual es la disolución de la separación, convirtiendo el hogar en un espacio ritual de comunión con lo invisible, donde se honra la presencia de lo divino en la intimidad del silencio y la entrega emocional.' 
    },
    '5_Piscis': { 
        d: 'Expresas tu creatividad a través de la imaginación pura, el arte visionario o cualquier forma de belleza que toque el alma. En el amor, eres un romántico abnegado y soñador que busca la fusión espiritual perfecta, viviendo los romances con una entrega que celebra el sacrificio y la idealización del ser amado.', 
        g: 'Tu capacidad creadora es el acto de soñar la voluntad divina. El arte y el goce son para ti ritos de trascendencia del ego, donde la chispa espiritual se manifiesta a través de la inspiración mística, creando belleza mediante la disolución de las formas y la evocación de los reinos celestiales del espíritu.' 
    },
    '6_Piscis': { 
        d: 'Abordas tus responsabilidades diarias con una actitud de servicio desinteresado, necesitando que tu trabajo sea una forma de ayudar a los demás o de expresar tu compasión. Tu salud está muy ligada a tu sensibilidad psíquica, necesitando una rutina que incluya momentos de retiro y purificación de las energías externas absorbidas.', 
        g: 'El servicio cotidiano es una disciplina de sanación y sacrificio consciente. Tu trabajo es la transmutación del dolor en luz a través de la entrega, donde cada tarea se convierte en un rito de amor universal que purifica la materia mediante la intención pura de aliviar el sufrimiento de la creación divina.' 
    },
    '7_Piscis': { 
        d: 'Buscas parejas y socios que sean sensibles, espirituales o que despierten en ti un deseo de protección y cuidado mutuo. Aprendes a disolver tus fronteras a través del vínculo, buscando una unión basada en la compasión infinita y en una conexión de almas que trascienda los juicios y las exigencias de la realidad material.', 
        g: 'En el espejo del otro, encuentras la redención y el reflejo del amor crístico. Esta casa representa el matrimonio místico de las almas que se perdonan y se funden en el espíritu, donde el pneuma aprende que la unión verdadera es el reconocimiento de la divinidad que habita en todo ser humano.' 
    },
    '8_Piscis': { 
        d: 'Vives las transformaciones personales a través de la entrega y el desapego emocional, sintiendo que cada crisis es una disolución necesaria para renacer en el espíritu. Tu relación con lo oculto y los recursos compartidos es mística y profunda, buscando los secretos de la muerte mediante la meditación y la fe.', 
        g: 'Representas la transmutación del alma en las aguas del perdón absoluto. Tu camino hacia el conocimiento oculto pasa por la renuncia a la lucha y la inmersión en la vacuidad sagrada, permitiendo que el espíritu se libere de los lazos del karma al reconocer la unidad esencial de toda la vida.' 
    },
    '9_Piscis': { 
        d: 'Tu filosofía de vida es mística, compasiva y se expande mediante la búsqueda de la unión con lo divino en todas sus formas. Te atraen los viajes de peregrinaje y conocimientos que hablen del alma universal, buscando una verdad que no se puede explicar con palabras, sino que se siente en la comunión del corazón.', 
        g: 'Tu mente superior es el Navegante de los Mares del Espíritu. La búsqueda de la gnosis es para ti un regreso a la fuente a través de la disolución del dogma, donde la fe se manifiesta como la visión de la interconexión de todo lo existente y la capacidad de actuar como un canal de la gracia divina.' 
    },
    '10_Piscis': { 
        d: 'Proyectas una imagen pública de idealismo, sacrificio o una carrera profesional vinculada a la sanación, el arte o el servicio humanitario. Tu vocación está ligada a tu necesidad de inspirar compasión, donde tu reputación se basa en tu entrega desinteresada y tu talento para manifestar la belleza de lo invisible.', 
        g: 'Tu destino social es la manifestación de la caridad divina en la cumbre del mundo. Esta posición indica que tu obra exterior debe ser un testimonio de la presencia del espíritu en la debilidad humana, actuando como un sanador de la conciencia colectiva que guía a la humanidad hacia la paz del perdón.' 
    },
    '11_Piscis': { 
        d: 'En tus grupos sociales, eres la presencia empática que aporta una visión espiritual y una compasión que une a los amigos en la solidaridad. Valoras las amistades basadas en la conexión de almas y los círculos que trabajan por causas idealistas, aportando una sensibilidad que disuelve los conflictos y fomenta el amor universal.', 
        g: 'Tu relación con la fraternidad universal es la del guardián del sueño sagrado. Formas parte de la red de almas que mantienen viva la llama de la esperanza espiritual, utilizando tu intuición para unir a los buscadores de la verdad en una hermandad mística que reconoce al espíritu en cada hermano de camino.' 
    },
    '12_Piscis': { 
        d: 'Posees un mundo interior de una riqueza mística incalculable, donde te fundes con el universo en la soledad de tu meditación o tus sueños. Tu espíritu busca la liberación total a través del retorno al origen, aunque puedes enfrentar miedos inconscientes a perderte a ti mismo o a ser herido por la dureza de la realidad.', 
        g: 'Representas la culminación del viaje del alma que se disuelve en la luz del Absoluto. Tu camino de liberación final es la entrega total del pneuma a su fuente original, transmutando el último vestigio de separación en una paz inefable que reconoce que el final del camino es el comienzo de la eternidad.' 
    },
  },
  planetAspects: {
    // Sol - Luna
'Sun_con_Moon': { 
      d: 'Tu identidad y tus necesidades emocionales laten al unísono, creando una personalidad de una sola pieza. Actúas con una convicción total porque lo que deseas y lo que sientes no tienen fisuras, permitiéndote una concentración de energía vital que te hace avanzar con una fuerza natural y subjetiva.', 
      g: 'Representas la unión mística de las luminarias dentro del ser. El espíritu y el alma se fusionan en un matrimonio sagrado que te permite manifestar la voluntad del pneuma sin la interferencia de la dualidad, recordando la unidad original del Pleroma en cada acto de tu existencia consciente.' 
    }, // Sol Conjuncion Luna
    'Sun_sex_Moon': { 
      d: 'Existe una comunicación fluida y armoniosa entre tu voluntad y tus sentimientos. Tienes la habilidad de encontrar oportunidades para expresar quién eres de una forma que te hace sentir seguro, facilitando que tus relaciones y tu vida cotidiana se desarrollen con una naturalidad que atrae bienestar.', 
      g: 'Tu conciencia logra percibir los ritmos del alma como aliados de la gran obra. Esta armonía te permite utilizar las fuerzas lunares como un vehículo dócil para la luz solar, facilitando el despertar gradual mediante una cooperación inteligente entre tu vehículo emocional y tu chispa divina.' 
    }, // Sol Sextil Luna
    'Sun_cua_Moon': { 
      d: 'Vives en una tensión creativa entre lo que quieres lograr y lo que necesitas para sentirte en paz. Esta fricción interna te empuja a evolucionar constantemente, obligándote a encontrar soluciones nuevas para integrar tu ambición personal con la profundidad de tus raíces y afectos.', 
      g: 'Experimentas el conflicto necesario entre la luz del espíritu y la inercia del alma condicionada. Esta crisis es un motor de gnosis que te obliga a trabajar activamente en la transmutación de tus instintos, forjando un carácter templado en la lucha por liberar al pneuma de las ataduras emocionales.' 
    }, // Sol Cuadratura Luna
    'Sun_tri_Moon': { 
      d: 'La armonía entre tu esencia y tus emociones es un don natural que te otorga un equilibrio envidiable. Fluyes con la vida con una confianza innata, encontrando apoyo en tu mundo interno para alcanzar tus metas externas sin esfuerzo, proyectando una imagen de integridad y serenidad constante.', 
      g: 'Tu ser refleja un estado de gracia donde la sustancia del alma se ha alineado espontáneamente con el propósito del espíritu. Gozas de una visión clara que te permite navegar el mundo de las formas sin perder la conexión con la fuente, manifestando la paz de quien ya ha integrado sus polaridades.' 
    }, // Sol Trigono Luna
    'Sun_opo_Moon': { 
      d: 'Te mueves constantemente entre la necesidad de brillar individualmente y la demanda de tus vínculos o emociones profundas. Ves tu vida reflejada en los demás, aprendiendo a través del espejo de las relaciones a equilibrar tu identidad con la necesidad de pertenencia y cuidado mutuo.', 
      g: 'Representas la tensión entre el observador consciente y el reflejo de la materia. Tu camino es el de la integración de los opuestos, aprendiendo a no identificarte exclusivamente con la luz ni con la sombra, hasta encontrar el punto central donde el espíritu se reconoce a sí mismo más allá de la dualidad.' 
    }, // Sol Oposicion Luna
    // Sol - Mercurio
  'Sun_con_Mercury': { 
      d: 'Tu identidad y tu intelecto están fundidos en una sola fuerza expresiva. Posees una claridad mental poderosa y una voz que proyecta tu esencia con autoridad, logrando que tus pensamientos y tu voluntad caminen siempre en la misma dirección, dotándote de una capacidad de comunicación centralizada y vibrante.', 
      g: 'Representas la iluminación del Logos a través de la presencia del espíritu. Tu mente no es un instrumento separado, sino un canal directo para la luz de la conciencia, permitiendo que el conocimiento superior sea verbalizado con la pureza de quien ha integrado la inteligencia con su chispa divina.' 
    }, // Sol Conjuncion Mercurio
    'Sun_sex_Mercury': { 
      d: 'La comunicación de tu propósito personal fluye con una facilidad creativa envidiable. Tienes la habilidad de traducir tus intenciones en palabras precisas y gestos inteligentes, encontrando siempre la manera de que tu mensaje sea escuchado y de que tu aprendizaje sea un aliado constante de tu crecimiento.', 
      g: 'Tu intelecto actúa como un puente armonioso para las emanaciones del espíritu. Esta conexión te permite captar las verdades sutiles del cosmos y expresarlas con una fluidez que facilita el despertar de tu entorno, utilizando la palabra como una herramienta de enseñanza y ordenación sagrada.' 
    }, // Sun Sextil Mercurio
    'Sun_cua_Mercury': { 
      d: 'Vives un desafío constante entre la velocidad de tu mente y la dirección de tu voluntad. Esta tensión te obliga a agudizar tu ingenio y a revisar tus opiniones con rigor, forjando una inteligencia resiliente que aprende a través del debate interno y la necesidad de dar coherencia a tus ideas.', 
      g: 'Experimentas la lucha del Logos por liberarse de las limitaciones de la percepción subjetiva. Esta fricción es una técnica de purificación mental que te obliga a destruir los prejuicios del ego para que la luz de la verdad real pueda emerger tras el esfuerzo de un pensamiento consciente y disciplinado.' 
    }, // Sun Cuadratura Mercurio
    'Sun_tri_Mercury': { 
      d: 'La armonía entre tu ser y tu capacidad de aprendizaje te otorga una lucidez natural y una agilidad mental asombrosa. Tus ideas se alinean espontáneamente con tus objetivos, permitiéndote comprender situaciones complejas con una visión clara y una elocuencia que inspira confianza en los demás.', 
      g: 'Posees una mente que resuena naturalmente con las leyes del espíritu. Tu intelecto es un espejo limpio que refleja la sabiduría del Pleroma, facilitando una comprensión profunda de los misterios sin las interferencias del error, donde el acto de pensar se convierte en una meditación sobre la unidad.' 
    }, // Sun Trigono Mercurio
    'Sun_opo_Mercury': { 
      d: 'Tu pensamiento se nutre del contraste y del intercambio constante con los demás. A menudo te ves obligado a equilibrar tu propia visión con los puntos de vista ajenos, lo que te otorga una capacidad analítica objetiva y una gran habilidad para mediar entre diferentes realidades intelectuales.', 
      g: 'Representas la búsqueda de la síntesis entre el observador interno y la multiplicidad de la información externa. Tu camino consiste en equilibrar la luz de tu conciencia con los mensajes del mundo, aprendiendo a discernir la palabra verdadera en medio del ruido de la dualidad para alcanzar la gnosis.' 
    }, // Sun Oposicion Mercurio
    // Sol - Venus
   'Sun_con_Venus': { 
      d: 'Tu identidad irradia una gracia natural y un magnetismo que armoniza tu entorno. Existe una fusión total entre tu voluntad y tu sentido del placer, lo que te permite proyectar una imagen de belleza y equilibrio donde tus deseos personales están alineados con una expresión estética refinada y amable.', 
      g: 'Representas la unión mística de la Luz y la Belleza en el centro del corazón. Tu chispa divina se manifiesta a través de la armonía, indicando que tu camino de despertar pasa por reconocer que el amor puro no es una emoción humana, sino la fuerza cohesiva que mantiene al espíritu unido a su origen.' 
    }, // Sol Conjuncion Venus
    'Sun_sex_Venus': { 
      d: 'Posees una facilidad innata para atraer circunstancias placenteras y relaciones equilibradas que apoyan tu crecimiento. Tu capacidad para disfrutar de la vida y expresar afecto fluye sin obstáculos, permitiéndote utilizar tu encanto personal como una herramienta creativa que abre puertas y suaviza tensiones.', 
      g: 'Tu conciencia capta con facilidad las frecuencias sutiles de la armonía cósmica. Esta conexión te permite actuar como un mediador de paz, utilizando la belleza como un lenguaje sagrado para recordar a las almas la serenidad del Pleroma, facilitando una evolución suave y llena de satisfacción espiritual.' 
    }, // Sol Sextil Venus
    'Sun_cua_Venus': { 
      d: 'Vives una tensión constante entre tu necesidad de autoafirmación y tu deseo de complacer o ser amado. Esta fricción te obliga a reevaluar tus valores y a no sacrificar tu identidad por mantener una paz superficial, forjando un carácter que aprende a amarse a sí mismo antes de buscar la aprobación externa.', 
      g: 'Experimentas el conflicto entre el fuego del espíritu y la seducción de las formas materiales. Esta crisis es una prueba alquímica que te impulsa a purificar tu deseo, obligándote a trascender la gratificación inmediata del demiurgo para encontrar la verdadera armonía que nace del rigor y la honestidad interior.' 
    }, // Sol Cuadratura Venus
    'Sun_tri_Venus': { 
      d: 'La elegancia y el bienestar fluyen en tu vida de manera espontánea, otorgándote un carácter sereno y una gran apreciación por las artes. Tus talentos creativos se integran perfectamente con tu propósito vital, atrayendo prosperidad y afecto sin necesidad de forzar las situaciones o los vínculos.', 
      g: 'Tu alma resuena en una frecuencia de gracia divina que te permite percibir la perfección oculta tras la apariencia del mundo. Manifiestas la belleza como un estado de conciencia donde el espíritu se deleita en su propia pureza, convirtiendo tu existencia en un reflejo del equilibrio celestial.' 
    }, // Sol Trigono Venus
    'Sun_opo_Venus': { 
      d: 'Tu búsqueda de equilibrio se manifiesta a través del espejo de los demás, oscilando entre tus propias necesidades y las demandas de tus relaciones. Aprendes a valorarte al observar lo que proyectas en el otro, integrando la belleza y el deseo mediante el reconocimiento de tus polaridades internas.', 
      g: 'Representas la tensión entre la conciencia central y el deseo de unión externa. Tu camino consiste en encontrar el centro de la balanza mística, comprendiendo que la armonía que buscas afuera es el reflejo de la reintegración de tu propia alma con su contraparte espiritual en el silencio absoluto.' 
    }, // Sol Oposicion Venus
    // Sol - Marte
 'Sun_con_Mars': { 
      d: 'Tu voluntad y tu capacidad de acción son una sola fuerza arrolladora. Posees una vitalidad inagotable y un coraje natural que te impulsa a conquistar tus objetivos sin vacilación, proyectando una personalidad valiente, competitiva y dotada de un liderazgo que se impone por su propia energía.', 
      g: 'Representas la encarnación del Guerrero de la Luz. El fuego del espíritu y la fuerza de la ejecución se funden para combatir la inercia de la materia, indicando que tu camino de gnosis es la acción consciente: el uso de la voluntad para rasgar el velo de la ilusión mediante el ímpetu sagrado.' 
    }, // Sol Conjuncion Marte
    'Sun_sex_Mars': { 
      d: 'Existe una armonía dinámica entre tus intenciones y tu capacidad para llevarlas a cabo. Tienes la habilidad de canalizar tu energía de manera constructiva, encontrando el momento justo para actuar con eficacia y sabiendo cómo utilizar tu competitividad para abrirte camino sin generar conflictos innecesarios.', 
      g: 'Tu conciencia utiliza la fuerza marcial como un vehículo disciplinado para la gran obra. Esta conexión te permite actuar con precisión dentro del mundo de las formas, utilizando el coraje como una herramienta de liberación que facilita el avance del alma hacia su soberanía espiritual sin desperdiciar energía.' 
    }, // Sol Sextil Marte
    'Sun_cua_Mars': { 
      d: 'Vives en una tensión constante que te empuja a la acción, a menudo a través del desafío o la impaciencia. Esta fricción interna es un motor poderoso que te obliga a desarrollar una resistencia inmensa, forjando tu carácter en el fuego de la lucha y enseñándote a dominar tu propia fuerza.', 
      g: 'Experimentas el combate entre la chispa divina y la impulsividad de la naturaleza animal. Esta crisis es una prueba de templanza: el espíritu es golpeado por el deseo para que aprendas a transmutar la ira en voluntad pura, convirtiendo la fricción del mundo en el calor necesario para la alquimia interior.' 
    }, // Sol Cuadratura Marte
    'Sun_tri_Mars': { 
      d: 'La energía vital y la confianza en ti mismo fluyen de manera natural y poderosa. Posees un entusiasmo contagioso y una capacidad ejecutiva que te permite alcanzar el éxito con determinación pero sin esfuerzo aparente, logrando que tu presencia sea sinónimo de fuerza, salud y victoria.', 
      g: 'Tu ser manifiesta la voluntad triunfante del pneuma sobre las leyes de la densidad. Gozas de una alineación donde la fuerza no es esfuerzo, sino una emanación natural de tu autoridad espiritual, permitiéndote proteger la luz y manifestar el propósito divino con una nobleza invicta.' 
    }, // Sol Oposicion Marte
    'Sun_opo_Mars': { 
      d: 'Tu fuerza personal se pone a prueba a través del espejo de la confrontación o la competencia con los demás. Aprendes a equilibrar tu voluntad observando cómo reaccionan otros ante tu poder, integrando tu capacidad de lucha mediante el reconocimiento de los límites y la negociación de tu autoridad.', 
      g: 'Representas la tensión entre la identidad solar y la fuerza proyectada en el mundo externo. Tu camino consiste en encontrar el punto de equilibrio donde la acción no se convierta en agresión, comprendiendo que el verdadero adversario es la dualidad y que la victoria real es el dominio de sí mismo.' 
    }, // Sol Oposicion Marte
    // Sol - Jupiter
    'Sun_con_Jupiter': { 
      d: 'Tu identidad está imbuida de un optimismo expansivo y una confianza inquebrantable en la vida. Posees una vitalidad generosa que busca constantemente el crecimiento y la sabiduría, proyectando una personalidad magnética que atrae la fortuna a través de una visión amplia y una fe natural en tus propias capacidades.', 
      g: 'Representas la manifestación de la Gracia en el centro de la conciencia. Tu espíritu se expande sin límites al reconocer su origen divino, indicando que tu camino de despertar es la integración de la abundancia espiritual, donde el ser se convierte en un faro de esperanza y conocimiento para los demás.' 
    }, // Sol Conjuncion Jupiter
    'Sun_sex_Jupiter': { 
      d: 'La vida te presenta oportunidades constantes para expandir tus horizontes con fluidez y alegría. Tienes el don de integrar la sabiduría en tu propósito vital, encontrando siempre el apoyo necesario y la perspectiva adecuada para que tus ambiciones se desarrollen en armonía con el bienestar general.', 
      g: 'Tu conciencia resuena con las leyes de la providencia divina. Esta conexión te permite captar las frecuencias de la abundancia espiritual, utilizando cada experiencia como un peldaño de conocimiento que facilita el ascenso del alma hacia una comprensión más vasta y luminosa del cosmos.', 
    }, // Sol Sextil Jupiter
    'Sun_cua_Jupiter': { 
      d: 'Vives una tensión constante entre tu ambición personal y el exceso de confianza, lo que te obliga a moderar tus impulsos para no desbordar tus límites. Esta fricción te impulsa a desarrollar una ética sólida y a buscar una verdad más profunda tras el desafío de tus propios juicios y creencias.', 
      g: 'Experimentas el conflicto entre el deseo de expansión del ego y la verdadera magnitud del espíritu. Esta crisis es una prueba de discernimiento: se te exige purificar tu visión de la soberbia para que la luz de la gnosis no se pierda en la arrogancia de creer que ya lo sabes todo.', 
    }, // Sol Cuadratura Jupiter
    'Sun_tri_Jupiter': { 
      d: 'Gozas de una armonía natural que te brinda protección y un sentido de propósito elevado. Tu generosidad y nobleza de carácter te abren puertas de manera espontánea, permitiéndote vivir con una plenitud que inspira a otros a buscar su propia verdad y a confiar en el flujo benévolo de la existencia.', 
      g: 'Tu alma manifiesta la majestad de quien se sabe heredero del reino espiritual. Existe en ti una alineación con la justicia divina que te permite transitar el mundo con una autoridad serena, convirtiendo tu vida en un testimonio de la bondad y la sabiduría que emanan directamente del Absoluto.', 
    }, // Sol Trigono Jupiter
    'Sun_opo_Jupiter': { 
      d: 'Tu búsqueda de sentido y expansión se refleja en tus encuentros con el mundo exterior y los demás. Aprendes a equilibrar tu visión personal con las verdades ajenas, integrando tu crecimiento mediante la moderación de tus expectativas y el reconocimiento de que la sabiduría también reside en el espejo del otro.', 
      g: 'Representas la tensión entre la conciencia individual y la ley universal de expansión. Tu camino consiste en encontrar el equilibrio entre tu fe personal y la realidad del mundo, comprendiendo que la verdadera libertad surge cuando la voluntad del ser se ajusta a la armonía del orden cósmico.', 
    }, // Sol Oposicion Jupiter
    // Sol - Saturno
'Sun_con_Saturn': { 
      d: 'Tu identidad está forjada en la disciplina, la responsabilidad y una seriedad profunda ante la vida. Posees una voluntad inquebrantable que se manifiesta a través de la autosuficiencia y el realismo, proyectando una autoridad que nace del esfuerzo propio y de una madurez que a menudo se manifiesta desde temprana edad.', 
      g: 'Representas la encarnación del Rigor en el centro del ser. La chispa divina se somete a la ley de la forma para dominarla, indicando que tu camino de gnosis es la maestría sobre el tiempo y la materia: el espíritu que se hace piedra angular para construir un templo interior inexpugnable ante el caos.' 
    }, // Sol Conjuncion Saturno
    'Sun_sex_Saturn': { 
      d: 'Existe una comunicación fluida entre tu propósito vital y tu capacidad para estructurar la realidad. Tienes el don de organizar tus ambiciones con paciencia y método, encontrando oportunidades para consolidar tu éxito de manera duradera mediante un uso inteligente de la tradición y el esfuerzo constante.', 
      g: 'Tu conciencia utiliza la ley del karma y el orden como herramientas de ascenso espiritual. Esta conexión te permite actuar con una integridad sagrada dentro de la densidad, utilizando la disciplina como un vehículo que facilita la cristalización de las virtudes del pneuma en estructuras tangibles y permanentes.', 
    }, // Sol Sextil Saturno
    'Sun_cua_Saturn': { 
      d: 'Vives una tensión constante entre tu deseo de expresión personal y las limitaciones o exigencias del mundo externo. Esta fricción te obliga a desarrollar una resiliencia de acero, forjando tu carácter a través de la superación de obstáculos que ponen a prueba tu valía y tu capacidad de persistir ante la adversidad.', 
      g: 'Experimentas el conflicto entre la luz del espíritu y la resistencia del Arconte del Tiempo. Esta crisis es una prueba de fuego donde la identidad es golpeada por el límite para purificarla de toda vanidad, obligándote a encontrar la verdadera autoridad que surge cuando el ego se rinde ante la ley superior del ser.', 
    }, // Sol Cuadratura Saturno
    'Sun_tri_Saturn': { 
      d: 'La estabilidad y el sentido del deber fluyen en tu vida de manera natural, otorgándote una reputación de integridad y confianza. Posees una sabiduría innata para manejar el mundo material y las jerarquías, logrando que tu vida sea un ejemplo de orden y éxito basado en cimientos sólidos y principios éticos.', 
      g: 'Tu alma manifiesta la serenidad de quien ha comprendido el propósito del límite. Gozas de una alineación donde el tiempo no es un enemigo, sino un aliado en la gran obra, permitiéndote manifestar la soberanía del espíritu con una seriedad divina que ordena el entorno y redime la materia mediante el ejemplo.', 
    }, // Sol Trigono Saturno
    'Sun_opo_Saturn': { 
      d: 'Tu identidad y tu sentido de la responsabilidad se ponen a prueba a través de tus relaciones y el juicio externo. Aprendes a valorar tu autoridad al enfrentar los límites que otros te imponen, integrando tu propia estructura interna al equilibrar tus necesidades personales con las demandas del mundo real.', 
      g: 'Representas la tensión entre la conciencia solar y el guardián del umbral. Tu camino consiste en encontrar el centro de la balanza entre la libertad del pneuma y la necesidad de la forma, comprendiendo que el verdadero rigor es el que te libera de las ilusiones externas para someterte solo a tu propia luz interna.', 
    }, // Sol Oposicion Saturno
    // Sol - Urano
'Sun_con_Uranus': { 
      d: 'Tu identidad es una explosión de originalidad y genio independiente. Posees una necesidad vital de romper moldes y expresar tu verdad única sin concesiones, proyectando una personalidad eléctrica y revolucionaria que actúa como un catalizador de cambio y libertad en cualquier entorno donde te encuentres.', 
      g: 'Representas la irrupción del relámpago gnóstico en el centro de la conciencia. Tu chispa divina se activa mediante el despertar súbito, indicando que tu camino es la liberación radical de los programas de control del demiurgo, convirtiendo tu presencia en una frecuencia de choque que despierta a otras almas.' 
    }, // Sol Conjuncion Urano
    'Sun_sex_Uranus': { 
      d: 'La vida te ofrece oportunidades fluidas para renovar tu identidad y abrazar lo innovador. Tienes la habilidad de integrar cambios repentinos con creatividad y astucia, encontrando siempre formas originales de expresar tu propósito vital que resultan estimulantes tanto para ti como para tu círculo social.', 
      g: 'Tu conciencia sintoniza con las corrientes de la inteligencia estelar de manera armoniosa. Esta conexión te permite captar ideas visionarias y aplicarlas en tu proceso de despertar, utilizando la intuición como un radar sagrado que facilita la navegación fuera de las estructuras limitantes del mundo astral.' 
    }, // Sol Sextil Urano
    'Sun_cua_Uranus': { 
      d: 'Vives en una tensión constante entre tu voluntad personal y un impulso de rebeldía incontrolable. Esta fricción te obliga a desarrollar una autenticidad extrema a través de crisis de identidad y giros inesperados, forjando un carácter que no teme caminar solo con tal de ser fiel a su propia verdad interna.', 
      g: 'Experimentas el conflicto entre la luz solar y el rayo de la liberación disruptiva. Esta crisis es una prueba de desapego total: se te exige romper con la necesidad de seguridad y pertenencia al sistema para que el pneuma pueda emerger puro, libre de las cadenas de la costumbre y la mente colmena.' 
    }, // Sol Cuadratura Urano
    'Sun_tri_Uranus': { 
      d: 'La libertad y la genialidad fluyen en tu vida de manera espontánea, otorgándote una visión de futuro clara y una gran capacidad de invención. Tu carácter progresista atrae situaciones afortunadas donde tu diferencia es celebrada, permitiéndote vivir con una independencia que inspira a otros a ser libres.', 
      g: 'Tu alma manifiesta la frecuencia de las esferas superiores con una naturalidad asombrosa. Existe en ti una alineación con la verdad trascendente que te permite vivir en el mundo sin ser de él, manifestando una sabiduría revolucionaria que fluye sin esfuerzo desde tu centro espiritual hacia la colectividad.' 
    }, // Sol Trigono Urano
    'Sun_opo_Uranus': { 
      d: 'Tu necesidad de independencia se pone a prueba a través de encuentros con personas o situaciones impredecibles que desafían tu autoridad. Aprendes a reconocer tu propia originalidad al observar la rebeldía en los demás, integrando tu genio mediante el equilibrio entre tu identidad y el cambio social.', 
      g: 'Representas la tensión entre la conciencia central y la libertad absoluta proyectada en el espejo del mundo. Tu camino consiste en encontrar el centro del rayo, comprendiendo que la verdadera revolución no es contra lo externo, sino la recuperación de tu autonomía divina frente a todas las fuerzas de la dualidad.' 
    }, // Sol Oposicion Urano
    // Sol - Neptuno
'Sun_con_Neptune': { 
      d: 'Tu identidad se disuelve en una sensibilidad oceánica y una imaginación sin límites. Posees una naturaleza empática y mística que busca fundirse con algo superior, proyectando una personalidad magnética, inspirada y artística que a menudo percibe dimensiones de la realidad que otros ignoran.', 
      g: 'Representas la inmersión de la conciencia solar en las aguas de la compasión infinita. Tu chispa divina se manifiesta a través de la disolución del ego, indicando que tu camino de gnosis es el sacrificio del "yo" separado para reconocer la presencia del Absoluto en toda la creación, convirtiéndote en un canal puro para la luz del Pleroma.' 
    }, // Sol Conjuncion Neptuno
    'Sun_sex_Neptune': { 
      d: 'Existe una armonía sutil entre tu propósito vital y tu intuición. Tienes la facilidad de integrar tus sueños y visiones espirituales en tu vida cotidiana, encontrando oportunidades para expresar tu creatividad y tu bondad de manera que elevan tu entorno y te brindan una profunda paz interior.', 
      g: 'Tu conciencia sintoniza con las frecuencias del amor universal de forma fluida. Esta conexión te permite percibir la unidad oculta tras la fragmentación de la materia, utilizando tu sensibilidad como un instrumento de sanación y consuelo que facilita el retorno de las almas hacia la fuente espiritual mediante la gracia.' 
    }, // Sol Sextil Neptuno
    'Sun_cua_Neptune': { 
      d: 'Vives una tensión constante entre tu voluntad personal y un sentimiento de confusión o desilusión. Esta fricción te obliga a desarrollar un discernimiento espiritual agudo, forjando tu carácter a través de la necesidad de diferenciar tus anhelos ideales de la realidad tangible, aprendiendo a no perderte en espejismos.', 
      g: 'Experimentas el conflicto entre la luz del pneuma y los velos engañosos de la ilusión astral (Maya). Esta crisis es una prueba de transparencia: se te exige purificar tu visión para no ser devorado por las falsas luces del demiurgo, obligándote a encontrar la verdad que reside más allá de los sueños y las fantasías del ego.' 
    }, // Sol Cuadratura Neptuno
    'Sun_tri_Neptune': { 
      d: 'La inspiración y la conexión espiritual fluyen en tu vida de manera espontánea, otorgándote un carisma suave y una gran capacidad de perdón. Tu naturaleza idealista atrae circunstancias mágicas donde tu fe se ve recompensada, permitiéndote vivir con una entrega que disuelve las asperezas del mundo material.', 
      g: 'Tu alma manifiesta la serenidad de quien ha regresado al océano de la luz sin haber dejado el cuerpo. Existe en ti una alineación con la voluntad divina que te permite transitar la densidad con una pureza inalterable, convirtiendo tu vida en un reflejo de la armonía inefable que aguarda a los espíritus liberados.' 
    }, // Sol Trigono Neptuno
    'Sun_opo_Neptune': { 
      d: 'Tu identidad y tu necesidad de trascendencia se ponen a prueba a través del espejo de los demás, oscilando entre la claridad personal y la proyección de tus ideales en otros. Aprendes a valorarte al descubrir que la magia y la salvación que buscas afuera residen en tu propio centro espiritual.', 
      g: 'Representas la tensión entre la conciencia central y la disolución absoluta proyectada en el mundo externo. Tu camino consiste en encontrar el centro del espejo sagrado, comprendiendo que el verdadero amor incondicional no es una pérdida de identidad, sino el reconocimiento de la chispa divina en el rostro del hermano.' 
    }, // Sol Oposicion Neptuno
    // Sol - Pluton
  'Sun_con_Pluto': { 
      d: 'Tu identidad está fusionada con una voluntad de hierro y una intensidad que no acepta términos medios. Posees una capacidad de regeneración total, proyectando una presencia magnética y autoritaria que busca penetrar hasta el fondo de cada situación, transformando radicalmente todo lo que tocas a través del poder de tu esencia.', 
      g: 'Representas la manifestación del Fuego Sagrado en las profundidades de la materia. Tu pneuma ha descendido al abismo para recuperar su soberanía, indicando que tu camino es la alquimia de la muerte mística: la destrucción total del ego para que el espíritu real resurja con un poder que no es de este mundo.' 
    }, // Sol Conjuncion Pluton
    'Sun_sex_Pluto': { 
      d: 'Existe una armonía poderosa entre tu propósito vital y tu capacidad para manejar el poder oculto. Tienes la habilidad de transformar tu realidad con astucia y determinación, encontrando oportunidades para regenerar tu vida de manera fluida y utilizando tu magnetismo personal para influir positivamente en las estructuras que te rodean.', 
      g: 'Tu conciencia sintoniza con las fuerzas de transmutación del cosmos de forma natural. Esta conexión te permite utilizar la voluntad como una herramienta de purificación, facilitando el proceso de redención de la sombra y permitiendo que la luz del espíritu penetre en los rincones más densos del alma con una eficacia silenciosa.' 
    }, // Sol Sextil Pluton
    'Sun_cua_Pluto': { 
      d: 'Vives una tensión extrema entre tu necesidad de control y fuerzas externas que te obligan a la rendición. Esta fricción es un motor de transformación profunda que te obliga a morir y renacer constantemente, forjando un carácter indestructible que ha aprendido a soltar lo que ya no sirve bajo la presión del destino.', 
      g: 'Experimentas el conflicto directo entre el Sol espiritual y el Arconte de la muerte y el poder. Esta crisis es una prueba de fuego iniciática: se te exige despojarte de toda ambición mundana y miedo al vacío para que el espíritu pueda liberarse de los lazos kármicos más antiguos a través de la desintegración consciente.' 
    }, // Sol Cuadratura Pluton
    'Sun_tri_Pluto': { 
      d: 'La capacidad de regeneración y el mando natural fluyen en tu vida de manera espontánea. Posees una autoridad innata y una comprensión profunda de las motivaciones ocultas, lo que te permite sanar y transformar tu entorno con una facilidad asombrosa, atrayendo el éxito mediante una voluntad que se siente predestinada.', 
      g: 'Tu alma manifiesta la majestad del espíritu que ha triunfado sobre la oscuridad. Gozas de una alineación donde el poder no corrompe, sino que sirve como un bálsamo purificador, permitiéndote manifestar la voluntad del Absoluto con una fuerza que disuelve cualquier obstáculo y transmuta la materia en luz divina.' 
    }, // Sol Trigono Pluton
    'Sun_opo_Pluto': { 
      d: 'Tu identidad y tu poder personal se ponen a prueba a través de encuentros intensos con otros que intentan dominarte o transformarte. Aprendes a reconocer tu propia fuerza al enfrentar la sombra proyectada en el mundo externo, integrando tu capacidad de mando mediante el equilibrio entre tu voluntad y la entrega.', 
      g: 'Representas la tensión entre la conciencia central y el guardián de los misterios subterráneos. Tu camino consiste en encontrar el centro de la balanza entre la luz y el abismo, comprendiendo que el verdadero poder surge cuando dejas de luchar contra la sombra externa y realizas la unión mística de los opuestos en tu propio ser.' 
    }, // Sol Oposicion Pluton
// Luna - Mercurio
    'Moon_con_Mercury': { d: 'Tu mente y tus emociones hablan el mismo lenguaje. Posees una gran intuición intelectual y la capacidad de verbalizar lo que sientes con una claridad asombrosa, permitiéndote conectar con los demás a través de una comunicación empática y una memoria emocional muy aguda.', g: 'Representas la unión de la sustancia del alma con el Logos. Tu pensamiento no es seco ni racionalista, sino que está impregnado por la sensibilidad mística, permitiendo que la palabra se convierta en un vehículo para transmitir las verdades internas del pneuma.' }, // Luna Conjuncion Mercurio
    'Moon_sex_Mercury': { d: 'Existe un flujo natural entre tu intuición y tu razonamiento. Tienes la habilidad de comprender tus procesos emocionales de forma lógica, lo que facilita el aprendizaje y te permite dar consejos sabios basados en una mezcla equilibrada de intelecto y sentimiento.', g: 'Tu mente racional actúa como un aliado de la psique purificada. Esta armonía facilita la captación de las enseñanzas esotéricas, permitiendo que el conocimiento descienda al alma sin distorsiones, convirtiendo la comunicación en un acto de equilibrio sagrado.' }, // Luna Sextil Mercurio
    'Moon_cua_Mercury': { d: 'Vives una tensión entre lo que piensas y lo que sientes, lo que puede generar indecisión o malentendidos. Esta fricción te obliga a trabajar en la objetividad, aprendiendo a no dejar que tus estados de ánimo nublen tu juicio ni que la lógica ignore tus necesidades afectivas.', g: 'Experimentas el conflicto entre el alma lunar y el pensamiento demiúrgico. Esta crisis es un proceso de refinamiento donde se te exige separar la verdad espiritual de las fluctuaciones emocionales, forjando un intelecto capaz de discernir la realidad tras el velo del sentimiento.' }, // Luna Cuadratura Mercurio
    'Moon_tri_Mercury': { d: 'La armonía entre tu sensibilidad y tu inteligencia te otorga una gran agilidad mental y una comprensión profunda de la naturaleza humana. Tus palabras tienen el poder de calmar y tu mente se adapta con facilidad a los cambios emocionales, fluyendo con una sensatez innata.', g: 'Tu alma resuena espontáneamente con las frecuencias del Logos superior. Gozas de una alineación donde la intuición espiritual guía al pensamiento, permitiendo una comprensión mística del cosmos que se expresa con una sencillez y una paz que trascienden la duda.' }, // Luna Trigono Mercurio
    'Moon_opo_Mercury': { d: 'Te encuentras constantemente mediando entre tu lógica y tus sentimientos, a menudo proyectando esta dualidad en tus conversaciones con otros. Aprendes a integrar tu mundo interno al escuchar diferentes perspectivas, buscando un equilibrio entre la cabeza y el corazón.', g: 'Representas la tensión entre la mente exterior y la profundidad del alma. Tu camino consiste en encontrar el punto de unión donde la palabra no traicione al sentimiento, logrando una síntesis que permita al espíritu hablar a través de la psique sin perderse en la dualidad del lenguaje.' }, // Luna Oposicion Mercurio

    // Luna - Venus
    'Moon_con_Venus': { d: 'Tu naturaleza es profundamente afectiva, amable y dotada de un gran sentido estético. Existe una fusión entre tu necesidad de seguridad emocional y tu deseo de armonía, lo que te otorga un encanto personal que busca la paz y la belleza en cada rincón de tu vida íntima.', g: 'Representas el matrimonio sagrado de la psique con la belleza espiritual. Tu alma busca el retorno al Pleroma a través del amor incondicional, convirtiendo tu sensibilidad en un altar donde la luz de la armonía divina se manifiesta como una presencia constante y nutricia.' }, // Luna Conjuncion Venus
    'Moon_sex_Venus': { d: 'Posees una facilidad natural para atraer relaciones armoniosas y bienestar a tu vida. Tu capacidad para expresar afecto y disfrutar de las cosas bellas fluye sin esfuerzo, permitiéndote crear un entorno hogareño y social lleno de calidez, equilibrio y gratitud.', g: 'Tu alma capta con facilidad las frecuencias de la bondad divina. Esta conexión facilita el proceso de purificación emocional, permitiendo que la belleza espiritual actúe como un bálsamo que suaviza el camino del despertar y atrae hacia ti las energías de la paz celestial.' }, // Luna Sextil Venus
    'Moon_cua_Venus': { d: 'Vives una tensión entre tus necesidades emocionales básicas y tus deseos de placer o aceptación social. Esta fricción te impulsa a buscar un equilibrio real en tus afectos, aprendiendo a no ceder tu seguridad por una armonía superficial o por la complacencia hacia los demás.', g: 'Experimentas el conflicto entre la sed de amor del alma y las ilusiones de la materia. Esta crisis es una prueba de valores: se te exige trascender el apego a la belleza transitoria del mundo para descubrir la verdadera armonía del espíritu que no depende de la aprobación externa.' }, // Luna Cuadratura Venus
    'Moon_tri_Venus': { d: 'La elegancia emocional y el confort fluyen en tu vida de manera espontánea. Tienes un don para la decoración, el cuidado y la creación de ambientes armoniosos, donde tu afectividad se expresa con una generosidad y una suavidad que atraen amor y prosperidad de forma natural.', g: 'Tu alma manifiesta la serenidad de quien ha encontrado la belleza en el silencio interior. Existe en ti una alineación con la armonía del Absoluto que te permite transitar la vida con una gracia mística, convirtiendo tus sentimientos en un reflejo del amor puro que emana de la fuente.' }, // Luna Trigono Venus
    'Moon_opo_Venus': { d: 'Tus necesidades afectivas a menudo se ven reflejadas o desafiadas en tus vínculos cercanos. Aprendes a equilibrar tu propia satisfacción con la de los demás, integrando tu sentido del valor personal al reconocer que el amor que buscas afuera debe nacer primero en tu interior.', g: 'Representas la búsqueda del equilibrio entre el alma y el deseo de unión externa. Tu camino consiste en comprender que las relaciones son espejos de tu estado espiritual, aprendiendo a amar sin poseer y a encontrar la belleza divina tanto en el silencio propio como en el encuentro con el otro.' }, // Luna Oposicion Venus

    // Luna - Marte
    'Moon_con_Mars': { d: 'Tus emociones son intensas, directas y están cargadas de una energía impulsiva. Tienes una reacción inmediata ante los estímulos, lo que te otorga una gran valentía para defender lo que quieres, aunque también una tendencia a la impaciencia y a vivir los sentimientos con fuego.', g: 'Representas la fuerza combativa del alma que lucha por su liberación. Tu energía emocional está al servicio del espíritu guerrero, indicando que tu camino de gnosis requiere el uso de la pasión purificada para romper las inercias de la materia y defender la chispa divina con determinación.' }, // Luna Conjuncion Marte
    'Moon_sex_Mars': { d: 'Existe una armonía constructiva entre tus sentimientos y tu capacidad de acción. Tienes el don de utilizar tus emociones como un motor para lograr metas tangibles, actuando con una seguridad emocional que te permite proteger y emprender proyectos con eficacia y entusiasmo.', g: 'Tu alma utiliza la fuerza marcial de manera equilibrada para avanzar en el sendero. Esta conexión te permite actuar con un coraje consciente, utilizando tus instintos como un vehículo disciplinado que facilita la superación de las pruebas espirituales sin perder la serenidad interior.' }, // Luna Sextil Marte
    'Moon_cua_Mars': { d: 'Vives una fricción constante entre tu necesidad de paz y tus impulsos agresivos o competitivos. Esta tensión genera una gran fuerza interior pero también volatilidad emocional, obligándote a dominar tu temperamento y a transformar la ira en una voluntad constructiva y consciente.', g: 'Experimentas la lucha entre la sustancia emocional y la fuerza ciega del deseo. Esta crisis es una prueba de templanza alquímica: se te exige transmutar el fuego de las pasiones en la luz del espíritu, evitando que la energía del alma se disperse en conflictos estériles del mundo astral.' }, // Luna Cuadratura Marte
    'Moon_tri_Mars': { d: 'La energía vital y el equilibrio emocional fluyen de manera poderosa en ti. Tienes una capacidad innata para recuperarte de los golpes y una fuerza protectora natural que inspira confianza, permitiéndote actuar de acuerdo con lo que sientes con una confianza y un éxito envidiables.', g: 'Tu alma manifiesta la nobleza del guerrero que ha encontrado la paz. Gozas de una alineación donde la fuerza no es violencia, sino una emanación natural de la voluntad espiritual que protege el templo interior y actúa con la precisión de quien se sabe guiado por una fuerza superior.' }, // Luna Trigono Marte
    'Moon_opo_Mars': { d: 'Tus conflictos internos suelen proyectarse en tus relaciones, enfrentándote a situaciones donde debes equilibrar tu sensibilidad con la asertividad de los demás. Aprendes a manejar tu fuerza emocional al observar cómo reaccionan otros, integrando tu poder a través del autocontrol.', g: 'Representas la tensión entre la receptividad del alma y la fuerza proyectiva del deseo. Tu camino consiste en encontrar el centro de la balanza, comprendiendo que la verdadera victoria no es contra el otro, sino la conquista de las propias turbulencias para alcanzar la calma del espíritu.' }, // Luna Oposicion Marte

    // Luna - Jupiter
    'Moon_con_Jupiter': { d: 'Tu mundo emocional es vasto, generoso y está lleno de una fe natural en la vida. Posees una gran capacidad de expansión y protección hacia los demás, proyectando una calidez que atrae la buena fortuna y un sentido de bienestar que se nutre de ideales elevados y alegría.', g: 'Representas la expansión del alma hacia las esferas superiores de la gracia. Tu sensibilidad está sintonizada con la abundancia espiritual, indicando que tu camino de despertar pasa por reconocer la inmensidad del pneuma y convertir tu vida emocional en un himno de gratitud al Absoluto.' }, // Luna Conjuncion Jupiter
    'Moon_sex_Jupiter': { d: 'La vida te ofrece oportunidades fluidas para crecer emocionalmente y sentirte protegido. Tienes la habilidad de ver el lado positivo de las situaciones, lo que te permite integrar las lecciones de la vida con sabiduría y atraer apoyo y prosperidad de manera natural y constante.', g: 'Tu alma resuena armoniosamente con las leyes de la providencia divina. Esta conexión te permite captar las enseñanzas de la sabiduría oculta con facilidad, utilizando tu bienestar emocional como un terreno fértil para que la semilla de la gnosis crezca y se expanda sin obstáculos.' }, // Luna Sextil Jupiter
    'Moon_cua_Jupiter': { d: 'Vives una tensión entre tus necesidades de seguridad y un deseo de expansión que a menudo te lleva al exceso. Esta fricción te obliga a trabajar en la moderación y a buscar una verdad emocional más profunda, aprendiendo a no buscar la felicidad solo en el crecimiento externo desmedido.', g: 'Experimentas el conflicto entre la búsqueda de consuelo del alma y la verdadera magnitud del conocimiento espiritual. Esta crisis es una prueba de discernimiento que te impulsa a purificar tu fe, evitando que la esperanza se convierta en una ilusión que te aleje de la realidad del espíritu.' }, // Luna Cuadratura Jupiter
    'Moon_tri_Jupiter': { d: 'La plenitud y la sabiduría emocional fluyen en ti con una naturalidad asombrosa. Posees una naturaleza noble y protectora que encuentra satisfacción en el aprendizaje y en la ayuda a los demás, atrayendo una protección casi providencial sobre tu vida y tu hogar.', g: 'Tu alma manifiesta la serenidad de quien se sabe conectado con la fuente de toda vida. Existe en ti una alineación con la benevolencia del cosmos que te permite transitar la existencia con una confianza sagrada, convirtiendo tu mundo interno en un refugio de luz y sabiduría para todos.' }, // Luna Trigono Jupiter
    'Moon_opo_Jupiter': { d: 'Tu búsqueda de crecimiento y sentido a menudo choca con tus necesidades de seguridad o se refleja en tus vínculos. Aprendes a equilibrar tu generosidad con tus límites personales, integrando tu expansión emocional al comprender que la verdadera abundancia reside en el equilibrio interno.', g: 'Representas la tensión entre el alma individual y la ley universal de expansión. Tu camino consiste en encontrar el punto medio donde la fe no se convierta en fanatismo ni la necesidad en dependencia, reconociendo que la verdadera patria del alma es la inmensidad del espíritu eterno.' }, // Luna Oposicion Jupiter

    // Luna - Saturno
    'Moon_con_Saturn': { d: 'Tus emociones están marcadas por una gran seriedad, reserva y sentido del deber. Posees una madurez emocional que te hace autosuficiente y responsable, aunque a veces puedes sentir una carga de soledad o la necesidad de controlar tus sentimientos bajo una estructura rígida.', g: 'Representas el alma que acepta la ley del rigor para alcanzar su propia maestría. Tu sensibilidad se somete a la disciplina del tiempo para purificarse, indicando que tu camino de gnosis es la construcción de una fortaleza interna que no depende de consuelos externos, sino de la roca del espíritu.' }, // Luna Conjuncion Saturno
    'Moon_sex_Saturn': { d: 'Existe una armonía fluida entre tu mundo emocional y tu capacidad para poner límites y estructuras. Tienes el don de manejar tus sentimientos con realismo y paciencia, logrando una estabilidad duradera en tu vida privada y una reputación de seriedad y confianza ante los demás.', g: 'Tu alma utiliza la ley del orden como una herramienta de protección espiritual. Esta conexión te permite integrar las lecciones del karma con sabiduría, utilizando la disciplina emocional como un vehículo que facilita la cristalización de las virtudes del pneuma en una paz sólida e inalterable.' }, // Luna Sextil Saturno
    'Moon_cua_Saturn': { d: 'Vives una tensión constante entre tu necesidad de afecto y una sensación de restricción o frialdad, a menudo proveniente del pasado o de figuras de autoridad. Esta fricción te obliga a desarrollar una resistencia inmensa y a aprender que la verdadera seguridad nace de tu propio esfuerzo.', g: 'Experimentas el conflicto entre el alma sedienta de luz y el peso de la materia demiúrgica. Esta crisis es una prueba de templanza extrema: se te exige despojarte de toda autocompasión para encontrar la autoridad espiritual que surge cuando el alma deja de buscar refugio en la ilusión y acepta su propio poder.' }, // Luna Cuadratura Saturno
    'Moon_tri_Saturn': { d: 'La estabilidad y la madurez emocional fluyen en ti de manera natural, otorgándote un carácter digno y confiable. Tienes una habilidad innata para cuidar de lo propio con orden y constancia, logrando que tu vida emocional sea un ejemplo de integridad y respeto por la tradición.', g: 'Tu alma manifiesta la paz de quien ha comprendido el propósito del límite y el tiempo. Gozas de una alineación donde la madurez no es peso, sino sabiduría acumulada, permitiéndote proteger la chispa divina con una seriedad sagrada que ordena tu mundo interno y redime tus emociones.' }, // Luna Trigono Saturno
    'Moon_opo_Saturn': { d: 'Tu necesidad de seguridad emocional choca a menudo con las responsabilidades o juicios del mundo exterior y los demás. Aprendes a valorar tus sentimientos al enfrentar los límites que otros te imponen, integrando tu propia estructura interna al equilibrar el cuidado de ti mismo con el deber.', g: 'Representas la tensión entre la vulnerabilidad de la psique y el rigor de la ley cósmica. Tu camino consiste en encontrar el equilibrio entre el corazón y la ley, comprendiendo que el verdadero guardián de tu alma no está afuera, sino en la disciplina consciente que te libera de las ataduras del karma.' }, // Luna Oposicion Saturno

    // Luna - Urano
    'Moon_con_Uranus': { d: 'Tus emociones son eléctricas, originales y están sujetas a cambios repentinos e iluminadores. Posees una necesidad vital de libertad emocional y una intuición que raya en la genialidad, proyectando una personalidad única que rompe con las tradiciones familiares o sociales establecidas.', g: 'Representas el despertar súbito de la psique ante la luz estelar. Tu alma se libera de los programas de condicionamiento lunar, indicando que tu camino es la revolución interna: el pneuma que sacude las aguas de la emoción para que la conciencia pueda emerger libre de las cadenas del pasado.' }, // Luna Conjuncion Urano
    'Moon_sex_Uranus': { d: 'La vida te ofrece oportunidades fluidas para renovar tus hábitos y liberar tus emociones de forma creativa. Tienes la habilidad de adaptarte a los cambios con entusiasmo y de encontrar soluciones originales a tus problemas afectivos, fluyendo con una independencia que resulta refrescante.', g: 'Tu alma sintoniza con las frecuencias de la liberación de manera armoniosa. Esta conexión te permite captar destellos de intuición superior que facilitan el proceso de despertar, utilizando tu sensibilidad como un radar para detectar las verdades que se ocultan tras las formas obsoletas del mundo astral.' }, // Luna Sextil Urano
    'Moon_cua_Uranus': { d: 'Vives una tensión constante entre tu deseo de seguridad y un impulso de rebelión que te empuja a romper con lo conocido de forma brusca. Esta fricción genera una gran inquietud interna, pero te obliga a desarrollar una autenticidad emocional que no depende de la estabilidad externa.', g: 'Experimentas el conflicto entre la inercia del alma y el rayo de la liberación disruptiva. Esta crisis es una prueba de desapego radical: se te exige romper con la necesidad de pertenencia al sistema lunar para que la chispa divina pueda respirar en la libertad del espíritu, fuera de la zona de confort.' }, // Luna Cuadratura Urano
    'Moon_tri_Uranus': { d: 'La libertad y la intuición fluyen en tu mundo emocional de manera espontánea, otorgándote una visión clara y una gran capacidad para soltar el pasado. Tu naturaleza progresista atrae situaciones afortunadas donde tu originalidad es tu mayor protección y tu fuente de felicidad.', g: 'Tu alma manifiesta la frecuencia de las esferas superiores con una naturalidad asombrosa. Existe en ti una alineación con la verdad trascendente que te permite vivir tus emociones con una independencia sagrada, manifestando una sabiduría visionaria que fluye sin esfuerzo desde tu centro místico.' }, // Luna Trigono Urano
    'Moon_opo_Uranus': { d: 'Tu necesidad de libertad emocional se pone a prueba a través de relaciones o eventos inesperados que desafían tu estabilidad. Aprendes a reconocer tu propia originalidad al observar la imprevisibilidad en los demás, integrando tu genio emocional al equilibrar tu paz con el cambio permanente.', g: 'Representas la tensión entre la receptividad de la psique y la libertad absoluta proyectada en el mundo externo. Tu camino consiste en encontrar el centro del relámpago, comprendiendo que la verdadera autonomía es la que recuperas al dejar de buscar seguridad en lo que siempre está por cambiar.' }, // Luna Oposicion Urano

    // Luna - Neptuno
    'Moon_con_Neptune': { d: 'Tu sensibilidad es ilimitada y tu alma parece estar fundida con los planos invisibles de la existencia. Posees una empatía oceánica, una imaginación desbordante y una mística natural que te hace percibir el mundo a través de los sueños, la música y el sentimiento puro.', g: 'Representas la disolución de la psique en el océano del espíritu universal. Tu alma ha traspasado el velo de Maya para buscar la unidad con el Pleroma, indicando que tu camino de gnosis es la entrega mística y la compasión, convirtiendo tu sensibilidad en un canal para la luz inefable del Absoluto.' }, // Luna Conjuncion Neptuno
    'Moon_sex_Neptune': { d: 'Existe una armonía sutil entre tus emociones y tu intuición espiritual. Tienes la facilidad de canalizar tu sensibilidad hacia fines artísticos o sanadores, encontrando en la espiritualidad un refugio natural que te brinda paz y eleva tu vida cotidiana de manera suave y mágica.', g: 'Tu alma sintoniza con las frecuencias del amor divino de forma fluida. Esta conexión te permite captar las vibraciones superiores de la creación, utilizando tu intuición como un bálsamo que facilita el despertar de tu conciencia y la de los demás a través del perdón y la belleza mística.' }, // Luna Sextil Neptuno
    'Moon_cua_Neptune': { d: 'Vives una tensión entre tu necesidad de seguridad real y una tendencia a perderte en confusiones o idealizaciones. Esta fricción te obliga a desarrollar un discernimiento emocional agudo, aprendiendo a diferenciar la verdadera conexión espiritual de los espejismos de tu propia imaginación.', g: 'Experimentas el conflicto entre el alma pura y los velos engañosos del plano astral. Esta crisis es una prueba de transparencia mística: se te exige purificar tus sentimientos para no ser arrastrado por las ilusiones del demiurgo, buscando la verdad que reside más allá de los sueños del ego.' }, // Luna Cuadratura Neptuno
    'Moon_tri_Neptune': { d: 'La inspiración y la paz espiritual fluyen en tu vida emocional de manera espontánea, otorgándote una fe profunda y una gran capacidad de entrega. Tu naturaleza idealista atrae circunstancias sanadoras donde tu sensibilidad es respetada y tu alma se siente en casa en cualquier lugar sagrado.', g: 'Tu alma manifiesta la serenidad de quien ha vislumbrado el origen divino de todas las cosas. Existe en ti una alineación con la armonía del Pleroma que te permite transitar la densidad con una pureza inalterable, convirtiendo tus emociones en un reflejo de la luz infinita que redime a la materia.' }, // Luna Trigono Neptuno
    'Moon_opo_Neptune': { d: 'Tu sensibilidad y tu búsqueda de trascendencia se reflejan en tus vínculos, donde a menudo proyectas tus sueños o sufres por desilusiones. Aprendes a valorarte al descubrir que la salvación y el paraíso que buscas en el otro residen en la profundidad de tu propio templo interior.', g: 'Representas la tensión entre la psique individual y la disolución absoluta proyectada en el mundo externo. Tu camino consiste en encontrar el centro del espejo sagrado, comprendiendo que el verdadero amor no es una pérdida de sí mismo, sino el reencuentro de la chispa divina con su propia fuente.' }, // Luna Oposicion Neptuno

    // Luna - Pluton
    'Moon_con_Pluto': { d: 'Tus emociones son de una intensidad volcánica y posees una voluntad de transformación profunda que nace de tus entrañas. Nada es superficial para ti; vives los afectos y las crisis con una pasión que busca la raíz de las cosas, otorgándote un poder de regeneración emocional indestructible.', g: 'Representas el descenso de la psique al abismo para rescatar el fuego espiritual cautivo. Tu alma se somete a la muerte mística para renacer purificada, indicando que tu camino de gnosis es la alquimia de las emociones: destruir el ego lunar para que el pneuma resurja con una autoridad absoluta.' }, // Luna Conjuncion Pluton
    'Moon_sex_Pluto': { d: 'Existe una armonía poderosa entre tu sensibilidad y tu capacidad para manejar las crisis. Tienes el don de transformar tus sentimientos de forma constructiva, encontrando oportunidades para sanar heridas antiguas y utilizando tu magnetismo emocional para influir positivamente en tu entorno.', g: 'Tu alma sintoniza con las fuerzas de transmutación cósmica de manera natural. Esta conexión te permite utilizar tus emociones como una herramienta de purificación espiritual, facilitando el proceso de redención de la sombra y permitiendo que la luz del espíritu penetre en las capas más profundas de tu ser.' }, // Luna Sextil Pluton
    'Moon_cua_Pluto': { d: 'Vives una tensión extrema entre tu necesidad de seguridad afectiva y fuerzas internas o externas que te obligan a la transformación radical. Esta fricción es un motor de cambio que te obliga a soltar apegos tóxicos, forjando una fortaleza emocional que ha sobrevivido a sus propios infiernos.', g: 'Experimentas el conflicto directo entre el alma y el poder del Arconte de las sombras. Esta crisis es una prueba iniciática: se te exige despojarte de todo control emocional y miedo a la pérdida para que el espíritu pueda liberarse de los lazos kármicos más densos a través de la transmutación consciente.' }, // Luna Cuadratura Pluton
    'Moon_tri_Pluto': { d: 'La capacidad de regeneración y la profundidad emocional fluyen en ti de manera espontánea. Posees una intuición penetrante y un mando natural sobre tus procesos internos, lo que te permite sanar a otros y a ti mismo con una eficacia asombrosa, atrayendo el éxito mediante la intensidad de tu fe.', g: 'Tu alma manifiesta la majestad del espíritu que ha integrado su propia sombra. Gozas de una alineación donde el poder emocional no destruye, sino que purifica, permitiéndote manifestar la voluntad del Absoluto con una fuerza que transmuta el dolor en sabiduría y la materia en luz divina.' }, // Luna Trigono Pluton
    'Moon_opo_Pluto': { d: 'Tu profundidad emocional y tu poder personal se ponen a prueba a través de encuentros intensos con otros que intentan controlarte o transformarte. Aprendes a reconocer tu fuerza al enfrentar la sombra en tus relaciones, integrando tu capacidad de regeneración al equilibrar el poder con la entrega.', g: 'Representas la tensión entre la psique individual y el guardián de los misterios profundos proyectado en el mundo externo. Tu camino consiste en encontrar el centro de la balanza entre la luz y el abismo emocional, comprendiendo que el verdadero poder surge de la unión mística de tus propias polaridades.' }, // Luna Oposicion Pluton
 // Mercurio - Venus
    'Mercury_con_Venus': { d: 'Tu pensamiento y tu palabra están impregnados de belleza y diplomacia. Posees un don para la oratoria persuasiva y encantadora, logrando armonizar ideas y sentimientos con una elegancia natural que facilita los acuerdos y el arte de la mediación.', g: 'Representas la unión del Logos con la Armonía divina. Tu intelecto no solo procesa información, sino que busca la simetría del Pleroma en cada pensamiento, convirtiendo la comunicación en una expresión estética de la verdad espiritual.' }, // Mercurio Conjuncion Venus
    'Mercury_sex_Venus': { d: 'La comunicación y el afecto fluyen con una facilidad creativa. Tienes la habilidad de expresar tus sentimientos con gracia y de encontrar soluciones amables a los conflictos, atrayendo oportunidades a través de tu trato social refinado.', g: 'Tu mente racional sintoniza con las frecuencias de la belleza mística. Esta conexión permite que el conocimiento se transmita con suavidad, facilitando que el alma comprenda las leyes de la armonía cósmica mediante un intelecto dócil a la luz divina.' }, // Mercurio Sextil Venus
    'Mercury_cua_Venus': { d: 'Vives una tensión entre lo que piensas lógicamente y tus deseos de complacer o ser amado. Esta fricción te obliga a trabajar en la honestidad intelectual, aprendiendo a no adornar la verdad solo por mantener una paz superficial en tus relaciones.', g: 'Experimentas el conflicto entre el razonamiento y la seducción de las formas. Esta crisis es una prueba de sinceridad espiritual: se te exige purificar tu palabra de toda vanidad egoica para que la verdad no sea sacrificada en el altar de la aprobación externa.' }, // Mercurio Cuadratura Venus
    'Mercury_tri_Venus': { d: 'La elocuencia y el buen gusto mental fluyen en ti de manera espontánea. Posees un talento innato para las artes, la literatura o cualquier forma de comunicación que requiera equilibrio y tacto, atrayendo el éxito mediante una mente serena y apreciativa.', g: 'Tu intelecto manifiesta la paz de quien ha integrado la inteligencia con el amor puro. Existe en ti una alineación donde el pensamiento se convierte en una danza de formas sagradas, permitiendo que la sabiduría del espíritu se exprese con una naturalidad inefable.' }, // Mercurio Trigono Venus
    'Mercury_opo_Venus': { d: 'Te encuentras a menudo debatiendo entre tu mente analítica y tus preferencias afectivas, buscando el equilibrio en el espejo de los demás. Aprendes a valorar tus ideas al contrastarlas con los valores ajenos, integrando la armonía mediante la comunicación.', g: 'Representas la búsqueda de la síntesis entre el pensamiento individual y la armonía universal. Tu camino consiste en encontrar el punto de unión donde la lógica y la belleza no se contradigan, logrando que el Logos reconozca su reflejo en la armonía del alma.' }, // Mercurio Oposicion Venus

    // Mercurio - Marte
    'Mercury_con_Mars': { d: 'Tu mente es aguda, directa y combativa. Posees una capacidad de respuesta inmediata y una palabra que corta con la precisión de un bisturí, proyectando una inteligencia valiente que no teme defender sus ideas con energía y decisión.', g: 'Representas el Logos en acción guerrera. Tu pensamiento es una espada flamígera dedicada a rasgar el velo de la ignorancia, indicando que tu camino de gnosis requiere el uso de una mente penetrante para combatir las ilusiones del demiurgo y conquistar la claridad.' }, // Mercurio Conjuncion Marte
    'Mercury_sex_Mars': { d: 'Existe una armonía dinámica entre tu pensamiento y tu capacidad de ejecución. Tienes el don de planificar con estrategia y actuar con rapidez, encontrando siempre la palabra justa para motivar o la idea precisa para resolver problemas técnicos con eficacia.', g: 'Tu intelecto utiliza la fuerza marcial como un motor de avance consciente. Esta conexión te permite aplicar el conocimiento con un coraje espiritual que facilita la superación de obstáculos mentales, convirtiendo la inteligencia en una herramienta de liberación activa.' }, // Mercurio Sextil Marte
    'Mercury_cua_Mars': { d: 'Vives una tensión constante que inclina tu mente hacia la irritabilidad o la competitividad intelectual. Esta fricción te obliga a dominar tu lengua y a canalizar tu agresividad mental hacia el análisis profundo, forjando una inteligencia resiliente y aguda.', g: 'Experimentas la lucha entre la lógica lineal y el impulso del deseo. Esta crisis es una prueba de control mental alquímico: se te exige transmutar la impulsividad de la palabra en la fuerza de la voluntad consciente, evitando que la luz del Logos se disperse en disputas banales.' }, // Mercurio Cuadratura Marte
    'Mercury_tri_Mars': { d: 'La agilidad mental y el coraje intelectual fluyen en ti de manera poderosa. Posees una capacidad innata para el liderazgo de ideas y una elocuencia vigorosa que convence sin esfuerzo, permitiéndote alcanzar tus metas mediante un pensamiento decidido y constructivo.', g: 'Tu mente manifiesta la nobleza de la voluntad espiritual dirigida por la inteligencia. Gozas de una alineación donde la palabra es poder y la idea es acción, permitiéndote manifestar el propósito divino con una autoridad mental que ordena el caos y protege la verdad.' }, // Mercurio Trigono Marte
    'Mercury_opo_Mars': { d: 'Tu pensamiento se pone a prueba a través del debate y la confrontación con los demás. Aprendes a equilibrar tu agresividad verbal al observar la reacción de tu entorno, integrando tu capacidad de análisis al reconocer que la verdadera victoria intelectual es la síntesis.', g: 'Representas la tensión entre la mente proyectiva y la resistencia del mundo. Tu camino consiste en encontrar el centro donde la palabra no sea agresión, sino una fuerza de equilibrio que permita al espíritu dominar la dualidad mediante un diálogo consciente y firme.' }, // Mercurio Oposicion Marte

    // Mercurio - Jupiter
    'Mercury_con_Jupiter': { d: 'Tu mente es un océano de grandes ideas, optimismo y búsqueda de sabiduría. Posees una elocuencia expansiva y un deseo insaciable de conocimiento, proyectando una inteligencia generosa que busca constantemente el sentido profundo y las leyes generales de la vida.', g: 'Representas la unión del Logos con la Gracia expansiva. Tu pensamiento está sintonizado con la mente universal, indicando que tu camino de despertar es la integración de la sabiduría oculta, donde cada proceso intelectual se convierte en un peldaño hacia la comprensión del Pleroma.' }, // Mercurio Conjuncion Jupiter
    'Mercury_sex_Jupiter': { d: 'La vida te ofrece oportunidades fluidas para expandir tus conocimientos y comunicarte con éxito. Tienes la habilidad de ver el panorama completo y de integrar lecciones filosóficas en tu razonamiento cotidiano, lo que atrae apoyo y facilita el aprendizaje.', g: 'Tu intelecto resuena armoniosamente con las leyes de la providencia espiritual. Esta conexión facilita la captación de verdades elevadas sin esfuerzo, utilizando la mente como un campo fértil donde la semilla de la gnosis puede crecer y multiplicarse a través del estudio y la enseñanza.' }, // Mercurio Sextil Jupiter
    'Mercury_cua_Jupiter': { d: 'Vives una tensión entre el detalle minucioso y la visión exagerada, lo que puede llevarte a juicios apresurados. Esta fricción te obliga a trabajar en la precisión de tus ideas, aprendiendo a no perderte en grandes promesas o teorías sin una base real y consciente.', g: 'Experimentas el conflicto entre el razonamiento limitado y la sed de infinito. Esta crisis es una prueba de discernimiento: se te exige purificar tu pensamiento de la soberbia intelectual para que la luz de la verdad no se desvanezca en la arrogancia de creer que la mente puede abarcarlo todo.' }, // Mercurio Cuadratura Jupiter
    'Mercury_tri_Jupiter': { d: 'La sabiduría y la elocuencia fluyen en ti de manera espontánea, otorgándote una mente visionaria y una gran capacidad pedagógica. Atraes el éxito mediante tus palabras y tus viajes mentales, viviendo con una plenitud intelectual que inspira a otros a buscar su propia verdad.', g: 'Tu mente manifiesta la serenidad de quien comprende el orden sagrado del cosmos. Existe en ti una alineación con la inteligencia divina que te permite comunicar misterios con claridad, convirtiendo tu palabra en un faro de esperanza y conocimiento para los buscadores de la luz.' }, // Mercurio Trigono Jupiter
    'Mercury_opo_Jupiter': { d: 'Tu búsqueda de conocimiento se refleja en el intercambio con los demás, oscilando entre el detalle práctico y la teoría filosófica. Aprendes a equilibrar tu verdad con las opiniones ajenas, integrando tu visión al comprender que la sabiduría nace del diálogo y la moderación.', g: 'Representas la tensión entre la mente individual y la sabiduría universal. Tu camino consiste en encontrar el punto de equilibrio donde la lógica no niegue la fe, reconociendo que el verdadero conocimiento es una síntesis mística que trasciende la letra para llegar al espíritu.' }, // Mercurio Oposicion Jupiter

    // Mercurio - Saturno
    'Mercury_con_Saturn': { d: 'Tu mente es disciplinada, estructurada y posee una profundidad analítica excepcional. Prefieres el silencio reflexivo a la palabra vana, proyectando una inteligencia seria y responsable que se toma el tiempo necesario para construir pensamientos sólidos y duraderos.', g: 'Representas el Logos sometido a la Ley del Rigor. Tu intelecto se concentra para dominar la materia a través del conocimiento, indicando que tu camino de gnosis es la maestría mental: el espíritu que utiliza el orden y la disciplina para desmantelar las trampas del error demiúrgico.' }, // Mercurio Conjuncion Saturno
    'Mercury_sex_Saturn': { d: 'Existe una comunicación fluida entre tu creatividad mental y tu capacidad de organización. Tienes el don de dar forma práctica a tus ideas, encontrando oportunidades para consolidar tu conocimiento de manera estructurada y ganándote el respeto por tu sensatez.', g: 'Tu intelecto utiliza la ley del orden como una herramienta de protección espiritual. Esta conexión te permite integrar el conocimiento sagrado con paciencia, utilizando la mente disciplinada como un vehículo que facilita la cristalización de las verdades del pneuma en la realidad tangible.' }, // Mercurio Sextil Saturno
    'Mercury_cua_Saturn': { d: 'Vives una tensión constante entre tu deseo de expresión y una autocrítica o rigidez mental severa. Esta fricción te obliga a desarrollar una precisión milimétrica en tus juicios, forjando una inteligencia resiliente que aprende a través del esfuerzo y la superación del pesimismo.', g: 'Experimentas el conflicto entre la luz de la idea y la inercia de la estructura limitante. Esta crisis es una prueba de templanza mental: se te exige despojarte de toda duda existencial para encontrar la autoridad espiritual que surge cuando la mente se alinea con la verdad inmutable del ser.' }, // Mercurio Cuadratura Saturno
    'Mercury_tri_Saturn': { d: 'La estabilidad y el sentido común fluyen en tu razonamiento de manera natural. Posees una habilidad innata para el estudio profundo y la gestión de la realidad, logrando que tu palabra sea sinónimo de integridad y que tus planes tengan siempre un cimiento indestructible.', g: 'Tu mente manifiesta la paz de quien ha comprendido el propósito de la ley y el tiempo. Gozas de una alineación donde el pensamiento no se dispersa, sino que se concentra en lo esencial, permitiéndote comunicar la sabiduría del espíritu con una seriedad sagrada que ordena el entorno.' }, // Mercurio Trigono Saturno
    'Mercury_opo_Saturn': { d: 'Tu capacidad intelectual se pone a prueba a través del juicio de los demás o de obstáculos externos que limitan tu expresión. Aprendes a valorar tus ideas al enfrentar la realidad, integrando tu propia estructura mental al equilibrar tu visión con la responsabilidad social.', g: 'Representas la tensión entre el Logos y el Guardián del Umbral. Tu camino consiste en encontrar el equilibrio entre la libertad de pensamiento y el peso de la ley, comprendiendo que el verdadero maestro no es el que impone reglas, sino el que libera la mente mediante la disciplina consciente.' }, // Mercurio Oposicion Saturno

    // Mercurio - Urano
    'Mercury_con_Uranus': { d: 'Tu mente es un rayo de originalidad, genio e independencia. Posees una velocidad de pensamiento asombrosa y una tendencia a la ruptura de esquemas tradicionales, proyectando una inteligencia eléctrica que siempre va un paso por delante de su tiempo y de las convenciones.', g: 'Representas la irrupción de la inteligencia estelar en el Logos humano. Tu mente se activa mediante el despertar súbito, indicando que tu camino es la liberación mental: el espíritu que utiliza la intuición instantánea para romper los programas de control de la mente colmena demiúrgica.' }, // Mercurio Conjuncion Urano
    'Mercury_sex_Uranus': { d: 'La vida te ofrece oportunidades constantes para renovar tus ideas y abrazar tecnologías o conceptos vanguardistas. Tienes la habilidad de integrar el cambio con ingenio, encontrando siempre formas originales de comunicar tu verdad que resultan estimulantes y renovadoras.', g: 'Tu intelecto sintoniza con las frecuencias de la liberación de manera armoniosa. Esta conexión te permite captar destellos de verdad trascendente que facilitan el proceso de despertar, utilizando la mente como un radar para detectar las grietas en la matriz y comunicar la libertad.' }, // Mercurio Sextil Urano
    'Mercury_cua_Uranus': { d: 'Vives una tensión constante entre la lógica convencional y un impulso de rebelión intelectual que te lleva a la excentricidad. Esta fricción te obliga a desarrollar una autenticidad mental extrema, forjando una inteligencia que no teme al caos con tal de ser fiel a su propia luz.', g: 'Experimentas el conflicto entre el razonamiento lineal y el rayo de la liberación disruptiva. Esta crisis es una prueba de desapego intelectual: se te exige romper con la necesidad de coherencia externa para que el Logos pueda respirar en la libertad del espíritu puro, más allá de la razón.' }, // Mercurio Cuadratura Urano
    'Mercury_tri_Uranus': { d: 'La genialidad y la intuición fluyen en tu razonamiento de manera espontánea, otorgándote una visión de futuro clara y una gran agilidad para resolver problemas complejos. Tu carácter innovador atrae situaciones donde tu diferencia es celebrada y tu palabra inspira revolución.', g: 'Tu mente manifiesta la frecuencia de las esferas superiores con una naturalidad asombrosa. Existe en ti una alineación con la verdad visionaria que te permite comunicar misterios con una claridad revolucionaria, manifestando la sabiduría que fluye sin esfuerzo desde el centro místico del pneuma.' }, // Mercurio Trigono Urano
    'Mercury_opo_Uranus': { d: 'Tu necesidad de independencia mental se pone a prueba a través del debate con otros que desafían tus ideas más radicales. Aprendes a reconocer tu propio genio al observar la excentricidad ajena, integrando tu originalidad al equilibrar tu comunicación con el impacto social.', g: 'Representas la tensión entre la mente individual y la libertad absoluta proyectada en el mundo. Tu camino consiste en encontrar el centro del relámpago, comprendiendo que la verdadera revolución intelectual es la que recuperas al dejar de buscar validación en las mentes condicionadas.' }, // Mercurio Oposicion Urano

    // Mercurio - Neptuno
    'Mercury_con_Neptune': { d: 'Tu mente es un canal para la imaginación, la poesía y la percepción extrasensorial. Posees una inteligencia sutil que no se guía por la lógica dura, sino por la intuición y el sentimiento, proyectando una palabra inspirada que puede sanar o evocar mundos invisibles con gran belleza.', g: 'Representas la inmersión del Logos en las aguas de la mística. Tu pensamiento ha traspasado el velo de Maya para buscar la verdad en el silencio, indicando que tu camino de gnosis es la palabra inspirada: convertir el intelecto en un espejo para la luz inefable del Pleroma mediante la entrega espiritual.' }, // Mercurio Conjuncion Neptuno
    'Mercury_sex_Neptune': { d: 'Existe una armonía sutil entre tu razonamiento y tu intuición. Tienes la facilidad de expresar conceptos espirituales o artísticos con claridad, encontrando en la creatividad un refugio natural que te permite comprender la realidad desde una perspectiva más elevada y compasiva.', g: 'Tu intelecto sintoniza con las frecuencias del amor divino de forma fluida. Esta conexión permite que la mente capte las vibraciones superiores de la creación, utilizando la palabra como un instrumento de consuelo que facilita el despertar de la conciencia a través del lenguaje simbólico y místico.' }, // Mercurio Sextil Neptuno
    'Mercury_cua_Neptune': { d: 'Vives una tensión entre la necesidad de precisión y una tendencia a la confusión o al autoengaño mental. Esta fricción te obliga a desarrollar un discernimiento sagrado, aprendiendo a diferenciar la verdadera inspiración espiritual de los ruidos y espejismos del plano astral.', g: 'Experimentas el conflicto entre el Logos puro y los velos engañosos de la ilusión neptuniana. Esta crisis es una prueba de transparencia mental: se te exige purificar tu pensamiento para no ser arrastrado por las fantasías del demiurgo, buscando la verdad que reside más allá de los sueños del ego.' }, // Mercurio Cuadratura Neptuno
    'Mercury_tri_Neptune': { d: 'La inspiración y la visión espiritual fluyen en tu mente de manera espontánea, otorgándote una elocuencia suave y una gran capacidad para la comprensión psíquica. Tu naturaleza idealista atrae conocimientos que nutren el alma, permitiéndote comunicar la paz con una naturalidad mágica.', g: 'Tu mente manifiesta la serenidad de quien ha integrado la inteligencia con el océano de la luz. Existe en ti una alineación con la sabiduría inefable que te permite transitar la densidad con una comprensión mística, convirtiendo tu palabra en un reflejo de la armonía que redime a la materia.' }, // Mercurio Trigono Neptuno
    'Mercury_opo_Neptune': { d: 'Tu pensamiento y tu búsqueda de trascendencia se reflejan en tus conversaciones, donde a menudo proyectas tus sueños o sufres por malentendidos. Aprendes a valorarte al descubrir que la verdad y la claridad que buscas afuera residen en el silencio de tu propio templo interior.', g: 'Representas la tensión entre la mente individual y la disolución absoluta proyectada en el mundo externo. Tu camino consiste en encontrar el centro del espejo sagrado, comprendiendo que el verdadero conocimiento no es acumular datos, sino el reconocimiento del espíritu en medio de la ilusión.' }, // Mercurio Oposicion Neptuno

    // Mercurio - Pluton
    'Mercury_con_Pluto': { d: 'Tu mente es un escáner poderoso, profundo y obsesionado con la verdad absoluta. Posees una palabra magnética y penetrante que busca desentrañar los secretos más ocultos, proyectando una inteligencia que no se detiene ante nada hasta llegar a la raíz de cada situación.', g: 'Representas el Logos descendiendo al Hades para rescatar el fuego de la sabiduría. Tu pensamiento se somete a la alquimia de la destrucción de las formas mentales falsas, indicando que tu camino de gnosis es la palabra de poder: destruir el engaño para que la luz del espíritu real resurja con autoridad.' }, // Mercurio Conjuncion Pluton
    'Mercury_sex_Pluto': { d: 'Existe una armonía poderosa entre tu capacidad analítica y tu habilidad para manejar el poder oculto de la información. Tienes el don de transformar tu realidad mediante una comunicación estratégica, encontrando siempre la clave para influir positivamente en las estructuras que te rodean.', g: 'Tu intelecto sintoniza con las fuerzas de transmutación cósmica de manera natural. Esta conexión te permite utilizar la mente como una herramienta de purificación espiritual, facilitando el proceso de despojo de las sombras mentales y permitiendo que la luz penetre en lo más denso de la psique.' }, // Mercurio Sextil Pluton
    'Mercury_cua_Pluto': { d: 'Vives una tensión extrema entre tu necesidad de control mental y verdades que te obligan a la transformación radical de tus ideas. Esta fricción es un motor de búsqueda incansable que te obliga a soltar prejuicios, forjando una inteligencia indestructible curtida en la crisis.', g: 'Experimentas el conflicto directo entre el Logos y el poder del Arconte de las sombras. Esta crisis es una prueba de fuego iniciática: se te exige despojarte de toda manipulación mental y miedo a la verdad cruda para que el espíritu pueda liberarse de los lazos kármicos de la mente a través de la gnosis.' }, // Mercurio Cuadratura Pluton
    'Mercury_tri_Pluto': { d: 'La capacidad de regeneración mental y la profundidad de juicio fluyen en ti de manera espontánea. Posees una intuición psicológica penetrante y una elocuencia que transforma, logrando éxito mediante una voluntad intelectual que sabe cuándo y cómo actuar sobre la raíz del problema.', g: 'Tu mente manifiesta la majestad del espíritu que ha integrado su propia sombra cognitiva. Gozas de una alineación donde el conocimiento no es dato, sino poder sanador, permitiéndote comunicar la voluntad del Absoluto con una fuerza que transmuta el error en verdad y la duda en certeza divina.' }, // Mercurio Trigono Pluton
    'Mercury_opo_Pluto': { d: 'Tu profundidad mental y tu palabra se ponen a prueba a través de encuentros con otros que intentan silenciarte o controlarte. Aprendes a reconocer tu propia fuerza intelectual al enfrentar la sombra en el debate, integrando tu capacidad de análisis al equilibrar la verdad con la entrega.', g: 'Representas la tensión entre la mente individual y el guardián de los misterios profundos proyectado en el mundo externo. Tu camino consiste en encontrar el centro de la balanza entre la luz y el abismo del pensamiento, comprendiendo que el verdadero poder mental es la unión de tus propias polaridades.' }, // Mercurio Oposicion Pluton

    // Venus - Marte
    'Venus_con_Mars': { d: 'La pasión y el deseo se funden en ti, creando una naturaleza ardiente y un carisma irresistible que busca la conquista afectiva. Expresas tus sentimientos con una fuerza directa, unificando la ternura con la acción impulsiva para materializar tus anhelos de forma vibrante y decidida.', g: 'Encarnas la unión alquímica del Azufre y el Mercurio en el crisol del corazón. Esta conjunción representa el matrimonio de las polaridades que permite al espíritu manifestar su voluntad creativa a través del amor activo, equilibrando la fuerza y la gracia en un solo acto de voluntad divina.' }, // Venus Conjuncion Marte
    'Venus_sex_Mars': { d: 'Cuentas con una armonía envidiable entre tu capacidad de seducción y tu iniciativa personal, facilitando que tus relaciones sean dinámicas y equilibradas. Encuentras oportunidades constantes para disfrutar de la vida de manera activa, integrando el placer con el esfuerzo constructivo sin fricciones.', g: 'La energía de tus deseos fluye en consonancia con la ley del equilibrio cósmico. Esta conexión te permite utilizar la fuerza marcial para proteger y elevar la belleza de tu alma, facilitando una evolución donde la acción se convierte en un rito sagrado que honra la armonía del Pleroma.' }, // Venus Sextil Marte
    'Venus_cua_Mars': { d: 'Sientes una tensión interna entre tu necesidad de paz y tus impulsos competitivos, lo que a menudo genera chispas en tus vínculos más cercanos. Esta fricción actúa como un motor que te obliga a madurar tus deseos, aprendiendo a equilibrar la autoafirmación con la capacidad de ceder por amor.', g: 'Vives el combate iniciático entre la atracción de las formas y la fuerza del impulso vital. Esta crisis es una oportunidad para transmutar la pasión ciega en una voluntad consciente, evitando que la luz del espíritu se agote en los conflictos del deseo demiúrgico y se enfoque en la Gran Obra.' }, // Venus Cuadratura Marte
    'Venus_tri_Mars': { d: 'El magnetismo y la vitalidad fluyen en tu vida con una naturalidad asombrosa, otorgándote un talento especial para las artes y la conquista amorosa. Tus intenciones y tus acciones se alinean espontáneamente, permitiéndote atraer lo que deseas con una gracia que es, a la vez, poderosa y serena.', g: 'Tu ser manifiesta la danza armoniosa de las energías creadoras del universo. Gozas de una alineación donde la belleza inspira a la fuerza y la fuerza sirve a la belleza, permitiendo que el pneuma actúe en el mundo con una nobleza que refleja el orden perfecto de las esferas superiores.' }, // Venus Trigono Marte
    'Venus_opo_Mars': { d: 'Te encuentras constantemente buscando el equilibrio entre tu sensibilidad y la agresividad de tu entorno, proyectando tus deseos en el otro. Aprendes a conocer tu propia fuerza a través de la pasión compartida o la rivalidad, integrando tu capacidad de amar al aceptar la dualidad de la fuerza.', g: 'Representas la balanza mística entre el amor y la guerra. Tu camino consiste en encontrar el punto central donde los opuestos se reconcilian, comprendiendo que el adversario externo es solo un reflejo de tu propia necesidad de integrar la fuerza ejecutiva con la receptividad del alma.' }, // Venus Oposicion Marte

    // Venus - Jupiter
    'Venus_con_Jupiter': { d: 'Posees un corazón expansivo y una generosidad que te otorga una suerte natural en el afecto y la prosperidad material. Tu identidad se nutre de la alegría y la fe, proyectando un encanto que atrae la abundancia y una visión optimista que embellece cualquier situación que atraviesas.', g: 'Representas la manifestación de la Gracia infinita en la sustancia del alma. Tu espíritu se deleita en la magnificencia del Absoluto, indicando que tu camino es el de la "Vía Real": el reconocimiento de la belleza divina como un estado de conciencia que nos libera de la escasez del mundo material.' }, // Venus Conjuncion Jupiter
    'Venus_sex_Jupiter': { d: 'La vida te brinda facilidades para expandir tus horizontes afectivos y disfrutar de una armonía social que apoya tu crecimiento. Integrar el conocimiento y el placer te resulta sencillo, encontrando siempre el apoyo necesario para que tus proyectos creativos florezcan con éxito.', g: 'Tu alma resuena con las frecuencias de la providencia y la justicia celestial. Esta conexión facilita la captación de los misterios del amor sagrado, permitiendo que tu evolución sea un proceso de expansión jubilosa donde el bienestar es visto como un reflejo de la armonía espiritual.' }, // Venus Sextil Jupiter
    'Venus_cua_Jupiter': { d: 'Te enfrentas al desafío de moderar tus excesos y tus expectativas afectivas, pues tu deseo de expansión a veces supera tus límites reales. Esta tensión te impulsa a buscar valores más sólidos, aprendiendo que la verdadera satisfacción no depende de la cantidad, sino de la profundidad del ser.', g: 'Experimentas el conflicto entre el goce de los sentidos y la inmensidad del espíritu. Esta crisis es una prueba de templanza ética: se te exige purificar tu deseo de la exageración para que la luz de la sabiduría no se diluya en la búsqueda de placeres transitorios o promesas ilusorias.' }, // Venus Cuadratura Jupiter
    'Venus_tri_Jupiter': { d: 'Fluyes con una suerte y una elegancia natural que te abren todas las puertas del bienestar y la gratitud. Tu carácter noble y jovial inspira confianza, permitiéndote disfrutar de la vida con una plenitud que parece bendecida por una protección invisible que favorece tus vínculos.', g: 'Tu alma manifiesta la serenidad de quien habita en la abundancia del Pleroma. Existe en ti una alineación con la generosidad divina que te permite atraer la belleza sin esfuerzo, convirtiendo tu existencia en un testimonio de la paz y la opulencia que aguardan a los espíritus alineados.' }, // Venus Trigono Jupiter
    'Venus_opo_Jupiter': { d: 'Buscas la plenitud a través del otro, oscilando a menudo entre la entrega total y la necesidad de libertad personal. Aprendes a equilibrar tu visión del amor con la realidad, integrando tu crecimiento al reconocer que la verdadera fortuna es la armonía que cultivas en tu interior.', g: 'Representas la tensión entre el deseo individual y la ley universal de la expansión amorosa. Tu camino consiste en encontrar el centro donde la fe y el afecto no se conviertan en derroche, comprendiendo que el amor verdadero es una síntesis mística que no conoce la carencia ni la dependencia.' }, // Venus Oposicion Jupiter

    // Venus - Saturno
    'Venus_con_Saturn': { d: 'Tu forma de amar es seria, estructurada y basada en el compromiso a largo plazo y la lealtad inquebrantable. Posees un sentido del valor muy definido y realista, proyectando una elegancia austera que prefiere la calidad y la permanencia sobre lo efímero o superficial.', g: 'Representas la belleza sometida a la cristalización del Rigor. Tu alma acepta la disciplina de la forma para purificar sus deseos, indicando que tu camino de gnosis es la maestría sobre el apego: convertir el amor en una estructura sólida capaz de resistir las pruebas del tiempo demiúrgico.' }, // Venus Conjuncion Saturno
    'Venus_sex_Saturn': { d: 'Dispones de una habilidad natural para consolidar tus relaciones y tus finanzas con paciencia y sentido práctico. Encuentras oportunidades para dar forma a tus talentos creativos de manera duradera, logrando un equilibrio entre el disfrute de la vida y tus responsabilidades sociales.', g: 'Tu conciencia utiliza la ley del orden para proteger la pureza de tus afectos. Esta conexión facilita que las virtudes del espíritu se manifiesten en la materia con estabilidad, permitiendo que tu evolución emocional sea un proceso de construcción consciente bajo las leyes de la justicia divina.' }, // Venus Sextil Saturno
    'Venus_cua_Saturn': { d: 'Vives una fricción entre tus deseos de afecto y una sensación de rechazo o limitación que te obliga a madurar a la fuerza. Esta tensión forja un carácter resiliente que aprende a valorarse a sí mismo por encima de las carencias externas, logrando una integridad afectiva a través del esfuerzo.', g: 'Experimentas el combate entre el anhelo de armonía del alma y la frialdad de la materia limitante. Esta crisis es una prueba de fuego alquímico: se te exige despojarte de la necesidad de consuelo para encontrar la belleza inmutable que surge cuando el ego se rinde ante el rigor del espíritu.' }, // Venus Cuadratura Saturno
    'Venus_tri_Saturn': { d: 'La estabilidad y la fidelidad fluyen en tus vínculos de manera espontánea, otorgándote una reputación de dignidad y buen juicio. Posees un talento innato para las artes clásicas y la gestión del valor, logrando que tu vida sea un ejemplo de armonía basada en principios sólidos.', g: 'Tu alma manifiesta la paz de quien ha integrado la gracia con la ley. Gozas de una alineación donde el tiempo fortalece el amor en lugar de desgastarlo, permitiéndote manifestar la belleza del espíritu con una seriedad sagrada que ordena tu mundo interno y redime tus deseos.' }, // Venus Trigono Saturno
    'Venus_opo_Saturn': { d: 'Tus necesidades afectivas a menudo chocan con obstáculos externos o personas que imponen límites estrictos a tu expresión. Aprendes a consolidar tu amor propio al enfrentar la frialdad del mundo, integrando tu capacidad de valorar al equilibrar el deseo con la responsabilidad.', g: 'Representas la balanza entre la sensibilidad del alma y el Guardián del Umbral. Tu camino consiste en encontrar el equilibrio entre la calidez del corazón y el frío de la ley, comprendiendo que el verdadero compromiso es aquel que te libera de las ilusiones externas para servir solo a la luz interior.' }, // Venus Oposicion Saturno

    // Venus - Urano
    'Venus_con_Uranus': { d: 'Expresas tu afectividad de una manera única, rebelde y profundamente original, rompiendo con todas las convenciones sociales. Tu magnetismo es eléctrico e impredecible, atrayendo experiencias amorosas y artísticas vanguardistas que buscan la libertad absoluta por encima de la seguridad.', g: 'Representas la irrupción de la belleza estelar en el plano de los deseos. Tu alma se libera de los lazos del apego convencional mediante el rayo de la intuición, indicando que tu camino es la revolución del corazón: despertar a la conciencia de que el amor es una fuerza de liberación radical.' }, // Venus Conjuncion Urano
    'Venus_sex_Uranus': { d: 'La vida te ofrece oportunidades fluidas para renovar tus relaciones y tus fuentes de placer con ingenio y creatividad. Tienes el don de integrar lo nuevo y lo diferente en tus vínculos, encontrando siempre formas estimulantes de expresar tu afecto sin perder tu independencia.', g: 'Tu sensibilidad sintoniza armoniosamente con las frecuencias de la liberación cósmica. Esta conexión te permite percibir la belleza en lo inusual, utilizando la intuición como un radar sagrado que facilita el desapego de las formas obsoletas del deseo para abrazar la libertad del espíritu.' }, // Venus Sextil Urano
    'Venus_cua_Uranus': { d: 'Sientes una tensión constante entre tu deseo de compañía y un impulso de libertad que te lleva a romper vínculos de forma inesperada. Esta fricción te obliga a desarrollar una autenticidad extrema en el amor, aprendiendo a no sacrificar tu individualidad por una paz que te asfixia.', g: 'Vives el conflicto entre la seducción de la armonía formal y el rayo de la ruptura disruptiva. Esta crisis es una prueba de desprendimiento total: se te exige soltar la necesidad de seguridad afectiva para que el alma pueda vibrar en la frecuencia de la libertad divina, fuera de la matriz.' }, // Venus Cuadratura Urano
    'Venus_tri_Uranus': { d: 'La originalidad y el encanto fluyen en tu vida de manera espontánea, otorgándote una visión artística avanzada y una gran capacidad de desapego. Atraes situaciones afortunadas donde tu diferencia es valorada, permitiéndote amar con una frescura que inspira a otros a ser libres.', g: 'Tu alma manifiesta la elegancia de las esferas superiores con una naturalidad asombrosa. Existe en ti una alineación con la verdad visionaria que te permite vivir el placer y el afecto como una meditación sobre la libertad, manifestando una armonía que fluye directamente desde el centro místico del pneuma.' }, // Venus Trigono Urano
    'Venus_opo_Uranus': { d: 'Tu búsqueda de armonía se pone a prueba a través de relaciones con personas impredecibles que desafían tus conceptos del amor. Aprendes a reconocer tu propia genialidad afectiva al observar la rebeldía en los demás, integrando tu libertad al equilibrar la unión con el cambio.', g: 'Representas la tensión entre la identidad amorosa y la libertad absoluta proyectada en el espejo del mundo. Tu camino consiste en encontrar el centro del relámpago místico, comprendiendo que el verdadero encuentro no es la posesión, sino la danza libre de dos chispas divinas que se reconocen.' }, // Venus Oposicion Urano

    // Venus - Neptuno
    'Venus_con_Neptune': { d: 'Tu naturaleza amorosa es poética, compasiva y se funde con los ideales más elevados de la belleza universal. Posees una imaginación artística desbordante y una entrega mística en tus afectos, proyectando una sensibilidad que parece sacada de un sueño y que busca la unión total.', g: 'Representas la disolución del deseo en el océano del Amor Divino. Tu alma busca retornar al origen a través de la belleza inefable, indicando que tu camino de gnosis es la devoción mística: convertir tus sentimientos en un canal puro para que la luz del Pleroma sane y redima la materia.' }, // Venus Conjuncion Neptuno
    'Venus_sex_Neptune': { d: 'Existe una armonía sutil entre tus deseos y tu intuición espiritual, facilitando una vida afectiva llena de momentos mágicos y sanadores. Tienes el don de percibir la bondad en los demás y de expresar tu creatividad con una suavidad que eleva la frecuencia de tu entorno.', g: 'Tu sensibilidad sintoniza con las vibraciones del amor incondicional de forma fluida. Esta conexión te permite captar la armonía oculta en la creación, utilizando el arte y el afecto como instrumentos de redención espiritual que facilitan el despertar de la conciencia a través de la gracia divina.' }, // Venus Sextil Neptuno
    'Venus_cua_Neptune': { d: 'Vives una tensión entre tu anhelo de un amor perfecto y la desilusión que provocan las debilidades humanas. Esta fricción te obliga a desarrollar un discernimiento sagrado, aprendiendo a amar la esencia espiritual del otro sin perderte en los espejismos de tu propia idealización.', g: 'Experimentas el conflicto entre el alma pura y los velos engañosos del plano astral. Esta crisis es una prueba de transparencia mística: se te exige purificar tus afectos de toda fantasía egoica para encontrar el verdadero Amor que reside más allá de las ilusiones y decepciones de la matriz.' }, // Venus Cuadratura Neptuno
    'Venus_tri_Neptune': { d: 'La inspiración estética y la paz emocional fluyen en ti de manera espontánea, otorgándote un carisma casi angelical y una gran capacidad de perdón. Atraes circunstancias de una belleza sobrenatural donde tu entrega es recompensada, permitiéndote vivir con una devoción que disuelve el ego.', g: 'Tu alma manifiesta la serenidad de quien ha encontrado el Paraíso dentro de sí mismo. Existe en ti una alineación con la armonía inefable que te permite transitar la densidad con una pureza inalterable, convirtiendo tus deseos en un reflejo del amor infinito que redime y libera a los espíritus.' }, // Venus Trigono Neptuno
    'Venus_opo_Neptune': { d: 'Tu búsqueda del amor ideal se proyecta constantemente en los demás, enfrentándote a menudo a la confusión o al sacrificio personal. Aprendes a valorarte al descubrir que la belleza y la salvación que buscas en tu pareja residen en la profundidad de tu propio templo espiritual.', g: 'Representas la tensión entre la sed de unión del alma y la disolución absoluta proyectada en el espejo del mundo. Tu camino consiste en encontrar el centro del espejo sagrado, comprendiendo que el verdadero amor no es una pérdida de identidad, sino el reencuentro de tu chispa divina con su propia fuente.' }, // Venus Oposicion Neptuno

    // Venus - Pluton
    'Venus_con_Pluto': { d: 'Tu afectividad es de una intensidad abrumadora, marcada por una pasión que exige transformación total y una entrega absoluta. Posees un magnetismo irresistible y una voluntad de hierro en el amor, buscando penetrar en las profundidades de tus vínculos para renacer a través de ellos.', g: 'Representas la unión de la Belleza con el Fuego Transformador del abismo. Tu alma se somete a la muerte mística del deseo para que el Amor real resurja purificado, indicando que tu camino es la alquimia del corazón: destruir el ego afectivo para que el pneuma gobierne con un poder soberano.' }, // Venus Conjuncion Pluton
    'Venus_sex_Pluto': { d: 'Dispones de una armonía poderosa entre tu capacidad de amar y tu habilidad para regenerar tus relaciones. Tienes el don de transformar situaciones afectivas difíciles en oportunidades de crecimiento, utilizando tu magnetismo para influir y sanar profundamente tu entorno cercano.', g: 'Tu sensibilidad sintoniza con las fuerzas de transmutación cósmica de manera natural. Esta conexión te permite utilizar el afecto como una herramienta de purificación espiritual, facilitando el despojo de las sombras del alma y permitiendo que la luz del espíritu penetre en lo más denso del deseo.' }, // Venus Sextil Pluton
    'Venus_cua_Pluto': { d: 'Vives una tensión extrema entre tu necesidad de armonía y crisis emocionales que te obligan a la transformación radical. Esta fricción es un motor de búsqueda que te obliga a soltar apegos tóxicos y juegos de poder, forjando un carácter indestructible que se valora por su esencia.', g: 'Experimentas el conflicto directo entre la sustancia del alma y el Arconte del poder y las sombras. Esta crisis es una prueba iniciática: se te exige despojarte de toda manipulación y miedo a la pérdida para que el espíritu pueda liberarse de los lazos kármicos del deseo a través de la transmutación.' }, // Venus Cuadratura Pluton
    'Venus_tri_Pluto': { d: 'La capacidad de regeneración amorosa y el poder de atracción fluyen en ti de manera espontánea. Posees una comprensión profunda de la psicología del otro y una autoridad afectiva que transforma, logrando éxito mediante una voluntad que sabe sanar y elevar lo que ama con fuerza.', g: 'Tu alma manifiesta la majestad del espíritu que ha integrado su sombra afectiva. Gozas de una alineación donde el amor no esclaviza, sino que libera, permitiéndote manifestar la voluntad del Absoluto con una fuerza que transmuta el deseo en sabiduría y la atracción en luz divina inmarcesible.' }, // Venus Trigono Pluton
    'Venus_opo_Pluto': { d: 'Tu poder personal y tus relaciones se ponen a prueba a través de encuentros intensos con otros que intentan dominarte emocionalmente. Aprendes a reconocer tu propio valor al enfrentar la sombra en el vínculo, integrando tu fuerza al equilibrar la entrega con la soberanía propia.', g: 'Representas la balanza entre la armonía del alma y el guardián de los misterios profundos proyectado en el mundo externo. Tu camino consiste en encontrar el centro entre la luz y el abismo del deseo, comprendiendo que el verdadero poder es la unión mística de tus propias polaridades internas.' }, // Venus Oposicion Pluton
    // Marte - Jupiter
    'Mars_con_Jupiter': { d: 'Tu capacidad de acción está impulsada por un optimismo inagotable y un gran espíritu de conquista. Posees una energía expansiva que te lleva a emprender grandes proyectos con una confianza total, proyectando una personalidad audaz que no teme arriesgarse para alcanzar metas elevadas y crecimiento personal.', g: 'Encarnas la fuerza del Guerrero que lucha por la Justicia Divina. Tu voluntad está alineada con la abundancia del espíritu, indicando que tu camino de gnosis es la acción expansiva: utilizar tu potencia vital como un vehículo para manifestar la victoria del Pleroma sobre la limitación material.' }, // Marte Conjuncion Jupiter
    'Mars_sex_Jupiter': { d: 'Cuentas con una facilidad natural para canalizar tu fuerza de manera constructiva y afortunada. Tienes el don de encontrar el momento oportuno para actuar, logrando que tus esfuerzos se traduzcan en crecimiento y éxito gracias a una visión amplia y una actitud valiente pero equilibrada.', g: 'La energía de tu voluntad resuena con las leyes de la providencia de forma fluida. Esta conexión te permite avanzar en el sendero espiritual con un dinamismo protegido, utilizando cada acción como un acto de fe que atrae la gracia y facilita la expansión de tu conciencia hacia planos superiores.' }, // Marte Sextil Jupiter
    'Mars_cua_Jupiter': { d: 'Vives una tensión constante entre tu impulso de actuar y una tendencia al exceso de confianza o a la desmesura. Esta fricción te obliga a trabajar en la disciplina de tu energía, aprendiendo a dirigir tu coraje hacia causas justas sin caer en la arrogancia o el derroche de tus recursos vitales.', g: 'Experimentas el conflicto entre la fuerza instintiva y la aspiración al infinito. Esta crisis es una prueba de rectitud: se te exige purificar tu ambición del ego para que tu potencia no se disperse en batallas inútiles, sino que se concentre en la conquista de la verdadera soberanía espiritual.' }, // Mars Cuadratura Jupiter
    'Mars_tri_Jupiter': { d: 'El entusiasmo y el éxito en la acción fluyen en tu vida de manera espontánea, otorgándote un liderazgo noble y una gran capacidad ejecutiva. Tus acciones parecen estar bendecidas por la fortuna, permitiéndote alcanzar tus propósitos con una generosidad y una alegría que inspiran a otros.', g: 'Tu ser manifiesta la autoridad del espíritu triunfante. Existe en ti una alineación donde la fuerza se pone al servicio de la sabiduría divina, permitiéndote manifestar la voluntad del Absoluto con una nobleza natural que disuelve la resistencia del mundo y establece el orden de la luz.' }, // Marte Trigono Jupiter
    'Mars_opo_Jupiter': { d: 'Tu necesidad de acción y tu búsqueda de expansión a menudo chocan en tus encuentros con los demás, enfrentándote a debates sobre tus creencias o métodos. Aprendes a moderar tu ímpetu al observar los límites ajenos, integrando tu fuerza al reconocer que la verdadera victoria es el equilibrio.', g: 'Representas la balanza entre la fuerza individual y la ley universal. Tu camino consiste en encontrar el punto central donde tu voluntad no se imponga sobre el orden cósmico, comprendiendo que la verdadera libertad de acción nace de la sintonía con la voluntad superior y no de la rebelión ciega.' }, // Marte Oposicion Jupiter

    // Marte - Saturno
    'Mars_con_Saturn': { d: 'Tu voluntad está forjada en la disciplina, el esfuerzo sostenido y una resistencia de acero. Posees una capacidad de trabajo inmensa y una paciencia estratégica para actuar, proyectando una personalidad que sabe controlar sus impulsos para construir resultados sólidos y permanentes en el tiempo.', g: 'Encarnas la cristalización de la Voluntad bajo la Ley del Rigor. Tu fuerza se somete al límite para ganar maestría, indicando que tu camino de gnosis es la alquimia de la perseverancia: el espíritu que domina la inercia de la materia mediante la disciplina consciente y el dominio absoluto de sí mismo.' }, // Marte Conjuncion Saturno
    'Mars_sex_Saturn': { d: 'Dispones de una armonía fluida entre tu energía emprendedora y tu sentido de la responsabilidad. Tienes el don de organizar tus acciones con método y realismo, encontrando oportunidades para consolidar tu éxito de manera duradera mediante un uso inteligente del esfuerzo y la perseverancia.', g: 'Tu potencia vital utiliza el orden cósmico como un carril seguro para su manifestación. Esta conexión te permite actuar con integridad sagrada, utilizando la disciplina como una herramienta que garantiza que cada uno de tus actos sea una piedra sólida en la construcción de tu templo interior.' }, // Marte Sextil Saturno
    'Mars_cua_Saturn': { d: 'Sientes una tensión constante entre tus deseos de avanzar y obstáculos externos que parecen frenar tu impulso. Esta fricción te obliga a desarrollar una resiliencia extraordinaria, forjando tu carácter en el fuego de la frustración para aprender que la verdadera fuerza nace del dominio de la paciencia.', g: 'Vives el combate entre la chispa divina activa y el Arconte de la Limitación. Esta crisis es una prueba de fuego iniciática: se te exige despojarte de la ira y la impaciencia para descubrir la autoridad espiritual que surge cuando la voluntad se templa en el yunque del destino.' }, // Marte Cuadratura Saturno
    'Mars_tri_Saturn': { d: 'La eficiencia y el control sobre tus acciones fluyen de manera natural, otorgándote una reputación de competencia y seriedad. Posees una habilidad innata para manejar situaciones difíciles con calma y rigor, logrando que tu energía se traduzca siempre en logros tangibles y respetados.', g: 'Tu ser manifiesta la paz del guerrero que ha integrado la ley. Gozas de una alineación donde la fuerza no se desperdicia, sino que se concentra con precisión divina, permitiéndote actuar en el mundo con una madurez que redime la materia y manifiesta la voluntad inmutable del espíritu.' }, // Marte Trigono Saturno
    'Mars_opo_Saturn': { d: 'Tu voluntad personal se pone a prueba a través de la confrontación con figuras de autoridad o reglas que limitan tu libertad de acción. Aprendes a valorar tu fuerza al enfrentar la resistencia del mundo, integrando tu capacidad ejecutiva al equilibrar tu ímpetu con la responsabilidad social.', g: 'Representas la tensión entre el impulso de libertad y el Guardián del Umbral. Tu camino consiste en encontrar el equilibrio entre el fuego de la acción y el frío de la ley, comprendiendo que el verdadero poder no es luchar contra el límite, sino convertir el límite en el instrumento de tu propia liberación.' }, // Marte Oposicion Saturno

    // Marte - Urano
    'Mars_con_Uranus': { d: 'Tu energía es eléctrica, impredecible y está impulsada por un deseo radical de independencia y cambio. Posees una capacidad de reacción instantánea y un coraje revolucionario que te lleva a romper con lo establecido, proyectando una personalidad innovadora que actúa como un rayo de renovación.', g: 'Representas la irrupción de la fuerza estelar disruptiva en la voluntad humana. Tu potencia se activa mediante el despertar súbito, indicando que tu camino es la liberación de la acción: el espíritu que utiliza el choque y la sorpresa para destruir las prisiones del hábito y el control demiúrgico.' }, // Marte Conjuncion Urano
    'Mars_sex_Uranus': { d: 'La vida te ofrece oportunidades fluidas para aplicar soluciones originales a tus desafíos prácticos. Tienes la habilidad de integrar el cambio repentino con una acción decidida y creativa, encontrando siempre formas innovadoras de avanzar que resultan estimulantes y abren nuevos caminos.', g: 'Tu voluntad sintoniza con las corrientes de la inteligencia liberadora de forma armoniosa. Esta conexión te permite actuar como un catalizador de transformación, utilizando la intuición como un motor de acción que facilita el salto cuántico del alma hacia estados de conciencia más libres.' }, // Marte Sextil Urano
    'Mars_cua_Uranus': { d: 'Vives una tensión extrema entre tu necesidad de actuar y un impulso de rebelión explosiva que puede volverse contra ti. Esta fricción te obliga a desarrollar una autenticidad radical, aprendiendo a canalizar tu inquietud hacia una reforma consciente en lugar de una destrucción sin propósito.', g: 'Experimentas el conflicto entre la fuerza de la voluntad y el rayo de la liberación absoluta. Esta crisis es una prueba de desapego total: se te exige romper con la necesidad de resultados predecibles para que tu acción sea un acto puro del espíritu, libre de las cadenas de la causalidad material.' }, // Marte Cuadratura Urano
    'Mars_tri_Uranus': { d: 'La genialidad en la acción y el coraje visionario fluyen en ti de manera espontánea, otorgándote una gran capacidad para inventar y liderar cambios técnicos o sociales. Atraes éxito mediante tus métodos inusuales, permitiéndote actuar con una libertad que inspira a otros a romper sus propias cadenas.', g: 'Tu ser manifiesta la frecuencia de la voluntad superior con una naturalidad asombrosa. Existe en ti una alineación con la verdad revolucionaria que te permite actuar en el mundo como un agente del pneuma, manifestando una fuerza que fluye sin esfuerzo desde la libertad absoluta del centro místico.' }, // Marte Trigono Urano
    'Mars_opo_Uranus': { d: 'Tu impulso de independencia se pone a prueba a través de encuentros con situaciones o personas que desafían tu autoridad de forma brusca. Aprendes a reconocer tu propia originalidad al enfrentar la rebelión externa, integrando tu fuerza al equilibrar tu acción con el impacto social impredecible.', g: 'Representas la tensión entre la voluntad individual y la libertad absoluta proyectada en el espejo del mundo. Tu camino consiste en encontrar el centro del relámpago, comprendiendo que la verdadera autonomía es la que recuperas al dejar de luchar contra lo externo para actuar desde tu propia luz.' }, // Marte Oposicion Urano

    // Marte - Neptuno
    'Mars_con_Neptune': { d: 'Tu fuerza de voluntad se disuelve en una sensibilidad mística, orientando tus acciones hacia ideales elevados, el arte o la ayuda desinteresada. Posees una energía que fluye de manera sutil e intuitiva, proyectando una personalidad inspirada que busca actuar por motivos que trascienden lo material.', g: 'Representas la inmersión de la fuerza marcial en las aguas de la compasión infinita. Tu voluntad se somete al sacrificio místico, indicando que tu camino de gnosis es la acción inspirada: convertir tu potencia vital en un canal para que la luz del Pleroma actúe en el mundo a través de la entrega.' }, // Marte Conjuncion Neptuno
    'Mars_sex_Neptune': { d: 'Existe una armonía sutil entre tus impulsos y tu intuición, facilitando que actúes de manera inspirada y compasiva. Tienes el don de trabajar por tus sueños con suavidad, encontrando oportunidades para canalizar tu energía hacia fines creativos o espirituales que elevan tu entorno cotidiano.', g: 'Tu voluntad sintoniza con las frecuencias del amor universal de forma fluida. Esta conexión te permite actuar como un instrumento de sanación, utilizando tu fuerza como un vehículo para la gracia divina que facilita el avance del alma mediante la suavidad y el servicio a la luz.' }, // Marte Sextil Neptuno
    'Mars_cua_Neptune': { d: 'Vives una tensión constante entre tu deseo de actuar y un sentimiento de confusión o debilidad que puede llevarte al desánimo. Esta fricción te obliga a desarrollar un discernimiento sagrado, aprendiendo a dirigir tu energía hacia metas reales sin perderte en fantasías o causas ilusorias.', g: 'Experimentas el conflicto entre el impulso vital y los velos engañosos del plano astral. Esta crisis es una prueba de transparencia: se te exige purificar tu voluntad de todo espejismo egoico para encontrar la fuerza real que reside más allá de los miedos y las dudas sembradas por la ilusión.' }, // Marte Cuadratura Neptuno
    'Mars_tri_Neptune': { d: 'La inspiración y la capacidad de actuar con fe fluyen en ti de manera espontánea, otorgándote un carisma magnético y una gran fuerza espiritual. Tus acciones parecen guiadas por una mano invisible que te protege, permitiéndote alcanzar tus metas mediante la suavidad y la entrega total.', g: 'Tu ser manifiesta la serenidad de quien actúa bajo la guía del espíritu inefable. Existe en ti una alineación con la voluntad divina que te permite transitar la densidad sin violencia, convirtiendo cada uno de tus actos en un reflejo de la armonía que redime y libera a la materia de sus cadenas.' }, // Marte Trigono Neptuno
    'Mars_opo_Neptune': { d: 'Tu voluntad y tu búsqueda de trascendencia se reflejan en tus conflictos con los demás, enfrentándote a menudo a situaciones de engaño o desilusión. Aprendes a valorarte al descubrir que la fuerza y la dirección que buscas afuera residen en el silencio de tu propio centro espiritual.', g: 'Representas la tensión entre la acción individual y la disolución absoluta proyectada en el espejo del mundo. Tu camino consiste en encontrar el centro del espejo sagrado, comprendiendo que la verdadera fuerza no es la lucha externa, sino la entrega de tu voluntad a la luz del espíritu interior.' }, // Marte Oposicion Neptuno

    // Marte - Pluton
    'Mars_con_Pluto': { d: 'Tu voluntad posee una intensidad volcánica y una capacidad de transformación que no conoce límites. Nada te detiene cuando te propones un objetivo, proyectando una presencia de mando abrumadora que busca penetrar en las profundidades de la realidad para regenerarla desde su raíz.', g: 'Encarnas la unión de la Fuerza Vital con el Fuego Transformador del abismo. Tu pneuma utiliza la potencia marcial para destruir las estructuras del ego, indicando que tu camino es la alquimia de la voluntad: morir al deseo mundano para que el espíritu resurja con un poder absoluto y soberano.' }, // Marte Conjuncion Pluton
    'Mars_sex_Pluto': { d: 'Dispones de una armonía poderosa entre tu capacidad ejecutiva y tu habilidad para manejar el poder oculto y las crisis. Tienes el don de transformar tu realidad mediante una acción estratégica y profunda, encontrando siempre la clave para regenerar tus proyectos con una fuerza magnética.', g: 'Tu voluntad sintoniza con las fuerzas de transmutación cósmica de manera natural. Esta conexión te permite utilizar la acción como una herramienta de purificación espiritual, facilitando el proceso de despojo de las sombras y permitiendo que la luz del espíritu penetre en lo más denso de la materia.' }, // Marte Sextil Pluton
    'Mars_cua_Pluto': { d: 'Vives una tensión extrema entre tu impulso de poder y fuerzas externas que te obligan a la rendición o a la transformación total. Esta fricción es un motor de cambio que te obliga a soltar la manipulación y el control, forjando un carácter indestructible que ha sobrevivido a sus propios abismos.', g: 'Experimentas el conflicto directo entre la voluntad individual y el Arconte de las sombras. Esta crisis es una prueba iniciática: se te exige despojarte de toda ambición ciega y miedo a la muerte para que el espíritu pueda liberarse de los lazos kármicos más densos a través de la transmutación total.' }, // Marte Cuadratura Pluton
    'Mars_tri_Pluto': { d: 'La capacidad de regeneración física y el mando natural fluyen en ti de manera espontánea. Posees una intuición penetrante sobre dónde aplicar tu fuerza para obtener el máximo impacto, logrando éxito mediante una voluntad que sabe sanar y transformar lo que toca con una potencia sagrada.', g: 'Tu ser manifiesta la majestad del espíritu que ha integrado su sombra combativa. Gozas de una alineación donde el poder no destruye, sino que purifica, permitiéndote manifestar la voluntad del Absoluto con una fuerza que transmuta el dolor en soberanía y la debilidad en luz divina invicta.' }, // Marte Trigono Pluton
    'Mars_opo_Pluto': { d: 'Tu fuerza personal y tu capacidad de acción se ponen a prueba a través de luchas de poder intensas con otros que intentan dominarte. Aprendes a reconocer tu propio poder al enfrentar la sombra en la confrontación, integrando tu fuerza al equilibrar la asertividad con la entrega profunda.', g: 'Representas la balanza entre la voluntad central y el guardián de los misterios profundos proyectado en el mundo. Tu camino consiste en encontrar el centro entre la luz y el abismo de la acción, comprendiendo que el verdadero poder surge cuando la lucha externa se convierte en dominio interno.' }, // Marte Oposicion Pluton
 // Jupiter - Saturno
    'Jupiter_con_Saturn': { d: 'Tu vida está marcada por un ciclo de expansión controlada y realismo ambicioso, permitiéndote construir grandes estructuras con bases sólidas. Posees una sabiduría práctica que equilibra el optimismo con la cautela, proyectando una personalidad capaz de manifestar el éxito a través de la paciencia y el respeto por el tiempo.', g: 'Encarnas la unión de la Gracia y el Rigor, los dos pilares que sostienen el equilibrio del templo interior. Esta conjunción representa la materialización de la ley divina en la forma, indicando que tu camino de gnosis es la maestría sobre la densidad: convertir la fe en una estructura inquebrantable que resiste las tormentas del mundo demiúrgico.' }, // Jupiter Conjuncion Saturno
    'Jupiter_sex_Saturn': { d: 'Cuentas con una facilidad natural para organizar tus ideales y darles una forma productiva y estable. Tienes el don de saber cuándo arriesgarte y cuándo retroceder, encontrando siempre el apoyo de las estructuras sociales o legales para expandir tus proyectos con seguridad y orden.', g: 'La expansión de tu conciencia fluye en armonía con las leyes del karma y el tiempo. Esta conexión facilita una evolución espiritual equilibrada, donde el crecimiento no es caótico sino que se asienta sobre la justicia sagrada, permitiendo que tu espíritu ascienda con pasos firmes hacia el conocimiento del Absoluto.' }, // Jupiter Sextil Saturno
    'Jupiter_cua_Saturn': { d: 'Vives una tensión constante entre tu deseo de crecer y las limitaciones o responsabilidades que parecen frenarte. Esta fricción te obliga a reevaluar tus creencias y a desarrollar una ética de trabajo impecable, aprendiendo que la verdadera libertad nace de la disciplina y el cumplimiento del deber.', g: 'Experimentas el conflicto entre el anhelo de liberación del alma y las prisiones de la forma material. Esta crisis es una prueba de templanza ética: se te exige purificar tu visión de la vida para que tu fe no se quiebre ante el rigor, encontrando la plenitud en la aceptación de las leyes que gobiernan el plano físico.' }, // Jupiter Cuadratura Saturno
    'Jupiter_tri_Saturn': { d: 'La sabiduría y la prosperidad fluyen en tu vida con una naturalidad asombrosa, otorgándote una reputación de integridad y buen juicio. Posees un talento innato para la administración de grandes recursos y la enseñanza, logrando un éxito duradero gracias a una visión que une lo ideal con lo posible.', g: 'Tu ser manifiesta la paz de quien ha integrado la expansión de la luz con la solidez de la ley. Gozas de una alineación donde la providencia divina se manifiesta a través del orden perfecto, permitiéndote habitar en el mundo como un canal de justicia y abundancia que refleja la armonía de las esferas superiores.' }, // Jupiter Trigono Saturno
    'Jupiter_opo_Saturn': { d: 'Te encuentras constantemente buscando el equilibrio entre tus ambiciones personales y las exigencias de tu entorno social o profesional. Aprendes a consolidar tus valores al enfrentar la resistencia del sistema, integrando tu crecimiento al reconocer que el éxito verdadero requiere tanto de fe como de estructura.', g: 'Representas la balanza mística entre la libertad del espíritu y el límite de la materia. Tu camino consiste en encontrar el punto central donde la expansión no sea evasión ni la ley sea opresión, comprendiendo que el equilibrio entre dar y recibir es la clave para trascender la dualidad de este plano.' }, // Jupiter Oposicion Saturno

    // Jupiter - Urano
    'Jupiter_con_Uranus': { d: 'Tu mente está dotada de una genialidad visionaria y una sed insaciable de libertad intelectual y espiritual. Posees un optimismo revolucionario que te lleva a buscar verdades inusuales, proyectando una personalidad que actúa como un catalizador de cambios súbitos y descubrimientos afortunados.', g: 'Representas el rayo de la iluminación que rasga el velo de la ignorancia. Tu espíritu se expande mediante despertares repentinos de la conciencia, indicando que tu camino es la revolución de la gnosis: recibir destellos de la verdad del Pleroma que transforman instantáneamente tu visión del universo.' }, // Jupiter Conjuncion Urano
    'Jupiter_sex_Uranus': { d: 'La vida te ofrece oportunidades fluidas para renovar tus creencias y expandir tus horizontes a través de ideas innovadoras. Tienes el don de integrar la tecnología o los conceptos vanguardistas en tu filosofía de vida, encontrando siempre formas estimulantes de crecer sin perder tu independencia.', g: 'Tu conciencia sintoniza armoniosamente con las corrientes de la inteligencia cósmica liberadora. Esta conexión te permite percibir la belleza de la verdad en lo no convencional, utilizando la intuición como un faro sagrado que facilita el desapego de los dogmas obsoletos para abrazar la libertad del espíritu.' }, // Jupiter Sextil Urano
    'Jupiter_cua_Uranus': { d: 'Sientes una tensión entre tu necesidad de estabilidad filosófica y un impulso de rebelión que te lleva a cuestionarlo todo. Esta fricción te obliga a desarrollar una verdad propia y radical, aprendiendo a expandir tu conciencia sin caer en la excentricidad vacía o el desorden intelectual.', g: 'Vives el conflicto entre la expansión del conocimiento y el rayo de la ruptura absoluta. Esta crisis es una prueba de desprendimiento mental: se te exige soltar las seguridades de la fe tradicional para que tu mente pueda vibrar en la frecuencia de la libertad divina, más allá de los límites de la matriz.' }, // Jupiter Cuadratura Urano
    'Jupiter_tri_Uranus': { d: 'La originalidad y el éxito visionario fluyen en ti de manera espontánea, otorgándote una gran capacidad para inspirar reformas y adelantos sociales. Atraes circunstancias afortunadas donde tu diferencia es valorada, permitiéndote vivir con una plenitud que desafía las normas establecidas.', g: 'Tu alma manifiesta la elegancia de la verdad estelar con una naturalidad asombrosa. Existe en ti una alineación con la sabiduría visionaria que te permite vivir la expansión del ser como un acto de libertad, manifestando una armonía que fluye directamente desde el centro místico de la inteligencia liberada.' }, // Jupiter Trigono Urano
    'Jupiter_opo_Uranus': { d: 'Tu búsqueda de crecimiento se pone a prueba a través de encuentros con ideas o personas que desafían radicalmente tus creencias. Aprendes a reconocer tu propia genialidad al observar la rebeldía ajena, integrando tu visión del mundo al equilibrar la tradición con la innovación constante.', g: 'Representas la tensión entre la expansión de la ley y la libertad absoluta proyectada en el espejo de la sociedad. Tu camino consiste en encontrar el centro del relámpago místico, comprendiendo que la verdadera sabiduría no reside en seguir una norma, sino en la danza libre de la mente consciente.' }, // Jupiter Oposicion Urano

    // Jupiter - Neptuno
    'Jupiter_con_Neptune': { d: 'Tu naturaleza está impregnada de un idealismo poético y una compasión universal que no conoce fronteras. Posees una fe mística desbordante y una imaginación que busca la unión con lo divino, proyectando una sensibilidad que eleva y sana a quienes te rodean a través de la esperanza.', g: 'Representas la inmersión de la sabiduría en el océano de la compasión infinita. Tu conciencia se expande mediante la disolución del ego en la unidad del Todo, indicando que tu camino de gnosis es la devoción mística: convertir tu vida en un reflejo de la luz del Pleroma que redime la materia mediante el amor.' }, // Jupiter Conjuncion Neptuno
    'Jupiter_sex_Neptune': { d: 'Existe una armonía sutil entre tus ideales y tu intuición espiritual, facilitando una vida llena de momentos de inspiración y paz interna. Tienes el don de percibir la bondad en lo invisible, encontrando oportunidades para expandir tu alma a través del arte, la meditación o el servicio desinteresado.', g: 'Tu conciencia sintoniza con las frecuencias del amor universal de forma fluida. Esta conexión te permite captar la armonía mística oculta en la creación, utilizando la fe como un instrumento de redención espiritual que facilita el despertar a través de la gracia y la suavidad del corazón.' }, // Jupiter Sextil Neptuno
    'Jupiter_cua_Neptune': { d: 'Vives una tensión entre tu anhelo de una verdad perfecta y la confusión que provocan las ilusiones del mundo material. Esta fricción te obliga a desarrollar un discernimiento sagrado, aprendiendo a expandir tu fe sin perderte en el escapismo o en falsas promesas de salvación externa.', g: 'Experimentas el conflicto entre el anhelo de infinitud y los velos engañosos del plano astral. Esta crisis es una prueba de transparencia mística: se te exige purificar tu visión de toda fantasía para encontrar la verdadera sabiduría que reside más allá de los espejismos de la mente demiúrgica.' }, // Jupiter Cuadratura Neptuno
    'Jupiter_tri_Neptune': { d: 'La inspiración espiritual y la suerte en los asuntos del alma fluyen en ti de manera espontánea, otorgándote una fe que mueve montañas. Tus ideales parecen estar protegidos por una gracia invisible, permitiéndote vivir con una plenitud que disuelve las barreras entre lo humano y lo divino.', g: 'Tu alma manifiesta la serenidad de quien habita en la abundancia del espíritu inefable. Existe en ti una alineación con la armonía inmarcesible que te permite transitar la existencia con una pureza total, convirtiendo tu conocimiento en un reflejo del amor infinito que libera a los seres del sufrimiento.' }, // Jupiter Trigono Neptuno
    'Jupiter_opo_Neptune': { d: 'Tu búsqueda de sentido y trascendencia se refleja en tus conflictos con las creencias de los demás, enfrentándote a menudo a la duda o a la desilusión. Aprendes a valorarte al descubrir que la verdad y la paz que buscas afuera residen en el silencio de tu propio templo espiritual interno.', g: 'Representas la tensión entre la expansión de la conciencia y la disolución absoluta proyectada en el mundo. Tu camino consiste en encontrar el centro del espejo sagrado, comprendiendo que la verdadera fe no es una creencia externa, sino el reencuentro de tu chispa divina con su propia fuente oceánica.' }, // Jupiter Oposicion Neptuno

    // Jupiter - Pluton
    'Jupiter_con_Pluto': { d: 'Tu capacidad de crecimiento está ligada a un poder de transformación profunda y a una voluntad de regenerar tus propios sistemas de creencias. Posees un magnetismo influyente y una ambición de gran alcance, buscando penetrar en los secretos de la vida para alcanzar una soberanía total.', g: 'Encarnas la unión de la Expansión con el Fuego Transformador del abismo. Tu conciencia utiliza el poder de la transmutación para destruir las estructuras de la ignorancia, indicando que tu camino es la alquimia de la sabiduría: morir al conocimiento mundano para que el espíritu resurja con poder absoluto.' }, // Jupiter Conjuncion Pluton
    'Jupiter_sex_Pluto': { d: 'Dispones de una armonía poderosa entre tus ideales y tu habilidad para manejar el poder y los recursos ocultos. Tienes el don de regenerar tu visión del mundo mediante crisis constructivas, encontrando siempre la clave para expandir tu influencia con una fuerza estratégica y profunda.', g: 'Tu conciencia sintoniza con las fuerzas de transmutación cósmica de manera natural. Esta conexión te permite utilizar la sabiduría como una herramienta de purificación espiritual, facilitando el despojo de las sombras y permitiendo que la luz del espíritu penetre en los estratos más densos de la materia.' }, // Jupiter Sextil Pluton
    'Jupiter_cua_Pluto': { d: 'Vives una tensión extrema entre tu deseo de expansión y fuerzas de transformación que te obligan a la rendición total. Esta fricción es un motor de cambio que te obliga a soltar la arrogancia y el control, forjando una filosofía de vida indestructible que ha sobrevivido a sus propias sombras.', g: 'Experimentas el conflicto directo entre la aspiración al infinito y el Arconte de las profundidades. Esta crisis es una prueba iniciática: se te exige despojarte de toda ambición de poder terrenal para que tu fe pueda liberarse de los lazos kármicos y brillar con una autoridad espiritual pura.' }, // Jupiter Cuadratura Pluton
    'Jupiter_tri_Pluto': { d: 'La capacidad de regeneración moral y el éxito en grandes transformaciones fluyen en ti de manera espontánea. Posees una intuición penetrante sobre dónde invertir tu energía para obtener el máximo crecimiento, logrando prosperidad mediante una sabiduría que sabe sanar y elevar lo que toca.', g: 'Tu ser manifiesta la majestad del espíritu que ha integrado su sombra expansiva. Gozas de una alineación donde el conocimiento no domina, sino que purifica, permitiéndote manifestar la voluntad del Absoluto con una fuerza que transmuta el dolor en soberanía y la búsqueda en luz divina invicta.' }, // Jupiter Trigono Pluton
    'Jupiter_opo_Pluto': { d: 'Tu visión de la vida y tu poder personal se ponen a prueba a través de luchas ideológicas o crisis de fe con otros que intentan imponerte su verdad. Aprendes a reconocer tu propia autoridad al enfrentar la sombra externa, integrando tu crecimiento al equilibrar la fe con la entrega profunda.', g: 'Representas la balanza entre la expansión del conocimiento y el guardián de los misterios profundos proyectado en el mundo. Tu camino consiste en encontrar el centro entre la luz de la fe y el abismo de la transmutación, comprendiendo que el verdadero poder surge cuando la sabiduría externa se vuelve dominio interior.' }, // Jupiter Oposicion Pluton
 // Saturno - Urano
    'Saturn_con_Uranus': { d: 'Tu vida es un puente entre la tradición y la innovación, permitiéndote dar una estructura sólida a ideas revolucionarias. Posees una paciencia única para materializar cambios drásticos, proyectando una personalidad que sabe reformar las reglas desde adentro con una disciplina visionaria y un sentido del tiempo excepcional.', g: 'Encarnas la síntesis del Guardián del Tiempo y el Rayo de la Liberación. Esta unión permite que la luz del despertar no se pierda en el caos, sino que se asiente en la materia, indicando que tu camino de gnosis es la construcción del nuevo mundo: fijar las verdades eternas del pneuma en formas que desafían la inercia del demiurgo.' }, // Saturno Conjuncion Urano
    'Saturn_sex_Uranus': { d: 'Dispones de una armonía fluida para introducir mejoras originales en tus responsabilidades y estructuras de vida. Tienes el don de equilibrar la libertad con el deber, encontrando oportunidades constantes para renovar tu realidad sin destruir las bases seguras que has construido con esfuerzo.', g: 'Tu conciencia utiliza la ley del orden para canalizar las frecuencias de la inteligencia liberadora. Esta conexión facilita una transición armoniosa hacia nuevos estados de ser, permitiendo que tu evolución sea un proceso de reforma sagrada donde lo viejo muere con dignidad para dar paso a la luz de la verdad visionaria.' }, // Saturno Sextil Urano
    'Saturn_cua_Uranus': { d: 'Sientes una tensión constante entre el miedo al cambio y la necesidad de romper con las limitaciones del pasado. Esta fricción actúa como un martillo que forja tu carácter, obligándote a encontrar un equilibrio difícil pero necesario entre la estabilidad que anhelas y la libertad que tu espíritu reclama a gritos.', g: 'Vives el combate entre la cristalización de la materia y el impulso de ruptura del espíritu. Esta crisis es una prueba de flexibilidad iniciática: se te exige despojarte de la rigidez mental para que la estructura de tu ego no estalle ante el rayo de Urano, sino que se transforme en un receptáculo para la libertad divina.' }, // Saturno Cuadratura Urano
    'Saturn_tri_Uranus': { d: 'La capacidad de reformar y estabilizar nuevas ideas fluye en ti de manera espontánea, otorgándote una sabiduría que une lo clásico con lo vanguardista. Atraes éxito mediante la implementación de métodos innovadores dentro de marcos respetados, logrando una autoridad que es a la vez firme y renovadora.', g: 'Tu ser manifiesta la paz del arquitecto cósmico que ha integrado la ley con la genialidad. Gozas de una alineación donde el tiempo sirve a la liberación, permitiéndote manifestar la voluntad del espíritu con una precisión que ordena el caos y convierte la innovación en una estructura sagrada e inamovible.' }, // Saturno Trigono Urano
    'Saturn_opo_Uranus': { d: 'Te encuentras atrapado a menudo entre las exigencias de la autoridad externa y tus impulsos de rebelión personal. Aprendes a consolidar tu propia soberanía al enfrentar la resistencia de las viejas formas, integrando tu crecimiento al reconocer que la verdadera libertad requiere de una responsabilidad profunda.', g: 'Representas la balanza entre el Demiurgo limitador y el Prometeo liberador proyectados en tu realidad. Tu camino consiste en encontrar el punto de equilibrio donde la ley no asfixie tu luz y el cambio no destruya tu centro, comprendiendo que la síntesis de ambos es la clave para trascender la dualidad de la forma.' }, // Saturno Oposicion Urano

    // Saturno - Neptuno
    'Saturn_con_Neptune': { d: 'Posees la capacidad de dar forma a tus sueños y de convertir tus ideales más elevados en realidades tangibles y estructuradas. Tu naturaleza es profundamente seria con respecto a la espiritualidad, proyectando una disciplina mística que busca manifestar la compasión y la belleza en el mundo físico de forma duradera.', g: 'Encarnas la materialización de lo invisible en el crisol de la forma. Esta unión representa la "espiritualización de la materia", indicando que tu camino de gnosis es convertir el anhelo del alma en una obra concreta, permitiendo que la luz del Pleroma se ancle en la densidad a través de una voluntad disciplinada.' }, // Saturno Conjuncion Neptuno
    'Saturn_sex_Neptune': { d: 'Existe una armonía fluida entre tu sentido de la realidad y tu intuición mística, permitiéndote navegar el mundo práctico con una guía espiritual clara. Tienes el don de concretar tus visiones artísticas o humanitarias con paciencia, encontrando siempre la forma de integrar lo sagrado en tus tareas cotidianas.', g: 'Tu conciencia utiliza la ley del rigor para proteger la pureza de tus visiones místicas. Esta conexión facilita una evolución espiritual estable, donde la fe no se convierte en ilusión porque está sostenida por la disciplina, permitiendo que el espíritu ascienda con pasos firmes hacia la disolución consciente en la fuente.' }, // Saturno Sextil Neptuno
    'Saturn_cua_Neptune': { d: 'Vives una tensión entre la dureza de los hechos materiales y un anhelo de escape hacia mundos ideales o espirituales. Esta fricción te obliga a desarrollar un discernimiento extraordinario, aprendiendo a no perder la estructura ante la duda o la confusión, y a no endurecer el corazón ante la fragilidad de la vida.', g: 'Experimentas el conflicto entre el Guardián del Umbral y los velos engañosos de la ilusión. Esta crisis es una prueba de veracidad espiritual: se te exige purificar tu realidad de toda fantasía para encontrar la verdadera estructura del ser que permanece cuando todas las máscaras del demiurgo se disuelven en el agua del espíritu.' }, // Saturno Cuadratura Neptuno
    'Saturn_tri_Neptune': { d: 'La capacidad de manifestar la paz interna y el idealismo de forma práctica fluye en ti de manera natural. Posees un talento innato para la meditación disciplinada y la caridad organizada, logrando que tu vida sea un ejemplo de cómo la fe y el trabajo pueden unirse para crear una armonía duradera.', g: 'Tu ser manifiesta la serenidad de quien ha construido su templo sobre las aguas del espíritu. Gozas de una alineación donde la ley apoya la trascendencia, permitiéndote habitar en el mundo como un canal de gracia sólida que refleja la estabilidad eterna de la luz divina en medio del flujo de la existencia.' }, // Saturno Trigono Neptuno
    'Saturn_opo_Neptune': { d: 'Tu búsqueda de seguridad material a menudo choca con situaciones de incertidumbre o sacrificios que parecen desvanecer tus logros. Aprendes a encontrar tu verdadera base al enfrentar la disolución de lo externo, integrando tu realidad al reconocer que lo único permanente es la esencia del espíritu.', g: 'Representas la tensión entre la forma rígida y la infinitud oceánica proyectada en tu destino. Tu camino consiste en encontrar el equilibrio donde la estructura no impida la comunión mística, comprendiendo que la verdadera seguridad nace de la entrega de la forma finita a la voluntad infinita del Absoluto.' }, // Saturno Oposicion Neptuno

    // Saturno - Pluton
    'Saturn_con_Pluto': { d: 'Tu voluntad está marcada por una determinación implacable y una capacidad de resistencia ante las crisis más profundas de la vida. Posees un sentido de la autoridad extremadamente fuerte y austero, proyectando una personalidad que sabe reconstruir su realidad desde las cenizas con una disciplina total.', g: 'Encarnas la unión del Rigor con el Fuego Transformador del abismo. Esta conjunción representa la "Gran Obra" de la transmutación de la materia pesada en luz espiritual, indicando que tu camino de gnosis es la maestría sobre la muerte y el renacimiento: purificar la forma hasta que solo quede el diamante del espíritu.' }, // Saturno Conjuncion Pluton
    'Saturn_sex_Pluto': { d: 'Dispones de una armonía poderosa para manejar el poder y las transformaciones estructurales con paciencia y estrategia. Tienes el don de regenerar tus bases de vida mediante un esfuerzo sostenido, encontrando siempre la fuerza necesaria para consolidar tus ambiciones en medio de los cambios sociales.', g: 'Tu conciencia utiliza la ley del orden para canalizar las energías de transmutación profunda. Esta conexión facilita una evolución espiritual resiliente, donde cada crisis se convierte en una piedra angular para la construcción de una soberanía interior que es capaz de dominar las fuerzas kármicas más densas.' }, // Saturno Sextil Pluton
    'Saturn_cua_Pluto': { d: 'Vives una tensión extrema entre la necesidad de control y fuerzas de destrucción que te obligan a la transformación radical. Esta fricción es un fuego purificador que te obliga a soltar la rigidez del ego, aprendiendo que el verdadero poder nace de la capacidad de morir a lo viejo para que surja lo eterno.', g: 'Experimentas el conflicto directo entre el Arconte de la forma y el Señor de las sombras transmutadoras. Esta crisis es una prueba de integridad absoluta: se te exige despojarte de toda ambición de control material para que tu espíritu pueda liberarse de los lazos del apego y alcanzar la verdadera autoridad divina.' }, // Saturno Cuadratura Pluton
    'Saturn_tri_Pluto': { d: 'La capacidad de mando y la regeneración de estructuras fluyen en ti de manera espontánea, otorgándote una autoridad natural que inspira respeto. Posees una intuición técnica para reparar lo que está roto en la sociedad, logrando un éxito sólido mediante una voluntad que sabe cuándo ser firme y cuándo transformar.', g: 'Tu ser manifiesta la majestad del espíritu que ha dominado la ley y el abismo. Gozas de una alineación donde el tiempo y el poder trabajan en conjunto para purificar la creación, permitiéndote actuar en el mundo con una fuerza que transmuta la densidad en orden sagrado y la debilidad en luz invicta.' }, // Saturno Trigono Pluton
    'Saturn_opo_Pluto': { d: 'Tu necesidad de seguridad y tu ambición de poder se ponen a prueba a través de luchas intensas con el sistema o con figuras que desafían tu base. Aprendes a reconocer tu verdadera fuerza al enfrentar la sombra de la autoridad, integrando tu capacidad de liderazgo al equilibrar la ley con la transformación.', g: 'Representas la balanza mística entre la ley de la forma y el poder del abismo proyectado en el mundo. Tu camino consiste en encontrar el centro donde la disciplina no se convierta en tiranía ni la transformación en caos, comprendiendo que el equilibrio entre morir y durar es la esencia de la vida eterna.' }, // Saturno Oposicion Pluton
   // Urano - Neptuno
    'Uranus_con_Neptune': { d: 'Tu generación y tú poseen una sensibilidad visionaria que rompe los límites de la imaginación convencional, fusionando la tecnología con la espiritualidad. Eres capaz de percibir realidades alternativas, proyectando una mente que busca idealizar el futuro a través de conceptos artísticos o sociales que parecen adelantados a su tiempo.', g: 'Encarnas la unión de la Inteligencia Liberadora con el Océano de la Compasión. Esta conjunción representa el despertar de la conciencia colectiva hacia lo inefable, indicando que tu camino de gnosis es la percepción directa del Pleroma a través de la disolución de las estructuras mentales lógicas y la entrada en la intuición pura.' }, // Urano Conjuncion Neptuno
    'Uranus_sex_Neptune': { d: 'Dispones de una sintonía fluida entre tu deseo de libertad y tu idealismo místico, lo que facilita una apertura mental hacia nuevas formas de fe o arte. Tienes el don de integrar cambios repentinos con una paz interna sutil, encontrando siempre la inspiración necesaria para renovar tu espíritu sin perder la conexión con lo sagrado.', g: 'Tu conciencia vibra en armonía con las corrientes de la redención cósmica. Esta conexión facilita una evolución donde el rayo del despertar sirve para limpiar los espejismos del alma, permitiendo que la luz de la verdad visionaria fluya sin obstáculos hacia el corazón místico, elevando tu frecuencia vibratoria con naturalidad.' }, // Urano Sextil Neptuno
    'Uranus_cua_Neptune': { d: 'Vives una tensión entre el impulso de cambio radical y una confusión interna que empaña tus objetivos. Esta fricción te obliga a discernir entre la verdadera libertad y el simple escapismo, aprendiendo a aterrizar tus visiones utópicas para que no se disuelvan en la inacción o en la desilusión de un mundo imperfecto.', g: 'Experimentas el conflicto entre el relámpago de la liberación y los velos de la ilusión astral. Esta crisis es una prueba de claridad espiritual: se te exige despojarte de las falsas visiones para que tu pneuma no sea engañado por quimeras, encontrando la verdad absoluta que reside más allá del desorden mental y el caos emocional.' }, // Urano Cuadratura Neptuno
    'Uranus_tri_Neptune': { d: 'La inspiración visionaria y la paz espiritual fluyen en ti con una naturalidad asombrosa, otorgándote una fe en el progreso que trasciende lo material. Atraes experiencias que elevan tu conciencia de forma espontánea, logrando un equilibrio perfecto entre tu originalidad mental y tu capacidad de entrega a los misterios de la vida.', g: 'Tu ser manifiesta la armonía de las esferas superiores donde la mente y el alma son una sola voluntad. Gozas de una alineación mística que te permite actuar como un puente entre dimensiones, manifestando una luz que libera y sana simultáneamente, reflejando el orden inmarcesible de la creación divina.' }, // Urano Trigono Neptuno
    'Uranus_opo_Neptune': { d: 'Tu búsqueda de independencia choca a menudo con anhelos de fusión total o con una sensibilidad que te hace sentir vulnerable ante el cambio. Aprendes a equilibrar tu genialidad con tu compasión al enfrentar la dualidad del mundo, integrando tu crecimiento al reconocer que la verdadera libertad también incluye la unión con el Todo.', g: 'Representas la balanza entre la individualidad electrizante y la disolución oceánica proyectada en tu realidad. Tu camino consiste en encontrar el centro del espejo sagrado donde el despertar no te aísle y la entrega no te anule, comprendiendo que la síntesis de ambos es la entrada a la conciencia crística.' }, // Urano Oposicion Neptuno

    // Urano - Pluton
    'Uranus_con_Pluto': { d: 'Posees una fuerza de voluntad revolucionaria y una capacidad de transformación radical que puede alterar el curso de tu vida y de tu entorno. Tu energía es volcánica e impredecible, proyectando una personalidad que busca destruir las estructuras obsoletas para reconstruir la realidad sobre bases de libertad absoluta y poder auténtico.', g: 'Encarnas la unión de la Transmutación Profunda con el Rayo de la Liberación. Esta conjunción representa la demolición necesaria de la matriz para liberar la chispa divina, indicando que tu camino de gnosis es la alquimia de la ruptura: morir a la vieja forma social y personal para que el espíritu renazca con soberanía estelar.' }, // Urano Conjuncion Pluton
    'Uranus_sex_Pluto': { d: 'Cuentas con una facilidad natural para regenerar tu vida a través de cambios innovadores y estratégicos. Tienes el don de utilizar las crisis como trampolines para el progreso, encontrando oportunidades para expandir tu influencia personal mediante una renovación constante que no teme adentrarse en lo desconocido.', g: 'La potencia de tu voluntad sintoniza armoniosamente con las fuerzas del despertar cósmico. Esta conexión facilita una evolución donde el poder interno se utiliza para catalizar la libertad del alma, permitiendo que cada proceso de muerte y renacimiento sea una liberación consciente de las cadenas kármicas que atan al espíritu a la densidad.' }, // Urano Sextil Pluton
    'Uranus_cua_Pluto': { d: 'Vives una tensión extrema entre tu necesidad de libertad y fuerzas de control profundo que exigen una transformación dolorosa. Esta fricción actúa como un acelerador evolutivo, obligándote a soltar toda resistencia al cambio para que tu identidad no estalle, sino que se refine en el fuego de la crisis.', g: 'Experimentas el combate entre el rayo de Urano y el señor del abismo plutoniano. Esta crisis es una prueba de fuego iniciática: se te exige una rendición total de los apegos del ego para que la energía de la liberación pueda transmutar tu ser desde la raíz, permitiendo que el pneuma emerja invicto del caos.' }, // Urano Cuadratura Pluton
    'Uranus_tri_Pluto': { d: 'La capacidad de transformar la realidad y el coraje para innovar fluyen en ti de manera espontánea, otorgándote un carisma magnético y regenerador. Tus acciones parecen impulsadas por una fuerza evolutiva irresistible, logrando un éxito sólido al unir tu visión vanguardista con una voluntad que no conoce el miedo.', g: 'Tu ser manifiesta la majestad del espíritu que ha integrado la luz visionaria con el poder de las profundidades. Gozas de una alineación sagrada que te permite manifestar la voluntad del Absoluto con una fuerza que transmuta el entorno, convirtiendo la innovación en una ley de vida que eleva la conciencia colectiva.' }, // Urano Trigono Pluton
    'Uranus_opo_Pluto': { d: 'Te encuentras atrapado entre tu deseo de romper cadenas y la intensidad de fuerzas externas que intentan dominar tu destino. Aprendes a consolidar tu verdadera independencia al enfrentar la sombra del poder, integrando tu fuerza al reconocer que la rebelión externa es solo un reflejo de tu necesidad de dominio interno.', g: 'Representas la balanza mística entre la liberación disruptiva y el poder de la transmutación proyectados en el espejo del mundo. Tu camino consiste en encontrar el punto central donde el cambio no sea destructivo y el poder no sea opresivo, comprendiendo que la verdadera autonomía nace de la paz encontrada en el epicentro de la tormenta.' }, // Urano Oposicion Pluton

    // Neptuno - Pluton
    'Neptune_con_Pluto': { d: 'Tu naturaleza está marcada por una profundidad mística y una capacidad de regeneración espiritual que busca los secretos más ocultos de la existencia. Posees una imaginación poderosa vinculada a los instintos primordiales, proyectando una sensibilidad que desea sanar las heridas más profundas de la humanidad a través de la entrega.', g: 'Encarnas la unión de la Compasión Infinita con el Fuego de la Transmutación. Esta conjunción representa el descenso del alma a los infiernos para redimirlos con amor, indicando que tu camino de gnosis es la santificación de la sombra: disolver el dolor del mundo en el océano del espíritu para que la luz divina penetre hasta el abismo.' }, // Neptuno Conjuncion Pluton
    'Neptune_sex_Pluto': { d: 'Existe una armonía sutil pero poderosa entre tu intuición espiritual y tu capacidad para manejar las crisis personales. Tienes el don de encontrar la paz en medio de las grandes transformaciones, utilizando tu sensibilidad como una brújula que te guía hacia la sanación y la regeneración de tu fe.', g: 'Tu conciencia sintoniza con las frecuencias de la redención alquímica de forma fluida. Esta conexión facilita una evolución donde la espiritualidad no es una evasión, sino una herramienta de poder real que permite transmutar la debilidad en fortaleza mística, guiando al alma hacia la unión con la fuente a través del despojo consciente.' }, // Neptuno Sextil Pluton
    'Neptune_cua_Pluto': { d: 'Vives una tensión entre tus ideales elevados y las sombras destructivas que acechan en el inconsciente o en el mundo. Esta fricción te obliga a desarrollar un coraje espiritual inmenso, aprendiendo a no dejar que tu fe sea devorada por el cinismo o el miedo, y a usar tu sensibilidad para transformar el dolor en sabiduría.', g: 'Experimentas el conflicto entre el anhelo de pureza y el Arconte de las profundidades tenebrosas. Esta crisis es una prueba de transparencia absoluta: se te exige purificar tu visión de todo velo astral para que tu espíritu pueda enfrentar la sombra sin perder su luz, convirtiendo la agonía del ego en el éxtasis de la liberación.' }, // Neptuno Cuadratura Pluton
    'Neptune_tri_Pluto': { d: 'La inspiración sanadora y el poder de transformación espiritual fluyen en ti de manera espontánea, otorgándote una comprensión profunda de los misterios de la vida y la muerte. Atraes circunstancias que fortalecen tu fe a través de experiencias intensas, permitiéndote vivir con una entrega que transmuta tu realidad.', g: 'Tu ser manifiesta la serenidad del iniciado que ha comprendido la unidad entre el amor y el poder. Gozas de una alineación divina donde la compasión se convierte en una fuerza transformadora irresistible, permitiéndote habitar el mundo como un canal de gracia que redime la materia y manifiesta la gloria eterna del Pleroma.' }, // Neptuno Trigono Pluton
    'Neptune_opo_Pluto': { d: 'Tu búsqueda de trascendencia se ve a menudo confrontada por crisis de poder o pérdidas que ponen a prueba tu capacidad de perdón y entrega. Aprendes a valorarte al descubrir que la luz que buscas en el infinito es la misma fuerza que te permite sobrevivir a tus propios abismos internos.', g: 'Representas la balanza mística entre la disolución del alma y el poder de la muerte proyectados en tu camino evolutivo. Tu camino consiste en encontrar el centro donde la paz no sea debilidad y la transformación no sea pérdida, comprendiendo que el amor divino es la única fuerza capaz de gobernar sobre la tumba y el olvido.' }, // Neptuno Oposicion Pluton
  },
  housesEmpresas: {
// Casa V — Empresa Personal
    '5_Aries':       { d: 'Tu empresa nace de ti: de tu valentía, tu impulso y tu capacidad de arrancar proyectos desde cero. La marca lleva tu sello personal y necesita proyectar fuerza e innovación. Cuanto más auténtica sea tu presencia, más potente será el negocio.', g: 'Marte rige esta Casa: el Logos activo que desciende al mundo material para crear. Tu empresa es un acto de voluntad consciente sobre la materia. Cada lanzamiento es un rito de iniciación en el que el Ego solar se afirma como creador.' },
    '5_Tauro':       { d: 'Tu empresa se construye sobre lo que ya tienes: capital, conocimiento o herramientas concretas. No es un negocio de impulso, sino de acumulación y persistencia. La calidad sensorial y la solidez son tu diferencial en el mercado.', g: 'Venus en la tierra densa: el alma aprende a valorizar la materia como reflejo de la abundancia divina. La empresa es el templo de la forma, donde el espíritu desciende a hacerse tangible. La riqueza acumulada es un símbolo del Pleroma manifestado en lo físico.' },
    '5_Geminis':     { d: 'Tu empresa vive del flujo de información y la comunicación. No necesita activos físicos grandes: necesita ideas claras, versatilidad y presencia digital constante. Si el intercambio de conocimiento se detiene, el negocio pierde fuerza.', g: 'Mercurio como Logos dual: la empresa es un canal entre mundos, un puente entre el conocimiento superior y la comprensión de las masas. El Demiurgo actúa aquí a través de la palabra y el dato; el gnóstico usa esa misma herramienta para despertar conciencias.' },
    '5_Cancer':      { d: 'Tu empresa funciona como un refugio: cuida, contiene y da soporte emocional a quienes la eligen. La marca debe proyectar calidez y empatía. Los vínculos afectivos que generas con el mercado son tu mayor activo.', g: 'La Luna rige la Casa V: el alma-empresa nutre desde la oscuridad fértil del inconsciente colectivo. Como la Gran Madre gnóstica, tu negocio ofrece cobijo a los que buscan amparo. Es un útero espiritual donde el cliente encuentra su centro emocional.' },
    '5_Leo':         { d: 'Tu empresa es una extensión directa de tu identidad: tu rostro, tu nombre y tu energía son la marca. Cuanto más visible y auténtico seas, más fuerte es el negocio. El liderazgo y la creatividad son el motor central.', g: 'El Sol en la Casa de la creación: el Demiurgo solar que se expresa a través de la obra personal. El gnóstico reconoce en este Sol no solo al ego brillante, sino al Pneuma que busca manifestarse. Tu empresa es el vehículo por el que la chispa divina se hace visible en el mundo.' },
    '5_Virgo':       { d: 'Tu empresa se sostiene en la precisión, el orden y la utilidad técnica. La excelencia en la ejecución es lo que te diferencia. Protocolos claros, métodos bien definidos y atención al detalle son las bases del éxito.', g: 'Mercurio en su expresión analítica: el intelecto como herramienta de discernimiento gnóstico. La empresa es el laboratorio donde se separa lo puro de lo impuro, la esencia del accidente. El trabajo meticuloso es una forma de askesis: purificación a través del servicio exacto.' },
    '5_Libra':       { d: 'Tu empresa se define por la armonía, la estética y los vínculos estratégicos. La belleza visual y el trato diplomático son tu diferencial. Los socios y las alianzas son fundamentales para el crecimiento; trabajar en equipo es más poderoso que hacerlo solo.', g: 'Venus como principio de equilibrio cósmico: la empresa busca restaurar la armonía en el mundo material fragmentado. En la cosmología gnóstica, la belleza es un reflejo del Pleroma; tu negocio actúa como un espejo que devuelve al mundo una imagen más ordenada y luminosa.' },
    '5_Escorpio':    { d: 'Tu empresa trabaja con lo profundo: con las necesidades ocultas, los procesos de cambio y la transformación emocional o psicológica. No es un negocio superficial; penetra en lo que el cliente realmente desea, más allá de lo que dice. La transparencia y la ética son indispensables.', g: 'Plutón y Marte en las aguas profundas: la empresa como agente de muerte y renacimiento. En la gnosis, la kénosis es el vaciamiento necesario para recibir la luz. Tu negocio guía al cliente a través de ese descenso iniciático, del caos hacia la regeneración consciente.' },
    '5_Sagitario':   { d: 'Tu empresa tiene vocación de expansión: fronteras, culturas, ideas grandes. El éxito viene de pensar en grande, de ir más allá del mercado local y de posicionarte como una autoridad con propósito y visión. La flexibilidad ante los cambios del entorno es clave.', g: 'Júpiter como Demiurgo expansivo: la empresa como misión hacia la gnosis universal. Sagitario porta la flecha hacia el Absoluto; tu negocio es el arco. Cada cliente alcanzado es un alma que entra en contacto con una verdad más amplia que su horizonte cotidiano.' },
    '5_Capricornio': { d: 'Tu empresa se construye sobre la autoridad, la experiencia y la estructura sólida. El mercado te respeta cuando percibe trayectoria y conocimiento técnico comprobado. Es un negocio de largo plazo: la seriedad y la responsabilidad son la base de todo.', g: 'Saturno como arquitecto cósmico: la empresa como obra que desafía el tiempo. En la gnosis, Saturno es el guardián del umbral, el Demiurgo que pone a prueba al alma. Tu negocio es la piedra de toque donde el espíritu demuestra que puede sostener la materia con integridad.' },
    '5_Acuario':     { d: 'Tu empresa debe ser diferente a todo lo que ya existe. La innovación, lo intangible y las ideas revolucionarias son tu terreno natural. Una propuesta original, accesible y con sentido social es lo que te distingue en el mercado.', g: 'Urano como rayo gnóstico que rompe el orden establecido del Demiurgo. Tu empresa es un acto de subversión creadora: propone un mundo distinto. En la tradición gnóstica, la chispa divina siempre perturba el orden del Kenoma; tu negocio es esa perturbación luminosa.' },
    '5_Piscis':      { d: 'Tu empresa tiene una misión de sanación, trascendencia o acompañamiento espiritual. Es un negocio sensible, adaptable y con vocación de servicio. El mayor riesgo es prometer lo que no puedes cumplir; la honestidad mantiene la credibilidad intacta.', g: 'Neptuno como velo entre mundos: la empresa como puente hacia lo invisible. Piscis en la Casa V convierte al negocio en un canal entre el plano espiritual y el material. En la gnosis, el Pneuma desciende a través de las aguas; tu empresa es el recipiente que lo contiene y lo transmite.' },

    // Casa XI — Clientes y Red
    '11_Aries':      { d: 'Tus clientes son personas de acción, líderes, competitivos y directos. Buscan resultados inmediatos y una respuesta ágil. Tu negocio debe demostrar velocidad y capacidad de potenciar su autonomía. Si no ofreces resultados concretos rápido, buscan otra opción.', g: 'El alma marciana en la Casa de la comunidad: clientes que portan la chispa del Logos activo. En la gnosis, son almas que ya iniciaron su despertar pero necesitan una herramienta para avanzar. Tu servicio es la espada que les ayuda a cortar los velos de la ignorancia.' },
    '11_Tauro':      { d: 'Tus clientes son los más leales que puedes tener. Una vez que comprueban la calidad de tu trabajo, no se van. Son prácticos, constantes y aprecian tanto la utilidad como la presentación impecable. No perdonan que no se cumpla lo prometido.', g: 'El alma venusina en la Casa XI: clientes que buscan en tu servicio la permanencia del bien en el mundo material. En la gnosis, la materia bien trabajada refleja el Pleroma. Tu cliente taurino reconoce esa belleza y la elige; es el alma que quiere anclar la luz en la tierra.' },
    '11_Geminis':    { d: 'Tus clientes son curiosos, inteligentes y están siempre al tanto de las tendencias. Se convencen con datos y argumentos claros, no con promesas vagas. Son poco fieles por naturaleza y comparan constantemente, así que necesitas darles razones sólidas para quedarse.', g: 'El alma mercurial en la Casa de la red: clientes que procesan todo a través del intelecto dual. En la gnosis, son almas que coleccionan información pero aún no han encontrado la síntesis. Tu servicio puede ser el punto de convergencia donde los datos se vuelven conocimiento real.' },
    '11_Cancer':     { d: 'Tus clientes no compran por lógica: compran por el vínculo afectivo y la confianza que les genera tu marca. Son sensibles al trato y buscan sentirse protegidos y comprendidos. Tu negocio debe funcionar como un espacio de seguridad emocional.', g: 'El alma lunar en la Casa XI: clientes que buscan la Gran Madre en tu servicio. En la cosmología gnóstica, el alma desciende al mundo material buscando el calor del hogar perdido. Tu empresa es ese punto de retorno; el cliente canceriano busca en ti el eco del Pleroma que recuerda.' },
    '11_Leo':        { d: 'Tus clientes tienen presencia: son líderes, figuras públicas o personas con un ego marcado que busca lo mejor. Son absorbentes y exigentes, pero cuando confían, son fieles. Necesitan sentirse reconocidos y bien atendidos para quedarse.', g: 'El alma solar en la Casa de la comunidad: clientes que portan la conciencia del rey interior. En la gnosis, el Pneuma solar busca ser reconocido en su nobleza esencial. Tu servicio debe ser el espejo que refleja esa nobleza; cuando el cliente leonino se ve en él, elige quedarse.' },
    '11_Virgo':      { d: 'Tus clientes son prácticos, críticos y muy atentos a los detalles. Detectan cualquier error y valoran la excelencia técnica por encima de todo. Si ofreces algo que nadie más ofrece con esa precisión, se vuelven clientes leales y puntuales.', g: 'El alma mercurial analítica en la Casa XI: clientes que aplican el discernimiento gnóstico a cada servicio. Son almas que separan el grano de la paja de forma natural. Tu negocio debe pasar esa prueba de pureza técnica; si lo hace, el cliente virginiano reconoce en ti un aliado en el camino del conocimiento real.' },
    '11_Libra':      { d: 'Tus clientes valoran la estética, el trato y la presentación tanto como el servicio en sí. Son comunicativos, inteligentes y tienden a compartir recomendaciones: son difusores naturales de tu marca. Un vínculo bien cultivado con ellos se convierte en publicidad espontánea.', g: 'El alma venusina equilibrada en la Casa de la red: clientes que buscan la armonía del Pleroma reflejada en tu servicio. En la gnosis, la belleza es un lenguaje del Absoluto; el cliente libriano reconoce ese lenguaje y lo propaga. Tu empresa, bien presentada, se convierte en un símbolo de orden cósmico para ellos.' },
    '11_Escorpio':   { d: 'Tus clientes investigan a fondo antes de comprarte. Son exigentes, perceptivos y no aceptan nada a medias. Si detectan falta de transparencia, reaccionan con intensidad. Pero si confían en ti, son de los clientes más comprometidos y poderosos que puedes tener.', g: 'El alma plutónica en la Casa XI: clientes que han descendido a sus propios infiernos y buscan un guía que los acompañe en la transformación. En la gnosis, el Escorpio es el umbral de la muerte iniciática. Tu servicio es la antorcha que ilumina ese pasaje; quienes confían en ti están listos para renacer.' },
    '11_Sagitario':  { d: 'Tus clientes son personas con visión amplia, autoridad en su campo y muchas veces con perfil internacional. Son cálidos, dinámicos y capaces de adaptarse si el negocio necesita cambiar. No son clientes locales; piensan en grande y esperan lo mismo de ti.', g: 'El alma jupiteriana en la Casa de la comunidad: clientes que ya apuntan la flecha hacia lo Absoluto. En la gnosis, Sagitario es el arquetipo del buscador que no se detiene. Tu servicio puede ser una estación en ese camino; si les das una verdad más amplia, la llevarán consigo más lejos de lo que imaginas.' },
    '11_Capricornio':{ d: 'Tus clientes son personas con experiencia, ambición y criterio muy formado. Valoran el profesionalismo extremo y la solidez. Son difíciles de impresionar, pero cuando confían en ti como autoridad en lo que haces, se vuelven clientes constantes, leales y con buena capacidad económica.', g: 'El alma saturnina en la Casa XI: clientes que han sido templados por el tiempo y la materia. En la gnosis, Saturno es el Demiurgo justo que pone a prueba al alma antes de dejarla avanzar. Tu cliente capricorniano ya pasó esas pruebas; busca en ti a alguien que también las haya pasado.' },
    '11_Acuario':    { d: 'Tus clientes son innovadores, vanguardistas y a veces con un toque rebelde. Una vez que encuentran en tu servicio lo que nadie más ofrece, se vuelven muy fieles y además aportan ideas para mejorar el negocio. Buscan exclusividad y distinción.', g: 'El alma uraniana en la Casa de la red: clientes que portan la chispa gnóstica de la ruptura. Son almas que ya sienten que el orden establecido del Demiurgo no los contiene. Tu servicio, si es verdaderamente distinto, se convierte para ellos en una prueba de que otro mundo es posible.' },
    '11_Piscis':     { d: 'Tus clientes son sensibles, intuitivos y muchas veces en búsqueda de sanación o de un sostén que les dé estructura. Sienten la marca antes de decidirse por ella. Son mutables en sus demandas, así que contratos claros y pasos definidos evitan malentendidos sin romper el vínculo emocional.', g: 'El alma neptuniana en la Casa XI: clientes que todavía recuerdan, aunque sea de forma velada, el Pleroma del que provienen. En la gnosis, Piscis es el alma que flota entre mundos sin ancla. Tu empresa es ese ancla: les ofrece la estructura que necesitan para que la luz interior no se pierda en el caos del mundo material.' },
  },
  planetasEmpresas: {
// ── Júpiter por Signo ──
    'Jupiter-Aries':       { d: 'Tu expansión llega cuando actúas con valentía y sin esperar permiso. Las oportunidades más grandes de tu vida aparecen cuando tomas la iniciativa, empiezas algo nuevo o te posicionas como pionero en algún campo. La abundancia te exige movimiento, no espera.', g: 'Júpiter en el signo del fuego iniciático: el Logos expansivo se activa a través de la voluntad pura. En la gnosis, el Pneuma avanza rasgando los velos del Kenoma con decisión. Cada acto valiente es una chispa que amplía el espacio de luz dentro de la materia.' },
    'Jupiter-Tauro':       { d: 'Tu expansión viene a través de la paciencia y la acumulación consciente. Las mejores oportunidades llegan cuando construyes sobre bases sólidas y valorizas lo que ya tienes. La prosperidad para ti es tangible: tierra, dinero, calidad de vida sensorial.', g: 'Júpiter en la materia densa de Venus: la abundancia como reflejo del Pleroma en el mundo físico. En la gnosis, la tierra bien trabajada es sagrada porque porta la huella del Creador Supremo. El alma aprende aquí que la riqueza material, bien gestionada, puede ser un camino hacia la luz.' },
    'Jupiter-Geminis':     { d: 'Tu expansión llega a través de las ideas, la comunicación y los contactos. Cuantas más conexiones cultivas y más información procesas, más oportunidades se abren. Tu abundancia viene de aprender, enseñar y circular conocimiento constantemente.', g: 'Júpiter en el signo del Logos dual: la expansión a través de la palabra y el pensamiento. En la gnosis, Mercurio es el mensajero que atraviesa los planos; Júpiter amplifica esa capacidad. El alma se expande aquí multiplicando los puentes entre el conocimiento celeste y el mundo de las formas.' },
    'Jupiter-Cancer':      { d: 'Tu expansión llega a través del hogar, la familia y el cuidado de los demás. Las oportunidades más poderosas se abren cuando actúas desde la empatía y el sentido de pertenencia. La prosperidad para ti tiene raíces profundas y un sabor íntimo.', g: 'Júpiter en las aguas lunares: la abundancia que brota del inconsciente colectivo y del amor incondicional. En la gnosis, la Gran Madre es el recipiente donde el Pneuma se nutre antes de ascender. El alma crece aquí expandiendo su capacidad de dar cobijo y reconocer lo sagrado en lo cotidiano.' },
    'Jupiter-Leo':         { d: 'Tu expansión llega cuando te muestras con confianza y liderazgo. Las oportunidades más grandes aparecen en el escenario público: cuando creas, cuando diriges, cuando te permites brillar sin disculparte. La generosidad también te abre puertas que la timidez cierra.', g: 'Júpiter en el signo solar: el Pneuma que se expande a través del fuego de la conciencia individual. En la gnosis, el Sol interior es el símbolo de la chispa divina reconociéndose a sí misma. Júpiter aquí amplifica esa luz; cada acto creativo auténtico es un gesto de reconocimiento del Absoluto.' },
    'Jupiter-Virgo':       { d: 'Tu expansión llega a través del trabajo bien hecho y el servicio preciso. Las mejores oportunidades aparecen cuando perfeccionas tus métodos, te especializas y demuestras utilidad real. La abundancia no cae del cielo: la construyes con dedicación y análisis.', g: 'Júpiter en el signo del discernimiento mercurial: la expansión a través de la purificación del método. En la gnosis, el análisis riguroso es una forma de separar la luz de la oscuridad en el plano mental. El alma se expande aquí no por grandiosidad, sino por la humildad del servicio exacto.' },
    'Jupiter-Libra':       { d: 'Tu expansión llega a través de las relaciones, las alianzas y la diplomacia. Las mejores oportunidades aparecen cuando colaboras, negocias y creas acuerdos que beneficien a todos. La justicia y la estética son tus herramientas de crecimiento.', g: 'Júpiter en el signo de Venus equilibrada: la abundancia como fruto del orden cósmico restaurado. En la gnosis, el equilibrio es un reflejo del Pleroma; cada relación armoniosa es un pequeño espejo del estado original del alma. El espíritu se expande aquí aprendiendo que la unión consciente amplía la luz.' },
    'Jupiter-Escorpio':    { d: 'Tu expansión llega a través de la transformación y de ir donde otros no se atreven. Las oportunidades más profundas aparecen en las crisis, en los procesos de cambio y en los recursos compartidos. Tu prosperidad crece cuando no le temes a la profundidad.', g: 'Júpiter en las aguas plutónicas: la abundancia que emerge del descenso iniciático. En la gnosis, la muerte del ego es la puerta hacia la verdadera gnosis. Júpiter aquí amplifica la capacidad del alma de renacer; cada transformación profunda es una expansión del Pneuma que rompe otra capa del Kenoma.' },
    'Jupiter-Sagitario':   { d: 'Júpiter está en su propio signo: aquí se expresa con máxima fuerza. Tu expansión llega a través de la filosofía, la aventura, los viajes y la búsqueda de verdad. Las oportunidades son grandes y constantes cuando sigues tu visión con convicción y abres el horizonte.', g: 'Júpiter en su domicilio: el Demiurgo expansivo en su máxima expresión. En la gnosis, el alma que porta esta configuración tiene una misión de expansión de la conciencia colectiva. La flecha sagitariana apunta hacia el Absoluto; Júpiter la impulsa con fuerza. Cada verdad encontrada es un paso de regreso al Pleroma.' },
    'Jupiter-Capricornio': { d: 'Júpiter está en su signo de caída: aquí la expansión es más lenta pero más duradera. Las oportunidades llegan con paciencia, estructura y esfuerzo sostenido. La prosperidad tarda más en manifestarse, pero cuando lo hace, tiene una solidez que pocas posiciones pueden igualar.', g: 'Júpiter en la tierra saturnina: la luz expansiva contenida por la forma. En la gnosis, el Kenoma es el reino de la limitación; Júpiter en Capricornio aprende que la abundancia verdadera solo se sostiene cuando está anclada en la integridad. El alma madura aquí comprendiendo que el orden es un camino, no un obstáculo.' },
    'Jupiter-Acuario':     { d: 'Tu expansión llega a través de las ideas innovadoras, la comunidad y los proyectos que benefician a muchos. Las mejores oportunidades aparecen cuando rompes esquemas y propones algo que nadie había pensado antes. Tu prosperidad tiene un carácter colectivo y visionario.', g: 'Júpiter en el signo uraniano: la expansión como acto de ruptura luminosa. En la gnosis, el Pneuma que despierta perturba el orden del Demiurgo para restaurar la libertad original del alma. Júpiter aquí actúa como el rayo gnóstico que ilumina a las multitudes; cada idea revolucionaria es una chispa del Pleroma que se cuela en el Kenoma.' },
    'Jupiter-Piscis':      { d: 'Tu expansión llega a través de la espiritualidad, la empatía y la entrega al servicio de algo más grande que tú. Las oportunidades aparecen de formas inesperadas, como si el universo conspirara a tu favor cuando actúas desde la fe y la compasión. La prosperidad tiene un sabor místico.', g: 'Júpiter en su codomicilio neptuniano: la abundancia que fluye desde las aguas primordiales del espíritu. En la gnosis, Piscis es el último velo antes del regreso al Pleroma. Júpiter aquí disuelve las fronteras entre el yo y el Todo; el alma se expande al reconocerse como parte del cuerpo del Padre-Madre supremo.' },

    // ── Júpiter por Casa ──
    'Jupiter-Casa1':       { d: 'Júpiter en la Casa 1 te da una presencia expansiva y optimista que los demás perciben de inmediato. Tu imagen proyecta abundancia, generosidad y confianza. Las oportunidades llegan muchas veces simplemente por cómo te presentas ante el mundo.', g: 'Júpiter en la Casa del ser encarnado: el Pneuma que se viste de luz al descender al mundo material. En la gnosis, el cuerpo físico es el templo provisional del alma; con Júpiter aquí, ese templo irradia la memoria del Pleroma. Tu presencia en el mundo es en sí misma una proclamación de abundancia divina.' },
    'Jupiter-Casa2':       { d: 'Júpiter en la Casa 2 favorece la prosperidad material y la capacidad de generar recursos. Tienes una relación natural con la abundancia económica, aunque el riesgo es la extravagancia. Tus valores son expansivos: cuando los honras, el dinero fluye con más facilidad.', g: 'Júpiter en la Casa de los recursos del alma: la abundancia del Pleroma que se filtra en el plano material. En la gnosis, los bienes materiales son chispas de luz congelada en la materia; gestionarlos con consciencia es una forma de liberar esa luz. El alma aprende aquí que la verdadera riqueza incluye, pero trasciende, lo económico.' },
    'Jupiter-Casa3':       { d: 'Júpiter en la Casa 3 expande tu capacidad de comunicarte, aprender y conectar con el entorno cercano. Las oportunidades llegan a través de hermanos, vecinos, estudios y viajes cortos. Tu mente es curiosa y optimista; la palabra es tu herramienta de crecimiento.', g: 'Júpiter en la Casa del Logos cotidiano: la expansión del conocimiento como práctica espiritual diaria. En la gnosis, cada intercambio de información es un acto de transmisión de luz entre almas. Con Júpiter aquí, el alma tiene la misión de ser un puente constante entre el conocimiento superior y el mundo inmediato.' },
    'Jupiter-Casa4':       { d: 'Júpiter en la Casa 4 expande el mundo del hogar, la familia y las raíces. La prosperidad puede venir a través de la familia o de los bienes inmuebles. Tu base emocional es generosa y protectora; el hogar es un espacio de abundancia y crecimiento.', g: 'Júpiter en la Casa de las raíces del alma: la abundancia que brota del inconsciente profundo y de la memoria ancestral. En la gnosis, el hogar es el símbolo del lugar de origen espiritual; con Júpiter aquí, el alma lleva grabada en sus raíces la huella del Pleroma. La familia puede ser un camino de iniciación.' },
    'Jupiter-Casa5':       { d: 'Júpiter en la Casa 5 amplifica la creatividad, el placer, el romance y la capacidad de disfrutar la vida. Las oportunidades llegan a través de proyectos creativos, el amor y la expresión personal. Los hijos, si los hay, pueden ser una fuente de gran expansión y alegría.', g: 'Júpiter en la Casa de la creación: el Pneuma que se expande a través del juego sagrado. En la gnosis, la creatividad es un acto de co-creación con el Absoluto; el alma que crea desde la alegría imita al Padre-Madre en su acto primordial. Júpiter aquí convierte cada expresión auténtica en un gesto de reconexión con el origen.' },
    'Jupiter-Casa6':       { d: 'Júpiter en la Casa 6 expande el campo del trabajo, la salud y el servicio cotidiano. Las oportunidades llegan a través de la dedicación, la especialización y el cuidado del cuerpo. Puedes encontrar abundancia en el trabajo bien hecho y en ayudar a otros de forma práctica.', g: 'Júpiter en la Casa de la askesis cotidiana: la expansión a través del servicio y la purificación del cuerpo. En la gnosis, el cuidado del templo físico es un acto espiritual; con Júpiter aquí, el alma aprende que la humildad del servicio exacto es una de las vías más directas hacia el conocimiento de lo divino.' },
    'Jupiter-Casa7':       { d: 'Júpiter en la Casa 7 expande el mundo de las relaciones, las alianzas y las asociaciones. Las mejores oportunidades de tu vida llegan a través de otras personas. Las relaciones amorosas y de negocios tienden a ser enriquecedoras y a abrir horizontes inesperados.', g: 'Júpiter en la Casa del otro como espejo: la expansión a través del encuentro con el alma que complementa. En la gnosis, el otro es el velo a través del cual el alma puede reconocer una faceta de sí misma que aún no había visto. Con Júpiter aquí, cada relación profunda es una puerta hacia una comprensión más amplia del Pleroma.' },
    'Jupiter-Casa8':       { d: 'Júpiter en la Casa 8 expande los recursos compartidos, las herencias y los procesos de transformación profunda. Las oportunidades llegan a través de situaciones de crisis, de lo oculto o de bienes que vienen de otros. Tu capacidad de renacer después de las dificultades es muy poderosa.', g: 'Júpiter en la Casa de la muerte iniciática: la expansión a través del descenso y el renacimiento. En la gnosis, el alma que atraviesa la muerte del ego conscientemente no pierde nada; gana la comprensión de que el Pneuma es indestructible. Júpiter aquí amplifica cada transformación, convirtiendo cada crisis en una puerta hacia más luz.' },
    'Jupiter-Casa9':       { d: 'Júpiter está en su Casa natural: aquí se expresa con toda su fuerza. Las oportunidades llegan a través de la filosofía, los estudios superiores, los viajes largos y la búsqueda de sentido. Tu mente busca la verdad con entusiasmo y eso te abre puertas que otros ni ven.', g: 'Júpiter en su domicilio natural: el Demiurgo expansivo en el plano de la búsqueda espiritual. En la gnosis, la Casa 9 es el templo del buscador; con Júpiter aquí, el alma tiene una capacidad extraordinaria de aproximarse al Absoluto a través del conocimiento y la experiencia directa. Cada viaje, interno o externo, es una iniciación.' },
    'Jupiter-Casa10':      { d: 'Júpiter en la Casa 10 expande la carrera, la reputación y el lugar que ocupas en el mundo. Las oportunidades llegan a través del reconocimiento público y del ejercicio de la autoridad. Tu camino profesional tiende a la expansión y al liderazgo visible.', g: 'Júpiter en la Casa de la misión pública: el Pneuma que se manifiesta como autoridad espiritual en el mundo. En la gnosis, el alma que asume un rol de liderazgo consciente actúa como un distribuidor de luz en el plano colectivo. Con Júpiter aquí, la vocación pública puede convertirse en una misión gnóstica de despertar.' },
    'Jupiter-Casa11':      { d: 'Júpiter en la Casa 11 expande los amigos, los grupos, las redes y los sueños a largo plazo. Las oportunidades llegan a través de la comunidad y de personas que creen en tu visión. Tus ideales son grandes y tienes la capacidad de convocar a otros alrededor de ellos.', g: 'Júpiter en la Casa de la comunidad de almas: la expansión a través del reconocimiento mutuo entre Pneumas despiertos. En la gnosis, la fraternidad espiritual es una de las formas más elevadas de la vida en el Kenoma. Con Júpiter aquí, el alma tiene la misión de construir redes de luz que anticipen el orden del Pleroma en el mundo material.' },
    'Jupiter-Casa12':      { d: 'Júpiter en la Casa 12 expande el mundo interior: la espiritualidad, el retiro y el contacto con lo invisible. Las oportunidades más grandes llegan en el silencio, en la soledad creativa y en el servicio desinteresado. La abundancia puede venir de formas inesperadas y ocultas.', g: 'Júpiter en la Casa del velo: la expansión en el umbral entre el mundo visible y el Pleroma. En la gnosis, la Casa 12 es el espacio donde el alma recuerda su origen antes de que la memoria del mundo la cubra del todo. Con Júpiter aquí, el alma tiene acceso privilegiado a la gracia; la abundancia llega desde lo invisible porque el Pneuma está cerca de su fuente.' },

    // ── Saturno por Signo ──
    'Saturn-Aries':       { d: 'Saturno en Aries te pide aprender a actuar con valentía sin perder el control. La impulsividad es tu mayor obstáculo; la disciplina en la acción es tu mayor logro. Cuando aprendes a iniciar con estructura y no solo con instinto, la vida deja de ponerte frenos.', g: 'Saturno en el signo del fuego iniciático: el Demiurgo que pone a prueba la voluntad del alma antes de dejarla avanzar. En la gnosis, la impaciencia es uno de los velos del Kenoma; Saturno en Aries enseña que la verdadera voluntad no es impulsiva, sino templada. El alma madura aquí aprendiendo que la acción consciente vale más que mil actos ciegos.' },
    'Saturn-Tauro':       { d: 'Saturno en Tauro te pide construir una relación sana con el dinero, los recursos y la materia. El miedo a la escasez puede ser un obstáculo; la disciplina financiera y la paciencia son tus herramientas de liberación. Lo que construyes con constancia aquí dura para siempre.', g: 'Saturno en la tierra densa de Venus: el Demiurgo que pone a prueba el apego del alma a la materia. En la gnosis, Tauro representa el riesgo de confundir la chispa de luz con el recipiente que la contiene. Saturno aquí enseña al alma a valorar la materia sin quedar atrapada en ella; la verdadera riqueza es la que no puede perderse.' },
    'Saturn-Geminis':     { d: 'Saturno en Géminis te pide disciplinar la mente y la comunicación. La dispersión y la superficialidad son los obstáculos; la profundidad intelectual y la coherencia entre lo que piensas y lo que dices son tus grandes logros. Cuando aprendes a enfocar tu mente, tu palabra se vuelve poderosa.', g: 'Saturno en el signo del Logos dual: el Demiurgo que impone forma al pensamiento errante. En la gnosis, la mente sin disciplina es un instrumento del Kenoma que dispersa la luz. Saturno en Géminis obliga al alma a elegir: o usa la palabra para despertar conciencias o la desperdicia en el ruido. El silencio interior es la puerta.' },
    'Saturn-Cancer':      { d: 'Saturno en Cáncer te pide trabajar la relación con el hogar, la familia y las emociones. Puede haber cargas emocionales heredadas o dificultades con figuras maternas. Tu mayor logro es construir una base emocional sólida desde adentro, sin depender de que el entorno te la dé.', g: 'Saturno en las aguas lunares: el Demiurgo que pone a prueba el vínculo del alma con su origen. En la gnosis, el hogar emocional es el primer velo que el alma debe atravesar para encontrar el hogar verdadero en el Pleroma. Saturno en Cáncer enseña que el amor incondicional solo se da cuando el alma deja de buscar completarse en el exterior.' },
    'Saturn-Leo':         { d: 'Saturno en Leo te pide trabajar el ego y la autoexpresión. El miedo al juicio, la vergüenza o la necesidad de aprobación pueden bloquearte. Tu mayor logro es brillar con autenticidad, sin necesitar que otros te validen. La creatividad se libera cuando ya no le temes al escenario.', g: 'Saturno en el signo solar: el Demiurgo que pone a prueba la autenticidad de la chispa interior. En la gnosis, el ego inflamado es uno de los obstáculos más gruesos del Kenoma; Saturno en Leo enseña al alma a distinguir entre la luz del Pneuma genuino y el brillo falso del reconocimiento externo. Solo cuando deja de buscar aplausos, la luz verdadera se enciende.' },
    'Saturn-Virgo':       { d: 'Saturno en Virgo te pide soltar el perfeccionismo paralizante y aprender a servir con humildad sin caer en la autocrítica destructiva. La disciplina del trabajo bien hecho es tu virtud; la obsesión por el error es tu obstáculo. Cuando encuentras el equilibrio, tu precisión se vuelve un don extraordinario.', g: 'Saturno en el signo del discernimiento: el Demiurgo que afina el instrumento del alma hasta que corte con precisión. En la gnosis, el análisis excesivo puede convertirse en otro velo del Kenoma si el alma lo usa para no avanzar. Saturno en Virgo enseña que el servicio perfecto no es el que no tiene errores, sino el que se ofrece con integridad total.' },
    'Saturn-Libra':       { d: 'Saturno está en su exaltación en Libra: aquí trabaja con máxima efectividad. Te pide aprender la justicia, el equilibrio en las relaciones y la disciplina en los acuerdos. Las relaciones pueden ser un área de trabajo serio, pero cuando maduras en ellas, construyes vínculos de una solidez excepcional.', g: 'Saturno en su exaltación: el Demiurgo como arquetipo de la justicia cósmica. En la gnosis, el equilibrio es el estado que el Kenoma perdió al separarse del Pleroma; Saturno exaltado en Libra es el guardián que recuerda esa ley. El alma que porta esta posición tiene la misión de restaurar el orden en cada vínculo que toca.' },
    'Saturn-Escorpio':    { d: 'Saturno en Escorpio te pide trabajar el poder, el control y el miedo a la pérdida y a la muerte. Las situaciones de crisis y transformación son tus grandes escuelas. Cuando dejas de temer lo que no puedes controlar y te entregas al proceso de cambio, tu fuerza interior se vuelve indestructible.', g: 'Saturno en las aguas plutónicas: el Demiurgo que conduce al alma a través de la muerte iniciática con rigurosidad. En la gnosis, el descenso a los infiernos es necesario para recuperar la luz que quedó atrapada en la materia más densa. Saturno en Escorpio enseña que no hay resurrección sin crucifixión; el alma que acepta esto gana una libertad que nada puede quitarle.' },
    'Saturn-Sagitario':   { d: 'Saturno en Sagitario te pide disciplinar las creencias y la búsqueda de sentido. El dogmatismo y la dispersión filosófica son los obstáculos. Tu mayor logro es construir una visión del mundo sólida y coherente que puedas transmitir con autoridad. La verdad que te cuesta encontrar es la que más vale.', g: 'Saturno en el signo del buscador: el Demiurgo que pone a prueba la sinceridad de la búsqueda espiritual. En la gnosis, la Casa de la filosofía puede ser un camino de liberación o un laberinto de conceptos vacíos; Saturno aquí exige que cada creencia sea vivida, no solo pensada. El alma madura cuando su filosofía y su vida son lo mismo.' },
    'Saturn-Capricornio': { d: 'Saturno está en su domicilio en Capricornio: aquí se expresa con máxima fuerza. La disciplina, la ambición estructurada y la responsabilidad son tus herramientas naturales. Las pruebas pueden ser duras, pero la solidez que construyes con ellas es la base de un éxito que nadie puede quitarte.', g: 'Saturno en su domicilio: el Demiurgo en su máxima expresión como arquitecto de la forma. En la gnosis, Saturno es el guardián del umbral entre el Kenoma y el Pleroma; en Capricornio, esa función es total. El alma que porta esta posición tiene la misión de demostrar que la materia puede ser habitada con integridad absoluta; es el constructor del templo en el mundo denso.' },
    'Saturn-Acuario':     { d: 'Saturno en Acuario te pide estructurar tus ideales y aprender a trabajar con otros sin perder tu independencia. El riesgo es el alejamiento emocional o el cinismo; el logro es convertirte en un arquitecto de sistemas que sirven al bien colectivo con una frialdad que en realidad es claridad.', g: 'Saturno en su codomicilio uraniano: el Demiurgo que impone forma a la visión revolucionaria. En la gnosis, la libertad sin estructura es otra trampa del Kenoma; Saturno en Acuario enseña que la verdadera emancipación del alma requiere disciplina colectiva. El alma madura aquí cuando sus ideales se convierten en actos concretos que transforman el mundo de adentro hacia afuera.' },
    'Saturn-Piscis':      { d: 'Saturno en Piscis te pide poner límites a la confusión emocional y espiritual. El riesgo es disolverse en el caos o escapar de la realidad; el logro es aprender a habitar lo invisible con rigor y convertir la espiritualidad en una práctica concreta y honesta. Los límites no te separan del Todo: te permiten servirlo mejor.', g: 'Saturno en las aguas primordiales: el Demiurgo que intenta dar forma a lo informe. En la gnosis, Piscis es el último velo antes del Pleroma; Saturno aquí es la prueba final del alma antes del retorno. La lección es que incluso en el umbral de la disolución, la consciencia debe mantenerse lúcida. El alma que logra esto no se pierde en el océano: se convierte en él sin olvidar quién es.' },

    // ── Saturno por Casa ──
    'Saturn-Casa1':       { d: 'Saturno en la Casa 1 te da una presencia seria, responsable y a veces austera. La vida te ha pedido madurar pronto y hacerte cargo de ti mismo. Con el tiempo, esa seriedad se convierte en una autoridad natural que los demás respetan y en la que confían.', g: 'Saturno en la Casa del ser encarnado: el Demiurgo que pesa sobre el alma desde el momento de la encarnación. En la gnosis, el cuerpo físico puede sentirse como una carga cuando el alma recuerda la ligereza del Pleroma. Saturno en Casa 1 enseña que asumir el cuerpo con plenitud y responsabilidad es el primer paso del camino gnóstico.' },
    'Saturn-Casa2':       { d: 'Saturno en la Casa 2 te pide trabajar seriamente tu relación con el dinero y los recursos. Puede haber escasez o esfuerzo sostenido antes de la estabilidad económica, pero lo que construyes con disciplina aquí dura. El valor que te das a ti mismo también es parte de esta lección.', g: 'Saturno en la Casa de los recursos del alma: el Demiurgo que pone a prueba el vínculo entre el ser y la materia. En la gnosis, los recursos son energía cristalizada; Saturno aquí enseña al alma a no confundir su valor esencial con lo que posee. La verdadera riqueza que construye esta posición es la del alma que sabe sostenerse sin depender de lo externo.' },
    'Saturn-Casa3':       { d: 'Saturno en la Casa 3 te pide disciplinar la mente, la comunicación y las relaciones con hermanos y entorno cercano. Puede haber dificultades en el aprendizaje temprano o con figuras de hermanos. Tu mayor logro es convertirte en alguien que piensa con profundidad y habla con precisión.', g: 'Saturno en la Casa del Logos cotidiano: el Demiurgo que impone estructura al flujo de la información. En la gnosis, la palabra sin disciplina es un instrumento del Kenoma que multiplica la confusión. Saturno en Casa 3 enseña al alma que el silencio interior es la condición de la palabra verdadera; hablar menos y con más precisión es un acto espiritual.' },
    'Saturn-Casa4':       { d: 'Saturno en la Casa 4 puede traer cargas relacionadas con el hogar de origen, la familia o las raíces. La relación con el padre o la figura de autoridad en la infancia puede haber sido exigente o distante. Tu mayor logro es construir desde adentro una base emocional que no dependa del origen.', g: 'Saturno en la Casa de las raíces del alma: el Demiurgo que graba su huella en el inconsciente más profundo. En la gnosis, el hogar de origen es el primer Kenoma que el alma debe aprender a trascender sin rechazarlo. Saturno aquí enseña que la verdadera raíz del alma no está en la familia ni en la tierra, sino en el Pleroma del que viene.' },
    'Saturn-Casa5':       { d: 'Saturno en la Casa 5 puede bloquear o retrasar la expresión creativa, el romance o la relación con los hijos. El miedo al juicio puede inhibir la autenticidad. Tu mayor logro es aprender a crear y a disfrutar con disciplina y sin vergüenza; cuando lo logras, tu expresión tiene una profundidad que pocos alcanzan.', g: 'Saturno en la Casa de la creación: el Demiurgo que pone a prueba la autenticidad del acto creador. En la gnosis, crear desde el miedo es crear desde el Kenoma; crear desde la libertad interior es imitar al Absoluto. Saturno en Casa 5 enseña que la obra más poderosa nace cuando el alma acepta su don y lo ofrece sin calcular el aplauso.' },
    'Saturn-Casa6':       { d: 'Saturno en la Casa 6 te pide una disciplina rigurosa en el trabajo, la salud y los hábitos cotidianos. El cuerpo puede ser un área de trabajo serio; los compromisos laborales pueden ser exigentes. Tu mayor logro es construir una rutina de servicio y cuidado que se convierta en la base de todo lo demás.', g: 'Saturno en la Casa de la askesis: el Demiurgo que convierte el trabajo cotidiano en un camino de purificación. En la gnosis, el cuidado del cuerpo y el servicio exacto son prácticas espirituales cuando se hacen con consciencia. Saturno en Casa 6 enseña que la disciplina del cuerpo y del hábito es la base sobre la que el Pneuma puede actuar en el mundo denso.' },
    'Saturn-Casa7':       { d: 'Saturno en la Casa 7 te pide trabajar seriamente las relaciones y los acuerdos. Las relaciones importantes pueden llegar tarde o traer responsabilidades grandes. Tu mayor logro es construir vínculos basados en el compromiso real, no en la ilusión; lo que construyes con otro cuando has madurado esto dura para toda la vida.', g: 'Saturno en la Casa del otro como espejo: el Demiurgo que usa el vínculo para revelar al alma lo que aún no ha resuelto en sí misma. En la gnosis, el otro es siempre un iniciador; con Saturno aquí, cada relación importante es una prueba de madurez espiritual. El alma que pasa esa prueba aprende que el amor verdadero no es fusión, sino reconocimiento entre dos seres libres.' },
    'Saturn-Casa8':       { d: 'Saturno en la Casa 8 te pide trabajar el miedo a la pérdida, a la muerte y al poder. Los recursos compartidos, las herencias y las crisis profundas son tus grandes escuelas. Tu mayor logro es transformarte conscientemente; cuando dejas de resistir el cambio, tu fuerza interior se vuelve extraordinaria.', g: 'Saturno en la Casa de la muerte iniciática: el Demiurgo como guardián del umbral entre la vida y la muerte. En la gnosis, la Casa 8 es el espacio donde el alma debe soltar todo lo que no es Pneuma para poder avanzar. Saturno aquí es riguroso pero justo; cada pérdida que impone es una capa del Kenoma que cae, dejando al descubierto más luz.' },
    'Saturn-Casa9':       { d: 'Saturno en la Casa 9 te pide construir tus creencias con rigor y honestidad. El dogmatismo o la falta de fe pueden ser obstáculos. Tu mayor logro es desarrollar una filosofía de vida sólida, basada en experiencias reales y no en dogmas heredados; esa visión del mundo madura se convierte en tu mayor autoridad.', g: 'Saturno en la Casa del buscador: el Demiurgo que pone a prueba la profundidad de la búsqueda espiritual. En la gnosis, la filosofía que no ha sido vivida es un velo más del Kenoma. Saturno en Casa 9 enseña que el verdadero conocimiento gnóstico no se hereda ni se aprende solo con libros: se conquista en el camino, con el cuerpo y el alma juntos.' },
    'Saturn-Casa10':      { d: 'Saturno en la Casa 10 es una posición de gran responsabilidad pública. La carrera puede ser exigente y el reconocimiento llega con esfuerzo sostenido y tiempo. Pero lo que construyes en el mundo profesional con esta posición tiene una solidez y una autoridad que muy pocos logran igualar.', g: 'Saturno en su Casa natural: el Demiurgo en el plano de la misión pública. En la gnosis, el liderazgo consciente es un servicio espiritual al colectivo; Saturno en Casa 10 convierte la carrera en un camino de prueba y maduración del alma. El logro público más alto de esta posición no es la fama, sino la integridad demostrada a lo largo del tiempo.' },
    'Saturn-Casa11':      { d: 'Saturno en la Casa 11 te pide trabajar los grupos, las amistades y los ideales colectivos con seriedad. Las amistades pueden ser pocas pero muy sólidas; los sueños a largo plazo requieren estructura y esfuerzo. Tu mayor logro es construir una red de vínculos basada en la lealtad real y en proyectos con propósito genuino.', g: 'Saturno en la Casa de la comunidad de almas: el Demiurgo que pone a prueba la autenticidad del vínculo colectivo. En la gnosis, la fraternidad espiritual no es un sentimiento sino un compromiso vivido. Saturno en Casa 11 enseña que las redes de luz verdaderas se construyen despacio, con personas que han sido probadas y que eligen quedarse no por comodidad, sino por misión compartida.' },
    'Saturn-Casa12':      { d: 'Saturno en la Casa 12 te pide confrontar los miedos más profundos, las cargas kármicas y los patrones inconscientes. El retiro, la soledad y el trabajo interior pueden ser exigentes, pero son tus grandes maestros. Tu mayor logro es transformar lo que estaba oculto en la mayor fuente de tu sabiduría.', g: 'Saturno en la Casa del velo final: el Demiurgo en el umbral entre el Kenoma y el Pleroma. En la gnosis, la Casa 12 es el lugar donde el alma enfrenta todo lo que no ha resuelto antes de poder regresar a su origen. Saturno aquí es el más severo de los iniciadores, pero también el más honesto: lo que libera en este espacio ya no puede volver a encadenarte.' },
  },
  regenteCasaII: {
    'regente2-Aries':       { d: 'El planeta que administra tu Casa del dinero opera desde Aries: impulso, iniciativa y velocidad. Tus recursos se mueven con la misma energía con que atacas un proyecto nuevo — rápido, directo, sin rodeos. El dinero llega cuando actúas antes de que otros terminen de pensar, y se escapa cuando te detienes a dudar demasiado. Tu ventaja financiera es la primera jugada; tu riesgo, quemar lo ganado antes de consolidarlo.', g: 'Gnósticamente, el guardián de tus recursos se expresa a través del fuego iniciático de Aries: la voluntad que no pide permiso. El dinero es aquí un espejo de tu relación con la fuerza primordial del alma. Cuando actúas desde tu chispa auténtica, los recursos fluyen. Cuando imitas o pospones, el flujo se corta.' },
    'regente2-Tauro':       { d: 'El planeta que rige tu Casa II se asienta en Tauro: paciencia, acumulación y valor tangible. Tus finanzas prosperan cuando construyes con lentitud y solidez, cuando inviertes en lo que dura y evitas la especulación vacía. Tienes un instinto natural para detectar lo que vale de verdad — úsalo. El peligro es la inercia: quedarte en lo seguro cuando la situación ya pide movimiento.', g: 'El guardián de tus recursos habla el lenguaje de la materia sagrada. En la gnosis, Tauro es el signo donde el espíritu aprende que la materia no es el enemigo — es el vehículo. Construir riqueza con consciencia es aquí un acto espiritual: conviertes el mundo denso en sustento para el alma.' },
    'regente2-Geminis':     { d: 'El regente de tu Casa II opera desde Géminis: tus recursos se generan a través de la palabra, la información, las conexiones y la versatilidad. Puedes tener múltiples fuentes de ingreso simultáneas, y eso es una fortaleza — siempre que no disperses tanta energía que ninguna prospere del todo. Tu capital más real es lo que sabes y a quién conoces.', g: 'Mercurio mediando los recursos del alma: la gnosis llega aquí por el intercambio consciente de conocimiento. Compartir lo que sabes no te empobrece — te multiplica. El riesgo es quedarte en la superficie de muchas fuentes sin profundizar en ninguna.' },
    'regente2-Cancer':      { d: 'El planeta que custodia tu Casa II actúa desde Cáncer: tus finanzas están profundamente ligadas a la seguridad emocional, el hogar y los vínculos familiares. Puedes generar mucho cuando te sientes contenido y protegido; cuando hay inestabilidad emocional, el flujo financiero lo acusa. Tu intuición sobre dinero es extraordinaria — aprende a confiar en ella.', g: 'El guardián de tus recursos opera desde las aguas del alma. En la tradición gnóstica, Cáncer representa la memoria del pleroma — el lugar de origen al que el alma quiere regresar. Tu abundancia crece cuando creas desde ese lugar de pertenencia genuina, no desde el miedo a la escasez.' },
    'regente2-Leo':         { d: 'El regente de tu Casa II brilla desde Leo: generosidad, visibilidad y creación son tus motores financieros. Ganas más cuando te permites destacar, cuando tu trabajo tiene tu sello personal inconfundible y cuando no minimizas lo que vales. El peligro es gastar en imagen más de lo que produce la imagen — o esperar reconocimiento antes de actuar.', g: 'El Sol como regente espiritual de tus recursos: en la gnosis, Leo es la expresión del pneuma solar en el plano manifestado. Cuando creas desde tu esencia y no desde la actuación, el universo respalda esa expresión con abundancia. Tu riqueza más profunda es la certeza de que lo que traes merece existir.' },
    'regente2-Virgo':       { d: 'El planeta que rige tu Casa II trabaja desde Virgo: análisis, precisión y servicio concreto. Tus recursos crecen cuando perfeccionas lo que haces, cuando ofreces soluciones reales a problemas reales y cuando administras con inteligencia cada euro que entra. El riesgo es la hiperexigencia: no lanzarte porque nada parece suficientemente bueno todavía.', g: 'Mercurio analítico al frente de tus recursos: en la gnosis, Virgo es el signo que purifica la materia a través del discernimiento. Cada vez que perfeccionas tu servicio con intención espiritual, no solo mejoras tu oferta — estás refinando el instrumento que el alma usa para manifestar el bien en el mundo.' },
    'regente2-Libra':       { d: 'El regente de tu Casa II opera desde Libra: tus recursos se mueven mejor en par que en solitario. Las alianzas, asociaciones y acuerdos justos son tu terreno financiero natural. Tienes habilidad para negociar y para crear valor donde otros solo ven conflicto. El riesgo es ceder demasiado por mantener la armonía, o no actuar hasta tener la aprobación de alguien más.', g: 'Venus mediando la sustancia del alma: Libra en la gnosis es el signo de la reciprocidad consciente — el intercambio donde ambas partes reciben lo que necesitan. Tu abundancia crece en la medida en que aprendes que recibir es tan sagrado como dar.' },
    'regente2-Escorpio':    { d: 'El planeta que custodia tu Casa II actúa desde Escorpio: tus recursos se regeneran a través de procesos de transformación profunda. Puedes perder y reconstruir desde cero con una capacidad que asombra a quienes te rodean. Tu relación con el dinero ajeno — inversiones, herencias, créditos — puede ser clave. El peligro es el control excesivo o el todo-o-nada en las decisiones financieras.', g: 'El guardián de tus recursos opera desde las profundidades plutonianas. En la gnosis, Escorpio es la muerte del ego que precede al renacimiento del espíritu. Tu riqueza más real emerge cuando dejas ir lo que ya no sirve — incluyendo creencias limitantes sobre lo que mereces.' },
    'regente2-Sagitario':   { d: 'El regente de tu Casa II se mueve desde Sagitario: expansión, visión y fe son tus aliados financieros. Tus recursos crecen cuando operas en grande, cuando cruzas fronteras — literales o mentales — y cuando actúas desde la confianza en lugar del miedo. El riesgo es el exceso: comprometerte más de lo que puedes sostener o apostar sin haber calculado el suelo.', g: 'Júpiter al frente de tus recursos espirituales: en la gnosis, Sagitario es la flecha que apunta hacia el conocimiento superior. Tu abundancia no tiene techo cuando sirves a algo más grande que tú mismo. La prosperidad aquí es consecuencia de la expansión de consciencia, no de la acumulación por acumulación.' },
    'regente2-Capricornio': { d: 'El planeta que rige tu Casa II trabaja desde Capricornio: disciplina, estructura y tiempo largo. Tus finanzas son sólidas cuando construyes con paciencia, cuando respetas los procesos y cuando no buscas atajos que comprometan la solidez. Puede que al principio cueste más que a otros — pero lo que construyes dura. El riesgo es sacrificar calidad de vida presente por una seguridad futura que nunca llega.', g: 'Saturno como guardián de los recursos del alma: en la tradición gnóstica, Capricornio es el signo donde el espíritu aprende la ley del esfuerzo consciente. La materia no se rinde ante quien la exige — se rinde ante quien la trabaja con paciencia e intención. Tu abundancia es el fruto de un karma bien administrado.' },
    'regente2-Acuario':     { d: 'El regente de tu Casa II opera desde Acuario: innovación, red y originalidad son tus palancas financieras. Tus recursos crecen cuando piensas diferente, cuando tu propuesta tiene algo que nadie más ofrece y cuando construyes comunidad alrededor de lo que haces. El peligro es desconectarte de las necesidades reales del mercado por estar demasiado adelantado a tu tiempo.', g: 'Urano al frente de tus recursos: en la gnosis, Acuario es el signo de la liberación colectiva. Tu abundancia tiene un propósito que va más allá de ti. Cuando sirves a la evolución del grupo, los recursos fluyen como consecuencia natural de ese alineamiento.' },
    'regente2-Piscis':      { d: 'El planeta que custodia tu Casa II actúa desde Piscis: intuición, fe y servicio incondicional son tus canales financieros más potentes. Puedes ganar de formas que no siempre se explican lógicamente — porque tu relación con el dinero opera en parte desde el plano invisible. El riesgo es la falta de límites: dar sin medida, confiar sin discernir o esconder la cabeza ante los números.', g: 'Neptuno al frente de tus recursos: en la gnosis, Piscis es el lugar donde el alma recuerda su origen en el pleroma. Tu mayor abundancia llega cuando no te aferras a ella — cuando confías en el flujo y lo usas al servicio de algo que trasciende el ego.' },
  },
