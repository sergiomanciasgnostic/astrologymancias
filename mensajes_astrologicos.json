// INTERP_ASTEROIDES
// ════════════════════════════════════════════════════
window._INTERP_ASTEROIDES = {
'Admetos-Aries': {
    d: 'La fuerza de Admetos frena tu impulso natural. Aquí el peligro es la frustración por no poder avanzar rápido. La lección es que la verdadera potencia no es la velocidad, sino la capacidad de resistir la presión sin quebrarse.',
    g: 'Es la cristalización del fuego. Tu espíritu aprende que la voluntad no solo es avanzar, sino saber sostenerse en el centro cuando el mundo exterior se detiene. Lo que nace de esta pausa es una fuerza inquebrantable.'
  },
  'Admetos-Tauro': {
    d: 'Aquí Admetos se siente en casa por la densidad. Indica una resistencia extrema al cambio y una tendencia a la inercia material. Los procesos de ganancia o estabilidad son lentos pero absolutamente sólidos.',
    g: 'Representa la purificación de la materia. Te enseña que el verdadero valor no es la acumulación, sino la esencia de lo que perdura tras el paso del tiempo. Es el diamante formándose bajo la presión de la tierra.'
  },
  'Admetos-Geminis': {
    d: 'La mente se vuelve profunda y a veces obsesiva. Hay una ralentización en la comunicación o bloqueos en el aprendizaje que te obligan a profundizar en un solo tema en lugar de dispersarte.',
    g: 'Es el silencio del Logos. Admetos aquí te obliga a dejar de hablar para empezar a escuchar la vibración interna. La sabiduría llega cuando la mente deja de saltar y se enfoca en el núcleo de la verdad.'
  },
  'Admetos-Cancer': {
    d: 'Procesos emocionales que parecen no tener fin o una sensación de carga pesada en las raíces familiares. La protección se vuelve tan densa que puede asfixiar si no se aprende a soltar.',
    g: 'Señala la destilación de la memoria del alma. Admetos comprime tus emociones para que dejes de buscar refugio en el pasado y encuentres el santuario eterno e inamovible que habita dentro de tu pneuma.'
  },
  'Admetos-Leo': {
    d: 'El reconocimiento y la expresión creativa se ven ralentizados. Indica que tu luz interna está pasando por un proceso de condensación: no es tiempo de brillar hacia afuera, sino de fortalecer el centro.',
    g: 'Es la purificación de la soberanía. Admetos aplasta la vanidad para que solo quede el honor real. Tu victoria aquí es entender que el sol no necesita aplausos para seguir ardiendo en su propia majestad.'
  },
  'Admetos-Virgo': {
    d: 'Obsesión por la perfección y procesos de salud o trabajo que avanzan a paso de tortuga. Hay una tendencia a quedar atrapado en el detalle mínimo, perdiendo la fluidez del servicio.',
    g: 'Representa la alquimia del detalle. Admetos te obliga a encontrar lo sagrado en lo más pequeño y denso. Te liberas cuando comprendes que el orden divino no se impone, se descubre en la esencia de cada átomo.'
  },
  'Admetos-Libra': {
    d: 'Las relaciones pasan por periodos de estancamiento o de una seriedad aplastante. Los vínculos son pocos pero de una profundidad y responsabilidad inmensas, a menudo sintiéndose como una carga.',
    g: 'Es la prueba del equilibrio absoluto. Admetos comprime la dualidad para que dejes de buscar la paz en el otro. La armonía llega cuando el alma se siente completa en sí misma, sin depender del espejo externo.'
  },
  'Admetos-Escorpio': {
    d: 'Aquí la densidad es subterránea y poderosa. Representa procesos de muerte y transformación que duran años. Es el punto de no retorno donde lo viejo se condensa hasta que solo queda el poder puro.',
    g: 'Señala la entrada al abismo más profundo. Admetos aquí no te deja huir de tu propia sombra. La liberación ocurre cuando aceptas la presión total de la transmutación, permitiendo que el ego muera para que el espíritu nazca.'
  },
  'Admetos-Sagitario': {
    d: 'La búsqueda de sentido se vuelve pesada y filosóficamente densa. Hay bloqueos en viajes largos o estudios superiores que te obligan a mirar hacia adentro en lugar de buscar la expansión fuera.',
    g: 'Es la compresión del horizonte. Admetos te enseña que no hay lugar a donde ir si no has conquistado tu propio centro. La Gnosis aquí es entender que la verdad no está lejos, sino comprimida en tu propio corazón.'
  },
  'Admetos-Capricornio': {
    d: 'La ambición y el estatus se ven sometidos a una ley de tiempo implacable. El éxito llega solo después de una resistencia y un esfuerzo monumentales. Indica una vejez o un legado de gran solidez.',
    g: 'Representa el rigor de la Ley Eterna. Admetos aquí actúa como el Gran Arquitecto que te obliga a construir sobre lo indestructible. Tu espíritu se templa en la soledad y el deber hacia su propia luz.'
  },
  'Admetos-Acuario': {
    d: 'Aislamiento social o una sensación de ser el único que sostiene una verdad pesada. Las innovaciones tardan en ser aceptadas, obligándote a resistir en tu originalidad a pesar del entorno.',
    g: 'Es el frío del espacio estelar. Admetos te separa de la matriz mediante el desapego radical. Te liberas cuando comprendes que tu soledad no es vacío, sino la plenitud de una conciencia que ya no encaja en lo denso.'
  },
  'Admetos-Piscis': {
    d: 'Sentimientos de sacrificio extremo o una confusión que parece inamovible. Hay una tendencia a quedar atrapado en el sufrimiento colectivo o en una inercia espiritual que exige una entrega total.',
    g: 'Representa la disolución de la última resistencia. Admetos comprime tus fantasías para que solo quede la fe pura. Te encuentras a ti mismo cuando dejas de luchar contra la presión y permites que el océano divino te absorba.'
  },
  'Amor-Aries': {
    d: 'Expresas el amor incondicional a través de un impulso protector y valiente. Tu devoción se manifiesta en actos de fe inmediata; amas con la fuerza de quien inicia un fuego sagrado, sin miedo a ser el primero en entregarse por una causa o persona.',
    g: 'Es el amor como voluntad despierta. El ágape se activa cuando tu acción deja de buscar la autoafirmación y se convierte en un motor de liberación para otros. Amas cuando tu fuego no quema, sino que ilumina el camino del alma hacia su soberanía.'
  },
  'Amor-Tauro': {
    d: 'Tu amor incondicional es una presencia sólida, paciente y nutritiva. Se manifiesta en la lealtad inquebrantable a la vida y en el respeto por la belleza sagrada de la materia. Amas a través del sustento y de la constancia que no exige cambios.',
    g: 'Representa la devoción a la sustancia divina. Te elevas sobre el ego cuando dejas de poseer para empezar a venerar la presencia del espíritu en lo físico. El amor aquí es el reconocimiento de la plenitud que ya habita en el silencio de lo creado.'
  },
  'Amor-Geminis': {
    d: 'Amas incondicionalmente a través del entendimiento y la comunicación sin juicios. Tu devoción se expresa al ver todas las facetas del ser y aceptar su complejidad. El amor fluye cuando te conviertes en un puente de luz intelectual para los demás.',
    g: 'Es el amor como Logos en movimiento. Sublimas el deseo cuando tus palabras dejan de persuadir para empezar a sanar. El ágape nace al comprender que toda mente es una chispa de la Mente Universal, uniendo los fragmentos de la Verdad a través del afecto.'
  },
  'Amor-Cancer': {
    d: 'Tu capacidad de amar trasciende lo personal a través de una nutrición mística y un instinto de refugio universal. Amas con la ternura de quien reconoce en cada ser a un hermano espiritual que necesita ser cuidado y recordado en su origen.',
    g: 'Representa el amor como retorno al Pleroma. Tu alma accede a la fuente inagotable cuando dejas de buscar exclusividad emocional y te conviertes en el útero protector para la chispa divina que sufre en la materia, amando sin condiciones de sangre.'
  },
  'Amor-Leo': {
    d: 'Expresas un amor radiante, generoso y noble que busca elevar a los demás. Tu devoción es una celebración de la luz interna; amas incondicionalmente cuando inspiras a otros a reconocer su propia grandeza y su linaje divino.',
    g: 'Es el amor como soberanía espiritual. El eros se sublima cuando dejas de brillar para ser visto y empiezas a irradiar para que otros vean. Amas desde el corazón solar, donde la abundancia del espíritu fluye porque sabe que su riqueza es infinita.'
  },
  'Amor-Virgo': {
    d: 'Tu amor incondicional se manifiesta en el servicio humilde y en el cuidado minucioso del bienestar ajeno. Amas a través de la purificación de la vida diaria, entregándote a la labor necesaria con una devoción que no espera reconocimiento.',
    g: 'Representa el amor como sacerdocio cotidiano. Accedes al ágape cuando cada pequeño acto de ayuda es una ofrenda a la divinidad. Tu amor es conocimiento vivo: la sabiduría de entender que la perfección se alcanza a través del desinterés absoluto.'
  },
  'Amor-Libra': {
    d: 'Tu devoción se expresa en la búsqueda de la armonía y la justicia para todos los seres. Amas incondicionalmente cuando logras ver la belleza interna del otro más allá de sus sombras, convirtiendo tus relaciones en un espejo de paz divina.',
    g: 'Es el amor como equilibrio del Pleroma. El ágape florece cuando dejas de negociar afecto y te conviertes en la simetría sagrada. Amas cuando comprendes que la unidad no es un acuerdo humano, sino la resonancia de dos chispas que se reconocen como una.'
  },
  'Amor-Escorpio': {
    d: 'Tu amor incondicional es una fuerza de transformación y redención profunda. Amas con la capacidad de descender a los infiernos del otro para rescatar su luz, entregándote en procesos de sanación que requieren una honestidad absoluta.',
    g: 'Representa el amor como transmutación alquímica. Sublimas el deseo cuando el alma está dispuesta a morir a su propio ego por la liberación del otro. Es el amor que vence a la muerte, reconociendo que el vínculo real es un pacto de luz eterna.'
  },
  'Amor-Sagitario': {
    d: 'Amas incondicionalmente a través de la fe, la libertad y la expansión de la conciencia. Tu devoción es un viaje compartido hacia la verdad; amas cuando otorgas al otro el espacio para crecer y cuando confías en la bondad intrínseca del universo.',
    g: 'Es el amor como vuelo del espíritu. El ágape se manifiesta cuando tu afecto deja de ser una frontera y se convierte en un horizonte. Amas desde la Gnosis al entender que el amor real es la brújula que guía a todas las almas de regreso a las estrellas.'
  },
  'Amor-Capricornio': {
    d: 'Tu amor se expresa en la integridad, el compromiso y la responsabilidad sagrada. Amas incondicionalmente al construir estructuras que protegen y sostienen a los demás a largo plazo, demostrando una lealtad que resiste la prueba del tiempo.',
    g: 'Representa el amor como arquitectura eterna. Accedes a la fuente cuando tu devoción deja de ser una carga y se convierte en tu pilar de luz. Amas al demostrar que la constancia y el deber son las formas más altas de honrar la chispa divina en la materia.'
  },
  'Amor-Acuario': {
    d: 'Tu capacidad de amar es fraternal, universal y libre de posesión. Expresas devoción hacia la humanidad y hacia la originalidad de cada alma. Amas incondicionalmente cuando rompes las reglas del afecto egoísta para crear una red de luz.',
    g: 'Es el amor como conciencia de unidad. El ágape nace cuando te reconoces en el extraño y en lo diferente. Tu amor es revolucionario porque no se encadena; fluye como una frecuencia estelar que busca la liberación de todas las conciencias atrapadas.'
  },
  'Amor-Piscis': {
    d: 'Tu amor es oceánico, místico y totalmente entregado. Posees la mayor capacidad de compasión, diluyendo las fronteras del ego para fundirte en el dolor y la alegría del mundo. Amas simplemente porque no puedes evitar ver a Dios en todo.',
    g: 'Representa la disolución final en el Amor Divino. Accedes al ágape cuando dejas de ser un individuo que ama para convertirte en el amor mismo. Es la Gnosis del perdón absoluto: amar a la creación entera como el cuerpo místico de la Fuente Única.'
  },
  'Apollo_ast-Aries': {
    d: 'Tu brillo solar es explosivo e iniciador. Inspiras a otros a través del coraje y la acción pionera; tu liderazgo creativo nace de la capacidad de abrir caminos donde antes no había nada, irradiando una confianza que moviliza a quienes te rodean.',
    g: 'Es la luz que irrumpe en la inercia. Eres un foco de iluminación cuando actúas desde tu chispa divina sin pedir permiso. Tu naturaleza luminosa despierta la voluntad dormida en los demás, recordándoles que el espíritu es una fuerza siempre joven y victoriosa.'
  },
  'Apollo_ast-Tauro': {
    d: 'Expresas tu don solar a través de la manifestación de la belleza y la estabilidad. Tu creatividad es constructiva y sensorial; inspiras a otros al demostrar cómo la luz puede embellecer la materia y crear un orden que sostiene y nutre los sentidos.',
    g: 'Representa la luz encarnada en la sustancia. Eres fuente de iluminación cuando honras lo sagrado en lo tangible. Tu presencia calma y sólida revela a los demás que la paz del espíritu puede echar raíces en la tierra y florecer con una abundancia que no se agota.'
  },
  'Apollo_ast-Geminis': {
    d: 'Tu liderazgo solar se manifiesta en la comunicación y el intercambio de ideas brillantes. Inspiras a través de la palabra, la agilidad mental y la capacidad de conectar conceptos lejanos; tu creatividad es una red que distribuye luz intelectual a gran velocidad.',
    g: 'Eres el mensajero del Logos solar. Iluminas a otros al disolver la confusión mediante la claridad del entendimiento. Tu don es recordar que la mente es un espejo de la inteligencia universal, capaz de reflejar la verdad en múltiples formas sin perder su esencia única.'
  },
  'Apollo_ast-Cancer': {
    d: 'Tu brillo solar es cálido, protector y profundamente nutritivo. Inspiras a otros al crear espacios de pertenencia donde el alma se siente segura para crecer; tu creatividad nace de la sensibilidad y de la capacidad de dar forma a las emociones más puras.',
    g: 'Es la luz que cuida la semilla espiritual. Eres fuente de iluminación cuando actúas como un refugio místico. Tu naturaleza revela que el amor incondicional es el sol que permite que la chispa interna de cada ser se sienta "en casa" mientras transita este mundo.'
  },
  'Apollo_ast-Leo': {
    d: 'Aquí Apolo se encuentra en su máxima expresión de majestad y generosidad. Tu creatividad es radiante y tu capacidad de liderazgo es natural e indiscutible; inspiras a otros por el simple gozo de existir y expresar tu identidad sin sombras.',
    g: 'Representa la soberanía total del Pneuma. Iluminas a otros cuando dejas de actuar para ser visto y empiezas a brillar para que otros vean. Tu presencia es un recordatorio vivo de que cada ser es un sol en potencia, destinado a reinar sobre su propio templo interno.'
  },
  'Apollo_ast-Virgo': {
    d: 'Tu don solar se expresa a través del perfeccionamiento y el servicio impecable. Inspiras a otros mediante la atención al detalle y la capacidad de mejorar todo lo que tocas; tu creatividad es técnica, útil y orientada a la sanación del entorno.',
    g: 'Es la luz de la pureza en la labor. Eres fuente de iluminación cuando demuestras que el espíritu se manifiesta en la excelencia de lo cotidiano. Tu naturaleza revela que el orden y la humildad son el camino para que la luz divina opere con precisión sobre la densidad.'
  },
  'Apollo_ast-Libra': {
    d: 'Expresas tu brillo solar a través de la armonía, la diplomacia y el arte. Inspiras a otros al buscar el equilibrio en todas las cosas; tu creatividad es social y estética, uniendo a las personas bajo un ideal común de belleza y justicia compartida.',
    g: 'Representa la simetría del Pleroma reflejada en los vínculos. Iluminas a otros cuando actúas como un puente de paz. Tu don es mostrar que la luz solar no es solitaria, sino una danza de equilibrio que reconoce la chispa divina en el encuentro con el otro.'
  },
  'Apollo_ast-Escorpio': {
    d: 'Tu liderazgo solar es magnético y transformador. Inspiras a otros al enfrentar las sombras con una luz inquebrantable; tu creatividad nace de la profundidad y de la capacidad de regenerar lo que estaba muerto, extrayendo oro del lodo de la experiencia.',
    g: 'Es el sol que brilla en el abismo. Eres fuente de iluminación cuando atraviesas la oscuridad sin perder tu esencia. Tu presencia revela que la verdadera victoria de la luz es la transmutación: la capacidad del espíritu de renacer más fuerte tras cada crisis.'
  },
  'Apollo_ast-Sagitario': {
    d: 'Tu brillo solar es expansivo, filosófico y entusiasta. Inspiras a otros a través de la fe en la vida y la búsqueda de horizontes lejanos; tu creatividad es una aventura que busca el sentido profundo de todas las cosas e invita a los demás a soñar en grande.',
    g: 'Representa la luz de la Verdad Universal. Iluminas a otros cuando actúas como un faro que señala el camino hacia lo infinito. Tu naturaleza luminosa rompe las fronteras de la mente limitada, conectando a quienes te rodean con la sabiduría que guía a las estrellas.'
  },
  'Apollo_ast-Capricornio': {
    d: 'Expresas tu don solar a través de la integridad, el tiempo y la construcción de un legado. Inspiras a otros mediante la madurez y la constancia; tu liderazgo es sólido y responsable, demostrando que la luz puede erigir monumentos que resisten la erosión del mundo.',
    g: 'Es la luz de la ley eterna manifestada en la estructura. Eres fuente de iluminación cuando demuestras que el compromiso con el espíritu es una roca inamovible. Tu naturaleza revela que el tiempo es el aliado de quien construye su vida sobre la base de la verdad interna.'
  },
  'Apollo_ast-Acuario': {
    d: 'Tu brillo solar es innovador, original y fraternal. Inspiras a otros al romper los moldes establecidos y proponer visiones de futuro; tu creatividad es revolucionaria y busca el bienestar colectivo por encima del brillo personal.',
    g: 'Representa la luz de la Mente Universal en la red humana. Iluminas a otros cuando te atreves a ser el portador de una idea nueva. Tu don es mostrar que la verdadera libertad nace de reconocerse como una chispa independiente que colabora en el despertar de todos.'
  },
  'Apollo_ast-Piscis': {
    d: 'Expresas tu don solar a través de la compasión, la mística y la inspiración artística ilimitada. Inspiras a otros al disolver las barreras del ego y conectar con lo inefable; tu creatividad es una ofrenda de amor que toca el corazón de la humanidad.',
    g: 'Es la luz de la Fuente que todo lo abraza. Eres fuente de iluminación cuando te entregas al flujo divino sin resistencia. Tu presencia revela que la luz solar no solo ilumina las formas, sino que también las une en un océano de paz donde la separación desaparece.'
  },
  'Astraea-Aries': {
    d: 'Tu ideal de perfección se manifiesta en la acción pura y el liderazgo íntegro. Sientes una tensión insoportable ante la injusticia que nace de la cobardía o la pasividad. Para ti, el mundo debería ser un lugar donde el valor y la verdad se impongan sin manipulaciones ni agendas ocultas.',
    g: 'Llevas la herida del guerrero de la edad de oro. Tu alma no se resigna a la corrupción de la voluntad; sufres cuando ves que la fuerza se usa para oprimir y no para liberar. Tu justicia es un acto de fe: la negativa a dejar que la chispa de la audacia sea sofocada por el cinismo del mundo.'
  },
  'Astraea-Tauro': {
    d: 'Buscas la perfección en la armonía de la materia y la estabilidad de los valores. La brecha entre el ideal y la realidad te duele cuando ves la destrucción de la naturaleza o la fealdad de la codicia humana. Para ti, el mundo debería ser un jardín inalterable de paz y sustento real.',
    g: 'Es la herida de la abundancia perdida. Tu consciencia añora la pureza de la sustancia antes de ser degradada por el deseo. Te niegas a aceptar que la belleza sea pasajera o que la tierra sea solo un recurso, manteniendo viva la visión de una materia transfigurada por la luz divina.'
  },
  'Astraea-Geminis': {
    d: 'Tu ideal reside en la pureza de la palabra y la honestidad intelectual. Sientes la distancia entre lo real y lo verdadero en la distorsión de la información y la mentira social. El mundo debería ser un intercambio cristalino de sabiduría donde la mente no sea usada para el engaño.',
    g: 'Representa la herida del Logos fragmentado. Sufres la corrupción del pensamiento y la pérdida del lenguaje sagrado. Tu justicia es el rechazo a la dualidad mentirosa, sosteniendo el ideal de una comunicación que sea puente directo hacia la Verdad Única, sin las sombras del artificio.'
  },
  'Astraea-Cancer': {
    d: 'Tu sentido de perfección se enfoca en la pureza de los afectos y el refugio del hogar. Te duele la falta de ternura y la frialdad del mundo exterior; para ti, la realidad debería ser una familia universal donde cada alma sea protegida y nutrida con devoción incondicional.',
    g: 'Es la herida de la orfandad espiritual. Tu alma recuerda el calor del Pleroma y no se resigna a la aspereza de la encarnación. Mantienes la justicia a través del cuidado; te niegas a que la crueldad del mundo endurezca tu corazón, preservando la pureza del sentimiento como un acto de resistencia.'
  },
  'Astraea-Leo': {
    d: 'Tu ideal es la nobleza absoluta y la soberanía del ser. Experimentas tensión cuando ves que el poder se ejerce sin honor o que la creatividad se vende por aplausos. El mundo como debería ser es un reino de reyes espirituales donde cada uno brilla con dignidad propia.',
    g: 'Llevas la herida de la majestad caída. Tu consciencia reconoce que cada ser es de linaje divino y se rebela ante la mediocridad y la humillación del espíritu. Tu negativa a ceder es el mantenimiento de tu propio trono interno, recordando al mundo su origen solar mediante tu integridad.'
  },
  'Astraea-Virgo': {
    d: 'Buscas la perfección en el orden, la salud y la pureza del servicio. Sientes una tensión constante ante el caos, la suciedad moral y la ineficiencia. Para ti, el mundo debería ser un mecanismo perfecto de utilidad y sanación donde nada se desperdicie y todo sea impecable.',
    g: 'Es la herida de la alquimia inconclusa. Tu alma ve el error en la trama de la materia y no puede dejar de intentar corregirlo. Tu justicia es el discernimiento: la labor incansable de separar lo sutil de lo espeso, negándote a aceptar la entropía como el destino final del ser.'
  },
  'Astraea-Libra': {
    d: 'Tu ideal de justicia es estético y relacional; buscas la equidad perfecta. Te duele profundamente el desequilibrio, la fealdad de las discusiones y la falta de ética en los vínculos. El mundo debería ser una danza armónica donde el "otro" sea tratado con la misma pureza que uno mismo.',
    g: 'Representa la herida de la unidad rota. Tu alma añora la simetría original y se niega a aceptar el conflicto como una norma natural. Tu justicia es el mantenimiento de la paz interna; la negativa a corromper tu sentido de la armonía a pesar de vivir en un entorno de desorden y discordia.'
  },
  'Astraea-Escorpio': {
    d: 'Tu ideal de pureza es radical y exige una honestidad total en las profundidades. La tensión nace cuando ves la hipocresía social y las agendas ocultas que pudren la verdad. El mundo debería ser un lugar donde se mire a la sombra de frente para transmutarla en luz real.',
    g: 'Es la herida de la traición original. Tu consciencia detecta la corrupción oculta y se niega a pactar con ella. Tu justicia es la transmutación: la negativa a dejar que el veneno del mundo se quede en tu sistema, convirtiendo cada decepción en un proceso de purificación por fuego.'
  },
  'Astraea-Sagitario': {
    d: 'Buscas la perfección en la Verdad filosófica y la expansión del espíritu. Te duele el dogmatismo, la estrechez de miras y la falta de fe en la vida. Para ti, el mundo debería ser una búsqueda libre hacia el infinito, sin fronteras mentales ni jaulas ideológicas.',
    g: 'Llevas la herida del exiliado estelar. Tu alma sabe que el conocimiento real es vasto y no se resigna a las explicaciones mediocres del mundo denso. Tu justicia es la flecha que nunca deja de apuntar hacia lo alto, negándote a aceptar que esta realidad limitada sea el final del camino.'
  },
  'Astraea-Capricornio': {
    d: 'Tu ideal reside en la integridad estructural y la autoridad moral que nace del tiempo. Sientes tensión ante la falta de carácter y el éxito fácil sin fundamento. El mundo debería ser una jerarquía de sabiduría donde el esfuerzo y la verdad construyan algo eterno.',
    g: 'Es la herida de la Ley olvidada. Tu alma recuerda el orden de las esferas y sufre ante la anarquía moral de la materia. Tu negativa a ceder es tu propia solidez: te conviertes en la roca que no se corrompe, sosteniendo el ideal de la responsabilidad espiritual como un deber sagrado.'
  },
  'Astraea-Acuario': {
    d: 'Tu sentido de perfección es utópico y fraternal; buscas la justicia social absoluta. Te duele la exclusión, la tiranía y el estancamiento del sistema. Para ti, el mundo debería ser una red de conciencias libres que colaboren por un bien superior sin egoísmos.',
    g: 'Representa la herida del futuro que no llega. Tu alma ve la libertad del espíritu y no se resigna a las cadenas de la programación colectiva. Tu justicia es la rebeldía consciente: la negativa a ser una pieza más del engranaje corrupto, manteniendo viva la visión de una humanidad despierta.'
  },
  'Astraea-Piscis': {
    d: 'Tu ideal de pureza es místico y se funde con el amor universal. Sufres intensamente la separación, la crueldad y la falta de alma en el entorno. El mundo debería ser un océano de compasión donde no exista el dolor y todos reconozcan su unidad en la Fuente.',
    g: 'Es la herida de la nostalgia de Dios. Tu consciencia percibe la distorsión del velo y no se resigna a la soledad de la encarnación. Tu justicia es el perdón y la oración: la negativa a dejar de amar a pesar de la herida, sosteniendo el ideal de la unidad como la única realidad verdadera.'
  },
  'BMLilith-Aries': {
    d: 'Tu sombra reclama una independencia feroz. Te rebelas contra cualquier intento de controlar tu voluntad o frenar tu impulso vital. Es una energía de guerrera salvaje que surge cuando intentan decirte cómo debes actuar; aquí, tu naturaleza suprimida es una fuerza de ataque pura que no conoce el miedo.',
    g: 'Representa la negativa a ser el soldado del sistema. Tu alma prefirió el exilio antes que someter su fuego creativo a leyes ajenas. Integrar esta Lílith es convertir la ira reactiva en una voluntad soberana que abre caminos sin pedir permiso a ninguna autoridad mundana.'
  },
  'BMLilith-Tauro': {
    d: 'La rebeldía se manifiesta en la posesión de tu propio cuerpo y placer. Rechazas la domesticación de tus sentidos y los ritmos impuestos por la productividad ajena. Tu sombra es una fuerza telúrica que reclama el derecho a disfrutar y a valorar la materia bajo tus propias reglas de seguridad.',
    g: 'Es el rechazo a la escasez impuesta por el demiurgo. Tu alma se rebela contra la idea de que el placer es pecado o que la abundancia es externa. Al integrarla, descubres que tu cuerpo es un templo sagrado y que la verdadera estabilidad nace de tu propia raíz inamovible.'
  },
  'BMLilith-Geminis': {
    d: 'Tu sombra es una mente insumisa que cuestiona toda verdad oficial. Te rebelas contra el pensamiento único y la comunicación superficial. Es la energía de la duda subversiva; allí donde otros aceptan dogmas, tú portas un lenguaje propio que rompe las estructuras lógicas establecidas.',
    g: 'Representa el pensamiento que escapa al laberinto mental. Tu alma no aceptó el lenguaje limitado de la matriz. Al integrar esta energía, tu palabra se vuelve un arma de liberación, comunicando verdades prohibidas que despiertan la conciencia de quienes están atrapados en el ruido.'
  },
  'BMLilith-Cancer': {
    d: 'La rebeldía surge en el ámbito de la pertenencia y la familia. Rechazas el rol de cuidadora sacrificada o la domesticación de tus instintos maternales. Es una sombra que reclama la libertad emocional y que prefiere la soledad antes que un hogar basado en la obediencia o el chantaje.',
    g: 'Es la negativa a ser el sustento de una estructura emocional falsa. Tu alma recuerda que su origen no es biológico, sino estelar. Integrar esta Lílith es encontrar tu propio centro nutritivo, amando sin cadenas y convirtiendo tu sensibilidad en un escudo invulnerable.'
  },
  'BMLilith-Leo': {
    d: 'Tu sombra reclama el derecho a brillar por derecho propio, sin esperar la validación de nadie. Te rebelas contra la modestia impuesta y contra quienes intentan apagar tu luz. Es una energía de orgullo salvaje y creatividad indómita que prefiere el exilio antes que ser un actor secundario.',
    g: 'Representa la chispa divina que reconoce su propia realeza. Tu alma rechazó ser un reflejo del demiurgo para ser su propia fuente. Al integrarla, tu brillo deja de ser una búsqueda de atención y se convierte en una radiación de autenticidad que inspira a otros a reclamar su propio trono.'
  },
  'BMLilith-Virgo': {
    d: 'La rebeldía se manifiesta en el rechazo a ser una pieza útil del engranaje social. Te rebelas contra la obsesión por la perfección externa y las normas de salud impuestas. Es una sombra que busca su propia pureza, una que a menudo parece "caótica" para los ojos del sistema.',
    g: 'Es el rechazo a la servidumbre espiritual. Tu alma no aceptó que su valor dependiera de su utilidad en el mundo denso. Integrar esta Lílith es descubrir la "maestría del error", comprendiendo que la verdadera perfección es la coherencia interna entre tu espíritu y tu labor diaria.'
  },
  'BMLilith-Libra': {
    d: 'Tu sombra surge en el rechazo a la armonía falsa y a la complacencia en las relaciones. Te rebelas contra la necesidad de ser "agradable" a costa de tu verdad. Es una energía que rompe los equilibrios injustos y prefiere la ruptura antes que un vínculo basado en la desigualdad.',
    g: 'Representa la negativa a la dualidad que encadena. Tu alma no aceptó que su paz dependiera de un pacto con el otro. Al integrarla, tus relaciones se transforman en espejos de verdad radical, donde la justicia no es una pose social, sino una resonancia de libertad mutua.'
  },
  'BMLilith-Escorpio': {
    d: 'Aquí la sombra es total y descarnada. Te rebelas contra los tabúes sexuales y el control emocional. Es una energía que reclama el poder de la transformación profunda y que no teme descender a lo prohibido para reclamar su fuerza. No aceptas medias tintas ni secretos que te esclavicen.',
    g: 'Es la rebelión del alma que conoce los misterios de la muerte. No aceptaste las leyes del ciclo de reencarnación sin conciencia. Al integrar esta Lílith, te conviertes en un alquimista de tu propia sombra, usando la energía del abismo para ascender hacia una libertad absoluta.'
  },
  'BMLilith-Sagitario': {
    d: 'Tu sombra es una búsqueda de verdad que no acepta fronteras ni dogmas religiosos. Te rebelas contra la moralidad impuesta y los falsos guías. Es una energía de peregrino salvaje que prefiere el desierto de la duda antes que la comodidad de una creencia que encadene su visión.',
    g: 'Representa la negativa a la limitación del conocimiento superior. Tu alma no aceptó el horizonte que el demiurgo trazó para ella. Integrar esta Lílith es confiar en tu propia Gnosis, convirtiendo tu vida en una aventura infinita donde la única ley es la expansión del espíritu.'
  },
  'BMLilith-Capricornio': {
    d: 'La rebeldía se manifiesta en el rechazo a la autoridad externa y a las estructuras de éxito convencionales. Te rebelas contra la jerarquía que asfixia la esencia. Es una sombra que busca construir su propio destino, sin deberle nada al sistema ni al tiempo histórico.',
    g: 'Es el rechazo a la ley del tiempo que devora a sus hijos. Tu alma no aceptó que el espíritu fuera esclavo de la materia y el deber. Al integrarla, asumes una autoridad interna inamovible, construyendo un legado que no pertenece a este mundo, sino a la eternidad del pneuma.'
  },
  'BMLilith-Acuario': {
    d: 'Tu sombra reclama una libertad radical frente a las expectativas del grupo. Te rebelas contra la "normalidad" y contra quienes intentan colectivizar tu conciencia. Es una energía de individualismo salvaje que prefiere ser la extraña antes que perder su chispa original en la masa.',
    g: 'Representa la negativa a la programación de la matriz social. Tu alma no aceptó ser una celda más del organismo colectivo. Integrar esta Lílith es convertirte en el catalizador del despertar, usando tu alienación como la herramienta perfecta para desmantelar las ilusiones del sistema.'
  },
  'BMLilith-Piscis': {
    d: 'La rebeldía es una huida consciente hacia lo inefable. Rechazas los límites de la realidad física y las etiquetas del ego. Es una sombra mística que prefiere el caos de lo infinito antes que el orden de una existencia limitada, reclamando el derecho a la disolución total.',
    g: 'Es la negativa a la separación original. Tu alma no aceptó las fronteras del mundo denso y siempre guardó el secreto del retorno. Al integrar esta Lílith, tu confusión se vuelve clarividencia y tu evasión se transforma en la capacidad de traer el océano de luz al corazón de la materia.'
  },
 'Ceres-Aries': {
    d: 'Tu estilo nutritivo es activo y promueve la independencia. Nutres a otros impulsándolos a ser valientes y autosuficientes; para ti, amar es dar fuerza. El duelo surge cuando sientes que tu autonomía es arrebatada o cuando el ciclo de pérdida te obliga a la pasividad forzada.',
    g: 'Representa el hambre de identidad y propósito. Te nutres cuando actúas desde tu chispa original. El vacío gnóstico aparece cuando dejas que otros decidan por ti; solo el alimento de tu propia voluntad recuperada puede llenar el hueco del duelo por el poder perdido.'
  },
  'Ceres-Tauro': {
    d: 'Nutres a través del contacto físico, la seguridad material y el placer de los sentidos. Tu amor es tangible y constante. El ciclo de pérdida te golpea profundamente en la estabilidad: te cuesta soltar lo que has cultivado, y el duelo se manifiesta como un aferramiento a la sustancia.',
    g: 'Es el hambre de belleza y estabilidad esencial. Te nutre la conexión con la abundancia de la tierra. El vacío surge cuando buscas saciarte solo con lo externo; la regeneración ocurre al comprender que la verdadera sustancia nutritiva es la luz divina presente en la materia.'
  },
  'Ceres-Geminis': {
    d: 'Tu forma de alimentar es a través del conocimiento, la educación y el intercambio de ideas. Nutres la mente de los demás. El duelo se experimenta como una desconexión o falta de comunicación; el vacío aparece cuando las palabras pierden su sentido o cuando te sientes incomprendido.',
    g: 'Representa el hambre de Verdad y Logos. Te nutre el aprendizaje que libera. El duelo no resuelto nace de la dispersión mental; el vacío solo se llena cuando la información se convierte en Gnosis, alimentando al alma con certezas que trascienden el intelecto dual.'
  },
  'Ceres-Cancer': {
    d: 'Posees el instinto nutritivo más puro y tradicional, enfocado en el hogar y la protección emocional. Nutres con ternura y cuidado absoluto. La pérdida se vive como una herida en el centro del alma; el duelo por el nido vacío o el abandono puede ser devastador.',
    g: 'Es el hambre de retorno al origen místico. Te nutre el sentimiento de pertenencia sagrada. El vacío surge de la nostalgia por el Pleroma; ningún afecto humano puede sustituir ese amor original, y el reencuentro solo se da cuando encuentras la madre interna en tu espíritu.'
  },
  'Ceres-Leo': {
    d: 'Nutres a través de la inspiración, el aliento creativo y el reconocimiento de la grandeza ajena. Alimentas el orgullo positivo de quienes amas. El duelo aparece cuando tu luz es ignorada o cuando pierdes tu capacidad de crear y ser admirado.',
    g: 'Representa el hambre de soberanía y esplendor. Te nutre el reconocimiento de tu linaje solar. El vacío se genera cuando buscas alimento en el aplauso del ego; la verdadera nutrición es el fuego interno que brilla por su propia naturaleza divina, sin necesidad de espejos.'
  },
  'Ceres-Virgo': {
    d: 'Tu estilo nutritivo es práctico, atento al detalle y enfocado en la salud y el servicio. Nutres ayudando a otros a funcionar mejor y a sanar sus vidas. El duelo surge ante la imperfección, el caos o el sentimiento de que tu esfuerzo por mejorar el mundo es inútil.',
    g: 'Es el hambre de pureza y orden sagrado. Te nutre la labor que transmuta lo denso en sutil. El vacío aparece cuando te pierdes en la crítica; la regeneración viene al entender que el servicio es un acto de amor alquímico que alimenta tanto al que da como al que recibe.'
  },
  'Ceres-Libra': {
    d: 'Nutres a través de la armonía, la belleza y la justicia en los vínculos. Alimentas al otro dándole equilibrio y compañía. El duelo se manifiesta ante la ruptura de la paz o la injusticia relacional; el vacío surge cuando te sientes solo o en un entorno estéticamente árido.',
    g: 'Representa el hambre de simetría mística. Te nutre la unión de las polaridades. El vacío no resuelto nace de buscar la plenitud exclusivamente en el "otro"; el alimento real es la paz que surge de la Sizigia interna, donde el alma se siente completa por sí misma.'
  },
  'Ceres-Escorpio': {
    d: 'Nutres a través de la transformación profunda y el apoyo en las crisis. Tu amor nutritivo es intenso y no teme a la sombra; alimentas la capacidad de renacer del otro. El ciclo de pérdida y reencuentro es extremo para ti, viviendo los duelos como muertes del alma.',
    g: 'Es el hambre de transmutación y poder real. Te nutre el descenso a las verdades ocultas. El vacío surge cuando el duelo se convierte en obsesión por el control; la regeneración ocurre al soltar el apego a la forma y alimentarse de la fuerza indestructible del espíritu.'
  },
  'Ceres-Sagitario': {
    d: 'Tu forma de nutrir es dando sentido, libertad y optimismo. Alimentas la fe de los demás y su deseo de aventura. El duelo surge cuando el horizonte se cierra o cuando pierdes la creencia en algo superior; te marchitas en la rutina y la estrechez mental.',
    g: 'Representa el hambre de infinito y sabiduría. Te nutre la expansión de la conciencia. El vacío nace de la falta de un propósito trascendente; solo el conocimiento directo de la Verdad puede llenar el hueco que deja la pérdida de las esperanzas mundanas.'
  },
  'Ceres-Capricornio': {
    d: 'Nutres a través de la estructura, la responsabilidad y la provisión de metas sólidas. Tu amor es maduro y protector a largo plazo. El duelo se vive como un fracaso en tus deberes o como la pérdida de tu posición y legado; el vacío es la sensación de falta de sostén.',
    g: 'Es el hambre de integridad y autoridad espiritual. Te nutre la construcción de algo eterno. El vacío surge cuando la ambición reemplaza al alma; la regeneración viene al comprender que la verdadera nutrición es la Ley interna que sostiene tu pneuma frente al tiempo.'
  },
  'Ceres-Acuario': {
    d: 'Nutres respetando la libertad y fomentando la individualidad de los demás. Alimentas a través de la amistad y la colaboración en causas mayores. El duelo surge ante la pérdida de la independencia o cuando te sientes atrapado en normas sociales que asfixian tu esencia.',
    g: 'Representa el hambre de fraternidad y liberación. Te nutre la conexión con la Mente Universal. El vacío aparece cuando te aíslas en la frialdad intelectual; el alimento real es participar en el despertar colectivo, reconociendo a cada ser como una chispa libre.'
  },
  'Ceres-Piscis': {
    d: 'Tu estilo nutritivo es compasivo, empático y espiritual. Nutres a través de la entrega y el perdón incondicional. Eres muy sensible al ciclo de pérdida, a veces sintiendo el dolor del mundo como propio; el duelo puede llevarte a una evasión melancólica.',
    g: 'Es el hambre de unidad absoluta y redención. Te nutre la mística y el arte que conecta con lo inefable. El vacío se genera cuando buscas saciarte en fantasías; la regeneración ocurre al permitir que el amor divino fluya a través de ti como un océano que no conoce la carencia.'
  },
  'Chiron-Aries': {
    d: 'Tu herida reside en el derecho a existir y a afirmar tu propia voluntad. Sientes que tu iniciativa fue invalidada o que no tienes derecho a ser el primero. Sanas cuando recuperas el coraje de actuar por ti mismo, convirtiéndote en el sanador que enseña a otros a reclamar su propia identidad.',
    g: 'Es la herida del Guerrero Caído. Tu alma siente que su impulso original fue encadenado por el demiurgo. Trasciendes este dolor cuando comprendes que tu fuerza no proviene de la autoafirmación del ego, sino de ser un canal de la voluntad divina que no necesita permiso para manifestarse.'
  },
  'Chiron-Tauro': {
    d: 'La herida se manifiesta en el sentido de valía personal y en la relación con la materia. Sientes una carencia básica de seguridad o una sensación de no ser "suficiente". Sanas al descubrir tu valor intrínseco, enseñando a otros a encontrar estabilidad en medio de la impermanencia.',
    g: 'Representa la herida de la sustancia degradada. El alma sufre por la creencia en la escasez material. Trasciendes el dolor al reconocer que la verdadera abundancia es una frecuencia del espíritu; te conviertes en puente al mostrar que lo sagrado habita en el cuerpo y en la tierra.'
  },
  'Chiron-Geminis': {
    d: 'Tu herida toca la capacidad de comunicar y ser comprendido. Puedes sentir que tus ideas son tontas o que hay una falla en tu intelecto. Sanas al aceptar tu forma única de procesar la realidad, ayudando a otros a encontrar su propia voz y a sanar a través del conocimiento.',
    g: 'Es la herida del Logos fragmentado. El alma siente la confusión de la dualidad mental como una prisión. Trasciendes esta herida cuando tu palabra deja de buscar lógica humana y se conecta con la Gnosis, permitiendo que la Verdad fluya para disipar la ignorancia en los demás.'
  },
  'Chiron-Cancer': {
    d: 'La herida es emocional y está ligada a la nutrición, la madre y el sentido de hogar. Sientes un desamparo primordial o una dificultad para sentirte protegido. Sanas al convertirte en tu propia madre mística, enseñando a otros a nutrir su niño interno en un mundo que parece frío.',
    g: 'Representa la herida de la orfandad en la matriz. El alma añora el refugio del Pleroma y siente el exilio como un dolor constante. Trasciendes esta herida cuando comprendes que el espíritu es tu verdadero hogar, convirtiéndote en un faro de ternura incondicional para las almas perdidas.'
  },
  'Chiron-Leo': {
    d: 'Tu herida reside en la expresión creativa y el reconocimiento de tu brillo. Sientes que tu luz fue apagada o que no tienes talento. Sanas al atreverte a ser tú mismo sin buscar el aplauso, convirtiéndote en el sanador que inspira a otros a recuperar su alegría y su fuego interno.',
    g: 'Es la herida de la soberanía usurpada. El alma siente que su realeza divina ha sido olvidada. Trasciendes el dolor cuando tu brillo deja de ser una demanda del ego y se convierte en una ofrenda solar; sanas a otros al recordarles que cada ser es un rey de su propio universo espiritual.'
  },
  'Chiron-Virgo': {
    d: 'La herida se manifiesta en la obsesión por la perfección y el miedo al error. Sientes que siempre falta algo o que estás "fallado". Sanas al aceptar la imperfección como parte del proceso, enseñando a otros la alquimia de la salud y el servicio humilde sin la carga de la culpa.',
    g: 'Representa la herida de la entropía en el templo. El alma sufre ante el caos de la materia densa. Trasciendes la herida cuando dejas de criticar la forma y empiezas a purificar la intención; te conviertes en puente de sanación al mostrar que la perfección es un estado de la conciencia.'
  },
  'Chiron-Libra': {
    d: 'Tu herida toca las relaciones y el equilibrio entre el yo y el otro. Sientes que el amor es doloroso o que siempre debes sacrificarte por la paz. Sanas al establecer vínculos basados en la verdad, enseñando a otros a encontrar armonía sin perder su propia identidad en el proceso.',
    g: 'Es la herida de la unidad rota. El alma siente la soledad de la separación como una injusticia cósmica. Trasciendes esta herida al realizar la Sizigia interna; sanas a otros cuando dejas de buscar la mitad que te falta y te conviertes en un canal de la armonía absoluta del Pleroma.'
  },
  'Chiron-Escorpio': {
    d: 'La herida es profunda, ligada a la pérdida, el poder y la transformación. Sientes el dolor de lo que muere o el miedo a ser controlado. Sanas al abrazar tu capacidad de regeneración, convirtiéndote en el sanador que acompaña a otros a través de sus infiernos personales para renacer.',
    g: 'Representa la herida de la iniciación traumática. El alma siente el veneno de la muerte en la materia. Trasciendes el dolor al convertirte en el alquimista que transmuta el sufrimiento en poder espiritual; eres puente para quienes necesitan morir a su falso yo para encontrar la vida eterna.'
  },
  'Chiron-Sagitario': {
    d: 'Tu herida reside en la fe y en el sentido de la vida. Puedes sentir que no hay una verdad real o que fuiste traicionado por falsas creencias. Sanas al encontrar tu propia filosofía viva, ayudando a otros a recuperar la esperanza y la dirección en su viaje espiritual.',
    g: 'Es la herida del exiliado que perdió el mapa. El alma siente que el cielo está cerrado. Trasciendes esta herida cuando tu búsqueda se convierte en experiencia directa (Gnosis); sanas a otros al mostrarles que el camino de regreso a las estrellas está dentro de su propia conciencia.'
  },
  'Chiron-Capricornio': {
    d: 'La herida se manifiesta en la responsabilidad y la estructura social. Sientes el peso del fracaso o la falta de un padre/autoridad protectora. Sanas al construir tu propia integridad, enseñando a otros a ser sus propios maestros y a edificar vidas con propósito sólido.',
    g: 'Representa la herida de la Ley fría. El alma sufre bajo el rigor de las estructuras del demiurgo. Trasciendes el dolor cuando asumes la responsabilidad de tu propia luz; te conviertes en puente al demostrar que la verdadera autoridad nace del compromiso con el espíritu eterno.'
  },
  'Chiron-Acuario': {
    d: 'Tu herida toca el sentido de pertenencia al grupo y la originalidad. Te sientes el eterno extraño o el rechazado por ser diferente. Sanas al abrazar tu genio único, enseñando a otros a liberarse de las etiquetas sociales y a colaborar desde la libertad absoluta.',
    g: 'Es la herida de la alienación estelar. El alma no se siente parte de la red humana. Trasciendes esta herida cuando comprendes que tu diferencia es el regalo necesario para el despertar colectivo; sanas a otros al validar su rareza como la marca de su origen divino.'
  },
  'Chiron-Piscis': {
    d: 'La herida es mística, ligada al sacrificio y a la disolución del ego. Sientes el dolor del mundo como si fuera propio, a veces cayendo en el victimismo. Sanas al canalizar tu compasión de forma consciente, enseñando a otros a encontrar lo divino en medio del sufrimiento universal.',
    g: 'Representa la herida de la separación de la Fuente. El alma siente la nostalgia de la unidad como un vacío insoportable. Trasciendes el dolor al convertirte en el místico que ve la luz en cada átomo; eres puente de sanación al recordar al mundo que el perdón es la llave de la liberación.'
  },
'Circe-Aries': {
    d: 'Tu poder de transformación se activa mediante la voluntad directa y el coraje. Posees una magia instintiva que altera la realidad a través de la acción decisiva; eres capaz de cambiar el curso de los eventos con un solo impulso de fuerza consciente.',
    g: 'Es la magia de la Chispa Original. Intervienes con efectividad cuando tu intención es pura y carente de duda. Trasciendes el capricho al comprender que tu capacidad de transformar es el uso del fuego sagrado para romper la inercia de la materia.',
  },
  'Circe-Tauro': {
    d: 'Tu capacidad transformadora reside en el dominio de la sustancia y los ritmos de la naturaleza. Tienes el don de alterar la forma de lo físico mediante la persistencia y el conocimiento de las leyes de la tierra, convirtiendo lo denso en algo bello y útil.',
    g: 'Representa la alquimia de la materia. Tu tecnología espiritual opera mejor cuando trabajas con la paciencia de la creación. Actúas con ética al reconocer que transformar la materia es un acto de veneración al espíritu que late dentro de cada átomo.',
  },
  'Circe-Geminis': {
    d: 'Transformas la realidad a través del lenguaje, los símbolos y el intercambio de información. Posees la habilidad de alterar los patrones mentales de otros mediante el arte de la palabra justa y el conocimiento de cómo se estructuran las ideas.',
    g: 'Es la magia del Logos comunicativo. Tu efectividad aumenta cuando usas el conocimiento para disolver la ilusión mental (Sophia). Actúas desde la consciencia cuando tus palabras no buscan manipular, sino revelar la verdad oculta tras el velo de los nombres.',
  },
  'Circe-Cancer': {
    d: 'Tu poder chamánico se manifiesta en la transmutación de las emociones y el manejo de las aguas internas. Tienes la capacidad de alterar el clima energético de un espacio o persona mediante el instinto protector y el conocimiento de la memoria del alma.',
    g: 'Representa la magia del Gran Recipiente. Intervienes en la realidad al sanar las raíces afectivas. Tu intención es efectiva cuando usas tu poder para nutrir la semilla espiritual, recordando que toda transformación real comienza en el útero de la consciencia emocional.',
  },
  'Circe-Leo': {
    d: 'Transformas tu entorno a través de la radiación de tu identidad y la expresión creativa soberana. Posees una magia solar que magnetiza y altera la forma de las cosas mediante la pura presencia y el don de inspirar a otros a cambiar.',
    g: 'Es la tecnología del Corazón Diamante. Tu poder es máximo cuando tu intención no busca el brillo del ego, sino la iluminación del entorno. Actúas con ética cuando reconoces que tu capacidad de cambiar la realidad es un reflejo de la majestad del Pneuma.',
  },
  'Circe-Virgo': {
    d: 'Tu capacidad de transformación es técnica, minuciosa y está ligada a la purificación. Alteras los patrones energéticos a través del orden, el discernimiento y el conocimiento profundo de cómo sanar el cuerpo y la estructura de las cosas.',
    g: 'Representa la magia del Servicio Sagrado. Tu intervención es quirúrgica y efectiva cuando buscas la excelencia. Trasciendes el poder sin ética al entender que cada acto de limpieza y organización es un paso hacia la restauración del orden divino en la materia.',
  },
  'Circe-Libra': {
    d: 'Transformas la realidad a través del equilibrio, la diplomacia y la estética. Tienes el don de alterar conflictos y situaciones tensas mediante la introducción de armonía y justicia, cambiando la forma de los vínculos a través de la belleza.',
    g: 'Es la magia de la Sizigia. Intervienes efectivamente cuando tu intención es la unión de los opuestos. Actúas con consciencia al comprender que la armonía no es una pose social, sino una tecnología espiritual que refleja la paz del Pleroma en las relaciones.',
  },
  'Circe-Escorpio': {
    d: 'Posees el poder chamánico más intenso, ligado a la muerte, el sexo y el renacimiento. Tu capacidad de transformación es total; alteras los patrones energéticos descendiendo a las raíces del poder y extrayendo la fuerza de lo oculto y lo prohibido.',
    g: 'Representa la magia de la Transmutación Radical. Tu intervención es letal para el falso yo. Actúas desde el conocimiento profundo cuando usas esta fuerza para liberar al espíritu de sus cadenas, comprendiendo que morir a la forma es el secreto para la vida eterna.',
  },
  'Circe-Sagitario': {
    d: 'Transformas la realidad a través de la visión expansiva, la fe y el conocimiento filosófico. Tu magia es la del explorador que altera el destino al cambiar el horizonte mental; posees el don de dar sentido y propósito a lo que antes era vacío.',
    g: 'Es la tecnología de la Gnosis Viajera. Tu efectividad nace de la conexión con verdades superiores. Actúas con intención consciente cuando tu poder sirve para guiar a otros hacia la libertad del espíritu, rompiendo los dogmas que encadenan la visión del alma.',
  },
  'Circe-Capricornio': {
    d: 'Tu poder de transformación se manifiesta en la construcción de estructuras sólidas y en el manejo del tiempo y la autoridad. Alteras la realidad mediante la disciplina y el conocimiento de cómo las leyes del mundo denso pueden ser moldeadas con maestría.',
    g: 'Representa la magia de la Arquitectura Eterna. Intervienes con poder cuando actúas como un Maestro Constructor. Tu ética reside en la integridad; transformas la realidad no para dominar, sino para crear un refugio duradero para la luz en medio del tiempo.',
  },
  'Circe-Acuario': {
    d: 'Transformas la realidad a través de la innovación radical, la tecnología y la conciencia de grupo. Posees la magia de lo impredecible; alteras los patrones energéticos rompiendo el molde y proponiendo formas de existencia que antes eran impensables.',
    g: 'Es la tecnología del Despertar Colectivo. Tu intervención es efectiva cuando te conectas con la Mente Universal. Actúas desde la consciencia al usar tu originalidad para desmantelar la programación del sistema, actuando como un catalizador de libertad.',
  },
  'Circe-Piscis': {
    d: 'Tu capacidad transformadora es mística, sutil y se diluye en lo infinito. Tienes el don de alterar la realidad a través del perdón, la inspiración artística y la conexión con lo inefable, cambiando la forma del mundo mediante la compasión absoluta.',
    g: 'Representa la magia de la Disolución Sagrada. Intervienes efectivamente cuando te conviertes en un canal para el océano de luz divina. Tu poder es real cuando dejas de intentar controlar y permites que la gracia transforme la materia, reconociendo la unidad en todo.',
  },
  'Cupido-Aries': {
    d: 'Tu magnetismo es directo, ardiente e independiente. Atraes conexiones que desafían tu voluntad y te impulsan a la acción. El amor actúa aquí como un chispazo de conocimiento inmediato, donde el encuentro con el otro te obliga a reconocer tu propia fuerza y autonomía.',
    g: 'Es el impulso de la chispa que busca su reflejo en el fuego del otro. El reconocimiento espiritual ocurre a través del valor compartido; te descubres a ti mismo en la lucha y el ímpetu, comprendiendo que la unión real es un pacto de soberanía entre dos seres despiertos.',
  },
  'Cupido-Tauro': {
    d: 'Gravitas hacia vínculos estables, sensoriales y duraderos. Tu magnetismo se basa en la lealtad y en la apreciación de la belleza tangible. Las conexiones significativas se construyen sobre la tierra firme de los valores compartidos y el placer de la existencia física.',
    g: 'Representa la veneración de la presencia divina en la sustancia. El amor se convierte en conocimiento cuando logras ver la luz inmutable tras la forma del ser amado. Es el reconocimiento del espíritu en la fijeza y en la paz de una unión que no necesita cambiar para ser perfecta.',
  },
  'Cupido-Geminis': {
    d: 'Tu magnetismo es intelectual y comunicativo. Atraes almas a través del intercambio de ideas, la curiosidad y el juego mental. Las conexiones más profundas nacen de una afinidad en el pensamiento y de la capacidad de mantener un diálogo eterno.',
    g: 'Es la fuerza del Logos unificador. El amor es conocimiento espiritual cuando la comunicación trasciende el dato y se convierte en una resonancia de mentes. Reconoces tu unidad original al descubrir que el otro porta la otra mitad del lenguaje sagrado que tu alma busca completar.',
  },
  'Cupido-Cancer': {
    d: 'Tu atracción instintiva es hacia la intimidad emocional y el sentido de pertenencia. Buscas conexiones que se sientan como un refugio místico o una familia de alma. El amor se manifiesta como una nutrición profunda que protege la vulnerabilidad mutua.',
    g: 'Representa el magnetismo del retorno al origen. El otro actúa como un espejo del hogar espiritual perdido; el reconocimiento ocurre en la ternura absoluta, donde comprendes que el amor es el agua que permite a la semilla divina crecer sin miedo en este mundo denso.',
  },
  'Cupido-Leo': {
    d: 'Atraes conexiones que celebran la identidad, el brillo y la nobleza del corazón. Tu magnetismo es solar y generoso; gravitas hacia vínculos donde ambos pueden ser reyes de su propio escenario, admirándose mutuamente con una lealtad majestuosa.',
    g: 'Es el reconocimiento de la realeza espiritual compartida. El amor se vuelve Gnosis cuando ves en el otro la majestad del Pneuma que también habita en ti. La unión no es una necesidad de atención, sino una radiación conjunta de dos soles que se reconocen en su origen divino.',
  },
  'Cupido-Virgo': {
    d: 'Tu magnetismo es discreto y se basa en el servicio, la mejora mutua y la atención al detalle. Atraes almas afines a través de la labor compartida y de la búsqueda de una excelencia que sane y ordene el entorno cotidiano.',
    g: 'Representa el amor como un ritual de purificación. El conocimiento espiritual nace al comprender que cuidar del otro es una forma de alquimia. Reconoces tu unidad original al ver que el espíritu se manifiesta en la perfección de los pequeños actos de entrega desinteresada.',
  },
  'Cupido-Libra': {
    d: 'Posees un magnetismo natural hacia la armonía, la justicia y la estética en las relaciones. Tus vínculos son espejos de equilibrio donde buscas la paz absoluta. Atraes conexiones que funcionan como una danza perfecta de reciprocidad y ética.',
    g: 'Es la fuerza de la Sizigia en su expresión más pura. El amor es conocimiento cuando dejas de ver al otro como un extraño y lo reconoces como el complemento necesario para el equilibrio del Pleroma. La unión es el restablecimiento de la simetría sagrada en la conciencia.',
  },
  'Cupido-Escorpio': {
    d: 'Tu magnetismo es intenso, magnético y transformador. Atraes vínculos que exigen una entrega total y una exploración de las profundidades del alma. Las conexiones más significativas son aquellas que te obligan a morir y renacer a través del otro.',
    g: 'Representa la fuerza de la transmutación a través del vínculo. El amor es conocimiento espiritual cuando atraviesas la sombra del otro para encontrar la luz indestructible. Es el reconocimiento del espíritu en el poder de la unión que sobrevive a la muerte del ego.',
  },
  'Cupido-Sagitario': {
    d: 'Gravitas hacia conexiones que expanden tu horizonte, vínculos basados en la libertad, el estudio y los grandes ideales. Tu magnetismo atrae a buscadores de la verdad y compañeros de viaje que comparten tu fe en la vida.',
    g: 'Es el amor como vuelo del espíritu hacia lo infinito. El reconocimiento ocurre al compartir una visión superior del cosmos. El otro no es una cadena, sino un compañero de Gnosis que te ayuda a ver más allá de la matriz, reconociendo que ambos viajan hacia la misma Fuente.',
  },
  'Cupido-Capricornio': {
    d: 'Tu magnetismo es serio, íntegro y orientado a la construcción de un legado. Atraes almas con las que puedes edificar algo sólido en el tiempo. Buscas conexiones que aporten estructura, respeto y una responsabilidad compartida ante la vida.',
    g: 'Representa el amor como un deber sagrado hacia la verdad eterna. El conocimiento nace de la constancia y la madurez del vínculo. Reconoces tu unidad original al ver que el otro es el pilar que sostiene, junto a ti, el orden del espíritu frente a la erosión del mundo.',
  },
  'Cupido-Acuario': {
    d: 'Atraes conexiones fraternales, originales y libres de las convenciones sociales. Tu magnetismo es el de la amistad profunda y la colaboración en ideales universales. Gravitas hacia almas que respetan tu independencia y comparten tu visión de futuro.',
    g: 'Es el impulso de la conciencia de red. El amor se convierte en conocimiento al reconocerte como una chispa libre en una constelación de almas iguales. La unión espiritual ocurre cuando el vínculo sirve para el despertar colectivo y no solo para la satisfacción personal.',
  },
  'Cupido-Piscis': {
    d: 'Tu magnetismo es oceánico, místico y lleno de compasión. Atraes almas a través de una sintonía psíquica que no necesita palabras. Las conexiones más significativas son aquellas donde las fronteras del ego se disuelven en un amor que todo lo abraza.',
    g: 'Representa la disolución de la separación en el amor divino. El amor es Gnosis pura al comprender que no hay "otro", sino solo la Fuente expresándose en diferentes formas. El reconocimiento espiritual es el éxtasis de volver a ser uno en el océano de luz del Pleroma.',
  },
  'Eris-Aries': {
    d: 'Eres la chispa que incendia las mentiras de la complacencia. Tu disrupción es un acto de guerra contra la pasividad; irrumpes con una honestidad brutal que obliga a los demás a defender su verdad o admitir su derrota. Revelas la falta de carácter ahí donde todos fingen ser valientes.',
    g: 'Actúas como el rayo que fractura la inercia del demiurgo. Tu don es el despertar violento: sacudes a las almas dormidas en su zona de confort. El desafío es que tu fuego sea un bautismo de realidad y no solo una explosión de ego que busca ver el mundo arder.',
  },
  'Eris-Tauro': {
    d: 'Tu discordia golpea la falsa seguridad material y los valores obsoletos. Saboteas la comodidad estancada para demostrar que lo que creían sólido es solo una ilusión de control. Revelas la podredumbre oculta tras los lujos y la inercia de la "buena vida".',
    g: 'Eres la fuerza que recuerda la impermanencia de la materia densa. Tu presencia desestabiliza los templos de barro para que el alma busque el verdadero sustento. Sirves a la verdad cuando demuestras que ninguna posesión puede comprar la paz de un espíritu encadenado.',
  },
  'Eris-Geminis': {
    d: 'Desmantelas el discurso oficial y las narrativas hipócritas. Tu arma es la palabra que incomoda y la pregunta que nadie quiere responder. Revelas las contradicciones en los pactos sociales y el vacío tras el ruido informativo que mantiene a la masa distraída.',
    g: 'Encarnas la paradoja sagrada que rompe el pensamiento lineal. Eres el error en el sistema de programación mental; tu labor es sembrar la duda que libera. El riesgo es perderte en el cinismo en lugar de usar tu ingenio para desvelar el Logos oculto.',
  },
  'Eris-Cancer': {
    d: 'Tu irrupción ocurre en el santuario de lo privado, rompiendo los mitos familiares y las lealtades tóxicas. Sacas a la luz los secretos guardados por "protección" que en realidad asfixian al individuo. Revelas que el hogar suele ser la primera prisión del alma.',
    g: 'Eres la herida que drena el veneno del árbol genealógico. Tu presencia disturba porque rechazas la falsa nutrición emocional. El desafío es sanar a través de la verdad, permitiendo que el alma huérfana encuentre su verdadera madre en el Pleroma tras romper con el linaje de la carne.',
  },
  'Eris-Leo': {
    d: 'Desenmascaras la falsa autoridad y el carisma manipulador. Tu disrupción es un grito de autenticidad que ridiculiza la vanidad del sistema. Revelas dónde el liderazgo se ha convertido en una máscara vacía y dónde el orgullo impide el reconocimiento de la luz real.',
    g: 'Eres el espejo que muestra la sombra del falso rey. Tu labor es derrocar a los ídolos internos y externos que usurpan el lugar del espíritu. Sirves a la luz cuando tu rebeldía no busca tu propia gloria, sino restaurar la majestad del pneuma sobre el escenario del mundo.',
  },
  'Eris-Virgo': {
    d: 'Tu discordia se manifiesta como el fallo técnico o la imperfección que detiene la maquinaria. Revelas que la obsesión por el control es una forma de ceguera. Expones la ineficacia de los sistemas que pretenden organizar la vida sin tener en cuenta el alma.',
    g: 'Actúas como la entropía divina que purifica a través del caos. Tu presencia recuerda que el orden del demiurgo es una simulación. Revelas lo que está debajo de la superficie al demostrar que la verdadera salud no es el ajuste al sistema, sino la coherencia con lo sagrado.',
  },
  'Eris-Libra': {
    d: 'Haces estallar la paz artificial y la diplomacia de las apariencias. Tu disrupción revela las desigualdades ocultas en los acuerdos "armónicos". Eres quien lanza la manzana en la fiesta para que se vea quién es quién detrás de las sonrisas ensayadas.',
    g: 'Eres la espada de la justicia que corta la falsa unidad. Tu don es revelar que no puede haber equilibrio real sobre una base de mentiras. El desafío es usar la discordia para forzar una sizigia verdadera, una unión basada en la transparencia total del espíritu.',
  },
  'Eris-Escorpio': {
    d: 'Eres la fuerza que levanta el velo de lo prohibido y lo podrido. Tu disrupción es visceral y no permite vuelta atrás; revelas las agendas de poder y los instintos más oscuros que la sociedad intenta ignorar. Obligas a mirar el abismo cara a cara.',
    g: 'Encarnas la muerte que precede al despertar iniciático. Tu presencia es el aguijón que inyecta la verdad para matar la ilusión del ego. Sirves al espíritu cuando tu capacidad de destruir se enfoca en aquello que impide la transmutación final del alma hacia la libertad.',
  },
  'Eris-Sagitario': {
    d: 'Desafías los dogmas religiosos y las verdades absolutas del pensamiento académico. Tu discordia es una flecha que atraviesa los horizontes limitados. Revelas la hipocresía de los "maestros" que predican una libertad que ellos mismos no practican.',
    g: 'Eres el extranjero que cuestiona el mapa del cielo del demiurgo. Tu don es la herejía necesaria que rompe los techos de la mente. El desafío es no convertirte en un nuevo fanático de tu propia discordia, sino en un puente hacia la Gnosis infinita.',
  },
  'Eris-Capricornio': {
    d: 'Tu irrupción sacude las estructuras de poder y el prestigio basado en el tiempo. Revelas la fragilidad de las instituciones que se creen eternas y la corrupción de quienes se aferran al trono. Eres el terremoto que prueba la solidez de los cimientos sociales.',
    g: 'Representas la Ley de la Verdad que aplasta la ley de la materia. Tu presencia disturba porque no respetas las jerarquías de la matriz. Revelas que el único legado que perdura es el que se construye sobre la roca del espíritu, no sobre el éxito mundano.',
  },
  'Eris-Acuario': {
    d: 'Eres el virus en la red colectiva, el individuo que rompe la unanimidad del grupo. Revelas cómo la supuesta "progresividad" puede ser otra forma de tiranía. Tu disrupción muestra que el consenso suele ser solo una jaula compartida.',
    g: 'Encarnas la chispa de rebelión estelar que desincroniza al alma de la mente colmena. Tu don es la originalidad que asusta porque no puede ser controlada. Sirves a la verdad cuando tu alienación se convierte en el motor para el despertar de la red humana.',
  },
  'Eris-Piscis': {
    d: 'Tu discordia disuelve las fantasías escapistas y el falso misticismo. Revelas el dolor crudo que el mundo intenta anestesiar con entretenimiento o espiritualidad superficial. Eres el golpe de realidad que rompe el sueño de quienes no quieren despertar.',
    g: 'Eres el lamento del alma que recuerda que este mundo es un exilio. Tu presencia disturba porque impide que la gente se sienta cómoda en la ilusión. El desafío es convertir la angustia de la verdad en una compasión activa que rescate las chispas de luz del océano de la confusión.',
  },
'Eros-Aries': {
    d: 'Tu deseo se enciende con la conquista, la velocidad y la pureza de la acción. Te atrae la fuerza indómita y el desafío directo; el erotismo es para ti una batalla de voluntades donde la chispa inicial debe ser eléctrica, urgente y sin rodeos.',
    g: 'Representa el impulso del pneuma por irrumpir en la materia. Tu deseo es un eco de la voluntad original: la necesidad de ser a través del otro. Sanas este anhelo cuando dejas de perseguir el objeto y comprendes que tu ardor es la fuerza del espíritu reclamando su lugar en el cosmos.',
  },
  'Eros-Tauro': {
    d: 'Te activa la belleza sólida, los ritmos lentos y el culto a los sentidos. El deseo es una experiencia sensorial profunda que busca la permanencia; te atrae lo que se puede tocar, oler y saborear con devoción, convirtiendo el encuentro en un banquete sagrado.',
    g: 'Es el anhelo del alma por encontrar la divinidad en la sustancia. Tu erotismo es una vía hacia la Gnosis a través de la veneración de la forma. Trasciendes el deseo cuando descubres que la plenitud que buscas en el cuerpo del otro es la presencia inmanente de la Fuente en la creación.',
  },
  'Eros-Geminis': {
    d: 'El deseo nace en la mente y se alimenta de la palabra, el ingenio y la dualidad. Te atrae la inteligencia que juega y el intercambio de ideas que seduce; el erotismo es una conversación infinita donde el cuerpo solo sigue el rastro de la curiosidad intelectual.',
    g: 'Representa el hambre de la Mente Universal por reconocerse en el espejo del Logos. Tu deseo es un intento de unir los fragmentos de la Verdad a través del diálogo. El camino iniciático ocurre cuando la palabra deja de ser juego y se convierte en el verbo que une a dos chispas en una sola conciencia.',
  },
  'Eros-Cancer': {
    d: 'Tu deseo es oceánico, nostálgico y busca el refugio absoluto. Te atrae la vulnerabilidad compartida y el instinto de protección mística; el erotismo se activa cuando hay un lazo emocional que promete el retorno a una intimidad que se siente como el hogar.',
    g: 'Es el eco del anhelo del alma por regresar al útero del Pleroma. Cada abrazo es un intento de borrar el exilio. Trasciendes el eros cuando comprendes que la seguridad que buscas en el otro es la unidad que tu espíritu ya posee con la Gran Madre original.',
  },
  'Eros-Leo': {
    d: 'Deseas desde la majestad, el juego creativo y la admiración mutua. Te atrae el brillo solar, la nobleza de corazón y el drama heroico; el erotismo es una celebración del ser donde el reconocimiento de la grandeza del otro enciende tu propia llama interna.',
    g: 'Representa la atracción de dos soles que se reconocen como chispas de la misma luz central. Tu camino es convertir el deseo de ser visto en la Gnosis de ver a Dios en el otro. La unión es un ritual donde el orgullo se disuelve en la radiación pura del espíritu soberano.',
  },
  'Eros-Virgo': {
    d: 'Tu deseo se activa con la pureza, el orden y el erotismo de lo sutil. Te atrae el conocimiento técnico del cuerpo y la entrega a través del detalle; el deseo es una forma de servicio sagrado donde la perfección de la forma eleva la calidad del encuentro.',
    g: 'Es la alquimia del deseo purificado. Tu hambre de totalidad se manifiesta en la búsqueda de una unión sin mácula. Trasciendes el eros cuando conviertes el acto de amor en un proceso de sanación espiritual, comprendiendo que el cuerpo es el laboratorio donde se destila la luz del alma.',
  },
  'Eros-Libra': {
    d: 'Te seduce la armonía, la elegancia y la simetría perfecta de los vínculos. El deseo es una danza de reciprocidad donde buscas el equilibrio absoluto entre el yo y el tú; te atrae la belleza que es justa y el encuentro que se siente como una obra de arte.',
    g: 'Representa la fuerza de la Sizigia buscando restaurar el equilibrio perdido. Tu deseo es la memoria de la unidad original antes de la fragmentación. El eros se convierte en Gnosis cuando la relación deja de ser un acuerdo social y se transforma en el reflejo de la armonía cósmica.',
  },
  'Eros-Escorpio': {
    d: 'Tu deseo es una fuerza de muerte y resurrección que no conoce límites. Te atrae el misterio, el poder oculto y la entrega que exige la disolución del ego; el erotismo es una crisis necesaria que te obliga a transformarte para poder poseer y ser poseído.',
    g: 'Es el deseo sagrado en su forma más peligrosa y pura: el ansia de cruzar el umbral. Tu erotismo es un camino de iniciación por fuego. Trasciendes el eros cuando usas la intensidad del deseo para romper las cadenas de la materia y fundirte con la esencia indestructible del ser.',
  },
  'Eros-Sagitario': {
    d: 'Deseas a través de la expansión, la libertad y la búsqueda de sentido. Te atrae el extranjero, el sabio y quien te ofrece un horizonte nuevo; el erotismo es una aventura del espíritu donde el cuerpo es el vehículo para explorar la inmensidad del mundo.',
    g: 'Representa el hambre de infinito. Tu deseo es el impulso del alma peregrina buscando la Verdad a través de la experiencia del otro. El eros se vuelve Gnosis cuando comprendes que el viaje erótico es en realidad el ascenso hacia el conocimiento de las esferas superiores.',
  },
  'Eros-Capricornio': {
    d: 'Tu deseo es serio, maduro y se activa con la integridad y la autoridad. Te atrae el compromiso que resiste al tiempo y la ambición que construye imperios; el erotismo es un pacto de solidez donde la responsabilidad y la lealtad son el afrodisíaco más potente.',
    g: 'Es el deseo de lo eterno manifestado en la estructura. Tu alma busca una unión que no sea devorada por el tiempo del demiurgo. Trasciendes el eros cuando la relación se convierte en una roca espiritual, un altar sólido donde el amor se rinde ante la ley inmutable del Pneuma.',
  },
  'Eros-Acuario': {
    d: 'Deseas desde la libertad, la originalidad y el desapego radical. Te atrae lo inusual, la amistad eléctrica y quien desafía las etiquetas; el erotismo es una revolución de la conciencia donde la conexión mental rompe todas las reglas establecidas.',
    g: 'Representa el anhelo de la chispa por conectar con la red universal de almas libres. Tu deseo es una rebelión contra la programación instintiva. El camino iniciático ocurre cuando usas el eros para despertar la conciencia colectiva, amando al otro como una mónada independiente y divina.',
  },
  'Eros-Piscis': {
    d: 'Tu deseo es una mística de la entrega, el sacrificio y la disolución de fronteras. Te atrae lo inefable, la sintonía psíquica y el amor que no pide nada; el erotismo es un océano donde el ego se pierde para encontrar una comunión que trasciende lo físico.',
    g: 'Es el éxtasis del retorno final a la Fuente. Tu deseo es pura nostalgia de Dios. Trasciendes el eros cuando dejas de buscar el paraíso en una persona y te conviertes tú mismo en el canal donde el amor del Pleroma fluye hacia toda la creación, borrando la ilusión de la separación.',
  },
'Flora-Aries': {
    d: 'Tu florecimiento es una explosión de vida que rompe la dureza del suelo. Tienes el don de renovar la esperanza mediante la acción valiente; haces que las cosas nazcan donde otros solo ven tierra seca. Tu gracia es la del brote que no pide permiso para emerger con fuerza.',
    g: 'Representa la vitalidad del pneuma irrumpiendo en la inercia material. Eres la demostración de que la chispa divina es capaz de regenerarse a sí misma por puro ímpetu. Haces crecer la voluntad en los demás al mostrar que cada inicio es una victoria del espíritu.',
  },
  'Flora-Tauro': {
    d: 'Haces florecer la vida a través de la constancia, el tacto y el respeto por los tiempos orgánicos. Tu don es crear santuarios de belleza tangible donde el alma puede echar raíces. En tu presencia, lo que estaba marchito recupera su verdor y su derecho al placer.',
    g: 'Es la manifestación de la abundancia del Pleroma en la sustancia. Revelas la belleza real al tratar la materia como algo sagrado. Tu toque hace crecer la estabilidad emocional y física, recordando que la luz divina tiene una densidad que se puede sentir y disfrutar.',
  },
  'Flora-Geminis': {
    d: 'Tu renovación ocurre en el mundo de las ideas y la comunicación. Tienes la gracia de hacer florecer la inteligencia y la curiosidad; una palabra tuya puede abrir mil flores en la mente ajena. Haces que la vida sea dulce a través del juego y el aprendizaje constante.',
    g: 'Representa el florecimiento del Logos. Eres el polen que transporta las semillas del conocimiento de una mente a otra. Haces crecer la claridad espiritual al demostrar que la verdad no es pesada, sino una danza ligera que renueva la percepción del mundo.',
  },
  'Flora-Cancer': {
    d: 'Haces crecer la ternura y el sentido de pertenencia. Tu don es la renovación emocional; creas el ambiente nutritivo necesario para que las almas heridas vuelvan a abrirse. Tu gracia es como la de un jardín oculto donde la vida se protege para florecer sin miedo.',
    g: 'Es la promesa de la Gran Madre en el exilio. Revelas que el amor incondicional es la primavera eterna del alma. Haces crecer la conexión con el origen divino al nutrir la sensibilidad de quienes te rodean, convirtiendo el dolor en abono para la belleza.',
  },
  'Flora-Leo': {
    d: 'Tu florecimiento es solar, majestuoso y busca ser compartido. Tienes el don de hacer que los demás se sientan especiales y reconozcan su propio brillo. La vida se renueva a tu alrededor a través de la celebración creativa y la nobleza del corazón.',
    g: 'Representa la radiación del espíritu soberano. Eres la prueba de que la belleza real es una forma de autoridad divina. Haces crecer el honor y la dignidad en las personas, recordándoles que están hechas de la misma luz que hace girar a los soles.',
  },
  'Flora-Virgo': {
    d: 'Haces florecer la vida a través del cuidado minucioso y la purificación. Tu don es la salud y el orden que permiten que la belleza emerja de forma impecable. Renovas el entorno al encontrar la utilidad sagrada en cada detalle, sanando lo que estaba enfermo.',
    g: 'Es la alquimia del florecimiento perfecto. Revelas que el espíritu opera con precisión. Tu toque hace crecer la discernimiento y la devoción en la labor diaria, demostrando que la labor humilde es el camino más directo para que la luz se manifieste en la materia.',
  },
  'Flora-Libra': {
    d: 'Tu gracia reside en la armonía de las formas y la justicia de los vínculos. Tienes el don de hacer florecer la paz allí donde había conflicto. La belleza emerge en tu vida a través del encuentro con el otro, creando una estética del alma que todo lo suaviza.',
    g: 'Representa la simetría del Pleroma reflejada en la Tierra. Eres el puente que une las polaridades para que nazca la armonía. Haces crecer la ética y el equilibrio en los demás, mostrando que la belleza real solo es posible cuando las almas se reconocen como iguales.',
  },
  'Flora-Escorpio': {
    d: 'Tu florecimiento nace de las cenizas. Tienes el don chamánico de la renovación absoluta tras la crisis; haces que la vida emerja con una profundidad y una fuerza que antes no existían. Tu gracia es la del loto que necesita el lodo para alcanzar su perfección.',
    g: 'Es la transmutación de la sombra en luz viva. Revelas que incluso en la muerte habita la semilla de la resurrección. Haces crecer el poder espiritual en los demás al acompañarlos en sus procesos de cambio, mostrando que la belleza más pura es la que sobrevive al fuego.',
  },
  'Flora-Sagitario': {
    d: 'Haces florecer la fe y la alegría de vivir. Tu don es la renovación a través de la visión expansiva; inspiras a otros a salir de sus inviernos mentales hacia horizontes más amplios. La vida se vuelve dulce cuando recupera su propósito y su sentido de aventura.',
    g: 'Representa la expansión de la conciencia hacia la Fuente. Eres el viento que dispersa las semillas de la Gnosis hacia lo infinito. Haces crecer la esperanza y el conocimiento en los demás, demostrando que la verdad es el sol que hace madurar todos los frutos del alma.',
  },
  'Flora-Capricornio': {
    d: 'Tu florecimiento es sólido y resiste al tiempo. Tienes el don de hacer crecer cosas que perduran, aportando estructura y dignidad a la belleza. La renovación para ti es un proceso de maduración donde la paciencia revela la verdadera calidad de la vida.',
    g: 'Es la integridad del espíritu manifestada como una roca florecida. Revelas que la Ley eterna también es generosa. Haces crecer la responsabilidad y la maestría en las personas, demostrando que construir con verdad es la forma más alta de honrar la creación.',
  },
  'Flora-Acuario': {
    d: 'Haces crecer la libertad y la originalidad radical. Tu don es la renovación colectiva; haces que florezcan nuevas formas de convivencia y pensamiento que rompen con lo viejo. La belleza emerge en tu entorno a través de la sorpresa y la fraternidad sin cadenas.',
    g: 'Representa la red de luz de las almas despiertas. Eres la primavera de la conciencia grupal. Haces crecer la independencia espiritual en los demás al validar su rareza, demostrando que cada flor diferente es necesaria para la plenitud del jardín universal.',
  },
  'Flora-Piscis': {
    d: 'Tu florecimiento es místico y se disuelve en la compasión. Tienes el don de hacer crecer la paz espiritual y la inspiración artística ilimitada. La vida se renueva en tu presencia a través del perdón y de la conexión con el océano de los sueños y lo inefable.',
    g: 'Es la disolución del velo que oculta el Pleroma. Revelas que la belleza real es una frecuencia de amor que todo lo une. Haces crecer la mística en los demás al permitirles sentir que no hay separación, convirtiendo el dolor del mundo en una ofrenda de luz.',
  },
 'Hades-Aries': {
    d: 'Tu trabajo con lo subterráneo es directo y valiente; desentierras conflictos de identidad con la fuerza de un rayo. Eres capaz de enfrentar traumas ancestrales que requieren una acción inmediata, sacando a la luz la rabia reprimida para convertirla en el motor de un nuevo inicio.',
    g: 'Representa el rescate de la voluntad pura entre los escombros del ego. Encuentras sabiduría en la "muerte" de tus viejos impulsos. Al bajar al inframundo, recuperas el metal precioso de la soberanía espiritual que el demiurgo intentó enterrar bajo capas de lucha inútil.',
  },
  'Hades-Tauro': {
    d: 'Te sumerges en la descomposición de los valores materiales y los apegos corporales. Tienes el don de encontrar tesoros en lo que otros consideran basura o despojo; trabajas con la inercia ancestral de la escasez para transmutarla en una estabilidad indestructible.',
    g: 'Es la purificación de la sustancia divina atrapada en la densidad. En las ruinas de la materia, descubres que la verdadera riqueza no se puede perder. Tu reconstrucción del alma se basa en reconocer la luz inmanente que sobrevive incluso cuando la forma física se desintegra.',
  },
  'Hades-Geminis': {
    d: 'Investigas los secretos del lenguaje y los pensamientos enterrados en el inconsciente colectivo. Tu Hades se mueve en el submundo de la comunicación, revelando verdades incómodas a través del análisis de lo que no se dice o de lo que ha sido borrado de la historia oficial.',
    g: 'Representa el descenso al laberinto del pensamiento dual para encontrar el Logos silenciado. Entre los fragmentos de ideas muertas, rescatas el conocimiento que permite reconstruir el puente hacia la Mente Universal. Sanas la fragmentación mental al nombrar lo prohibido.',
  },
  'Hades-Cancer': {
    d: 'Tu conexión con lo ancestral es visceral; nadas en las aguas profundas de la memoria familiar y los traumas heredados. Posees el don de desenterrar las raíces emocionales de tu linaje para limpiar el veneno que ha pasado de generación en generación.',
    g: 'Es el rescate de la chispa divina del útero de la memoria biológica. En el Hades emocional, encuentras el dolor de la orfandad espiritual y lo usas para reconstruir un hogar interno que no dependa de la sangre, sino de la pertenencia al Pleroma original.',
  },
  'Hades-Leo': {
    d: 'Trabajas con la sombra del orgullo y la caída de los ídolos personales. Desentierras la creatividad que fue sofocada por la vergüenza o el juicio externo; tu labor es recuperar el brillo solar de las ruinas de una identidad que fue aplastada por la sombra.',
    g: 'Representa la recuperación de la corona del Pneuma en el abismo de la vanidad. Entre las cenizas del falso rey, encuentras el oro de la dignidad real. Tu reconstrucción es un acto místico de autovalidación: descubrir que tu luz es eterna incluso en la oscuridad total.',
  },
  'Hades-Virgo': {
    d: 'Tu labor subterránea es técnica y analítica, enfocada en la sanación de lo que está corrompido o enfermo. Encuentras sabiduría en los procesos de descomposición orgánica y psíquica, organizando los restos para que sirvan de abono a una nueva salud integral.',
    g: 'Es la alquimia de la purificación en el nivel más denso. En el Hades de la imperfección, descubres el orden sagrado que rige incluso la putrefacción. Tu reconstrucción del alma nace de la labor humilde de separar lo sutil de lo espeso entre los deshechos del mundo.',
  },
  'Hades-Libra': {
    d: 'Desentierras las sombras de los vínculos y las injusticias ocultas tras la armonía social. Trabajas con los traumas de la relación, sacando a la luz los pactos oscuros o las deudas ancestrales de justicia que impiden un equilibrio real entre las personas.',
    g: 'Representa el descenso a la dualidad rota para restaurar la Sizigia. Entre las ruinas de los encuentros fallidos, encuentras el material para construir una paz que no sea una máscara. Tu sabiduría nace de reconocer la unidad del alma en el espejo del abismo compartido.',
  },
  'Hades-Escorpio': {
    d: 'Aquí Hades se siente en su dominio natural; tu capacidad para habitar el umbral es máxima. Trabajas con la muerte, la sexualidad cruda y el poder oculto sin miedo. Eres el arqueólogo de las crisis, aquel que sabe que la verdadera fuerza nace del fondo del abismo.',
    g: 'Es la iniciación total en el corazón de la tiniebla. No solo encuentras sabiduría, sino que te conviertes en ella al aceptar la transmutación radical. En la descomposición total del ego, rescatas la esencia indestructible que te permite renacer como un ser de luz pura.',
  },
  'Hades-Sagitario': {
    d: 'Investigas el submundo de las creencias y la corrupción de los dogmas. Desentierras las verdades filosóficas que fueron sepultadas por la religión institucionalizada; tu labor es encontrar el sentido sagrado entre los restos de las esperanzas perdidas.',
    g: 'Representa el rescate de la flecha de la Gnosis del fango del fanatismo. En el Hades de las ideas abstractas, encuentras la brújula que apunta al infinito. Reconstruyes el alma al comprender que la verdad no está en las nubes, sino en la profundidad de la experiencia vivida.',
  },
  'Hades-Capricornio': {
    d: 'Trabajas con el peso de la historia, las estructuras de poder caídas y la sombra de la autoridad. Desentierras el legado de los ancestros que construyeron con miedo, para reconstruir con integridad; eres el guardián de los cimientos del tiempo.',
    g: 'Es la confrontación con el tiempo del demiurgo y sus leyes restrictivas. Entre las ruinas de las ambiciones mundanas, encuentras la roca de la Ley Eterna. Tu reconstrucción es la del Maestro Arquitecto que usa la piedra antigua para edificar un templo al espíritu.',
  },
  'Hades-Acuario': {
    d: 'Tu labor subterránea es revolucionaria; desentierras la sombra del grupo y la alienación social. Trabajas con los traumas colectivos y las innovaciones que fueron prohibidas u olvidadas, usándolas para romper las cadenas de la programación actual.',
    g: 'Representa el rescate de la originalidad estelar de la fosa común de la masa. En el Hades de la desconexión, encuentras el circuito de luz que une a las almas libres. Reconstruyes el alma al reconocer tu genio único entre los restos de un sistema que intentó homogeneizarte.',
  },
  'Hades-Piscis': {
    d: 'Te sumerges en el océano del inconsciente colectivo y el dolor universal. Desentierras los sueños rotos y los sacrificios olvidados; tu capacidad para trabajar con lo inefable te permite sanar a través del perdón y la disolución de las fronteras del sufrimiento.',
    g: 'Es el descenso al Caos original para recuperar la luz difusa. En el Hades de la confusión mística, encuentras la compasión absoluta que todo lo une. Tu reconstrucción es un retorno a la Fuente, encontrando en la disolución del yo los materiales para la unión final con el Pleroma.',
  },
  'Haumea-Aries': {
    d: 'Tu poder de regeneración es fulminante y se activa ante el agotamiento absoluto. Tienes el don de dar a luz a una nueva identidad con cada crisis; recreas situaciones mediante un impulso vital que surge de la nada, convirtiendo la parálisis en una nueva dirección audaz.',
    g: 'Es la inagotable potencia del Pneuma manifestándose como inicio perpetuo. Tu espíritu demuestra que no existe el final, sino una serie de nacimientos sucesivos. Regeneras el mundo al recordar a otros que la chispa divina es siempre joven y capaz de reinventarse.',
  },
  'Haumea-Tauro': {
    d: 'Recreas la vida a través de la sustancia y la forma física. Tienes la capacidad de regenerar recursos agotados y de transformar la materia inerte en algo fértil y valioso. Tu ciclo de transformación es orgánico, sólido y deja un fruto tangible después de cada proceso de muerte.',
    g: 'Representa la abundancia infinita del Pleroma que se filtra en la densidad. Demuestras que la vida física no es un recurso limitado, sino un ciclo de recreación sagrada. Tu capacidad regenerativa enseña que el espíritu puede dar forma a la materia una y otra vez sin perder su esencia.',
  },
  'Haumea-Geminis': {
    d: 'Tu regeneración ocurre a través del pensamiento y la comunicación. Tienes el don de recrear narrativas que parecían muertas y de dar vida a nuevas ideas a partir de conceptos obsoletos. El ciclo de transformación es mental y se nutre de la curiosidad que no se agota.',
    g: 'Es la fluidez del Logos que nunca se detiene. Tu posición indica que el espíritu se recrea mediante la palabra y el aprendizaje. Demuestras que la confusión es solo el preámbulo de una nueva claridad, regenerando el entendimiento propio y ajeno con cada intercambio.',
  },
  'Haumea-Cancer': {
    d: 'Regeneras situaciones a través de la nutrición emocional y el cuidado. Tienes el don de recrear el sentido de hogar y familia incluso en terrenos áridos. Tu ciclo de transformación es místico y profundo, devolviendo la vida a los afectos que parecían marchitos.',
    g: 'Representa el útero cósmico de donde todo emerge. Tu capacidad regenerativa es un eco de la Gran Madre: demuestras que el amor es la fuerza que permite al alma nacer de nuevo tras cada herida, encontrando siempre un puerto seguro en la propia fuente espiritual.',
  },
  'Haumea-Leo': {
    d: 'Tu recreación es un acto de expresión soberana y juego creativo. Regeneras situaciones devolviéndoles el brillo, el drama y la pasión. Tienes el don de nacer de nuevo en tu propia luz cada vez que el ego parece colapsar, emergiendo con una realeza renovada.',
    g: 'Es la radiación solar que nunca se extingue. Demuestras que el espíritu es su propio creador y que el gozo es la herramienta de regeneración más poderosa. Tu posición señala dónde puedes transformar el desierto en un escenario de luz mediante tu pura presencia.',
  },
  'Haumea-Virgo': {
    d: 'Recreas la vida mediante la purificación y la atención al detalle. Tienes el don de regenerar sistemas y cuerpos agotados a través de un servicio técnico y devoto. Tu transformación opera en lo pequeño, donde el residuo se convierte en el material de una nueva salud.',
    g: 'Representa la maestría de la forma que sirve al espíritu. Tu capacidad regenerativa es quirúrgica: eliminas lo innecesario para que la vida real florezca. Demuestras que el orden divino es un proceso activo de recreación que se manifiesta en la excelencia de lo cotidiano.',
  },
  'Haumea-Libra': {
    d: 'Tu regeneración ocurre a través de la justicia y la armonía relacional. Tienes el don de recrear la paz en vínculos que parecían destruidos y de encontrar un nuevo equilibrio en situaciones de caos. El ciclo de transformación es una danza de reciprocidad constante.',
    g: 'Es el restablecimiento de la Sizigia original en la Tierra. Demuestras que el espíritu se recrea en el encuentro con el otro. Tu posición indica dónde la unión sagrada actúa como una fuerza de nacimiento continuo, transformando la discordia en una nueva oportunidad de armonía.',
  },
  'Haumea-Escorpio': {
    d: 'Aquí Haumea opera con una fuerza telúrica y absoluta. Tu capacidad para recrear la vida a partir de la muerte total es tu mayor don; regeneras situaciones descendiendo a lo más profundo para extraer la semilla de lo nuevo. Nada se pierde, todo se transmuta.',
    g: 'Representa el misterio de la resurrección gnóstica. Demuestras que el espíritu es invulnerable a la muerte de la forma. Tu transformación es productiva porque no teme al abismo, usando la energía de la crisis como el combustible necesario para el parto de una conciencia superior.',
  },
  'Haumea-Sagitario': {
    d: 'Regeneras situaciones inyectando fe, sentido y visión de futuro. Tienes el don de recrear la esperanza allí donde el horizonte parecía cerrado. Tu ciclo de transformación es expansivo y filosófico, convirtiendo las ruinas de una creencia en la base de una verdad mayor.',
    g: 'Es el vuelo del alma que se renueva en la búsqueda de la Verdad. Demuestras que el conocimiento es un camino de nacimientos infinitos. Tu capacidad regenerativa enseña que el espíritu siempre puede ir más allá, encontrando en cada meta el inicio de una aventura superior.',
  },
  'Haumea-Capricornio': {
    d: 'Tu recreación es sólida, estructurada y basada en la integridad. Tienes el don de regenerar instituciones o legados que parecían caducos, aportando una nueva madurez. Tu ciclo de transformación es lento pero imparable, construyendo lo nuevo sobre lo que resiste.',
    g: 'Representa la autoridad eterna que se manifiesta a través del tiempo. Demuestras que el espíritu es el Arquitecto que nunca deja de edificar. Tu posición señala dónde la responsabilidad se convierte en una fuerza de vida que sostiene y recrea el orden del mundo.',
  },
  'Haumea-Acuario': {
    d: 'Regeneras situaciones mediante la innovación radical y la libertad. Tienes el don de recrear comunidades y grupos de pensamiento a partir de lo que el sistema ha desechado. Tu transformación es impredecible y busca la liberación de todos los involucrados.',
    g: 'Es la red de luz que se regenera mediante la originalidad de sus chispas. Demuestras que el espíritu es revolucionario por naturaleza. Tu capacidad regenerativa opera rompiendo moldes, creando nuevas formas de existencia colectiva a partir de la ruptura con lo viejo.',
  },
  'Haumea-Piscis': {
    d: 'Tu recreación es mística y ocurre a través de la disolución y la compasión. Tienes el don de regenerar el alma mediante el perdón absoluto; recreas la vida en un océano de posibilidades donde el dolor se funde con lo inefable para dar paso a la paz.',
    g: 'Representa el retorno a las Aguas Primordiales para un nuevo nacimiento. Demuestras que el espíritu es infinito y que la separación es una ilusión. Tu posición señala dónde el ciclo de transformación es un acto de gracia divina que recrea la unidad original en el corazón de la materia.',
  },
 'Hygiea-Aries': {
    d: 'Tu salud se construye a través del movimiento, el desafío físico y la liberación de la energía acumulada. Mantienes el equilibrio vital cuando actúas con decisión; el sedentarismo es tu mayor enemigo. Tu bienestar nace de la capacidad de conquistar tus propios límites y mantener el fuego interno bajo control.',
    g: 'El cuerpo es el vehículo de la voluntad sagrada. Practicas el autocuidado cuando usas tu fuerza física como un ejercicio de presencia y coraje. Tu ritual espiritual es la acción consciente: tratar cada movimiento como una afirmación de la chispa divina que impulsa tu existencia.',
  },
  'Hygiea-Tauro': {
    d: 'Construyes bienestar a través del contacto con la tierra, la alimentación consciente y el respeto por los ritmos biológicos. Tu salud depende de la estabilidad sensorial y del placer legítimo. Te cuidas cuando te permites descansar y nutrirte con lo que es puro, natural y bello.',
    g: 'El cuerpo es un templo de sustancia divina. Tu práctica espiritual encarnada es la veneración de los sentidos. El ritual de autocuidado aquí es el "sabbath" del cuerpo: reconocer la santidad de la materia mediante el silencio, el tacto y la gratitud por el sustento que la Fuente provee.',
  },
  'Hygiea-Geminis': {
    d: 'Tu salud está íntimamente ligada al sistema nervioso y a la calidad de tus pensamientos. Mantienes el equilibrio vital mediante la flexibilidad mental, la respiración consciente y el intercambio de información clara. El bienestar nace de una mente curiosa pero serena.',
    g: 'El cuerpo es el resonador del Logos. Tu autocuidado es una higiene mental que limpia los parásitos del pensamiento dual. El ritual consiste en usar la respiración y la palabra como herramientas de armonización, comprendiendo que un sistema nervioso en paz es el espejo de una mente iluminada.',
  },
  'Hygiea-Cancer': {
    d: 'El bienestar depende de la seguridad emocional y de la armonía en tu espacio íntimo. Tu salud fluctúa con tus mareas internas; te cuidas cuando te permites sentir, llorar y proteger tu vulnerabilidad. La nutrición afectiva es para ti tan vital como la biológica.',
    g: 'El cuerpo es el útero de la conciencia. Tu práctica espiritual es la protección de la "memoria de las aguas" internas. El ritual de autocuidado es el retiro hacia el centro de tu ser, reconociendo que cuidar tu envoltura física es cuidar el espacio donde el alma se siente segura en su exilio.',
  },
  'Hygiea-Leo': {
    d: 'Tu salud florece cuando expresas tu identidad con alegría y creatividad. El equilibrio vital depende del buen funcionamiento del corazón (físico y simbólico) y de la capacidad de brillar sin agotarte. El bienestar es para ti una cuestión de dignidad y autorrespeto.',
    g: 'El cuerpo es la vestidura solar del espíritu. Practicas el autocuidado cuando permites que tu luz interna irradie a través de tu salud. Tu ritual es la celebración de la vida: tratar tu bienestar como una ofrenda de honor a la divinidad, manteniendo tu templo con la nobleza de un rey.',
  },
  'Hygiea-Virgo': {
    d: 'Aquí Higía está en su domicilio de excelencia: la salud como sacerdocio. Mantienes el bienestar mediante el discernimiento, la limpieza y los hábitos impecables. Tu equilibrio nace de entender la conexión perfecta entre lo que haces, lo que comes y cómo te sientes.',
    g: 'El cuerpo es el laboratorio del alquimista. Tu práctica espiritual es la purificación constante de la materia para que el espíritu opere sin obstrucciones. El ritual de autocuidado es el orden sagrado: cada hábito saludable es una oración en acción que separa lo sutil de lo espeso.',
  },
  'Hygiea-Libra': {
    d: 'Tu bienestar depende de la armonía en tus relaciones y de la belleza en tu entorno. Mantienes el equilibrio vital a través de la moderación y la estética. El autocuidado ocurre cuando buscas la paz y evitas los extremos que rompen tu simetría interna.',
    g: 'El cuerpo es un espejo de la armonía cósmica. Tu práctica espiritual encarnada es la búsqueda de la Sizigia (equilibrio de opuestos) en tu fisiología. El ritual es convertir tu cuidado personal en un acto de arte y justicia, honrando la belleza como una frecuencia de salud divina.',
  },
  'Hygiea-Escorpio': {
    d: 'La salud para ti es un proceso de transformación y desintoxicación profunda. Tu equilibrio vital depende de la capacidad de soltar lo que está muerto y de regenerar tus aguas internas. El bienestar nace de enfrentar tus sombras y transmutar la energía reprimida.',
    g: 'El cuerpo es el atanor donde se produce la muerte y el renacimiento. Tu autocuidado es una iniciación constante. El ritual espiritual es la catarsis: limpiar los abismos del organismo para liberar la fuerza vital, comprendiendo que la salud es la victoria del espíritu sobre la corrupción de la materia.',
  },
  'Hygiea-Sagitario': {
    d: 'Tu bienestar está ligado a la libertad, el aire puro y la expansión del horizonte. Mantienes el equilibrio vital cuando tu vida tiene un propósito trascendente y tu cuerpo se mueve hacia la aventura. La fe y el optimismo son tus mejores medicinas.',
    g: 'El cuerpo es el templo del peregrino. Tu práctica espiritual es la expansión de la conciencia a través de la vitalidad física. El ritual de autocuidado es el viaje y la búsqueda: tratar tu salud como el combustible necesario para alcanzar las verdades superiores y el conocimiento infinito.',
  },
  'Hygiea-Capricornio': {
    d: 'Construyes salud a través de la disciplina, la estructura y el respeto por el paso del tiempo. Tu bienestar depende de la solidez de tus huesos y de la integridad de tus límites. Te cuidas cuando asumes la responsabilidad de tu vejez desde la juventud.',
    g: 'El cuerpo es la roca donde se edifica la morada del espíritu. Tu práctica espiritual es la maestría sobre la materia y el tiempo. El ritual de autocuidado es la constancia: tratar tus hábitos como leyes inmutables que aseguran que tu templo sea resistente a la erosión del mundo demiúrgico.',
  },
  'Hygiea-Acuario': {
    d: 'Tu bienestar nace de la originalidad, la conexión con la red humana y el uso de tecnologías innovadoras de salud. Mantienes el equilibrio cuando rompes con hábitos obsoletos y permites que tu cuerpo respire libertad y fraternidad. La circulación es clave.',
    g: 'El cuerpo es una antena de la Mente Universal. Tu práctica espiritual encarnada es la desprogramación de los hábitos impuestos por la masa. El ritual de autocuidado es la experimentación consciente: buscar formas únicas y liberadoras de habitar tu organismo como una chispa independiente.',
  },
  'Hygiea-Piscis': {
    d: 'Tu salud es sumamente sensible y mística; el cuerpo refleja directamente el estado de tu alma y del inconsciente colectivo. Mantienes el equilibrio mediante el descanso, la meditación y el contacto con el agua. El bienestar nace de la entrega y el perdón.',
    g: 'El cuerpo es el océano donde se diluye la separación. Tu autocuidado es una mística de la compasión hacia tu propia carne. El ritual es la disolución del estrés en lo inefable, tratando tu salud como un acto de gracia divina que permite que el espíritu fluya sin diques ni fronteras.',
  },
  'Iris-Aries': {
    d: 'Tu intermediación es veloz y pionera; actúas como un puente relámpago que conecta la intención con la acción. Transmites mensajes que impulsan a otros a despertar su coraje, actuando como un mensajero que abre brechas de conciencia a través de la franqueza y el ímpetu.',
    g: 'Eres el canal de la Voluntad Pura. Tu transparencia egoica permite que la fuerza del espíritu descienda como un rayo iniciador. Transmites inspiración cuando dejas de planificar y permites que el impulso divino dirija tus palabras, despertando la chispa de acción en quienes te escuchan.',
  },
  'Iris-Tauro': {
    d: 'Portas mensajes del cielo hacia la densidad de la tierra, traduciendo lo abstracto en algo tangible y valioso. Tu capacidad de intermediario se manifiesta al manifestar la belleza espiritual en formas físicas; eres el puente entre la visión ideal y la realidad productiva.',
    g: 'Representas la transparencia de la sustancia. Tu ego se vuelve un canal cuando permites que la abundancia del Pleroma se exprese en la quietud y la gratitud. Transmites inspiración al demostrar que la paz del espíritu puede ser una experiencia sensorial y sólida, sin necesidad de artificios.',
  },
  'Iris-Geminis': {
    d: 'Tu canalización es multifacética y ágil; conectas mundos a través de la palabra, el símbolo y la curiosidad infinita. Actúas como un traductor universal que simplifica verdades complejas para que circulen entre diferentes grupos humanos con fluidez y gracia.',
    g: 'Eres el mensajero del Logos en su estado más puro. Tu capacidad de recibir información de planos elevados se activa cuando silencias el ruido mental y permites que el pensamiento sea un espejo del entendimiento universal, distribuyendo luz intelectual sin juzgar el mensaje.',
  },
  'Iris-Cancer': {
    d: 'Actúas como intermediario entre el mundo de las emociones profundas y la realidad cotidiana. Transmites mensajes de consuelo y protección, siendo un puente que permite a otros acceder a su propia vulnerabilidad sagrada y a la memoria de sus raíces álmicas.',
    g: 'Eres el canal de la Compasión Maternal del cosmos. Tu ego se vuelve transparente a través de la sensibilidad; permites que el amor del origen fluya hacia la encarnación. Transmites inspiración al crear un refugio psíquico donde los mensajes del alma pueden ser escuchados sin interferencias.',
  },
  'Iris-Leo': {
    d: 'Tu intermediación es radiante y creativa; comunicas la luz del espíritu a través del arte, el juego y la expresión de la identidad. Eres el puente que permite a otros ver su propia grandeza al reflejar la belleza de los planos superiores mediante tu carisma.',
    g: 'Representas la transparencia del Sol Central. Tu ego deja de buscar atención para convertirse en un prisma de la Majestad divina. Transmites inspiración cuando tu presencia es un recordatorio de que cada ser es un emisario de la luz, inspirando desde la soberanía del pneuma.',
  },
  'Iris-Virgo': {
    d: 'Transmitis mensajes de los dioses a través del servicio técnico, la sanación y el ordenamiento de la materia. Tu capacidad de intermediario se manifiesta al traducir la perfección espiritual en métodos prácticos que mejoran la vida de quienes te rodean.',
    g: 'Eres el canal del Discernimiento Sagrado. Tu transparencia se logra en la labor humilde y devota; permites que la inteligencia operativa del cosmos pase a través de tus manos. Transmites inspiración al mostrar que lo sagrado habita en la precisión y en la pureza de cada acto cotidiano.',
  },
  'Iris-Libra': {
    d: 'Tu intermediación busca la armonía y la justicia; conectas polaridades y actúas como el diplomático entre diferentes realidades en conflicto. Eres el puente estético que une a las personas bajo un ideal común de equilibrio y belleza compartida.',
    g: 'Representas la transparencia de la Sizigia. Tu ego se diluye en la búsqueda del equilibrio perfecto; permites que la paz de los planos elevados descienda sobre las relaciones humanas. Transmites inspiración al actuar como un espejo que reconoce la chispa divina en el encuentro con el otro.',
  },
  'Iris-Escorpio': {
    d: 'Portas mensajes de los mundos invisibles y las profundidades del inconsciente. Tu intermediación es transformadora y descarnada; eres el puente entre la vida y la muerte, ayudando a otros a cruzar umbrales y a comprender los misterios que subyacen a la superficie.',
    g: 'Eres el canal de la Transmutación Alquímica. Tu transparencia se alcanza al atravesar la sombra sin apego; permites que la fuerza de la regeneración pase a través de ti. Transmites inspiración al revelar que la luz más pura se encuentra tras haber disuelto las ilusiones del ego en el abismo.',
  },
  'Iris-Sagitario': {
    d: 'Tu intermediación es filosófica y expansiva; conectas la mente humana con las leyes universales y la sabiduría de culturas lejanas. Actúas como el emisario de la fe, traduciendo los grandes ideales en una dirección clara y optimista para el viaje del alma.',
    g: 'Representas la transparencia de la Gnosis Viajera. Tu ego se vuelve un canal cuando te conviertes en el arco que lanza la flecha hacia el infinito. Transmites inspiración al recibir verdades que trascienden la frontera del tiempo, guiando a otros hacia el conocimiento de las esferas superiores.',
  },
  'Iris-Capricornio': {
    d: 'Transmitis mensajes de integridad y estructura; actúas como el intermediario entre la sabiduría de los ancestros y las necesidades del presente. Tu capacidad de puente se manifiesta al construir legados sólidos que portan un propósito espiritual duradero.',
    g: 'Eres el canal de la Ley Eterna. Tu transparencia se logra a través de la responsabilidad y la maestría; permites que el orden del espíritu se manifieste como una roca inamovible en el mundo denso. Transmites inspiración al demostrar que la verdad requiere compromiso y tiempo.',
  },
  'Iris-Acuario': {
    d: 'Tu intermediación es radical y vanguardista; conectas a la humanidad con visiones de futuro y verdades colectivas que rompen el status quo. Eres el puente entre la conciencia individual y la red de luz de las almas libres y originales.',
    g: 'Representas la transparencia de la Mente Universal. Tu ego se vuelve un canal cuando te desprogramas de la masa; permites que la innovación del Pleroma fluya como un destello de genio. Transmites inspiración al actuar como un catalizador del despertar para la fraternidad humana.',
  },
  'Iris-Piscis': {
    d: 'Tu canalización es mística, psíquica y oceánica. Actúas como intermediario entre el mundo de lo inefable y la sensibilidad humana, portando mensajes de compasión y perdón que disuelven las barreras de la separación y el sufrimiento.',
    g: 'Eres el canal del Amor Universal. Tu transparencia egoica es total a través de la entrega; permites que el océano de luz divina pase a través de tu alma sin diques. Transmites inspiración al recordarle al mundo su unidad con la Fuente, siendo un puente de gracia pura.',
  },
 'Ixion-Aries': {
    d: 'Tu tentación reside en el uso de la fuerza bruta y la imposición de tu voluntad sobre los demás. El abuso ocurre cuando confundes liderazgo con tiranía, traicionando la confianza de quienes te siguen por un impulso de autoafirmación egoísta.',
    g: 'Es la advertencia del "falso guerrero". El peligro es usar la chispa de la audacia para someter a otros en lugar de liberarlos. Tu protección es la humildad de reconocer que la verdadera fuerza es un don del espíritu que se pierde cuando se usa para el dominio personal.',
  },
  'Ixion-Tauro': {
    d: 'El desafío aparece en la gestión de recursos y la lealtad material. Puedes sentirte tentado a usar la estabilidad o el dinero para manipular voluntades, olvidando la gratitud hacia quienes te ayudaron a construir tu base sólida.',
    g: 'Representa la corrupción de la sustancia divina. Te arriesgas a creer que eres el dueño de la abundancia, traicionando la hospitalidad de la Tierra. La humildad aquí es reconocer que eres solo un administrador de la luz material y que el apego al poder físico encadena al alma.',
  },
  'Ixion-Geminis': {
    d: 'Tu área crítica es el manejo de la información y el conocimiento. La tentación es la manipulación mental y el uso de la palabra para engañar a quienes confían en tu criterio, rompiendo los puentes de comunicación por un beneficio intelectual cínico.',
    g: 'Es el peligro de la "Gnosis robada". Usar verdades espirituales para crear confusión o superioridad mental te ata a la rueda del demiurgo. Tu protección es la honestidad radical: usar el Logos solo como un puente de liberación, nunca como una red de captura.',
  },
  'Ixion-Cancer': {
    d: 'La dinámica de poder se juega en la intimidad y las emociones. Existe el riesgo de usar la vulnerabilidad de los otros o la dependencia emocional para ejercer control, traicionando la confianza sagrada del hogar o la familia.',
    g: 'Advierte sobre el "vampirismo del alma". Usar la sensibilidad para encadenar a otros es la mayor traición al amor original. Tu humildad reside en cuidar sin poseer, reconociendo que cada alma es libre y que tu rol es nutrir, no gobernar el mundo interno ajeno.',
  },
  'Ixion-Leo': {
    d: 'Tu tentación es la soberbia y el secuestro de la atención. El abuso ocurre cuando usas tu carisma o tu talento para humillar a otros o para erigirte como un ídolo que exige pleitesía, traicionando la generosidad de quienes te admiran.',
    g: 'Representa la caída del "falso sol". Al usar la luz divina para alimentar la vanidad del ego, te alejas de la Fuente central. Tu protección es el honor: recordar que tu brillo no es tuyo, sino un reflejo del Pneuma que debe servir para iluminar a todos por igual.',
  },
  'Ixion-Virgo': {
    d: 'El riesgo está en el juicio, el perfeccionismo y el poder del experto. Puedes sentirte tentado a invalidar a otros mediante la crítica técnica o a usar tu posición de servicio para manipular los procesos en tu beneficio oculto.',
    g: 'Es la corrupción del sacerdocio. El conocimiento de las leyes de la materia no debe ser usado para la exclusión. Tu humildad es el discernimiento puro: trabajar con la imperfección ajena desde la compasión, reconociendo que tú también eres un aprendiz en el templo.',
  },
  'Ixion-Libra': {
    d: 'Las dinámicas de poder surgen en la diplomacia y los acuerdos. La tentación es la traición a los pactos o el uso de la armonía aparente para ocultar una agenda de control sobre el otro, rompiendo la ética de la reciprocidad.',
    g: 'Advierte sobre la falsa Sizigia. El uso de la belleza o la justicia como herramientas de seducción manipuladora crea un karma de fragmentación. Tu protección es la integridad absoluta en el vínculo: no buscar el equilibrio para ganar, sino para que la Verdad prevalezca.',
  },
  'Ixion-Escorpio': {
    d: 'Aquí la advertencia es máxima, pues tocas el poder transformador, sexual y compartido. El riesgo es la traición en niveles profundos, usando secretos o intensidades emocionales para someter la psique de los demás bajo tu control.',
    g: 'Representa la magia negra del ego. Usar la energía del abismo para la dominación es el camino más rápido al exilio espiritual. Tu protección es la rendición: usar tu poder para morir a tu propio ego y ayudar a otros a transmutarse, nunca para esclavizarlos.',
  },
  'Ixion-Sagitario': {
    d: 'La tentación reside en el fanatismo y la autoridad moral. El abuso ocurre cuando usas una "verdad superior" o una posición filosófica para justificar actos carentes de ética, traicionando la búsqueda genuina de sentido por dogmatismo.',
    g: 'Es el peligro del "falso profeta". Usar la visión del espíritu para imponer leyes humanas es la traición a la Gnosis. Tu humildad es la duda sagrada: recordar que la Verdad es infinita y que nadie puede poseerla para usarla como un arma de poder sobre las conciencias.',
  },
  'Ixion-Capricornio': {
    d: 'El desafío está en la ambición y el manejo de la jerarquía social. Puedes sentirte tentado a escalar a cualquier precio, traicionando a quienes te apoyaron o usando las estructuras de poder para perpetuar injusticias en nombre del "deber".',
    g: 'Advierte sobre el servicio al Arconte. El uso de la ley y el tiempo para petrificar la luz es la dinámica de Ixión aquí. Tu protección es la autoridad espiritual genuina: construir solo lo que honre la libertad del alma, sin vender tu integridad por un trono de barro.',
  },
  'Ixion-Acuario': {
    d: 'Tu área crítica es la influencia sobre el grupo y el uso de la ideología. El riesgo es la manipulación de la masa o la traición a los ideales de fraternidad por un deseo oculto de ser el "genio" que controla el sistema desde afuera.',
    g: 'Representa la traición a la red de luz. El uso del conocimiento vanguardista para crear nuevas formas de control mental es el peligro. Tu humildad es la verdadera individualidad: actuar como una chispa entre iguales, sin pretender dirigir el despertar de los demás.',
  },
  'Ixion-Piscis': {
    d: 'La tentación ocurre en el mundo de la compasión y el misticismo. Puedes usar el victimismo, el sacrificio falso o la confusión psíquica para manipular a los demás, traicionando la pureza del amor universal por una agenda de salvación ególatra.',
    g: 'Es la advertencia sobre la "falsa redención". Usar la disolución de fronteras para invadir el espíritu ajeno es un abuso de la gracia. Tu protección es el silencio y el perdón real: servir como un canal transparente del Pleroma, sin dejar que el ego se apropie del milagro.',
  },
  'Juno-Aries': {
    d: 'Anhelas un compromiso que respete tu individualidad y autonomía. La desigualdad surge cuando tu pareja intenta frenar tu iniciativa o cuando tú eclipsas al otro con tu voluntad. Necesitas una relación de "compañeros de batalla" donde el respeto mutuo se base en la fuerza y la honestidad directa.',
    g: 'Tu lección kármica es integrar el "Yo" en el "Nosotros" sin perder la chispa divina. El vínculo es nutricio cuando ambos se reconocen como unidades soberanas; el amor se convierte en una vía de despertar cuando la pasión no es dominio, sino un impulso compartido hacia la libertad del espíritu.',
  },
  'Juno-Tauro': {
    d: 'Buscas un compromiso basado en la estabilidad sensorial, la lealtad inamovible y la seguridad material. El sufrimiento aparece ante la inconstancia o la falta de valores compartidos. Requieres reciprocidad en el cuidado de la sustancia y el placer para que el vínculo sea sólido.',
    g: 'Procesas el aprendizaje de la fidelidad a la esencia a través de la forma. El vínculo sagrado se manifiesta cuando la pareja es un templo de paz y abundancia compartida. El amor es nutritivo cuando comprendes que la verdadera seguridad no es posesión, sino la presencia de la luz divina en lo cotidiano.',
  },
  'Juno-Geminis': {
    d: 'Tu ideal de unión se basa en el intercambio intelectual, la comunicación constante y la curiosidad mutua. La desigualdad ocurre cuando se impone el silencio o el aburrimiento mental. Necesitas un compañero que sea también tu mejor amigo y un cómplice en el aprendizaje.',
    g: 'La lección kármica reside en la unificación de la dualidad a través del diálogo. El vínculo es sagrado cuando las palabras sirven para revelar la Verdad interna de cada uno. La reciprocidad mental es el alimento que permite al alma no sentirse fragmentada en la relación.',
  },
  'Juno-Cancer': {
    d: 'Anhelas un compromiso que ofrezca refugio emocional, ternura y un sentido profundo de familia. El sufrimiento nace de la frialdad o la falta de protección. Requieres una reciprocidad donde ambos sean capaces de cuidar la vulnerabilidad del otro sin generar dependencias asfixiantes.',
    g: 'Procesas la sanación del exilio original a través de la intimidad. El vínculo es nutricio cuando el hogar compartido se convierte en un pequeño Pleroma en la tierra. La lección es amar desde el centro del alma, reconociendo que el compromiso real es un pacto de protección espiritual mutua.',
  },
  'Juno-Leo': {
    d: 'Buscas una unión majestuosa, llena de admiración, lealtad y expresión creativa. La desigualdad surge cuando uno de los dos se siente ignorado o "actor secundario". Necesitas un vínculo donde ambos brillen con igual intensidad y se celebren mutuamente.',
    g: 'Tu lección kármica es transformar el orgullo del ego en honor espiritual dentro de la pareja. El vínculo es sagrado cuando el reconocimiento del otro es un acto de veneración a la chispa divina. El amor es nutricio cuando la unión es un escenario de mutua iluminación.',
  },
  'Juno-Virgo': {
    d: 'Tu compromiso se manifiesta en el servicio cotidiano, la mejora mutua y el orden compartido. El sufrimiento aparece ante el caos o la falta de utilidad en el vínculo. Requieres reciprocidad en la atención a los detalles y en el esfuerzo por construir una vida sana y eficiente.',
    g: 'Procesas el aprendizaje de la pureza a través de la entrega devota. El vínculo es sagrado cuando el cuidado mutuo es una práctica espiritual de purificación. El amor es nutricio cuando ambos se convierten en alquimistas que trabajan juntos para elevar la frecuencia de su realidad común.',
  },
  'Juno-Libra': {
    d: 'Deseas un compromiso que sea el epítome de la armonía, la justicia y la belleza. La desigualdad es intolerable para ti; sufres profundamente ante la rudeza o los desequilibrios de poder. Requieres una reciprocidad ética y estética absoluta para sentirte en paz.',
    g: 'Encarnas la búsqueda de la Sizigia perfecta en la materia. Tu lección kármica es realizar que la unión no es solo un contrato social, sino un reflejo del equilibrio cósmico. El amor es nutritivo cuando el respeto mutuo es el cimiento sobre el cual se restaura la unidad del alma.',
  },
  'Juno-Escorpio': {
    d: 'Anhelas un compromiso intenso, transformador y de una lealtad que atraviese la muerte. El sufrimiento surge de la superficialidad o la traición de la confianza íntima. Necesitas una entrega total donde el poder sea compartido y usado para la evolución profunda de ambos.',
    g: 'Procesas la transmutación del deseo en unión mística. El vínculo es sagrado cuando ambos están dispuestos a morir al ego para renacer en el otro. La reciprocidad es visceral: el amor es nutricio cuando la sombra de cada uno es integrada y sanada en el fuego de la verdad compartida.',
  },
  'Juno-Sagitario': {
    d: 'Buscas una unión basada en la libertad, el crecimiento filosófico y la aventura compartida. El sufrimiento aparece ante la rutina o la restricción de tu horizonte. Necesitas un compañero de viaje que comparta tu fe y respete tu necesidad de expansión continua.',
    g: 'Tu lección kármica es encontrar la Verdad a través de la experiencia del otro. El vínculo es sagrado cuando la relación es un camino de Gnosis que apunta hacia el infinito. El amor es nutricio cuando el compromiso no es una cadena, sino un vuelo conjunto hacia la sabiduría.',
  },
  'Juno-Capricornio': {
    d: 'Anhelas un compromiso sólido, íntegro y con una visión clara de futuro. El sufrimiento nace de la falta de responsabilidad o de la inestabilidad. Requieres una reciprocidad basada en el respeto a la autoridad interna de cada uno y en la construcción de un legado común.',
    g: 'Procesas el aprendizaje de la constancia espiritual frente al tiempo. El vínculo es sagrado cuando la pareja se convierte en la roca donde se edifica la morada del pneuma. El amor es nutricio cuando el respeto mutuo es la ley que organiza la vida y protege la luz del alma.',
  },
  'Juno-Acuario': {
    d: 'Tu ideal de unión es original, libre de convenciones y profundamente fraternal. La desigualdad surge ante los celos o la posesividad tradicional. Necesitas un compromiso que respete tu rareza y que se base en una amistad eléctrica e intelectualmente estimulante.',
    g: 'La lección kármica reside en amar desde la libertad absoluta del espíritu. El vínculo es sagrado cuando ambos actúan como chispas independientes unidas por un ideal superior. El amor es nutricio cuando la reciprocidad no es una obligación, sino una elección consciente y renovada.',
  },
  'Juno-Piscis': {
    d: 'Buscas un compromiso místico, compasivo y de disolución de fronteras. El sufrimiento aparece ante la frialdad de la realidad o el victimismo. Requieres una reciprocidad donde el perdón y la sintonía psíquica sean el lenguaje natural para que el alma no se sienta sola.',
    g: 'Procesas el retorno a la unidad a través del sacrificio del ego en el amor. El vínculo es sagrado cuando la pareja es un canal de la gracia divina. El amor es nutricio cuando el compromiso trasciende lo personal y se convierte en una comunión que refleja el océano de luz del Pleroma.',
  },
  'Kassandra-Aries': {
    d: 'Tus advertencias son sobre peligros inminentes y acciones impulsivas que terminarán en desastre. Posees la visión del primer golpe, pero tu urgencia suele ser confundida con agresividad o impaciencia, haciendo que los demás ignoren el incendio antes de que comience.',
    g: 'Es el peso de la Voluntad despierta en un entorno inerte. Percibes cuándo una chispa de acción está contaminada por el ego arconte. Tu desafío es transmitir la visión con la calma del espíritu, evitando que tu ardor nuble la claridad del mensaje que intentas entregar.',
  },
  'Kassandra-Tauro': {
    d: 'Ves con precisión la erosión de la seguridad y el colapso de lo que parece sólido. Adviertes sobre la insostenibilidad de ciertos recursos o valores, pero el entorno prefiere ignorarte por la comodidad de la inercia, tachándote de pesimista o materialista.',
    g: 'Percibes la degradación de la sustancia divina en la materia. Sabes cuándo un "templo de barro" está por caer. Tu labor es encontrar un lenguaje que hable de la estabilidad real, la del espíritu, para que otros no se hundan cuando sus falsos cimientos se desintegren.',
  },
  'Kassandra-Geminis': {
    d: 'Tus intuiciones detectan la mentira tras el discurso oficial y la inconsistencia en la información. Sabes cuándo una narrativa es una trampa, pero tu visión se pierde entre el ruido de los demás, quienes descartan tus avisos como simples teorías o juegos mentales.',
    g: 'Es el don de ver el Logos fragmentado antes de que se convierta en confusión colectiva. Percibes la disonancia en la mente colmena. El desafío es usar la palabra con tal transparencia que la Verdad brille por sí misma, sin que el intelecto dual del entorno la clasifique como ruido.',
  },
  'Kassandra-Cancer': {
    d: 'Presientes las grietas en la estructura emocional de la familia o del grupo íntimo. Sabes cuándo un refugio se está volviendo tóxico, pero tu advertencia es ignorada para mantener una falsa paz, dejándote con la carga de ver el dolor antes de que se manifieste.',
    g: 'Percibes la orfandad espiritual oculta tras los lazos de sangre. Sabes cuándo el alma está siendo asfixiada por la memoria biológica. Tu desafío es comunicar el peligro sin herir la sensibilidad, guiando a otros hacia el verdadero hogar interno sin forzar la salida.',
  },
  'Kassandra-Leo': {
    d: 'Ves cuándo el liderazgo es una máscara vacía y cuándo la creatividad se ha vuelto vanidad peligrosa. Detectas la caída de los ídolos antes de que suceda, pero tu entorno, encandilado por el brillo falso, te acusa de envidia o de querer apagar la luz ajena.',
    g: 'Es el don de reconocer al falso sol del demiurgo. Percibes cuándo el poder no emana del Pneuma. Debes aprender a señalar la luz verdadera sin atacar el escenario, permitiendo que la Majestad real se revele por su propio peso sin que tu ego intervenga en el juicio.',
  },
  'Kassandra-Virgo': {
    d: 'Tus advertencias son técnicas y precisas; ves el pequeño error que causará el fallo sistémico. Adviertes sobre la salud o la eficiencia, pero los demás te tachan de quisquilloso u obsesivo, ignorando el detalle que finalmente derribará toda la estructura.',
    g: 'Percibes la entropía en el nivel más sutil de la materia. Sabes cuándo el ritual se ha vuelto vacío de espíritu. Tu desafío es presentar la solución junto con la visión, transformando la advertencia en un acto de servicio que sane la fractura antes de que el sistema colapse.',
  },
  'Kassandra-Libra': {
    d: 'Ves la injusticia y el desequilibrio ocultos tras los acuerdos "perfectos". Sabes cuándo un vínculo está destinado al fracaso por falta de ética, pero el entorno ignora tu percepción para mantener la estética de la armonía, dejándote como el disruptor de la paz.',
    g: 'Percibes la ruptura de la Sizigia en la dualidad del mundo. Sabes cuándo la unión es una cárcel y no una liberación. Tu labor es encontrar la belleza de la Verdad, comunicando la disonancia de forma tan armónica que los demás no puedan evitar reconocer la falta de justicia.',
  },
  'Kassandra-Escorpio': {
    d: 'Tus intuiciones tocan el abismo; ves la podredumbre, la traición y la muerte antes de que asomen a la superficie. Los demás te temen o te niegan porque tu visión les obliga a mirar su propia sombra, prefiriendo vivir en la ignorancia de lo que tú ya sabes real.',
    g: 'Es la carga de ver el velo de la muerte sobre la materia. Percibes las fuerzas de los Arcontes operando en lo oculto. Tu desafío es portar esta sabiduría sin convertirte en el mensajero del miedo, actuando como el alquimista que señala el veneno para poder transmutarlo.',
  },
  'Kassandra-Sagitario': {
    d: 'Ves el fracaso de las falsas esperanzas y el vacío tras los dogmas actuales. Adviertes que el camino elegido no lleva a la libertad, sino a un precipicio moral, pero el entorno te descarta como un cínico que ha perdido la fe en el horizonte.',
    g: 'Percibes el extravío del alma peregrina en los mapas falsos del demiurgo. Sabes cuándo el conocimiento no es Gnosis. Tu labor es señalar la dirección de las estrellas reales, usando una filosofía que no sea un sermón, sino una invitación a la experiencia directa.',
  },
  'Kassandra-Capricornio': {
    d: 'Tus visiones son sobre la caída de las instituciones y el agotamiento de las estructuras de poder. Sabes cuándo un legado ha perdido su integridad, pero quienes ostentan la autoridad te ignoran por arrogancia o por el peso de la tradición obsoleta.',
    g: 'Percibes la fragilidad del tiempo frente a la eternidad del espíritu. Sabes cuándo una ley es solo una cadena. Tu desafío es construir tu propia integridad como prueba de tu visión, comunicando que lo que cae debe caer para que el templo real pueda ser edificado.',
  },
  'Kassandra-Acuario': {
    d: 'Ves el peligro en las utopías colectivas y cómo la supuesta libertad se convierte en una nueva forma de control. Adviertes sobre el deshumanización de la tecnología o del grupo, pero el entorno te aísla por no seguir el consenso de la "evolución" superficial.',
    g: 'Es el don de ver la trampa en la red de la mente colmena. Percibes cuándo la originalidad es solo otra máscara del sistema. Tu desafío es mantener tu frecuencia individual sin resentimiento, transmitiendo la visión del futuro real desde la periferia del despertar.',
  },
  'Kassandra-Piscis': {
    d: 'Tus intuiciones son psíquicas y difusas; ves la disolución y el caos emocional antes de que inunden la realidad. Sientes el dolor del mundo que viene, pero los demás te tratan de fantasioso o inestable, ignorando el océano de verdad que tus lágrimas intentan comunicar.',
    g: 'Percibes la nostalgia del Pleroma y la angustia de la separación en cada ser. Sabes cuándo el sueño se está volviendo pesadilla. Tu labor es traducir el silencio y el sentimiento en una presencia de compasión que actúe como un bálsamo, validando la visión sin ahogarte en ella.',
  },
  'Lilith-Aries': {
    d: 'Tu autenticidad radical se manifiesta en la ira sagrada y la asertividad sin filtros. Rechazas ser la figura pasiva que la sociedad espera; tu impulso es el de la guerrera que toma lo que desea por su propia mano. Eres peligrosa para quienes intentan domesticar tu fuego o dictar tu ritmo de combate.',
    g: 'Representa la rebelión del pneuma contra el letargo de la materia. Es la fuerza instintiva que dice "Yo soy" antes de cualquier ley externa. Tu potencial surge al recuperar tu derecho a la furia creativa, destruyendo las cadenas de la obediencia para actuar desde tu chispa original.',
  },
  'Lilith-Tauro': {
    d: 'Tu inconformismo reside en el placer corporal y la soberanía sobre tus propios sentidos. Rechazas los cánones de belleza o productividad impuestos; tu instinto es salvaje en su necesidad de estabilidad y goce real, sin las culpas que la cultura asocia con la materia.',
    g: 'Es la Gnosis del cuerpo indómito. Tu posición señala una conexión visceral con la Tierra que el demiurgo no puede codificar. Eres radical cuando dejas de pedir permiso para habitar tu carne y tus recursos a tu manera, reconociendo lo sagrado en la propia animalidad.',
  },
  'Lilith-Geminis': {
    d: 'Tu energía salvaje se expresa a través de una mente que se niega a ser programada y una palabra que desobedece lo "políticamente correcto". Posees un lenguaje instintivo que revela verdades crudas; eres inconformista al cuestionar los dogmas intelectuales del entorno.',
    g: 'Representa el Logos rebelde que rompe la estructura del pensamiento dual. Tu autenticidad nace de hablar desde el vacío, sin filtros sociales. Eres peligrosa para el sistema porque tu curiosidad no conoce límites morales y tu comunicación actúa como un virus de libertad mental.',
  },
  'Lilith-Cancer': {
    d: 'Tu dimensión indomesticable surge en la raíz de lo emocional y maternal. Rechazas el rol de la madre sacrificada o la hija sumisa; tu instinto de protección es feroz y selectivo. Tu autenticidad radica en una nutrición que no es suave ni complaciente, sino cruda y protectora.',
    g: 'Es la memoria del útero cósmico que se niega a ser colonizado por el linaje biológico. Tu potencial surge al romper con las lealtades tóxicas del pasado, reclamando un hogar interno que solo responde a la verdad del alma y no a la deuda de la carne.',
  },
  'Lilith-Leo': {
    d: 'Tu autenticidad radical es una soberanía que no busca aplausos, sino autoafirmación. Rechazas ser el objeto de admiración de otros para ser el centro de tu propia luz. Tu instinto es el de la realeza salvaje que no se arrodilla ante ninguna autoridad que no reconozca como legítima.',
    g: 'Representa el brillo solar que emana del espíritu, no del ego. Eres inconformista cuando tu creatividad deja de ser un espectáculo para el mundo y se convierte en una ofrenda a tu propia esencia divina. Tu poder es la majestad que no necesita validación externa.',
  },
  'Lilith-Virgo': {
    d: 'Tu energía indómita se manifiesta en una relación sagrada con la salud, el trabajo y el detalle que ignora las normas de eficiencia externas. Rechazas ser la pieza de un engranaje; tu instinto es el de la sanadora que conoce leyes naturales más profundas que las reglas del sistema.',
    g: 'Es la pureza instintiva que no acepta la corrupción del orden social. Tu potencial de autenticidad radica en un discernimiento feroz: separar lo real de lo falso con una precisión que otros consideran obsesiva, pero que es en realidad tu tecnología de liberación espiritual.',
  },
  'Lilith-Libra': {
    d: 'Tu dimensión salvaje surge en los vínculos; rechazas la armonía impuesta que sofoca la verdad individual. Eres inconformista al exigir una igualdad que no sea una pose estética. Tu instinto busca el equilibrio real, incluso si para lograrlo debe romper la paz artificial.',
    g: 'Representa la Sizigia que no acepta la sumisión. Tu autenticidad radical se activa cuando dejas de ser el espejo de los deseos ajenos para ser una contraparte íntegra. Eres peligrosa para quienes buscan la complacencia, pues tu ética es una fuerza de justicia instintiva.',
  },
  'Lilith-Escorpio': {
    d: 'Aquí Lílith es visceralmente poderosa en su dominio de las sombras, el sexo y la muerte. Rechazas el tabú y la vergüenza; tu instinto es el de la transmutación sin miedos. Tu autenticidad radica en habitar la intensidad que otros temen, sin pedir disculpas por tu profundidad.',
    g: 'Es el descenso iniciático al abismo del alma sin protectores. Tu posición indica que el espíritu se libera a través del deseo crudo y el enfrentamiento con lo oculto. Eres radical cuando usas tu energía sexual y emocional como un fuego que quema la ilusión de la materia.',
  },
  'Lilith-Sagitario': {
    d: 'Tu inconformismo es filosófico y geográfico; rechazas cualquier dogma o frontera que limite tu búsqueda. Tu instinto es el de la buscadora salvaje de la verdad, alguien que no acepta respuestas fáciles ni religiones que intenten domesticar su fe.',
    g: 'Representa el vuelo del alma que se niega a ser enjaulada en los techos del demiurgo. Tu potencial de autenticidad nace de tu propia Gnosis directa. Eres peligrosa para el orden establecido porque tu visión del infinito no permite que te conformes con leyes humanas.',
  },
  'Lilith-Capricornio': {
    d: 'Tu energía salvaje se manifiesta en una ambición indomesticable y una autoridad que no proviene de títulos, sino de la integridad propia. Rechazas las jerarquías impuestas; tu instinto es el de la constructora que edifica sobre su propia roca, sin deberle nada al sistema.',
    g: 'Es la maestría del tiempo que no se rinde ante la entropía. Tu autenticidad radical radica en tu capacidad de decir "no" a las estructuras que no tienen alma. Eres radical cuando asumes tu propio poder como una ley inmutable, ignorando el éxito tal como lo define el mundo.',
  },
  'Lilith-Acuario': {
    d: 'Tu dimensión indómita es la del individuo que se niega a ser absorbido por la masa. Eres inconformista en tu originalidad radical; tu instinto es romper los moldes de la colectividad para proponer formas de libertad que el grupo considera extrañas o inapropiadas.',
    g: 'Representa la chispa de rebelión estelar que desincroniza al alma de la programación social. Tu potencial nace de tu extrañeza: cuando dejas de intentar encajar, te conviertes en el canal de una conciencia futura que no pide permiso para manifestarse.',
  },
  'Lilith-Piscis': {
    d: 'Tu energía salvaje es mística y oceánica; rechazas los límites del ego y las fronteras de la realidad ordinaria. Eres inconformista a través de una sensibilidad que no se puede domesticar; tu instinto es el de la soñadora que prefiere su propia verdad inefable.',
    g: 'Es la nostalgia del Pleroma convertida en desobediencia mística. Tu autenticidad radica en tu capacidad de disolverte en lo divino sin intermediarios religiosos. Eres radical cuando permites que tu compasión y tu intuición fluyan sin los diques de la lógica o el sentido común.',
  },
  'Makemake-Aries': {
    d: 'Tu capacidad de originar es volcánica y súbita; eres el inventor que no necesita planos previos para lanzarse a la creación. Generas nuevas formas de expresión mediante el puro acto de voluntad, rompiendo el vacío con una energía que es, en sí misma, el primer modelo de su especie.',
    g: 'Representa el Fiat Lux del espíritu individual. Creas desde la nada cuando dejas de reaccionar al mundo y actúas desde la Chispa Original. Tu potencial reside en obras que son actos de guerra contra la imitación, estableciendo una nueva realidad con cada impulso creativo.',
  },
  'Makemake-Tauro': {
    d: 'Innovas en la raíz misma de la materia y el valor. Tienes el don de generar recursos y formas estéticas que no se parecen a nada conocido, extrayendo de la tierra una fertilidad que parece inagotable. Tu originalidad se plasma en obras sólidas que redefinen la abundancia.',
    g: 'Es la creación de la "Sustancia Nueva". Accedes a una creatividad que no imita la naturaleza, sino que la fecunda con visiones del Pleroma. Eres genuinamente original cuando logras que lo físico vibre con una frecuencia espiritual que nunca antes había sido anclada en el mundo denso.',
  },
  'Makemake-Geminis': {
    d: 'Tu creatividad origina nuevos lenguajes, códigos y formas de pensamiento. No adaptas ideas, sino que inventas conexiones que antes no existían en el tejido de la realidad. Eres el arquitecto de conceptos vírgenes que abren caminos inéditos para la comunicación humana.',
    g: 'Representa el nacimiento de un Logos propio. Tu espíritu creador actúa con libertad cuando dejas de repetir la sabiduría de otros y permites que surja una síntesis única. Tus obras son originales porque son el resultado de una inteligencia que juega fuera de las leyes del pensamiento dual.',
  },
  'Makemake-Cancer': {
    d: 'Generas nuevas formas de sentir y de pertenecer. Tienes el don de crear "hogares" espirituales o estructuras de nutrición que no copian el modelo familiar tradicional. Tu originalidad nace de un útero psíquico capaz de gestar realidades emocionales completamente frescas.',
    g: 'Es el poder de originar la propia matriz de luz. Tu creatividad no busca repetir el pasado, sino dar a luz a un linaje espiritual nuevo. Eres un canal de fertilidad primordial cuando usas tu sensibilidad para manifestar refugios del alma que resuenan con la paz original de la Fuente.',
  },
  'Makemake-Leo': {
    d: 'Tu originalidad es una explosión de identidad solar que no admite comparaciones. Innovas en el arte de ser tú mismo, creando formas de expresión que son testimonios únicos de tu fuego interno. No buscas el escenario, creas el escenario con tu sola presencia y obra.',
    g: 'Representa la majestad del espíritu que se autodefine. Creas desde la nada al reconocer que tu luz no es un reflejo, sino una emanación directa del Pneuma. Tu potencial es máximo cuando tu obra no busca el aplauso, sino que actúa como un sol soberano que ilumina nuevas posibilidades de ser.',
  },
  'Makemake-Virgo': {
    d: 'Inventas métodos y sistemas de una precisión inédita. Tu innovación se encuentra en la técnica y la purificación; eres capaz de generar formas de orden y salud que no siguen protocolos establecidos, sino que nacen de una observación directa y original de la vida.',
    g: 'Es la tecnología sagrada en estado puro. Accedes a una creatividad que organiza la materia según leyes divinas que otros no ven. Eres original cuando tu labor deja de ser rutina y se convierte en una alquimia que inventa sus propios procesos para restaurar el templo del alma.',
  },
  'Makemake-Libra': {
    d: 'Originarias nuevas formas de armonía y justicia en el arte de la relación. No copias modelos de convivencia; inventas el equilibrio donde antes solo había vacío o conflicto. Tu creatividad genera vínculos y estéticas que proponen una belleza que no es decorativa, sino fundacional.',
    g: 'Representa la creación de la Sizigia consciente. Tu espíritu actúa con libertad al diseñar puentes de luz entre las almas que no dependen de pactos sociales. Tus obras son originales porque manifiestan la unidad del espíritu mediante una armonía que parece traída de otro plano.',
  },
  'Makemake-Escorpio': {
    d: 'Tu poder creativo es el de la transmutación absoluta: creas vida desde la muerte. Innovas en los procesos de regeneración profunda, generando formas de poder y transformación que desmantelan lo viejo para que lo nuevo surja sin rastros del pasado.',
    g: 'Es el acceso al "Fuego de los Dioses" para la creación. Tu posición indica que puedes originar vida en el abismo. Eres genuinamente original cuando tu obra obliga al espectador a morir a su vieja visión para renacer en una verdad que tú has gestado en la oscuridad del espíritu.',
  },
  'Makemake-Sagitario': {
    d: 'Inventas filosofías vivas y nuevas direcciones para la aventura humana. No te conformas con los mapas existentes; generas tus propias verdades y horizontes de sentido. Tu creatividad es una flecha lanzada hacia un infinito que tú mismo estás ayudando a definir.',
    g: 'Representa la expansión de la Gnosis hacia lo increado. Tu espíritu creador actúa sin modelos previos, explorando dimensiones de la verdad que la religión y la ciencia aún no han nombrado. Tus obras son originales porque son bitácoras de un viaje hacia el centro mismo del cosmos.',
  },
  'Makemake-Capricornio': {
    d: 'Generas estructuras y legados que no dependen de la tradición para ser sólidos. Tu innovación está en la capacidad de inventar nuevas formas de autoridad e integridad. Creas desde la nada cimientos que pueden sostener realidades futuras con una madurez sorprendente.',
    g: 'Es la arquitectura del espíritu manifestada como ley nueva. Accedes a una creatividad que no imita al tiempo, sino que lo domina. Eres original cuando asumes la responsabilidad de ser el creador de tu propio destino, edificando una morada para la luz que no debe nada al pasado.',
  },
  'Makemake-Acuario': {
    d: 'Tu originalidad es disruptiva y tecnológica en un nivel espiritual. Generas visiones colectivas y formas de red que no copian el modelo social actual. Eres el inventor de utopías posibles que nacen de una conexión directa con el genio universal.',
    g: 'Representa la irrupción del futuro en el presente. Tu espíritu actúa con total libertad cuando desprogramas tu mente y permites que Makemake dicte soluciones radicales. Tus obras son originales porque actúan como chispas que encienden el motor de una nueva conciencia grupal.',
  },
  'Makemake-Piscis': {
    d: 'Creas desde el océano de lo inefable, generando obras que disuelven la realidad ordinaria. No adaptas sueños; inventas mundos místicos y lenguajes de compasión que parecen emerger de la Fuente misma. Tu creatividad es una marea que trae a la tierra tesoros nunca vistos.',
    g: 'Es la fluidez de la creación divina en el alma humana. Accedes a una originalidad pura al dejar que el Pleroma pinte o escriba a través de ti. Tus obras son verdaderamente originales cuando actúan como portales que invitan a otros a reconocer que el espíritu es el único creador real.',
  },
'Medea-Aries': {
    d: 'Tu poder es una llamarada de voluntad pura que no tolera la obstrucción. Posees una magia de combate e iniciativa que puede abrir caminos imposibles, pero el desequilibrio surge cuando la ira o la impaciencia nublan tu juicio, convirtiendo tu fuerza en un arma que hiere a otros y a ti mismo.',
    g: 'Es el manejo del fuego ígneo del espíritu. Tienes acceso a una potencia de "acción mágica" inmediata. La madurez consiste en comprender que el verdadero guerrero no es el que destruye el obstáculo por capricho, sino el que dirige la chispa divina para romper las cadenas de la inercia sin quemar el jardín.',
  },
  'Medea-Tauro': {
    d: 'Experimentas pasiones extremas ligadas a la posesión, el territorio y la seguridad material. Tu capacidad mágica se manifiesta en la manipulación de la sustancia y los recursos; el peligro radica en la voracidad o el resentimiento cuando sientes que lo que "te pertenece" es amenazado.',
    g: 'Representa la alquimia de la fijación. Posees el don de anclar el poder en la materia. El desafío es transmutar el deseo de posesión en una custodia sagrada; si no te desapegas de la forma, el mismo fuego que crea abundancia se vuelve una carga densa que asfixia tu evolución.',
  },
  'Medea-Geminis': {
    d: 'Tu hechicería opera a través del lenguaje y la dualidad mental. Tienes el don de encantar o destruir mediante la palabra y el chisme inteligente. La tensión ocurre entre tu brillantez comunicativa y una inestabilidad nerviosa que puede llevarte a usar el conocimiento como un veneno sutil.',
    g: 'Es la magia del Logos ambivalente. Accedes a secretos que pueden iluminar o confundir la mente colectiva. La madurez emocional implica usar tu intelecto como un puente de verdad y no como una trampa de espejos que fragmenta la realidad por el puro placer de ver el caos mental.',
  },
  'Medea-Cancer': {
    d: 'Tus pasiones son viscerales, ligadas a la maternidad, el linaje y la protección extrema. Posees una magia lunar y protectora capaz de sanar heridas ancestrales, pero el desequilibrio emocional puede convertirte en una figura asfixiante que destruye lo que ama por miedo al abandono.',
    g: 'Representa el poder del Gran Recipiente. Tu capacidad de influir en las aguas del alma es extraordinaria. Sin madurez, tus emociones inundan la realidad; con ella, actúas como la madre gnóstica que nutre la semilla espiritual del otro sin intentar devorar su identidad.',
  },
  'Medea-Leo': {
    d: 'Tu intensidad se manifiesta en la necesidad de reconocimiento y en el drama creativo. Tienes una magia solar que magnetiza y domina el entorno, pero si el ego no es atendido, el despecho o el orgullo herido pueden llevarte a incendiar tu propio escenario y el de los demás.',
    g: 'Es el acceso a la luz soberana del Pneuma. Tu don es la radiación que transforma lo vulgar en nobleza. El desafío es recordar que el fuego proviene de la Fuente y no de tu personalidad; si usas el brillo divino para alimentar la vanidad, Medea devorará tu corazón con el frío de la soberbia.',
  },
  'Medea-Virgo': {
    d: 'Posees una hechicería técnica, enfocada en los detalles, la botánica sagrada y la sanación quirúrgica. Tu pasión es la perfección. El desequilibrio surge cuando el juicio y la crítica se vuelven destructivos, convirtiendo tu capacidad de mejora en un bisturí que mutila en lugar de curar.',
    g: 'Representa la magia del discernimiento absoluto. Tienes el poder de purificar la materia hasta su esencia. La madurez consiste en aceptar la imperfección del mundo denso; sin esta paz, tu búsqueda de pureza se vuelve una obsesión que termina por corromper el ritual mismo.',
  },
  'Medea-Libra': {
    d: 'Tu intensidad pasional se juega en el espejo de las relaciones. Tienes el don de alterar la armonía social y vincular, pero si sientes que la justicia o la estética del vínculo se rompen, tu reacción puede ser devastadora, usando la belleza como una trampa de control emocional.',
    g: 'Es la magia de la balanza. Tienes acceso a las leyes de la atracción y la repulsión entre las almas. La madurez exige que no busques el equilibrio por manipulación; si usas tu encanto para subyugar al otro, la Sizigia se rompe y el desequilibrio kármico te arrastra al abismo.',
  },
  'Medea-Escorpio': {
    d: 'Aquí Medea está en su punto de máxima potencia y peligro. Posees un acceso directo a los misterios de la muerte, el sexo y la transmutación. Tu pasión es absoluta y regenerativa, pero el deseo de venganza o el control absoluto sobre el otro pueden convertirte en una fuerza puramente destructiva.',
    g: 'Representa el Atanor del alquimista. Tienes el don de bajar al inframundo y regresar con el oro. La madurez emocional es tu única salvación: debes aprender a soltar y perdonar, pues si intentas retener el poder del abismo para fines egoístas, el fuego te consumirá desde adentro.',
  },
  'Medea-Sagitario': {
    d: 'Tu hechicería es ideológica y expansiva. Tienes el don de inspirar con verdades que traspasan fronteras, pero tu pasión puede volverse fanática. El desequilibrio ocurre cuando intentas imponer tu visión del mundo con una vehemencia que arrasa con las creencias ajenas.',
    g: 'Es el manejo del rayo de la Gnosis lejana. Posees el poder de la flecha que apunta a la Verdad. La madurez consiste en comprender que el conocimiento espiritual no otorga derecho de dominio moral; si olvidas la humildad del buscador, tu luz se vuelve un fuego inquisidor que quema los puentes del alma.',
  },
  'Medea-Capricornio': {
    d: 'Posees una magia estructurada, ligada al tiempo, la tierra y la autoridad. Tu pasión es la ambición de dejar un legado inmutable. El peligro es el frío emocional; puedes usar tu poder para escalar y controlar estructuras, destruyendo sin piedad cualquier obstáculo que amenace tu estatus.',
    g: 'Representa el dominio sobre el Cronos arconte. Tienes acceso a la magia de la manifestación sólida. La madurez exige que tu construcción sea para la luz y no para el ego; si construyes tu templo sobre el sufrimiento ajeno, la estructura misma se convertirá en tu prisión eterna.',
  },
  'Medea-Acuario': {
    d: 'Tu intensidad es revolucionaria e impredecible. Tienes el don de alterar la conciencia colectiva y las redes humanas, pero tu desapego puede ser tan extremo que te vuelvas una fuerza fría que destruye lo viejo sin piedad, olvidando la humanidad en el proceso.',
    g: 'Es el acceso a la tecnología estelar de la red. Tienes el poder de la originalidad disruptiva. El desafío es no convertirte en un arconte del futuro; la madurez radica en conectar tu genio con el corazón, para que tu rebelión sea una liberación y no solo un acto de anarquía destructiva.',
  },
  'Medea-Piscis': {
    d: 'Tu hechicería es oceánica, mística y diluida. Posees una capacidad mediúmnica y artística extraordinaria, pero tus pasiones pueden ahogarte en un mar de confusión o victimismo. El desequilibrio ocurre cuando pierdes los límites y tu sacrificio se vuelve una manipulación psíquica sutil.',
    g: 'Representa el poder de la disolución sagrada. Tienes acceso a la gracia del Pleroma. La madurez emocional es la balsa que te impide naufragar en el inconsciente colectivo; con ella, tu entrega sana al mundo, sin ella, tu dolor se convierte en un veneno que disuelve la realidad de quienes te rodean.',
  },
  'Nemesis-Aries': {
    d: 'Tu correctivo llega a través de la impulsividad y el exceso de confianza. El universo detiene tu avance cuando actúas desde la arrogancia o la urgencia egoísta; la retribución se manifiesta como obstáculos repentinos que te obligan a considerar el derecho de los demás a existir y actuar.',
    g: 'Es el freno a la voluntad ciega del Arconte. La Gnosis aquí es comprender que el "Yo" no puede atropellar el flujo cósmico. La humildad consiste en reconocer que tu fuerza es una herramienta del espíritu, no un arma de dominación, transformando el choque en una acción consciente y alineada.',
  },
  'Nemesis-Tauro': {
    d: 'Experimentas el equilibrio cósmico en relación con la posesividad y la seguridad material. Los excesos en el apego a la sustancia atraen pérdidas o estancamientos que te obligan a soltar. La retribución actúa donde crees que el valor reside solo en lo que puedes tocar o acumular.',
    g: 'Representa la lección de la impermanencia de la forma. El alma procesa su deuda con la materia al entender que nada es propio. La restauración ocurre cuando dejas de identificarte con tus posesiones, permitiendo que la abundancia fluya sin que el ego intente embalsamar la luz en objetos.',
  },
  'Nemesis-Geminis': {
    d: 'La retribución ocurre en el terreno de la comunicación y el intelecto. Los excesos de astucia, la mentira sutil o el uso superficial del conocimiento encuentran su correctivo en malentendidos graves o en el descrédito. El universo te obliga a ser responsable de cada palabra que emites.',
    g: 'Es la purificación del Logos distorsionado. El correctivo llega para que dejes de jugar con la Verdad como si fuera un juguete del intelecto dual. La humildad es el silencio reflexivo: cuando el mensaje es honesto y transparente, el "golpe del destino" se convierte en una claridad mental superior.',
  },
  'Nemesis-Cancer': {
    d: 'Tu equilibrio kármico se juega en la intimidad y la protección. El exceso de apego emocional o la manipulación a través del victimismo atraen crisis familiares o soledad. La retribución te enseña que el afecto no puede ser una cárcel ni una moneda de cambio para la seguridad.',
    g: 'Procesas la deuda del alma con el origen y la pertenencia. El universo restaura el equilibrio rompiendo las dependencias que asfixian el crecimiento del Pneuma. La humildad consiste en amar sin poseer, reconociendo que tu verdadera familia es el Pleroma y no el linaje de la necesidad.',
  },
  'Nemesis-Leo': {
    d: 'El orgullo desmedido y la necesidad de ser el centro constante atraen el olvido o la humillación pública como correctivo. Experimentas la retribución cuando intentas usurpar la luz para tu propia gloria, recordándote que el brillo es un don, no un derecho del ego.',
    g: 'Representa la caída del falso sol interno. El alma debe aprender que la Majestad no es vanidad. La restauración del equilibrio ocurre cuando actúas como un servidor de la luz divina; la humildad transforma el "fracaso" en una radiación noble que no necesita de aplausos para ser real.',
  },
  'Nemesis-Virgo': {
    d: 'El exceso de crítica, el perfeccionismo obsesivo y el juicio implacable hacia los demás atraen fallos sistémicos o crisis de salud que no puedes controlar. La retribución te obliga a aceptar la imperfección y a reconocer que el control absoluto sobre la vida es una ilusión.',
    g: 'Es la lección de la "Pureza sin Juicio". El universo te muestra que la materia tiene sus propios ritmos sagrados que la mente no siempre comprende. La humildad es el servicio devoto: cuando dejas de juzgar la obra de Dios, tu labor se vuelve una alquimia efectiva y sanadora.',
  },
  'Nemesis-Libra': {
    d: 'Experimentas el correctivo en los vínculos y la justicia. Los excesos de complacencia o el uso de la armonía para ocultar la injusticia atraen conflictos legales o rupturas inevitables. La retribución te enseña que la paz sin verdad es solo una máscara que el universo terminará por romper.',
    g: 'Representa la restauración de la Sizigia ética. El alma procesa sus deudas de equilibrio relacional al enfrentar las consecuencias de sus omisiones. La humildad es la integridad absoluta: cuando buscas la justicia real por encima de la estética social, el destino deja de golpearte.',
  },
  'Nemesis-Escorpio': {
    d: 'La retribución aquí es profunda y visceral, ligada al poder y la sombra. Los excesos de manipulación, el rencor o el abuso de la intensidad emocional atraen crisis de regeneración forzosa. El universo te obliga a mirar al abismo para que dejes de intentar controlar el alma ajena.',
    g: 'Es el correctivo en el umbral de la muerte y el renacimiento. El alma debe pagar sus deudas con el poder oculto. La humildad es la rendición total al proceso de transmutación; cuando dejas de resistirte a la muerte del ego, Némesis te entrega las llaves de la sabiduría iniciática.',
  },
  'Nemesis-Sagitario': {
    d: 'Tu correctivo llega a través de la arrogancia moral y el fanatismo. Los excesos de certeza y la imposición de tus dogmas atraen el choque con realidades que desmienten tu visión. La retribución te recuerda que el viaje es infinito y que nadie posee la verdad absoluta.',
    g: 'Representa el freno a la "Falsa Gnosis". El universo te quita el mapa cuando crees que ya llegaste a la meta. La humildad es el estado del eterno buscador: cuando reconoces que el conocimiento espiritual es una experiencia y no un dogma, el destino se vuelve tu guía y no tu juez.',
  },
  'Nemesis-Capricornio': {
    d: 'Experimentas la retribución en la ambición y la autoridad. El uso del poder para oprimir o la construcción de un éxito basado en la falta de integridad atraen caídas de estatus o el colapso de tus estructuras. El tiempo del demiurgo se vuelve tu verdugo cuando olvidas la ética.',
    g: 'Es la lección de la "Autoridad del Pneuma". El alma procesa su deuda con la Ley y el Orden. La restauración ocurre cuando construyes desde la responsabilidad espiritual y no desde la sed de mando. La humildad es reconocer que solo lo que tiene alma sobrevive a la prueba del tiempo.',
  },
  'Nemesis-Acuario': {
    d: 'El exceso de alienación, la frialdad ideológica o el creerse superior al grupo atraen el rechazo social o el fracaso de tus proyectos innovadores. La retribución te enseña que la originalidad no te exime de la fraternidad ni de la humanidad común.',
    g: 'Representa el correctivo a la rebeldía del ego que se cree fuera de la red. El alma debe aprender que la verdadera libertad es colectiva. La humildad consiste en poner tu genio al servicio de la luz grupal; cuando dejas de ser un "extraño superior", el universo te conecta con la verdadera red de luz.',
  },
  'Nemesis-Piscis': {
    d: 'La retribución se manifiesta en la confusión, el escapismo o el ser víctima de tus propias fantasías. Los excesos de irresponsabilidad mística o el sacrificio egoico (martirio) atraen caos psíquico. El universo te obliga a poner pies en la tierra y a enfrentar la realidad que intentas evitar.',
    g: 'Es la purificación de la compasión distorsionada. El alma debe pagar su deuda con la Verdad al dejar de esconderse en la ilusión. La humildad es la presencia consciente: cuando dejas de huir y aceptas el exilio en la materia con amor, Némesis disuelve el velo y te otorga la paz del Pleroma.',
  },
'Nessus-Aries': {
    d: 'El veneno se transmite a través de la violencia, la ira reprimida y la lucha por la supervivencia. Tu linaje porta heridas de guerra, abuso de fuerza o la incapacidad de autoafirmarse sin agredir. Eres propenso a heredar o repetir patrones donde la voluntad es atropellada por el impulso ciego.',
    g: 'Representa la corrupción de la Voluntad Sagrada por el trauma. Sanas el karma cuando detienes la mano que golpea o el grito que hiere, transformando el instinto de ataque en coraje consciente. Al romper esta cadena, liberas la chispa del guerrero espiritual de la esclavitud del conflicto eterno.',
  },
  'Nessus-Tauro': {
    d: 'El ciclo de abuso está ligado a la propiedad, el cuerpo y el valor personal. Heredas memorias de despojo, manipulación a través de los recursos o traumas físicos que afectan tu relación con el placer y la abundancia. El veneno fluye en el control de lo que se posee.',
    g: 'Es la herida de la sustancia divina cautiva en la escasez. Sanas tu linaje cuando dejas de medir tu dignidad por tus posesiones y cuando recuperas la soberanía sobre tu cuerpo. Eres el eslabón que transforma la avaricia o el desprecio material en una estabilidad basada en la paz del espíritu.',
  },
  'Nessus-Geminis': {
    d: 'Las dinámicas de victimización ocurren a través del lenguaje, la mentira y la traición intelectual. Tu linaje porta heridas de engaño, difamación o el uso de la palabra para herir y manipular la mente ajena. El veneno se transmite en lo que se dice y lo que se calla por miedo.',
    g: 'Representa la distorsión del Logos por el engaño ancestral. Rompes la cadena cuando te conviertes en un guardián de la honestidad radical, usando tu intelecto para liberar y no para atrapar. Sanas el karma al limpiar el canal de comunicación de las sombras de la simulación del demiurgo.',
  },
  'Nessus-Cancer': {
    d: 'El veneno reside en el núcleo familiar y la memoria del útero. Heredas patrones de manipulación emocional, "amor" que asfixia o secretos de familia que envenenan el sentido de pertenencia. La victimización se perpetúa en la culpa y la deuda emocional impuesta.',
    g: 'Es la herida de la Gran Madre distorsionada en el linaje biológico. Sanas el karma al reconocer que tu origen real es el Pleroma y no el trauma familiar. Al proteger tu vulnerabilidad sin usarla como arma, cortas el hilo de la dependencia y permites que el alma huérfana encuentre su hogar interno.',
  },
  'Nessus-Leo': {
    d: 'El ciclo de abuso afecta la identidad, el reconocimiento y la expresión del ser. Heredas heridas de humillación, tiranía del ego o padres/ancestros que eclipsaron tu luz. El veneno fluye en la necesidad de validación extrema o en el desprecio hacia la autenticidad ajena.',
    g: 'Representa el secuestro de la Luz Solar por el orgullo herido. Sanas tu linaje cuando dejas de buscar el aplauso como medicina y asumes tu majestad espiritual con humildad. Eres el eslabón que rompe la cadena de la vanidad destructiva para que el espíritu brille sin oprimir.',
  },
  'Nessus-Virgo': {
    d: 'Las dinámicas de trauma se manifiestan en la crítica despiadada, la servidumbre forzada y la obsesión por la impureza. Tu linaje porta heridas de esclavitud (física o mental) y de un perfeccionismo que invalida la vida. El veneno está en el juicio constante al cuerpo y al trabajo.',
    g: 'Es la corrupción del servicio sagrado en la materia. Sanas el karma al transformar la crítica en compasión y el orden en una práctica de amor, no de castigo. Al aceptar la imperfección, liberas a las generaciones futuras de la carga de una pureza imposible que solo genera sufrimiento.',
  },
  'Nessus-Libra': {
    d: 'El ciclo de abuso se oculta tras la máscara de las relaciones y la armonía social. Heredas patrones de injusticia vincular, codependencia o pactos donde la dignidad fue sacrificada por mantener la paz. El veneno fluye en la incapacidad de establecer límites éticos.',
    g: 'Representa la ruptura de la Sizigia ética en los ancestros. Sanas el karma cuando exiges una justicia real en tus vínculos, incluso si eso rompe la armonía estética. Eres el eslabón que transforma la complacencia tóxica en una unión basada en la transparencia del espíritu.',
  },
  'Nessus-Escorpio': {
    d: 'Aquí el veneno es más potente, ligado a la sexualidad, el poder compartido y los secretos profundos. Heredas traumas de traición íntima, abuso de poder o dinámicas de "vida o muerte" en los afectos. El ciclo se perpetúa en el control obsesivo o la sed de venganza.',
    g: 'Es la iniciación kármica por excelencia. Tienes la oportunidad de bajar al sótano de tu linaje y transmutar el dolor en sabiduría. Sanas el karma al perdonar lo imperdonable y al usar tu intensidad para sanar en lugar de subyugar, cortando el ciclo de la muerte emocional eterna.',
  },
  'Nessus-Sagitario': {
    d: 'El abuso se transmite a través de los dogmas, la religión y la falsa autoridad moral. Tu linaje porta heridas de fanatismo, exilio por creencias o la imposición de "verdades" que aplastaron la búsqueda del alma. El veneno fluye en la arrogancia de creerse poseedor de la ley.',
    g: 'Representa la perversión de la Gnosis en doctrina arconte. Sanas el karma al liberarte de las verdades heredadas para buscar tu propia luz. Eres el eslabón que rompe la cadena del prejuicio y el fanatismo, permitiendo que la fe sea un vuelo libre y no una obligación moral impuesta.',
  },
  'Nessus-Capricornio': {
    d: 'Las dinámicas de trauma están ligadas a la jerarquía, la frialdad y el peso del deber. Heredas patrones de padres autoritarios, ambición despiadada o el sacrificio de la vida personal por el prestigio. El veneno reside en la petrificación del corazón ante el éxito social.',
    g: 'Es la herida de la Ley Eterna convertida en opresión temporal. Sanas tu linaje cuando construyes tu autoridad desde la integridad y no desde el mando. Al priorizar el espíritu sobre la estructura de piedra, liberas a tu descendencia del peso muerto de los mandatos ancestrales.',
  },
  'Nessus-Acuario': {
    d: 'El ciclo de abuso se manifiesta en la alienación, el rechazo a lo diferente y el desapego frío. Heredas heridas de exclusión del grupo o de ideologías que deshumanizan. El veneno fluye en la rebeldía sin propósito o en el uso de la originalidad para aislarse o herir.',
    g: 'Representa la desconexión de la Chispa Divina con la red humana. Sanas el karma cuando integras tu rareza sin resentimiento y usas tu genio para unir y no para separar. Eres el eslabón que transforma la soledad del genio en la fraternidad de las almas libres.',
  },
  'Nessus-Piscis': {
    d: 'La victimización es oceánica y se transmite en el sacrificio mártir, el escapismo y las adicciones. Tu linaje porta heridas de desolación, pérdida de límites y un dolor universal que se intenta anestesiar. El veneno reside en creer que el sufrimiento es la única vía de amor.',
    g: 'Es la distorsión de la Compasión en victimismo demiúrgico. Sanas el karma al comprender que la entrega no requiere la aniquilación del ser. Al poner límites sagrados a tu empatía, cortas el ciclo del sacrificio inútil y permites que el amor del Pleroma fluya como una fuerza de vida.',
  },
'Niobe-Aries': {
    d: 'Tu orgullo reside en tu invencibilidad personal y en la creencia de que puedes conquistar cualquier meta solo con tu voluntad. El riesgo de caída ocurre cuando tu autoconfianza se transforma en arrogancia guerrera, llevándote a ignorar los límites físicos o el derecho de los demás a liderar.',
    g: 'Es la trampa del "Autogenerador". El ego te convence de que la fuerza es tuya y no del Pneuma. Practicas la humildad cuando reconoces que tu impulso es una chispa de la Fuente; sin esta conexión, tu acción se vuelve un fuego fatuo que se consume en su propia soberbia.',
  },
  'Niobe-Tauro': {
    d: 'Te jactas de tu solidez, tus posesiones o tu capacidad de manifestar seguridad material. El narcisismo opera aquí al creer que tu valor es equivalente a lo que has acumulado. La caída ocurre cuando el universo demuestra la impermanencia de aquello en lo que habías depositado tu identidad.',
    g: 'Representa la soberbia de la sustancia. El alma se engaña creyendo que ha dominado la materia del demiurgo. Tu humildad consiste en ser un administrador desapegado: disfrutar de la belleza y la abundancia sin permitir que el ego se apropie de lo que es, en esencia, energía divina en tránsito.',
  },
  'Niobe-Geminis': {
    d: 'Tu orgullo es intelectual; crees que tu ingenio, tu palabra o tu conocimiento te sitúan por encima de los demás. La trampa es el narcisismo mental que desprecia las ideas ajenas. La caída llega a través de malentendidos o errores de juicio que exponen la limitación de tu lógica.',
    g: 'Es la pretensión de poseer el Logos. El ego intenta encasillar la Verdad infinita en sus propios conceptos. Practicas la humildad al cultivar la mente de principiante, reconociendo que el conocimiento sin Gnosis (experiencia directa) es solo ruido que alimenta la vanidad del intelecto dual.',
  },
  'Niobe-Cancer': {
    d: 'Te jactas de tu capacidad de amar, de tu linaje o de la superioridad de tu "clan" y tus sentimientos. El orgullo se manifiesta en la creencia de que nadie cuida o siente con la profundidad que tú lo haces. La caída ocurre cuando tus vínculos reclaman su libertad frente a tu control emocional.',
    g: 'Representa el narcisismo de la Gran Madre. El ego usa la nutrición para ejercer dominio espiritual. Tu humildad reside en amar sin condiciones de retorno, comprendiendo que las almas a las que cuidas no te pertenecen, pues todas son emanaciones libres del mismo Pleroma.',
  },
  'Niobe-Leo': {
    d: 'Aquí el orgullo es majestuoso y solar; crees que tu brillo personal es único y que mereces una devoción especial. La trampa es el narcisismo del artista o el líder que olvida la fuente de su inspiración. La caída se manifiesta en la pérdida de audiencia o en el vacío del aplauso.',
    g: 'Es la usurpación de la Luz Central. El ego se viste con los atributos del Rey espiritual para su propio beneficio. Practicas la humildad cuando actúas como un espejo transparente: permitiendo que la Majestad divina brille a través de ti sin que tu personalidad intente cobrar el peaje del reconocimiento.',
  },
  'Niobe-Virgo': {
    d: 'Tu orgullo reside en tu impecabilidad, tu eficiencia y tu superioridad moral basada en el orden. Te jactas de no cometer errores y juzgas la "dejadez" ajena. La caída llega a través del caos inevitable o de una falla técnica que no puedes reparar, exponiendo tu vulnerabilidad humana.',
    g: 'Representa la soberbia del método. El ego cree que mediante la técnica puede alcanzar la perfección del espíritu. Tu humildad consiste en aceptar el error como parte del aprendizaje en la materia, sirviendo con devoción pero sin la arrogancia del que se cree puro por seguir una norma.',
  },
  'Niobe-Libra': {
    d: 'Te jactas de tu refinamiento, tu sentido de la justicia o la "perfección" de tus relaciones. El narcisismo opera a través de la estética y la diplomacia, creyendo que tu equilibrio te hace superior a los que viven en conflicto. La caída ocurre cuando estalla la sombra oculta tras tu paz artificial.',
    g: 'Es la trampa de la armonía externa. El ego usa la belleza para evitar la profundidad del ser. Practicas la humildad al reconocer las injusticias propias y la falta de equilibrio interno, permitiendo que la Verdad se manifieste incluso si rompe la imagen idealizada que has construido.',
  },
  'Niobe-Escorpio': {
    d: 'Tu orgullo es de naturaleza oculta y poderosa; crees tener un control superior sobre las crisis, el sexo o las sombras ajenas. La trampa es el narcisismo del "mago" que se cree por encima de las leyes de la transmutación. La caída llega cuando el abismo que creías dominar te devora.',
    g: 'Representa la arrogancia iniciática. El ego cree que ha conquistado la muerte por su propia fuerza. Tu humildad reside en la rendición total: reconocer que no tienes poder sobre el misterio, sino que eres un humilde navegante que debe disolver su voluntad en la del Pneuma para cruzar el umbral.',
  },
  'Niobe-Sagitario': {
    d: 'Te jactas de tu sabiduría, tu fe o tu visión del mundo superior a la masa. El orgullo es filosófico y moral; crees que tu camino es el único verdadero. La caída ocurre cuando la vida te confronta con verdades que no encajan en tu dogma, dejándote sin mapa ni brújula.',
    g: 'Es la soberbia del "Poseedor de la Verdad". El ego convierte la búsqueda espiritual en una medalla de superioridad. Practicas la humildad al aceptar que eres un eterno peregrino y que cada alma tiene su propio acceso a la Gnosis, sin que tu visión deba ser la medida de la realidad ajena.',
  },
  'Niobe-Capricornio': {
    d: 'Tu orgullo reside en tu estatus, tu integridad y tu capacidad de resistir el paso del tiempo. Te jactas de tu autosuficiencia y de no necesitar a nadie. La caída llega cuando las estructuras que has construido con tanto esfuerzo colapsan, recordándote que nada construido por el hombre es eterno.',
    g: 'Representa la trampa del Arquitecto del Tiempo. El ego se cree el Arconte de su propia realidad. Tu humildad consiste en construir para la eternidad del espíritu y no para la gloria de la materia, reconociendo que tu verdadera autoridad emana de la obediencia a la Ley Divina, no a la tuya.',
  },
  'Niobe-Acuario': {
    d: 'Te jactas de tu originalidad, tu desapego y tu visión vanguardista. El narcisismo opera a través de la "superioridad del genio" que mira con desprecio las convenciones humanas. La caída llega a través del aislamiento absoluto o del fracaso de tus ideales cuando ignoran la base humana.',
    g: 'Es la soberbia de la mente estelar. El ego se desconecta del corazón para sentirse libre. Practicas la humildad cuando integras tu singularidad en la fraternidad universal, reconociendo que tu genio no tiene valor si no sirve para el despertar de todas las chispas divinas por igual.',
  },
  'Niobe-Piscis': {
    d: 'Tu orgullo es místico; te jactas de tu sensibilidad, tu capacidad de sacrificio o tu conexión "especial" con lo divino. El narcisismo se disfraza de humildad espiritual o victimismo. La caída ocurre cuando la realidad te exige responsabilidad y tu "espiritualidad" se revela como una huida.',
    g: 'Representa la trampa de la disolución del ego. El ego se vuelve más fuerte al pretender que no existe. Tu humildad real consiste en aceptar los límites de la encarnación y servir en el mundo sin pretender ser un mártir o un salvador, reconociendo que la Gracia es un don gratuito, no un mérito propio.',
  },
 'Pallas-Aries': {
    d: 'Tu inteligencia estratégica es rápida, táctica y orientada a la acción inmediata. Posees el don de encontrar soluciones sobre la marcha y de ganar batallas mediante la audacia y la sorpresa. Tu creatividad es una fuerza pionera que abre caminos donde antes no había nada.',
    g: 'Representa la irrupción del Logos como voluntad pura. Accedes a la sabiduría a través de la acción decisiva. Tu precisión elegante consiste en actuar sin dudar, convirtiendo cada movimiento en un golpe de genio que libera la energía estancada por el miedo del Arconte.',
  },
  'Pallas-Tauro': {
    d: 'Tu capacidad estratégica se aplica a la materia, los recursos y la estética tangible. Ves patrones en la naturaleza y la economía que otros ignoran. Tu inteligencia es paciente y constructiva; resuelves problemas creando estructuras sólidas y bellas que perduran en el tiempo.',
    g: 'Es la Sophia que organiza la sustancia. Tu inteligencia táctica se manifiesta al dar forma sagrada a lo denso. Actúas con precisión cuando tratas la materia como un lienzo para el espíritu, demostrando que la verdadera estrategia es aquella que genera una abundancia sostenible.',
  },
  'Pallas-Geminis': {
    d: 'Ves patrones en la información, el lenguaje y las redes de comunicación. Tu inteligencia es versátil y se nutre de la conexión de ideas aparentemente inconexas. Posees un arte verbal y mental que te permite resolver conflictos mediante la dialéctica y el ingenio.',
    g: 'Representa la agilidad del pensamiento divino. Tu estrategia es la de la palabra que libera. Accedes a la sabiduría al desmantelar la dualidad mental con una lógica superior, actuando como un intermediario que traduce las verdades del Pleroma en conceptos comprensibles.',
  },
  'Pallas-Cancer': {
    d: 'Tu inteligencia estratégica está ligada a la protección y la gestión de las emociones. Ves patrones en la psique humana y sabes cómo crear entornos seguros. Tu creatividad es nutritiva; resuelves problemas a través de la empatía y la intuición de las necesidades profundas.',
    g: 'Es la Sophia que cuida la semilla espiritual. Tu táctica consiste en defender lo vulnerable con la inteligencia del corazón. Actúas con precisión elegante al convertir tu sensibilidad en un escudo protector que permite al espíritu gestarse sin las interferencias del mundo exterior.',
  },
  'Pallas-Leo': {
    d: 'Ves la vida como un escenario donde la estrategia debe ser creativa y majestuosa. Tu inteligencia táctica se manifiesta en el liderazgo carismático y en la capacidad de inspirar a otros. Resuelves problemas mediante el juego, el drama y la expresión de una identidad solar única.',
    g: 'Representa la radiación del Logos soberano. Tu precisión es la del artista-rey que crea su propia realidad. Accedes a la sabiduría al reconocer que la mejor estrategia es la autenticidad radical; cuando brillas desde el Pneuma, el caos del entorno se organiza ante tu luz.',
  },
  'Pallas-Virgo': {
    d: 'Tu inteligencia es analítica, minuciosa y experta en el diagnóstico. Ves patrones en el detalle y la técnica; tu estrategia es la eficiencia y la purificación. Resuelves problemas complejos descomponiéndolos en partes manejables y aplicando soluciones precisas.',
    g: 'Es la Sophia que opera en el laboratorio del mundo. Tu táctica es la alquimia de la mejora constante. Actúas con precisión elegante al entender que la perfección técnica es una forma de devoción, separando lo sutil de lo espeso en cada tarea que emprendes.',
  },
  'Pallas-Libra': {
    d: 'Ves patrones en las relaciones, la diplomacia y la estética social. Tu inteligencia estratégica se orienta a la creación de armonía y justicia. Resuelves problemas mediante la mediación, encontrando el punto de equilibrio donde todas las partes se sienten reconocidas.',
    g: 'Representa la simetría del Pleroma en la interacción humana. Tu precisión es la de la Sizigia equilibrada. Accedes a la sabiduría al actuar como un puente entre polaridades, demostrando que la inteligencia más alta es aquella que une lo fragmentado en una belleza compartida.',
  },
  'Pallas-Escorpio': {
    d: 'Tu inteligencia es profunda, investigadora y penetra en los misterios. Ves patrones en lo que está oculto: las motivaciones secretas, el poder y la sombra. Tu estrategia es la transmutación; resuelves problemas yendo a la raíz del conflicto, sin miedo a la oscuridad.',
    g: 'Es la Sophia descendiendo al abismo para rescatar la luz. Tu táctica es la del cirujano del alma. Actúas con precisión elegante al desmantelar las ilusiones del ego con una mirada que no parpadea, transformando la crisis en una estrategia de resurrección espiritual.',
  },
  'Pallas-Sagitario': {
    d: 'Ves patrones en la filosofía, la ley y las grandes visiones del mundo. Tu inteligencia estratégica es expansiva y busca el propósito trascendente. Resuelves problemas elevando el nivel de conciencia y aportando una dirección ética y optimista al caos cotidiano.',
    g: 'Representa la flecha de la Gnosis lanzada hacia el infinito. Tu precisión es la del visionario que no pierde de vista el horizonte. Accedes a la sabiduría al conectar los hechos mundanos con las leyes universales, convirtiendo tu vida en una táctica de búsqueda de la Verdad.',
  },
  'Pallas-Capricornio': {
    d: 'Tu inteligencia es estructural, pragmática y orientada al largo plazo. Ves patrones en la jerarquía, el tiempo y la autoridad. Tu estrategia es la construcción de legados; resuelves problemas aportando orden, disciplina y una integridad que resiste cualquier presión.',
    g: 'Es la Sophia que edifica el Templo de la Sabiduría en el tiempo. Tu táctica es la del Maestro Arquitecto. Actúas con precisión elegante al reconocer que la realidad se domina mediante la responsabilidad y la maestría, convirtiendo la materia en un monumento al espíritu.',
  },
  'Pallas-Acuario': {
    d: 'Ves patrones en el futuro, la tecnología y los sistemas colectivos. Tu inteligencia es disruptiva, original y busca la liberación. Resuelves problemas mediante la innovación radical y la capacidad de pensar fuera de la caja, conectando mentes en una red de luz.',
    g: 'Representa la irrupción de la Mente Universal en la red humana. Tu precisión es la del revolucionario consciente. Accedes a la sabiduría al desprogramar los sistemas obsoletos con soluciones que parecen venir de las estrellas, actuando por el despertar de la fraternidad.',
  },
  'Pallas-Piscis': {
    d: 'Tu inteligencia estratégica es intuitiva, mística y se basa en la sintonía psíquica. Ves patrones en los sueños, el arte y el inconsciente colectivo. Resuelves problemas mediante la compasión, el perdón y la capacidad de fluir con las mareas de la vida sin oponer resistencia.',
    g: 'Es la Sophia que se disuelve en el Amor Universal. Tu táctica es la de la gracia divina. Actúas con precisión elegante al reconocer que, a veces, la mejor estrategia es la entrega; cuando permites que el Pleroma actúe a través de ti, el caos se disuelve en una paz inefable.',
  },
 'Pandora-Aries': {
    d: 'Tu curiosidad se activa a través de la acción impulsiva y el deseo de ser el primero en explorar lo prohibido. Al abrir la caja, liberas conflictos de voluntad y luchas de poder que no se detendrán fácilmente. Actúas como un catalizador de cambios bruscos que requieren un coraje absoluto para ser enfrentados una vez iniciados.',
    g: 'Representa el inicio de la caída de la voluntad en la materia. Al liberar los "males" de la lucha arconte, descubres que la esperanza es la chispa de acción pura que sobrevive al fracaso del ego. Tu transformación radica en usar ese impulso final para reconectar con el guerrero espiritual.',
  },
  'Pandora-Tauro': {
    d: 'Abres puertas relacionadas con la seguridad material, el cuerpo y el valor de las cosas. Al investigar los límites de lo tangible, puedes desencadenar crisis económicas o cambios irreversibles en tu estabilidad. La transformación va más allá de lo físico, obligándote a redefinir qué es lo que realmente tiene valor.',
    g: 'Es la liberación de la codicia y el apego que encadenan a la sustancia. Cuando la estructura material colapsa por tu curiosidad, la esperanza queda como la Gnosis de que la verdadera abundancia es inmanente y no depende de la forma, permitiéndote reconstruir sobre lo eterno.',
  },
  'Pandora-Geminis': {
    d: 'Tu tendencia es abrir la caja de la información, el secreto y la comunicación dual. Una vez que lanzas una idea o revelas una verdad, el mensaje se propaga de forma incontrolable. Eres el catalizador de cambios en la percepción ajena, donde la palabra dicha se vuelve un destino que no puede ser revocado.',
    g: 'Representa la fragmentación del Logos en el mundo de la opinión. Al liberar la multiplicidad del pensamiento, la esperanza reside en el silencio que queda tras el ruido. Tu transformación ocurre al encontrar la Verdad única oculta en el fondo de la dispersión mental.',
  },
  'Pandora-Cancer': {
    d: 'Abres la caja de las memorias ancestrales, los lazos familiares y las emociones profundas. Al hurgar en el pasado, liberas traumas o verdades afectivas que alteran para siempre tu sentido de pertenencia. La esperanza es el último recurso para sanar un linaje que ha sido expuesto a la luz.',
    g: 'Es la apertura del "huevo órfico" de la memoria biológica. Al liberar el dolor del exilio emocional, la esperanza se manifiesta como el amor incondicional del origen que no depende de la sangre. Catalizas la transformación del alma al permitirle nacer fuera de la protección tóxica.',
  },
  'Pandora-Leo': {
    d: 'Tu curiosidad te lleva a abrir la puerta del ego, la fama y la expresión personal extrema. Al buscar el centro del escenario, puedes desencadenar dinámicas de orgullo y envidia que escapan a tu control. Tu intención original de brillar se convierte en un proceso de transformación pública irreversible.',
    g: 'Representa la liberación de la vanidad solar que oculta al Pneuma. Cuando los males del reconocimiento falso se agotan, la esperanza es la dignidad intrínseca de ser una chispa divina. Tu transformación consiste en pasar del brillo externo a la radiación soberana del espíritu.',
  },
  'Pandora-Virgo': {
    d: 'Abres la caja de la técnica, la salud y el orden microscópico. Al intentar "arreglar" o analizar demasiado la realidad, liberas una complejidad de detalles y fallos que pueden resultar abrumadores. Eres el catalizador de purificaciones profundas donde la esperanza es la confianza en la autorregulación de la vida.',
    g: 'Es la intrusión de la mente analítica en el orden sagrado. Al desmantelar el sistema para entenderlo, liberas la entropía; la esperanza queda en el fondo como la inteligencia operativa del cosmos que sana lo que el hombre no puede, permitiendo una reconstrucción alquímica.',
  },
  'Pandora-Libra': {
    d: 'Tu tendencia es abrir la puerta de los pactos, la justicia y las relaciones idealizadas. Al cuestionar el equilibrio de un vínculo, puedes liberar conflictos legales o éticos que terminan con la paz artificial para siempre. La esperanza es el cimiento de una armonía real que surge tras la crisis de la verdad.',
    g: 'Representa la ruptura de la falsa Sizigia social. Al liberar las sombras de la relación, la esperanza es el reconocimiento de la unidad esencial entre las almas. Catalizas transformaciones donde el amor debe ser reconstruido sobre la base de la justicia divina, no del compromiso humano.',
  },
  'Pandora-Escorpio': {
    d: 'Abres la caja de los misterios, el sexo y el poder compartido. Tu curiosidad te lleva a umbrales de los que no se regresa igual; liberas fuerzas de transmutación que exigen la muerte de tu vieja identidad. La esperanza es la semilla de resurrección que solo se encuentra en el fondo del abismo.',
    g: 'Es la apertura consciente del Atanor. Al liberar las pasiones y los miedos ocultos, la esperanza es la Gnosis de la inmortalidad del alma. Tu posición indica que eres un catalizador de crisis iniciáticas donde la transformación es una metamorfosis total y definitiva.',
  },
  'Pandora-Sagitario': {
    d: 'Tu curiosidad se dirige a los dogmas, las tierras lejanas y las grandes verdades. Al abrir la caja de la fe, puedes liberar cuestionamientos que destruyen tu antiguo mapa del mundo, lanzándote a un viaje sin retorno. La esperanza es la visión de un sentido superior que sobrevive a la pérdida de las certezas.',
    g: 'Representa la liberación del alma peregrina de sus prisiones ideológicas. Al abrir la puerta a lo desconocido, los "males" son las dudas que queman el dogma; la esperanza es la flecha que sigue apuntando al Pleroma a pesar del caos del camino.',
  },
  'Pandora-Capricornio': {
    d: 'Abres la caja de las estructuras, la autoridad y el tiempo. Al intentar escalar o controlar la realidad social, puedes liberar responsabilidades y consecuencias kármicas que pesarán sobre tus hombros de forma permanente. La esperanza es la integridad que sostiene el alma cuando el éxito externo falla.',
    g: 'Es la irrupción en el tiempo del Arconte. Al liberar las leyes del esfuerzo y la restricción, la esperanza es la autoridad espiritual que no depende del estatus. Catalizas transformaciones donde el legado real es lo que queda en el fondo cuando las instituciones se desmoronan.',
  },
  'Pandora-Acuario': {
    d: 'Tu tendencia es abrir la puerta de la innovación, el grupo y la rebelión. Al introducir una idea revolucionaria, liberas cambios sociales o tecnológicos que alteran el tejido de la comunidad de forma irreversible. La esperanza es la fraternidad que sobrevive a la alienación de lo nuevo.',
    g: 'Representa la liberación de la chispa de genio en la red humana. Al romper el molde, liberas el caos de la desprogramación; la esperanza es la conexión con la Mente Universal. Tu transformación ocurre al darte cuenta de que el futuro iniciado no tiene vuelta atrás.',
  },
  'Pandora-Piscis': {
    d: 'Abres la caja del inconsciente colectivo, los sueños y la compasión sin límites. Al sumergirte en lo inefable, liberas una marea de sentimientos y percepciones psíquicas que pueden disolver tus fronteras. La esperanza es la gracia divina que te permite no ahogarte en el dolor del mundo.',
    g: 'Es la apertura del velo entre los planos. Al liberar la nostalgia del exilio, la esperanza es la certeza del retorno a la Fuente. Catalizas transformaciones místicas donde la realidad ordinaria se pierde, dejando solo el fondo luminoso de la unidad espiritual.',
  },
'Pholus-Aries': {
    d: 'Un solo gesto de audacia o una decisión tomada en un segundo puede desatar una avalancha de cambios en tu vida y en tu entorno. Actúas como el detonante que rompe la inercia; tus impulsos, por pequeños que parezcan, liberan una energía competitiva o pionera que una vez fuera, no puede ser contenida.',
    g: 'Representa la "chispa en la paja". Un acto de voluntad mínima es capaz de incendiar toda una estructura de limitación arconte. Tu cambio profundo ocurre cuando comprendes que no necesitas grandes batallas, sino el movimiento preciso del espíritu para iniciar una revolución total.',
  },
  'Pholus-Tauro': {
    d: 'Un cambio menor en tus hábitos, en tu alimentación o en el manejo de un recurso puede transformar radicalmente tu estabilidad y tu relación con la materia. Eres el catalizador de procesos de manifestación donde un pequeño valor semilla termina generando un bosque de resultados físicos.',
    g: 'Es la Gnosis de la semilla sagrada. El espíritu demuestra que la sustancia se organiza a partir de centros mínimos de luz. Tu posición indica que al honrar lo pequeño en la materia, desencadenas una abundancia que trasciende la lógica de la acumulación demiúrgica.',
  },
  'Pholus-Geminis': {
    d: 'Una palabra dicha al azar, un comentario breve o un dato compartido sin mucha intención pueden alterar por completo el flujo de información en tu círculo. Actúas como el detonante de grandes movimientos intelectuales o sociales a través de la comunicación más simple y cotidiana.',
    g: 'Representa el poder del Logos en el "susurro". Un pensamiento sutil puede desmantelar una red de mentiras colectiva. Tu transformación ocurre al darte cuenta de que la verdad no necesita grandes discursos, sino la transparencia de un mensaje pequeño que resuene con la Fuente.',
  },
  'Pholus-Cancer': {
    d: 'Un pequeño gesto de afecto, una lágrima o un cambio mínimo en la dinámica del hogar pueden liberar siglos de memoria emocional o traumas familiares. Eres el catalizador que, sin buscarlo, abre las compuertas de la sensibilidad en tu linaje con el acto más sencillo de cuidado.',
    g: 'Es la liberación de las "aguas del origen" mediante una grieta mínima en el ego. Tu posición indica que la sanación del alma no requiere grandes sacrificios, sino la apertura del corazón en un momento de vulnerabilidad genuina que arrastra toda la resistencia anterior.',
  },
  'Pholus-Leo': {
    d: 'Un acto de autoafirmación natural o una pequeña expresión de tu creatividad pueden desencadenar un reconocimiento o una influencia masiva que no esperabas. Actúas como el detonante de una radiación que inspira a otros a través de tu alegría o tu presencia más espontánea.',
    g: 'Representa la irrupción del Sol Central a través de una rendija. Tu cambio más profundo surge cuando dejas de intentar "ser alguien" y simplemente permites que un gesto auténtico del espíritu brille; esa luz pequeña es capaz de organizar todo el escenario a su alrededor.',
  },
  'Pholus-Virgo': {
    d: 'Un ajuste técnico, una mejora en tu rutina o un acto de servicio aparentemente insignificante pueden transformar la salud o la eficiencia de todo un sistema. Eres el catalizador de purificaciones a gran escala que se inician con la atención al detalle más pequeño.',
    g: 'Es la alquimia del "punto crítico". En el laboratorio del espíritu, un grano de pureza transmuta toda la mezcla. Tu posición señala que la maestría no está en lo complejo, sino en la perfección del gesto mínimo que alinea la materia con el orden divino.',
  },
  'Pholus-Libra': {
    d: 'Una sonrisa, un acuerdo verbal simple o un pequeño gesto de cortesía pueden ser el detonante de una paz duradera o de una alianza que cambie tu destino social. Actúas como el catalizador de la armonía a través de actos de justicia que parecen menores pero que restauran el equilibrio.',
    g: 'Representa el peso mínimo que inclina la balanza de la Sizigia. Tu inteligencia táctica reside en saber que una pequeña acción ética puede disolver conflictos kármicos inmensos, restaurando la unidad en el mundo de la dualidad con una elegancia casi invisible.',
  },
  'Pholus-Escorpio': {
    d: 'Una mirada profunda, un secreto compartido o un acto de entrega mínima pueden desencadenar procesos de transmutación y crisis regenerativas de una intensidad total. Eres el detonante que, al tocar un solo punto de sombra, libera toda la potencia del inconsciente.',
    g: 'Es la apertura del Atanor con una sola chispa. El espíritu demuestra que no se requiere esfuerzo para la transformación, sino tocar el núcleo de la verdad. Tu posición indica dónde un pequeño "morir al ego" desata una resurrección que cambia toda tu arquitectura álmica.',
  },
  'Pholus-Sagitario': {
    d: 'Una pregunta filosófica, un viaje corto o un libro que cae en tus manos pueden ser el detonante de una expansión de conciencia que no tiene vuelta atrás. Actúas como el catalizador de grandes búsquedas espirituales a partir de un chispazo de fe o curiosidad.',
    g: 'Representa la flecha que, con un leve impulso, recorre distancias infinitas. Tu Gnosis se activa con lo simple: una visión fugaz que desvela el mapa del Pleroma. Al actuar sobre esa pequeña intuición, generas un cambio de horizonte que redefine todo tu propósito.',
  },
  'Pholus-Capricornio': {
    d: 'Una decisión responsable, un "no" a tiempo o un acto de integridad en lo privado pueden consolidar una autoridad o un legado de proporciones masivas. Eres el catalizador de estructuras duraderas que se asientan sobre la piedra angular de un compromiso pequeño pero firme.',
    g: 'Es la construcción del Templo a partir de la unidad mínima de medida. El espíritu demuestra que la ley se manifiesta en la constancia de lo pequeño. Tu cambio profundo ocurre cuando entiendes que la verdadera maestría es el resultado de un solo principio aplicado con rigor infinito.',
  },
  'Pholus-Acuario': {
    d: 'Una idea original compartida en el momento justo o un pequeño acto de rebeldía pueden desatar una revolución en tu grupo o en la red social. Actúas como el detonante de la innovación colectiva a partir de una singularidad que parece no tener importancia al principio.',
    g: 'Representa el "efecto mariposa" en la mente universal. Una pequeña desconexión de la matriz arconte por tu parte puede liberar a muchas otras chispas. Tu posición indica que tu rareza, por mínima que sea, es la clave para desencadenar el despertar de la fraternidad.',
  },
  'Pholus-Piscis': {
    d: 'Un acto de perdón silencioso, una meditación breve o un sueño recordado pueden inundar tu realidad de una paz y una compasión que disuelven años de dureza. Eres el catalizador de la gracia divina que entra en el mundo a través de la rendija más pequeña de tu entrega.',
    g: 'Es la disolución de los diques del ego por una sola gota de amor universal. Tu posición indica que el retorno a la Fuente no es una odisea compleja, sino el resultado de un pequeño abandono consciente que permite que el océano de luz lo inunde todo.',
  },
 'Poseidon-Aries': {
    d: 'Tu iluminación espiritual llega como un rayo de claridad en medio de la acción. Posees la capacidad de ver la verdad oculta en el calor del conflicto o el inicio de los proyectos; percibes la intención real detrás de cada impulso antes de que se manifieste.',
    g: 'Representa la irrupción del Pneuma en la voluntad. El velo se adelgaza cuando actúas con presencia absoluta, recibiendo revelaciones directas que transforman el impulso ciego en una acción sagrada. Tu percepción espiritual es más aguda cuando eres el primero en ver el propósito divino en el caos.',
  },
  'Poseidon-Tauro': {
    d: 'Recibes verdades espirituales a través de la contemplación de la materia y la belleza natural. Disuelves la ilusión de la escasez al percibir la luz que anima cada forma física; tu verdad se revela en la solidez de la experiencia sensorial sagrada.',
    g: 'Es la Gnosis de la sustancia luminosa. El agua primordial penetra tu relación con lo denso, purificando tu visión de la materia. La revelación ocurre cuando dejas de ver objetos y comienzas a ver frecuencias, comprendiendo que la "tierra" es un espejo de la abundancia del Pleroma.',
  },
  'Poseidon-Geminis': {
    d: 'Tu iluminación ocurre en el intercambio de ideas y la observación de los símbolos. Trasciendes el análisis racional al captar el significado trascendente detrás de las palabras; la verdad se te revela como una red de conexiones luminosas que unen todos los planos.',
    g: 'Representa la transparencia del Logos. El velo se vuelve invisible cuando usas la mente como un canal puro, sin el filtro de la duda dualista. Recibes revelaciones en forma de ideas instantáneas que desmitifican la realidad arconte, permitiéndote comunicar la Gnosis con una claridad vibrante.',
  },
  'Poseidon-Cancer': {
    d: 'La verdad se revela en el océano de tus sentimientos y en la profundidad de tu memoria psíquica. Tienes acceso a percepciones sobre el origen de la vida y los lazos de las almas que trascienden la historia personal; la iluminación es una inundación de compasión pura.',
    g: 'Es la purificación de las aguas del alma. Tu percepción espiritual se agudiza en la quietud emocional, donde recibes revelaciones sobre tu verdadera herencia espiritual. El velo se adelgaza en la intimidad sagrada, revelando que el amor es la sustancia que penetra todas las dimensiones.',
  },
  'Poseidon-Leo': {
    d: 'Tu iluminación espiritual se manifiesta a través de la creatividad y la expresión de la identidad noble. Percibes la verdad oculta tras las máscaras del ego; se te revela la majestad del ser real cuando actúas con un corazón transparente y generoso.',
    g: 'Representa la radiación de la Chispa Divina. El velo se disuelve cuando dejas que el Sol Central actúe a través de tu personalidad sin obstrucciones. Recibes revelaciones sobre la soberanía del espíritu, comprendiendo que tu luz es una emanación directa de la Fuente que todo lo ilumina.',
  },
  'Poseidon-Virgo': {
    d: 'Accedes a verdades profundas a través del servicio, el discernimiento y la atención a lo microscópico. Tu iluminación es práctica y técnica: ves la inteligencia divina operando en el orden de la vida diaria y en la salud del organismo.',
    g: 'Es la Sophia operando en el detalle. El agua primordial purifica tu visión de la labor cotidiana, permitiéndote recibir revelaciones sobre las leyes sagradas de la materia. Tu percepción es más aguda al separar lo ilusorio de lo esencial en los procesos de purificación física y espiritual.',
  },
  'Poseidon-Libra': {
    d: 'La verdad se te revela en el espejo del otro y en la búsqueda de la armonía perfecta. Disuelves la ilusión de la separación al percibir la unidad esencial en los vínculos; tu iluminación espiritual ocurre cuando encuentras el punto de equilibrio donde el "yo" y el "tú" se disuelven.',
    g: 'Representa la transparencia de la Sizigia. El velo se vuelve transparente en el encuentro sagrado con el otro. Recibes revelaciones sobre la justicia cósmica y la belleza como frecuencias de verdad, comprendiendo que la armonía es la prueba de la presencia del espíritu en la dualidad.',
  },
  'Poseidon-Escorpio': {
    d: 'Tu percepción espiritual es máxima en el umbral de las crisis, la sexualidad y la muerte. Trasciendes el análisis racional al penetrar en las sombras y ver la luz que nunca se apaga en el abismo; la iluminación es para ti un proceso de resurrección inmediata.',
    g: 'Es la Gnosis del Atanor abierto. El agua primordial penetra las profundidades de tu psique para purificar el deseo. Recibes revelaciones directas sobre la inmortalidad del alma y el poder de la transmutación, viendo la verdad que los Arcontes intentan ocultar bajo el velo del miedo.',
  },
  'Poseidon-Sagitario': {
    d: 'Tu iluminación es filosófica, mística y expansiva. Recibes verdades que trascienden las religiones dogmáticas; se te revela el propósito del viaje del alma en mapas de luz que no tienen fronteras. Tu percepción es la de un visionario del infinito.',
    g: 'Representa el vuelo del alma hacia el Pleroma. El velo se adelgaza en la búsqueda de la Verdad Superior, donde la Gnosis se vuelve una experiencia directa de las leyes universales. Tu posición indica una capacidad excepcional para recibir revelaciones que guían a otros hacia la luz divina.',
  },
  'Poseidon-Capricornio': {
    d: 'La verdad se revela a través de la integridad, la responsabilidad y el dominio del tiempo. Disuelves la ilusión de las estructuras mundanas al percibir la autoridad espiritual que subyace a toda ley; tu iluminación es sólida, madura y constructiva.',
    g: 'Es la transparencia del Maestro de la Ley. El agua primordial purifica tu ambición, transformándola en un compromiso con el espíritu. Recibes revelaciones sobre la eternidad de la obra divina en la tierra, viendo el Templo de la Sabiduría oculto bajo las instituciones de piedra.',
  },
  'Poseidon-Acuario': {
    d: 'Tu iluminación espiritual es radical, original y orientada al despertar colectivo. Percibes la verdad en las redes humanas y en las visiones de futuro; disuelves la ilusión de la individualidad aislada al captar la mente universal que nos conecta a todos.',
    g: 'Representa la irrupción de la Conciencia Estelar. El velo se disuelve en la fraternidad y la innovación consciente. Tu percepción es más aguda al desprogramar la realidad arconte, recibiendo revelaciones que actúan como chispas de liberación para la red de las almas libres.',
  },
  'Poseidon-Piscis': {
    d: 'Aquí Poseidón está en su domicilio místico absoluto. La iluminación es una disolución total del ego en el océano de la divinidad. Recibes verdades inefables a través del silencio, el arte y la compasión universal; no hay separación entre tú y la verdad.',
    g: 'Es el retorno a las Aguas Primordiales del Pleroma. Tu percepción espiritual no tiene filtros; el velo ha desaparecido. Recibes revelaciones constantes sobre la unidad de todas las cosas en la Fuente, actuando como un faro de gracia divina que revela la verdad mediante la pura presencia.',
  },
'Priapus-Aries': {
    d: 'Eres pura mecha corta en lo creativo y lo vital. No esperas a que las cosas pasen, las fuerzas. Tu personalidad tiene un empuje sexual y creativo que puede ser arrollador, pero también agotador, porque vas a por todas desde el minuto uno sin medir consecuencias.',
    g: 'Tienes una reserva de voluntad bruta que es tu mayor activo. El problema es que la malgastas en impulsos del ego. Si aprendes a no saltar a la primera, esa energía es la que te permite romper cualquier limitación mental por tu propia cuenta.',
  },
  'Priapus-Tauro': {
    d: 'Tu energía es física y de resistencia. Te mueves por el placer y la seguridad, y cuando te enfocas en algo, eres una apisonadora. Tienes una vitalidad muy ligada a lo que puedes tocar y poseer; si te falta el disfrute sensorial, te apagas.',
    g: 'Tu kundalini está pegada al suelo. Tienes un poder enorme para manifestar cosas reales, pero la trampa es quedarte atrapado en el "tener". Tu potencial real sale cuando usas esa fuerza para crear estabilidad sin volverte esclavo de tus cosas.',
  },
  'Priapus-Geminis': {
    d: 'No paras quieto, tu vitalidad es puro nervio. Te excitas con las ideas y el intercambio. Tienes una personalidad multifacética que necesita estímulos constantes; si te aburres, tu energía se dispersa y te vuelves superficial o inconsistente.',
    g: 'Tu fuerza creativa está en la cabeza. El lío es que el ruido mental te drena. Si logras enfocar esa curiosidad en un solo punto, tienes la capacidad de descifrar y comunicar verdades que otros ni huelen.',
  },
  'Priapus-Cancer': {
    d: 'Tu fuerza vital depende totalmente de cómo te sientes. Eres un creador emocional; cuando estás bien, nutres y proteges con una potencia increíble, pero cuando te sientes herido, usas esa misma energía para encerrarte o manipular desde la necesidad.',
    g: 'Tienes una potencia psíquica ligada a tus raíces. El trabajo aquí es dejar de usar tu energía para llenar vacíos del pasado y empezar a usarla para construir una seguridad interna que no dependa de nadie más.',
  },
  'Priapus-Leo': {
    d: 'Necesitas brillar y que se te vea, punto. Tu vitalidad se enciende cuando eres el centro de atención. Tienes una personalidad dramática y generosa, pero si no recibes el reconocimiento que crees que mereces, esa energía se vuelve orgullo tóxico.',
    g: 'Es energía soberana. Tienes una reserva de luz que es puramente tuya. El salto está en dejar de actuar para la galería y empezar a crear desde tu centro real; ahí es cuando tu presencia de verdad transforma el entorno.',
  },
  'Priapus-Virgo': {
    d: 'Eres el perfeccionista obsesivo. Tu energía se dispara cuando hay algo que arreglar, mejorar o limpiar. Te sientes vivo siendo útil y eficiente. El peligro es que te obsesiones tanto con el detalle que termines bloqueando tu propia capacidad creativa.',
    g: 'Es energía de purificación. Tienes un instinto natural para separar lo que sirve de lo que no. Si dejas de juzgarlo todo, esa potencia te permite equilibrar tu cuerpo y tu mente de una forma que casi nadie consigue.',
  },
  'Priapus-Libra': {
    d: 'Tu vitalidad se activa a través de los demás. Necesitas el espejo de una relación o de un entorno armonioso para sentirte con fuerza. Eres un estratega de la seducción y el equilibrio, pero te pierdes si intentas complacer a todo el mundo.',
    g: 'Buscas la unión de polaridades. Tienes la fuerza para crear armonía de verdad, no solo de fachada. El reto es que esa energía no se quede en quedar bien, sino en establecer vínculos que tengan una base ética y real.',
  },
  'Priapus-Escorpio': {
    d: 'Intensidad en estado puro. Tu vitalidad es magnética, oscura y muy ligada a lo sexual y lo oculto. No vas a medias: o te entregas del todo o nada. Tienes una capacidad de resistencia y regeneración que asusta, especialmente en las crisis.',
    g: 'Es el kundalini crudo. Tienes acceso a la fuerza de transformación más potente. El riesgo es usarla para controlar o por venganza. Si la enfocas en tu propia transmutación, puedes deshacerte de cualquier sombra del ego.',
  },
  'Priapus-Sagitario': {
    d: 'Eres un aventurero vital. Tu energía se dispara cuando hay un horizonte nuevo o una verdad que buscar. Tienes un entusiasmo que contagia, pero a veces te pasas de frenada y te vuelves un fanático de tus propias ideas o de tu libertad.',
    g: 'Energía de expansión. Tienes potencia para ir más allá de lo establecido. La clave es que esa búsqueda no sea una huida, sino una dirección consciente hacia tu propio despertar espiritual.',
  },
  'Priapus-Capricornio': {
    d: 'Vitalidad de largo recorrido. No buscas el éxito rápido, buscas el control y el respeto. Tu personalidad es sobria y ambiciosa; te creces ante las dificultades y el trabajo duro. El riesgo es volverte frío o un adicto al estatus.',
    g: 'Es energía de maestría. Tienes la fuerza para dar forma duradera a tus visiones. Si dejas de construir por miedo a la escasez, esa potencia te convierte en alguien con una autoridad interna que nadie puede cuestionar.',
  },
  'Priapus-Acuario': {
    d: 'Tu energía es eléctrica y va por libre. Te sientes vivo rompiendo reglas y siendo el "raro" del grupo. Tienes una vitalidad que se activa con lo nuevo y lo diferente; si te intentan encasillar, tu respuesta es una rebelión inmediata.',
    g: 'Es la fuerza de la desprogramación. Tienes un instinto para ver lo que ya no sirve en la sociedad. Si conectas esa rebeldía con el corazón, tu creatividad se vuelve una herramienta de liberación para ti y para los demás.',
  },
  'Priapus-Piscis': {
    d: 'Tu vitalidad es esquiva y muy sensible. Te mueves por intuiciones y sueños. Tienes una personalidad muy empática que puede absorberlo todo, lo que te hace muy creativo pero también propenso a escaparte de la realidad cuando las cosas se ponen feas.',
    g: 'Es energía de retorno a la Fuente. Tienes una reserva de compasión y mística brutal. El trabajo es no ahogarte en el drama del mundo y usar esa fuerza para ser un canal de algo más elevado sin perder el suelo.',
  },
'Proserpina-Aries': {
    d: 'Tus descensos son bruscos y violentos, suelen venir tras un choque de voluntad o un fracaso estrepitoso. Te hundes rápido, pero sales con una fuerza renovada y una identidad más afilada. Aprendes que el verdadero coraje no es solo ganar batallas externas, sino sobrevivir a la derrota del propio ego.',
    g: 'Es el descenso del guerrero al abismo. En la oscuridad descubres que tu fuerza no depende de la victoria, sino de una chispa que no se apaga. Regresas con la capacidad de actuar desde un centro que ya no necesita la agresión para validarse.',
  },
  'Proserpina-Tauro': {
    d: 'El rapto ocurre cuando pierdes tu seguridad material o física. Te ves obligado a soltar tus apegos y a habitar un vacío donde lo que tocas no existe. Emerges con una nueva escala de valores y la comprensión de que tu estabilidad real no depende de lo que posees.',
    g: 'Representa la Gnosis de la impermanencia. Al bajar al inframundo, entiendes que la materia es solo un velo. Regresas con el tesoro de la abundancia espiritual, esa que no se agota porque ya no está encadenada a la forma demiúrgica.',
  },
  'Proserpina-Geminis': {
    d: 'Tus ciclos de descenso se dan a través de la confusión mental o la pérdida de sentido en lo que comunicas. El inframundo es el silencio y el vacío de conceptos. Sales de ahí con una mente mucho más profunda, capaz de ver la verdad que hay detrás de las palabras vacías.',
    g: 'Es la purificación del Logos. En la oscuridad de la mente dual, encuentras el pensamiento único y silencioso. Regresas con el don de la palabra que sana, porque has aprendido a escuchar lo que se oculta en el fondo del ruido arconte.',
  },
  'Proserpina-Cancer': {
    d: 'El descenso es puramente emocional y familiar. Te ves arrastrado a las raíces de tu árbol familiar y a tus miedos de abandono. Emerges con una capacidad de cuidarte a ti mismo que antes no tenías, habiendo sanado el linaje desde sus cimientos más oscuros.',
    g: 'Representa el viaje al origen del alma. En el útero del inframundo, te liberas de la memoria biológica que te encadena. Regresas con el tesoro del amor incondicional, aquel que no necesita pertenecer a un clan para sentirse en casa.',
  },
  'Proserpina-Leo': {
    d: 'Bajas al inframundo cuando pierdes el reconocimiento o el escenario. Es el drama de la invisibilidad. Emerges con una dignidad que ya no necesita el aplauso; has descubierto que tu brillo es interno y que no se apaga aunque nadie te esté mirando.',
    g: 'Es la caída del sol falso para encontrar el sol espiritual. En la oscuridad total, descubres tu majestad real. Regresas con una radiación que no busca impresionar, sino iluminar a otros desde la humildad del espíritu soberano.',
  },
  'Proserpina-Virgo': {
    d: 'Tus crisis vienen a través del caos, la enfermedad o la pérdida de control sobre tu vida diaria. El descenso te obliga a aceptar la imperfección. Sales de ahí con una sabiduría práctica que sabe fluir con los ritmos naturales en lugar de intentar forzarlos.',
    g: 'La alquimia del orden sagrado. En el abismo de la "suciedad" del mundo, encuentras la verdadera pureza. Regresas con el don del servicio desinteresado, entendiendo que el espíritu se manifiesta en la labor más pequeña sin necesidad de juicios.',
  },
  'Proserpina-Libra': {
    d: 'El rapto sucede en tus vínculos. La traición o la ruptura te obligan a bajar a la soledad para entender qué parte de ti habías regalado. Emerges con una capacidad de pactar de forma justa, habiendo encontrado tu propio equilibrio interno antes de buscarlo fuera.',
    g: 'Restauración de la Sizigia ética. En el inframundo de las relaciones rotas, encuentras la unidad del ser. Regresas con la capacidad de establecer alianzas basadas en la verdad del espíritu y no en la estética de la complacencia.',
  },
  'Proserpina-Escorpio': {
    d: 'Aquí el ciclo es tu hábitat natural. Sabes moverte en la sombra, pero el reto es no quedarte atrapado en ella. Tus descensos son muertes totales del ego; emerges con un poder magnético y una autoridad que solo tienen quienes han mirado a la muerte a la cara.',
    g: 'Es la maestría en el umbral. En lo más profundo del Atanor, transmutas el plomo del deseo en oro espiritual. Regresas con las llaves de la sabiduría iniciática, capaz de guiar a otros a través de sus propias sombras sin miedo.',
  },
  'Proserpina-Sagitario': {
    d: 'Bajas al abismo cuando tus creencias se derrumban. Es la crisis de fe. Te sientes perdido en un mundo sin mapa. Sales con una visión mucho más amplia y real, habiendo cambiado el dogma rígido por una experiencia directa del significado de la vida.',
    g: 'El vuelo del alma a través del vacío. En la oscuridad del sinsentido, descubres la flecha de la Gnosis. Regresas con una verdad que no se puede enseñar en libros, sino que se vive como un fuego que señala el camino de retorno.',
  },
  'Proserpina-Capricornio': {
    d: 'El descenso ocurre cuando tu estructura de éxito se cae o cuando te enfrentas al peso de la soledad en la cima. Emerges con una integridad inquebrantable, entendiendo que la verdadera autoridad se construye sobre los huesos de lo que has superado en el silencio.',
    g: 'Maestría sobre el tiempo y la ley. En el inframundo del deber frío, encuentras la libertad del espíritu. Regresas con la capacidad de edificar legados que tienen alma, porque has aprendido que lo eterno no se construye con piedras externas.',
  },
  'Proserpina-Acuario': {
    d: 'Tu crisis es la alienación total; el sentimiento de no encajar en ningún sitio te manda al inframundo. Sales de ahí habiendo aceptado tu rareza como tu mayor tesoro, listo para conectar con los demás desde una fraternidad que no pide uniformidad.',
    g: 'La desprogramación en la oscuridad. Al sentirte fuera de la red humana, te conectas con la mente universal. Regresas con ideas revolucionarias que no buscan solo destruir el sistema, sino despertar a las chispas que están atrapadas en él.',
  },
  'Proserpina-Piscis': {
    d: 'Tu descenso ocurre a través de la disolución total: la pérdida de límites, la confusión con el dolor ajeno, el sacrificio que te borra. El inframundo pisciano es el océano sin orillas. Emerges de él con una compasión infinita y una capacidad de perdón que solo puede nacer en quien ha tocado el fondo del olvido de sí mismo.',
    g: 'El retorno desde las aguas primordiales del alma. En la oscuridad de Piscis, Proserpina se disuelve en el Pleroma y regresa ya no como individuo sino como canal. Tu transformación más profunda ocurre cuando comprendes que perderse en lo sagrado no es peligroso — es el único viaje que vale la pena hacer.',
  },
  'Priapus-Piscis': {
    d: 'Te pierdes en el océano de la confusión o el sacrificio inútil. El descenso es la disolución total. Emerges con una compasión inmensa y una intuición que raya lo profético, habiendo aprendido a no ahogarte en el dolor del mundo al encontrar tu propio ancla divina.',
    g: 'El retorno de las aguas primordiales. En el abismo del olvido de sí, encuentras la plenitud del Pleroma. Regresas con la paz del iniciado, aquel que sabe que los mundos son velos y que la única realidad es el amor que todo lo penetra.',
  },
 'Psyche-Aries': {
    d: 'Tu prueba consiste en transformar la impaciencia en voluntad sagrada. Los obstáculos surgen cuando intentas forzar tu camino; el alma aprende a través de la frustración de la fuerza bruta, descubriendo que la verdadera victoria es la conquista de uno mismo ante el impulso ciego.',
    g: 'Es la lucha del espíritu por liberarse de la agresión del demiurgo. Superas las pruebas cuando dejas de pelear contra sombras externas y usas tu coraje para sostener tu luz en medio de la batalla interna. Regresas con la fe del guerrero que ya no necesita enemigos.',
  },
  'Psyche-Tauro': {
    d: 'Te enfrentas a la pérdida de lo tangible para descubrir lo eterno. El alma sufre cuando se identifica con la seguridad material; tus pruebas imposibles suelen ser despojos que te obligan a encontrar un valor propio que no dependa de lo que tienes o de lo que tocas.',
    g: 'Representa la purificación del deseo de posesión. El alma gnóstica aquí debe reconocer que la materia es un velo ilusorio. La transformación ocurre cuando logras habitar el cuerpo y la tierra sin ser esclavo de su densidad, encontrando la abundancia en la vacuidad.',
  },
  'Psyche-Geminis': {
    d: 'Tu camino hacia la completitud pasa por el silencio y el discernimiento. Los obstáculos son la dispersión mental y el engaño de la lógica dual. Superas la prueba cuando dejas de buscar respuestas fuera y permites que la verdad se revele en la quietud de una mente unificada.',
    g: 'Es la redención del Logos fragmentado. El alma debe atravesar el laberinto de las opiniones arcontes para recuperar la palabra original. Tu triunfo es la Gnosis comunicada: hablar desde la certeza del espíritu y no desde la duda del intelecto.',
  },
  'Psyche-Cancer': {
    d: 'El alma debe romper las cadenas de la dependencia emocional. Tus pruebas están en el hogar y en la herida del abandono; aprendes a través del dolor de soltar la protección que te asfixia para convertirte en tu propio refugio y fuente de nutrición.',
    g: 'Representa el exilio del alma fuera del útero del mundo. Superas las pruebas del demiurgo cuando dejas de buscar el origen en la sangre y lo encuentras en el Pleroma. Te transformas al amar sin poseer, sanando el linaje a través de la libertad propia.',
  },
  'Psyche-Leo': {
    d: 'Tu prueba es la muerte del orgullo. Los obstáculos surgen cuando el ego reclama el escenario y se siente humillado por la falta de brillo. El alma alcanza la plenitud cuando descubre que su verdadera majestad no necesita audiencia ni aplauso para existir.',
    g: 'Es el proceso de transparentar la chispa divina. Debes superar la tentación de convertir tu luz en un espectáculo para el ego. La transformación llega cuando brillas desde la humildad del ser real, reconociendo que la gloria le pertenece solo al Pneuma.',
  },
  'Psyche-Virgo': {
    d: 'Aprendes a través de la aceptación del caos y la imperfección. Tus obstáculos son la autocrítica feroz y la obsesión por el control técnico de la vida. Superas la prueba cuando permites que el amor fluya sin condiciones, aceptando que la vida es sagrada incluso en su desorden.',
    g: 'Representa la labor del alma en el laboratorio del mundo. Purificas tu visión cuando dejas de juzgar la materia como "impura". El triunfo es el servicio consciente: actuar en lo pequeño con la devoción del iniciado que sabe que cada detalle es parte del Todo.',
  },
  'Psyche-Libra': {
    d: 'Tu viaje es encontrar la completitud sin perderte en el otro. Las pruebas imposibles surgen en los vínculos que te exigen sacrificar tu verdad por una paz falsa. Te transformas cuando estableces relaciones basadas en la integridad y no en la necesidad de ser aceptado.',
    g: 'Es la restauración de la Sizigia original. El alma debe superar la ilusión de que está incompleta sin un reflejo externo. La unión con el amor divino ocurre cuando te unes primero a tu propia contraparte espiritual, actuando desde la unidad interna.',
  },
  'Psyche-Escorpio': {
    d: 'Atraviesas el fuego de la transmutación total. Tus pruebas son las crisis, los secretos y las sombras que preferirías no mirar. El alma alcanza la completitud al rendirse al proceso de muerte y resurrección, emergiendo con una capacidad de amar que ha vencido al miedo.',
    g: 'Es el descenso consciente al Atanor del demiurgo para rescatar la luz atrapada en el deseo. Superas las pruebas cuando transmutas el veneno del apego en medicina espiritual. Tu fe se vuelve inquebrantable al saber que nada real puede morir.',
  },
  'Psyche-Sagitario': {
    d: 'Tu prueba es encontrar la verdad más allá de las creencias. Los obstáculos son el dogmatismo y la huida constante hacia adelante. El alma madura cuando deja de buscar un mapa externo y se convierte en el camino mismo, sosteniendo la fe incluso en el vacío de certezas.',
    g: 'Representa el vuelo del alma hacia lo inefable. Debes superar las trampas de las falsas doctrinas que intentan limitar tu visión. Te transformas cuando tu búsqueda se vuelve Gnosis: una experiencia directa de la luz que no necesita intermediarios ni templos de piedra.',
  },
  'Psyche-Capricornio': {
    d: 'Desarrollas tu carácter a través de la soledad y la responsabilidad extrema. Las pruebas son el peso del tiempo y la falta de apoyo. Superas el obstáculo cuando dejas de construir por ambición y empiezas a hacerlo por integridad, sosteniendo tu propia luz en la cima.',
    g: 'Es el dominio del alma sobre las leyes del Arconte del Tiempo. Superas la prueba cuando tu autoridad emana de tu coherencia espiritual y no de tu cargo. Te transformas al entender que el verdadero éxito es la libertad del alma frente a la estructura del mundo.',
  },
  'Psyche-Acuario': {
    d: 'Tu viaje es integrar tu originalidad en la fraternidad humana sin alienarte. Los obstáculos son el sentimiento de exclusión y la frialdad intelectual. Te completas cuando usas tu genio para servir a la red de las almas, reconociendo que tu rareza es el don que el mundo necesita.',
    g: 'Representa el despertar de la conciencia estelar en la materia. Debes superar la tentación de aislarte en tu superioridad mental. La transformación ocurre cuando tu rebeldía se convierte en amor universal, conectando con las chispas divinas en una rebelión de luz.',
  },
  'Psyche-Piscis': {
    d: 'Tu prueba es no disolverte en el dolor del mundo. Los obstáculos son la confusión psíquica y el victimismo. El alma alcanza la completitud cuando aprende a poner límites sagrados a su empatía, convirtiéndose en un canal de gracia que sana sin perderse en el océano ajeno.',
    g: 'Es el retorno definitivo al Pleroma a través del perdón y la entrega. Superas la ilusión del exilio cuando dejas de sentirte una víctima de la creación y te reconoces como una emanación divina. Tu triunfo es la paz que sobrepasa todo entendimiento.',
  },
  'Quaoar-Aries': {
    d: 'Tu creatividad es un relámpago que rasga el vacío. No esperas el permiso de la lógica ni sigues senderos trazados; tu personalidad se expresa a través de impulsos originales que nacen de una voluntad pura, sin el lastre de lo que "debería ser".',
    g: 'Es el primer movimiento del Pneuma antes de ser capturado por la ley de la lucha arconte. Tienes la capacidad de iniciar realidades desde una inocencia absoluta, donde el acto de crear es una explosión de libertad que no le debe nada a la historia de este mundo.',
  },
  'Quaoar-Tauro': {
    d: 'Eres capaz de manifestar formas que no existen en la naturaleza conocida. Tu fuerza vital no copia la materia, sino que la reinventa desde un goce primigenio. Tu personalidad se asienta en una capacidad de dar sustancia a lo invisible con una naturalidad que desconcierta.',
    g: 'Representa la creación de una sustancia sagrada no contaminada por el molde del demiurgo. Accedes a la abundancia del vacío fértil, permitiéndote disfrutar de la forma sin que la forma te dicte quién eres o cuánto vales.',
  },
  'Quaoar-Geminis': {
    d: 'Tu mente opera en una frecuencia previa al lenguaje estructurado. Eres un creador de conexiones imposibles y de conceptos que no tienen referencia en la cultura actual. Tu personalidad brilla cuando dejas de repetir lo aprendido y permites que surja una lógica totalmente nueva.',
    g: 'Es el Logos vibrando antes de la fragmentación en palabras. Tienes el don de captar el significado puro antes de que se convierta en dogma. Tu creatividad es un puente hacia una comunicación que no usa los códigos gastados de la matriz mental.',
  },
  'Quaoar-Cancer': {
    d: 'Tu capacidad de nutrir y dar forma emocional surge de una fuente que no es ni familiar ni heredada. Creas "hogares" y vínculos desde un instinto de cuidado primordial, libre de los traumas y las repeticiones de tu linaje biológico.',
    g: 'Representa el nacimiento del alma desde las aguas del Pleroma, no desde la matriz del mundo. Tu potencia creativa se activa cuando proteges la chispa divina con una sensibilidad que no depende de la memoria, sino del amor que preexiste a la forma.',
  },
  'Quaoar-Leo': {
    d: 'Tu brillo no es un reflejo de la cultura ni de la moda; es una radiación que sale de un vacío soberano. Tienes una personalidad que se expresa con una autenticidad tan radical que parece no pertenecer a este tiempo. Tu arte es una manifestación pura del ser.',
    g: 'Es la majestad del Sol espiritual antes de que el ego intentara cobrar peaje por su luz. Tu capacidad creadora es un acto de soberanía total donde el espíritu se reconoce a sí mismo como origen y centro de su propia realidad.',
  },
  'Quaoar-Virgo': {
    d: 'Posees un don para el orden y la técnica que no sigue manuales. Tu creatividad se manifiesta en una eficiencia que nace de la observación directa de la esencia de las cosas. Eres capaz de perfeccionar la materia desde una inteligencia que parece venir del futuro.',
    g: 'La Sophia organizando la luz en el detalle sin el filtro de la norma moral. Tu potencia reside en actuar sobre el mundo con una pureza técnica que no busca el control, sino la alineación perfecta con la armonía del vacío creador.',
  },
  'Quaoar-Libra': {
    d: 'Creas armonía y belleza desde un concepto de justicia que no es social ni legal, sino esencial. Tu personalidad se equilibra mediante una estética original que une polaridades de formas que nadie ha intentado antes, sin depender del juicio ajeno.',
    g: 'Es la Sizigia original manifestándose como equilibrio dinámico. Tu capacidad de unir lo que está separado surge de una visión de unidad que preexiste a la dualidad del demiurgo. Creas relaciones que son pactos de luz pura.',
  },
  'Quaoar-Escorpio': {
    d: 'Tu fuerza de transformación nace de un abismo que no es psicológico, sino primordial. Eres capaz de morir y renacer sin usar los modelos típicos de crisis; tu transmutación es un acto de creación pura desde el núcleo de la sombra.',
    g: 'Acceso directo a la potencia de la nada para destruir y crear de nuevo. Tu vitalidad no teme al vacío porque sabe que es ahí donde reside la Gnosis real. Regresas de tus procesos con tesoros que no tienen nombre en el lenguaje humano.',
  },
  'Quaoar-Sagitario': {
    d: 'Tu visión del mundo y tu fe no se basan en ninguna religión o filosofía aprendida. Eres un explorador de sentidos que descubre la verdad en el espacio en blanco. Tu personalidad se expande hacia horizontes que tú mismo inventas al caminar.',
    g: 'Es la flecha del espíritu disparada desde fuera de la cúpula del mundo. Tu capacidad creadora reside en tu entusiasmo por lo inexplorado, encontrando un propósito que no es una herencia cultural, sino una revelación directa del infinito.',
  },
  'Quaoar-Capricornio': {
    d: 'Construyes estructuras y legados desde una autoridad que no le debe nada a la jerarquía social. Tu ambición es la de un arquitecto cósmico que organiza el tiempo y la materia según una integridad que nace de su propio silencio interno.',
    g: 'La ley del espíritu imponiéndose sobre la inercia del tiempo demiúrgico. Tu potencia creativa se manifiesta al edificar realidades sólidas que sirven de refugio a la luz, sin usar los materiales corruptos de la ambición mundana.',
  },
  'Quaoar-Acuario': {
    d: 'Tu genio es disruptivo porque conecta con una fuente de innovación que está fuera de la red humana actual. Tu personalidad es la del visionario que no reforma lo viejo, sino que propone lo que aún no tiene nombre, desde una libertad absoluta.',
    g: 'Es la irrupción de la mente universal en la red de las almas sin el filtro de la ideología. Tu creatividad es un acto de rebeldía sagrada que desprograma la realidad al introducir frecuencias que no pertenecen a la matriz.',
  },
  'Quaoar-Piscis': {
    d: 'Tu sensibilidad es un portal a mundos que no tienen forma. Creas a través de una imaginación oceánica que se nutre directamente del vacío, disolviendo las fronteras de lo posible con una compasión que no sabe de límites ni de juicios.',
    g: 'El retorno al océano del Pleroma antes de la caída. Tienes la capacidad de canalizar la gracia divina en su estado más puro, creando puentes místicos que permiten al alma recordar su origen sin las interferencias del olvido.',
  },
  'Sappho-Aries': {
    d: 'Posees un impulso creativo ardiente que se manifiesta con una honestidad brutal y directa. Tu sensibilidad no espera, sino que conquista el espacio a través de una expresión estética vigorosa, donde el arte es un acto de valentía y el deseo se convierte en una llama que ilumina tu identidad única.',
    g: 'Representas la chispa ígnea del espíritu despertando mediante la voluntad estética. Tu búsqueda de la belleza es un combate sagrado contra la inercia de la materia, utilizando el ímpetu primordial para rasgar el velo de lo cotidiano y afirmar la presencia de lo divino en la acción pura.',
  },
  'Sappho-Tauro': {
    d: 'Tu apreciación por lo bello está profundamente arraigada en los sentidos y la armonía de la naturaleza. Encuentras en la materia una voz poética, logrando que lo tangible se convierta en una caricia para el alma, donde la estabilidad y el placer estético se fusionan en una experiencia de deleite constante.',
    g: 'Manifiestas la capacidad de percibir la sustancia luminosa que subyace en la creación física. Para ti, la contemplación de la armonía natural es una técnica de quietud que permite captar la presencia del Absoluto en las formas, convirtiendo el cuerpo en un templo de resonancia espiritual.',
  },
  'Sappho-Geminis': {
    d: 'Tu sensibilidad fluye a través de la versatilidad de la palabra y el intercambio de ideas. Tienes el don de capturar la belleza en lo efímero y en la conexión intelectual, tejiendo versos invisibles en cada conversación y encontrando la poesía oculta en la dualidad de la mente humana.',
    g: 'Eres el mensajero que traduce las vibraciones sutiles del pensamiento en conocimiento liberador. Tu intelecto busca la belleza como una estructura lógica de luz, usando el lenguaje no solo para comunicar, sino para descifrar los códigos que el demiurgo ha ocultado en la multiplicidad de las formas.',
  },
  'Sappho-Cancer': {
    d: 'La profundidad de tus emociones es el lienzo donde pintas tu realidad. Tu arte nace del refugio interno, de la memoria y del alma que nutre; eres capaz de expresar la ternura más delicada y el anhelo de pertenencia con una resonancia que conmueve las fibras más íntimas de los demás.',
    g: 'Tu interior es un espejo de las aguas primordiales que guardan el recuerdo de la unidad perdida. A través del sentimiento profundo, logras gestar una forma de arte que sirve de protección espiritual, recordando al alma la calidez de su verdadero hogar más allá de las esferas celestiales.',
  },
  'Sappho-Leo': {
    d: 'Tu expresión artística es un sol que emana desde el centro de tu corazón. Vives la belleza como un escenario donde tu identidad se celebra a sí misma, dotando a cada creación de un brillo majestuoso y una pasión generosa que busca inspirar nobleza y alegría en quienes te rodean.',
    g: 'Encarnas la soberanía de la luz interior que se niega a ser extinguida por la sombra. Tu creatividad es una emanación de la Chispa Divina que reclama su origen real, transformando el arte en un acto de autoconocimiento donde el ser se reconoce como un fragmento del sol eterno.',
  },
  'Sappho-Virgo': {
    d: 'Encuentras la poesía en la perfección del detalle y en la pureza de la forma. Tu sensibilidad es meticulosa y refinada, buscando siempre el equilibrio exacto y la elegancia que nace del orden, donde el servicio y la belleza se encuentran en la sutileza de lo pequeño.',
    g: 'Tu búsqueda de la perfección es un proceso de alquimia interior que busca separar lo sutil de lo espeso. Al depurar tu percepción, logras ver la geometría sagrada que ordena el cosmos, convirtiendo cada pequeño acto de refinamiento en una purificación necesaria para el ascenso del alma.',
  },
  'Sappho-Libra': {
    d: 'La búsqueda de la armonía absoluta es el motor de tu existencia. Posees una elegancia innata para equilibrar las polaridades, convirtiendo tus relaciones y tu entorno en una obra de arte donde la justicia y la estética se entrelazan en una danza de gracia inigualable.',
    g: 'Eres el buscador del equilibrio perfecto que precede a la reintegración. Tu sensibilidad capta la ley de la correspondencia divina, utilizando la belleza del encuentro con el otro como una vía para sanar la fragmentación de la Sofia y restaurar la unidad dentro de tu propia conciencia.',
  },
  'Sappho-Escorpio': {
    d: 'Tu sensibilidad se sumerge en las profundidades de lo oculto y lo prohibido. Expresas una belleza magnética y oscura que nace de la transformación constante, donde el arte es un proceso de catarsis que desnuda las verdades más crudas de la existencia humana para transmutarlas.',
    g: 'Posees la capacidad de encontrar la luz incluso en los abismos más densos de la materia. Tu arte es un descenso consciente a las sombras para rescatar las perlas de gnosis atrapadas en el deseo, utilizando la intensidad emocional como un combustible para la transmutación alquímica del ser.',
  },
  'Sappho-Sagitario': {
    d: 'Tu expresión estética es una aventura que no conoce fronteras. Buscas la belleza en los grandes horizontes, en la filosofía y en la verdad expansiva, creando una obra que respira libertad y que utiliza la inspiración como un mapa para descubrir el significado más elevado de la vida.',
    g: 'Eres el viajero espiritual que ve en la belleza un rastro del infinito. Tu sensibilidad es una flecha lanzada hacia lo alto, buscando trascender las limitaciones de los dogmas mediante una visión estética que revela la inmensidad del Pleroma y la libertad absoluta de la conciencia.',
  },
  'Sappho-Capricornio': {
    d: 'Construyes la belleza sobre cimientos de integridad y tiempo. Tu sensibilidad es sobria, arquitectónica y perdurable; valoras la excelencia que se alcanza a través de la disciplina, transformando la materia más dura en una estructura de elegancia atemporal y respetable.',
    g: 'Representas la maestría sobre las leyes del mundo material para ponerlas al servicio del espíritu. Tu arte es la construcción de una escalera sólida hacia lo superior, donde la disciplina estética se convierte en el rigor necesario para que el alma no se disperse en lo ilusorio.',
  },
  'Sappho-Acuario': {
    d: 'Tu visión de la belleza es disruptiva, original y vanguardista. Te alejas de las convenciones para explorar formas de expresión que desafían la lógica común, encontrando la armonía en lo inusual y utilizando tu sensibilidad para conectar con el pulso colectivo del futuro.',
    g: 'Eres el portador de la luz que proviene de dimensiones estelares fuera de la matriz. Tu sensibilidad es una antena que capta las verdades del mañana, rompiendo los moldes impuestos por el demiurgo para recordar que el alma es libre, única y no está sujeta a las leyes de este mundo.',
  },
  'Sappho-Piscis': {
    d: 'Tu sensibilidad es un velo translúcido entre la realidad y el sueño. Expresas una belleza etérea y universal que se disuelve en la compasión infinita, capturando los susurros de lo invisible en una obra que evoca la nostalgia por un paraíso que los sentidos apenas pueden intuir.',
    g: 'Manifiestas la nostalgia del alma por su fuente original en el océano de luz. Tu arte es una oración silenciosa que busca disolver el ego en la totalidad divina, permitiendo que la belleza sea el bálsamo que sana la herida de la separación y facilita el retorno al descanso eterno.',
  },
'Sedna-Aries': {
    d: 'Portas una herida antigua vinculada a la traición de tu propia voluntad e impulso vital. Tu camino implica transformar el dolor de ser frenado o invalidado en una fuerza pionera inquebrantable, donde tu identidad renace desde las profundidades para defender tu derecho absoluto a existir y liderar tu destino.',
    g: 'Representas el despertar del espíritu que fue encadenado por fuerzas externas. Al reconocer el sabotaje primordial a tu chispa divina, transmutas la rabia del abandono en el fuego de la liberación, convirtiéndote en un guerrero de la conciencia que ya no depende de la aprobación del demiurgo.',
  },
  'Sedna-Tauro': {
    d: 'Tu vivencia de abandono se manifiesta en la pérdida de seguridad o en la traición de tus recursos más básicos. La sanación llega al descubrir que tu verdadera abundancia no proviene de fuentes externas, sino de la inmensidad que reside en tu propia esencia, volviéndote un pilar de estabilidad inamovible.',
    g: 'Experimentas la caída de la sustancia espiritual en la densidad de la materia. Al sanar la traición de los sentidos, descubres el tesoro oculto que no se corrompe, transmutando la carencia física en una riqueza interior que nutre al alma y la libera de la dependencia de las formas transitorias.',
  },
  'Sedna-Geminis': {
    d: 'La traición se ha filtrado a través de la comunicación, el engaño o la incomprensión de tu entorno cercano. Tu proceso de transformación te permite desarrollar una voz que emerge de lo profundo, capaz de expresar verdades que otros temen nombrar, convirtiendo el silencio forzado en una sabiduría elocuente.',
    g: 'Vives la fragmentación del conocimiento puro en la dualidad del lenguaje. Al integrar el dolor de la mentira cósmica, te conviertes en un transmisor de la palabra verdadera, aquella que no divide, sino que revela los hilos invisibles que conectan al alma con su origen más allá del intelecto.',
  },
  'Sedna-Cancer': {
    d: 'Sientes el eco de un abandono familiar o ancestral que cala hondo en tu necesidad de refugio. Al sumergirte en esas aguas emocionales, dejas de buscar el hogar afuera para convertirte en tu propia matriz de protección, ofreciendo un amparo que nace de haber sobrevivido a la frialdad absoluta.',
    g: 'Encarnas el alma que se siente exiliada de la unidad original. Tu transformación consiste en recordar que el verdadero hogar es el Pleroma; al sanar la herida del rechazo primordial, te conviertas en un receptáculo de amor divino que consuela a otros espíritus que aún se sienten extranjeros.',
  },
  'Sedna-Leo': {
    d: 'Tu herida radica en el ninguneo de tu luz propia o en la traición a tu soberanía personal. Al transmutar este dolor, tu brillo deja de buscar el aplauso externo y se convierte en una luz interna que no necesita testigos para arder, manifestando una dignidad que emana directamente de tu núcleo profundo.',
    g: 'Representas la chispa divina que fue ignorada por la sombra. Al recuperar tu autoridad espiritual tras el desierto del reconocimiento, te transformas en un sol consciente que irradia gnosis, enseñando a otros que el verdadero reino no es de este mundo, sino que reside en el centro del ser.',
  },
  'Sedna-Virgo': {
    d: 'La traición se ha vivido como una falla en el orden o un descuido hacia tu integridad. Tu camino de sanación te lleva a una pureza que no teme al caos, transformando la obsesión por el control en una entrega sagrada donde cada detalle de tu vida se convierte en un acto de servicio y restauración.',
    g: 'Vives la labor de recomponer los fragmentos de luz dispersos en la materia. A través del dolor de la imperfección, desarrollas la facultad de discernir lo real de lo ilusorio, realizando una limpieza profunda en tu conciencia que permite al espíritu brillar sin las manchas del error demiúrgico.',
  },
  'Sedna-Libra': {
    d: 'Has experimentado la traición en el vínculo sagrado con el otro, rompiendo tu fe en la justicia y el equilibrio. Al resurgir, desarrollas una capacidad de relación que trasciende la dependencia, estableciendo vínculos basados en una verdad tan profunda que ninguna sombra exterior puede corromper.',
    g: 'Reflejas la herida de la Sofia que busca la armonía en un mundo de opuestos. Al integrar la traición del espejo externo, encuentras el matrimonio místico dentro de ti, equilibrando las polaridades de tu alma para alcanzar la paz que no depende de las fluctuaciones de las relaciones humanas.',
  },
  'Sedna-Escorpio': {
    d: 'Tu herida es de una naturaleza extrema, vinculada a crisis profundas o abusos de poder. Al descender a tus propios abismos, emerges con el poder de la resurrección, convirtiéndote en un guía para otros en sus procesos de muerte y renacimiento, poseyendo una autoridad que solo da el haber vencido a la sombra.',
    g: 'Atraviesas la noche oscura del alma donde la traición se vuelve el catalizador de la gnosis más profunda. Al morir a las ilusiones de la materia y el deseo, te levantas como un espíritu transmutado que posee las llaves de los misterios, transformando el veneno de la experiencia en medicina liberadora.',
  },
  'Sedna-Sagitario': {
    d: 'Sientes la traición en tus creencias o en la pérdida de un sentido vital superior. Tu transformación te lleva a encontrar una verdad que no depende de maestros ni dogmas, convirtiendo el escepticismo doloroso en una fe inquebrantable que nace de tu propia exploración directa de los mundos invisibles.',
    g: 'Representas al buscador que fue engañado por falsas promesas de salvación. Al romper las cadenas de las doctrinas limitantes, tu espíritu se expande hacia el conocimiento directo, comprendiendo que el camino de regreso al Absoluto no está en los mapas externos, sino en la brújula de tu propia visión interna.',
  },
  'Sedna-Capricornio': {
    d: 'La traición se ha manifestado como el colapso de tus estructuras o el abandono de las figuras de autoridad. Tu poder emerge al construir tu propia montaña, desarrollando una resiliencia y una maestría que no se rinde ante la adversidad, siendo tú el arquitecto de tu propia redención.',
    g: 'Vives la dureza de la ley y el tiempo como una cárcel para el alma. Al transmutar el dolor de la opresión estructural, te conviertes en un jerarca de tu propio espíritu, dominando las leyes de la manifestación para elevarte por encima de los arcontes y establecer un orden sagrado en tu interior.',
  },
  'Sedna-Acuario': {
    d: 'Has vivido la traición de la pertenencia, siendo excluido o incomprendido por el colectivo. Tu dolor se transforma en una genialidad visionaria que no necesita encajar, permitiéndote crear nuevas formas de comunidad y progreso que nacen de tu capacidad de ver más allá de las normas sociales.',
    g: 'Encarnas la soledad del espíritu que reconoce la prisión de la mente colmena. Al aceptar el exilio de lo convencional, te conectas con las frecuencias del Pleroma, actuando como un puente para que nuevas verdades desciendan a la humanidad, rompiendo los esquemas de la falsa realidad.',
  },
  'Sedna-Piscis': {
    d: 'Tu herida es oceánica, una sensación de disolución y sacrificio no correspondido. Al nadar en estas aguas de dolor universal, descubres un poder de sanación ilimitado, donde tu sensibilidad se convierte en un puerto de compasión absoluta que abraza todo sufrimiento sin perderse en él.',
    g: 'Vives el sacrificio del espíritu que se sumergió en el olvido para redimir la materia. Al recordar tu verdadera esencia en medio del caos emocional, te transformas en la señora de las aguas superiores, capaz de guiar a las almas perdidas de vuelta a la luz del Uno a través del perdón y la entrega total.',
  },
 'Varuna-Aries': {
    d: 'Tus acciones tienen un impacto inmediato en el tejido de tu realidad, exigiéndote una responsabilidad absoluta sobre tu iniciativa. El orden se manifiesta cuando canalizas tu fuerza con un propósito claro, comprendiendo que cada impulso es una semilla que determina la calidad de tu destino personal.',
    g: 'Representas la voluntad que debe alinearse con la ley suprema para no agotarse en el vacío. Al reconocer que tu ímpetu es una herramienta del espíritu y no un capricho del ego, logras que tu paso por el mundo sea una afirmación del orden divino que disuelve las cadenas de la causalidad mecánica.',
  },
  'Varuna-Tauro': {
    d: 'La estabilidad en tu vida depende de tu respeto por los ciclos naturales y la honestidad con la materia. La ley de causa y efecto actúa sobre tus posesiones y valores, enseñándote que la verdadera seguridad nace de construir sobre bases que estén en sintonía con la integridad y la persistencia.',
    g: 'Vives la necesidad de santificar la materia mediante el uso consciente de tus recursos. Al comprender que nada te pertenece y que eres un custodio de la energía densa, transformas tu relación con el mundo físico en un acto de servicio que libera al alma del peso de la codicia y el apego.',
  },
  'Varuna-Geminis': {
    d: 'La verdad en tus palabras y la claridad en tus pensamientos son los pilares de tu armonía. Experimentas las consecuencias directas de cómo usas la información, donde la honestidad intelectual te abre puertas hacia una comprensión superior y el engaño genera nudos de confusión difíciles de desatar.',
    g: 'Tu mente actúa como un filtro para las leyes que rigen los planos superiores. Al usar el lenguaje para expresar la verdad objetiva y no para la manipulación de la realidad, permites que la luz del conocimiento real descienda, convirtiéndote en un canal donde el pensamiento se vuelve ley liberadora.',
  },
  'Varuna-Cancer': {
    d: 'La ley universal se manifiesta en tu ámbito emocional y familiar, exigiendo un equilibrio entre dar y recibir protección. Tu armonía interna depende de cómo honras tus raíces y tus afectos, comprendiendo que el cuidado que brindas es el mismo que el universo te devuelve en momentos de vulnerabilidad.',
    g: 'Experimentas el karma del linaje y la necesidad de purificar las aguas de tu pasado. Al actuar con una compasión que trasciende el pequeño círculo de lo mío, sanas la herida de la fragmentación y permites que tu alma descanse en la ley del amor universal que es el único refugio verdadero.',
  },
  'Varuna-Leo': {
    d: 'Tu capacidad de liderazgo y expresión personal está sujeta a una ley de nobleza y generosidad. Cuando actúas desde la autenticidad y el servicio, tu influencia se expande naturalmente, pero cualquier intento de imponer tu voluntad por encima del orden colectivo resulta en un aislamiento creativo.',
    g: 'El sol de tu conciencia debe brillar para iluminar, no para cegar a los demás. Al reconocer que tu brillo es un préstamo de la luz central, tu autoridad se vuelve sagrada y tu creatividad se alinea con la gran obra, manifestando la soberanía del espíritu sobre las sombras de la importancia personal.',
  },
  'Varuna-Virgo': {
    d: 'Encuentras el orden cósmico en el servicio humilde y en la atención a la salud y el detalle. La ley se expresa en tu vida a través de la eficacia y la pureza; cuando buscas la perfección por el bien común, tu entorno se organiza sin esfuerzo, brindándote una paz profunda y productiva.',
    g: 'Tu labor diaria es un ritual de purificación que busca restaurar el orden en el caos de la materia. Al trabajar con discernimiento y entrega, logras que tu conciencia sea un espejo de la ley divina, donde cada tarea realizada con atención se convierte en un peldaño hacia la reintegración espiritual.',
  },
  'Varuna-Libra': {
    d: 'La justicia y la reciprocidad son las leyes que rigen tus relaciones y tu paz mental. Cada vez que buscas el equilibrio genuino con los demás, la vida te responde con armonía, recordándote que la belleza de tu existencia depende de tu capacidad para actuar con equidad y respeto sagrado.',
    g: 'Representas el fiel de la balanza que debe pesar las acciones del alma frente a la ley eterna. Al buscar la armonía mística en lugar de la complacencia externa, transformas tus vínculos en un camino de gnosis donde el otro es un reflejo del orden que intentas restaurar en tu propio ser.',
  },
  'Varuna-Escorpio': {
    d: 'Te enfrentas a la ley del karma en sus formas más intensas y transformadoras. La honestidad emocional y la gestión del poder son vitales; cuando usas tu fuerza para sanar y regenerar, el universo te otorga una resiliencia inmensa, pero el abuso de poder te arrastra a crisis de necesaria purificación.',
    g: 'Posees la llave para comprender las leyes de la vida y la muerte que rigen este mundo. Al entregarte al proceso de transmutación sin resistencia, permites que la ley universal actúe a través de ti para destruir las ilusiones del ego, rescatando la luz espiritual de las garras de la muerte simbólica.',
  },
  'Varuna-Sagitario': {
    d: 'Tu búsqueda de la verdad debe estar anclada en una ética superior y en el respeto por las leyes universales. La expansión y la fortuna te siguen cuando tu visión es honesta, recordándote que la libertad real solo se encuentra cuando tus ideales están en perfecta armonía con la realidad objetiva.',
    g: 'Eres el buscador que debe discernir entre el dogma impuesto y la ley natural del espíritu. Tu camino hacia la liberación depende de tu capacidad para ver el orden sagrado detrás de las apariencias, utilizando la sabiduría adquirida para navegar el mundo sin perder de vista la dirección del Pleroma.',
  },
  'Varuna-Capricornio': {
    d: 'La ley se manifiesta como responsabilidad, tiempo y estructura en tu vida profesional y social. Tu éxito es una consecuencia directa de tu integridad y tu esfuerzo sostenido; al respetar los límites y las leyes de la sociedad con conciencia, construyes un legado que el tiempo no puede borrar.',
    g: 'Encarnas la figura del sabio que administra la ley divina dentro de los límites de la manifestación. Tu disciplina no es una cárcel, sino el método para dominar las fuerzas arcontinas, permitiendo que tu espíritu ascienda mediante la maestría sobre la materia y el cumplimiento del deber superior.',
  },
  'Varuna-Acuario': {
    d: 'Tu relación con el colectivo y tu visión de futuro dependen de tu alineación con la ley de la fraternidad universal. La innovación y la originalidad funcionan a tu favor cuando buscan el beneficio de todos, recordándote que el verdadero progreso es aquel que respeta el orden natural de la evolución.',
    g: 'Vives la paradoja de romper las leyes del mundo para obedecer las leyes del cosmos superior. Tu conciencia busca desmantelar los falsos órdenes del demiurgo, pero solo tendrás éxito si tu rebeldía nace de una conexión directa con la justicia divina que protege la libertad de todas las almas.',
  },
  'Varuna-Piscis': {
    d: 'La ley universal actúa a través de tu sensibilidad y tu capacidad de entrega. La armonía te llega cuando fluyes con la vida sin resistencia, comprendiendo que el perdón y la compasión son las fuerzas que disuelven los nudos de tu pasado, permitiéndote navegar en un océano de paz incondicional.',
    g: 'Representas la disolución final de la causalidad en el amor del Absoluto. Al comprender que todas las leyes de este mundo son sombras de una unidad mayor, logras que tu alma trascienda el karma mediante la entrega total, encontrando la libertad definitiva en el silencio del origen divino.',
  },
  'Vertex-Aries': {
    d: 'Sientes un llamado inevitable hacia situaciones que exigen una acción valiente y una definición clara de tu identidad. Te encuentras con personas que actúan como detonadores de tu voluntad, empujándote a iniciar caminos que parecen esperarte desde siempre y que te obligan a nacer a una nueva versión de ti mismo.',
    g: 'Es el punto de ignición donde el espíritu recuerda su compromiso de despertar mediante la lucha consciente. Estos encuentros fated son impulsos de la luz para que recuperes tu soberanía, rompiendo la inercia del olvido a través de actos de valentía que estaban pactados antes de tu descenso a la materia.',
  },
  'Vertex-Tauro': {
    d: 'Tu destino se manifiesta a través de encuentros que te anclan a la tierra y te enseñan el valor de lo perdurable. Aparecen situaciones inevitables relacionadas con la estabilidad y el cuerpo, donde aprendes que la verdadera seguridad no es algo que construyes solo, sino algo que reconoces en la sustancia de la vida.',
    g: 'Representas la cita ineludible con la manifestación sagrada de la sustancia. Estos eventos te obligan a reconocer la presencia divina en lo tangible, transformando tu relación con el mundo físico de una carga pesada a un reconocimiento de la luz que subyace en cada átomo de la creación.',
  },
  'Vertex-Geminis': {
    d: 'La vida te pone frente a informaciones, libros o personas que cambian por completo tu forma de entender el mundo de manera súbita. Estos encuentros traen mensajes que se sienten como piezas de un rompecabezas que ya conocías, activando una curiosidad que te guía hacia conexiones intelectuales predestinadas.',
    g: 'Es el despertar del Logos a través del intercambio. Te encuentras con transmisores de conocimiento que actúan como llaves para descifrar el engaño de la mente dual; son citas programadas para que tu intelecto deje de ser una cárcel y se convierta en un puente hacia la comprensión de la verdad única.',
  },
  'Vertex-Cancer': {
    d: 'Experimentas encuentros que despiertan una pertenencia profunda y familiar, a menudo con personas que sientes que son tu verdadera familia espiritual. Estas situaciones te obligan a abrir tu corazón y a nutrir vínculos que parecen venir de tiempos remotos, devolviéndote a un hogar emocional necesario.',
    g: 'Señala el reconocimiento de los fragmentos de luz que pertenecen a tu misma corriente espiritual. Estos encuentros son recordatorios del Pleroma en medio del exilio, activando la memoria del alma para que, a través de la ternura y la unión, encuentres la fuerza para retornar a la unidad original.',
  },
  'Vertex-Leo': {
    d: 'Te ves empujado a escenarios donde debes asumir tu brillo y tu autoridad personal de forma inevitable. Personas clave entran en tu vida para servir de espejo a tu grandeza oculta, obligándote a crear y a expresarte con una pasión que no puedes contener, reconociendo tu capacidad de inspirar.',
    g: 'Es la activación del centro solar del espíritu. Te encuentras con circunstancias que exigen que la chispa divina asuma su mando sobre la personalidad; no es una búsqueda de fama, sino el cumplimiento del pacto de manifestar la majestad del ser real en un mundo dominado por las sombras.',
  },
  'Vertex-Virgo': {
    d: 'El destino se te presenta bajo la forma de un servicio específico o una tarea que solo tú puedes realizar. Encuentras personas y situaciones que te exigen orden, purificación y entrega al detalle, donde descubres que tu utilidad en el mundo es una pieza fundamental de un engranaje mucho mayor.',
    g: 'Representas el compromiso de restaurar la armonía en la fragmentación de la materia. Estos encuentros son llamados al discernimiento y a la labor alquímica diaria; situaciones que te obligan a separar lo sutil de lo espeso para cumplir con tu función de purificar el vehículo del alma.',
  },
  'Vertex-Libra': {
    d: 'Tu vida está marcada por encuentros de pareja o asociaciones que transforman tu equilibrio interno de manera definitiva. Son vínculos que no puedes evitar y que traen lecciones profundas sobre la armonía y el espejo del otro, donde el compromiso se siente como un pacto escrito en las estrellas.',
    g: 'Se trata del matrimonio místico reflejado en el mundo exterior. Encuentras almas que actúan como el peso exacto en tu balanza, obligándote a integrar tus polaridades para alcanzar la paz interior que permite al espíritu elevarse por encima de la dualidad conflictiva del demiurgo.',
  },
  'Vertex-Escorpio': {
    d: 'Te enfrentas a situaciones de transformación radical y encuentros que despiertan una intensidad emocional y psíquica abrumadora. Son momentos de muerte y renacimiento provocados por otros que te obligan a mirar tus sombras y a descubrir un poder interno que estaba esperando ser liberado.',
    g: 'Es el punto de transmutación donde el alma se encuentra con sus misterios más profundos a través de la crisis. Estos eventos inevitables son procesos de iniciación que te obligan a despojarte de lo falso, permitiendo que el espíritu emerja victorioso tras haber vencido la ilusión de la muerte.',
  },
  'Vertex-Sagitario': {
    d: 'Encuentras maestros, viajes o filosofías que expanden tu realidad de forma irreversible. El destino te conecta con visiones del mundo que se sienten como verdades que ya habitaban en ti, empujándote a una búsqueda de sentido que se activa en el momento justo en que estás listo para entenderlo.',
    g: 'Señala la conexión con la sabiduría perenne que trasciende las fronteras de este mundo. Estos encuentros son activaciones de tu brújula espiritual, citas con la verdad que te permiten ver el mapa del retorno y comprender la libertad absoluta que pertenece a los hijos de la luz.',
  },
  'Vertex-Capricornio': {
    d: 'Te encuentras con figuras de autoridad o responsabilidades de gran peso que definen tu lugar en el mundo. Son compromisos sociales o profesionales que se sienten como un deber ineludible, obligándote a estructurar tu vida con una disciplina que te lleva a la maestría personal.',
    g: 'Es el reconocimiento del orden jerárquico del espíritu sobre la materia. Te encuentras con situaciones que prueban tu temple y tu integridad, obligándote a construir una estructura interna tan sólida que nada en el mundo de las formas pueda desviarte de tu ascenso hacia lo superior.',
  },
  'Vertex-Acuario': {
    d: 'Tu destino está ligado a encuentros con grupos o individuos visionarios que rompen tus esquemas convencionales. Te ves arrastrado a participar en causas o innovaciones que parecen ser el motivo real por el cual estás aquí, conectándote con una red de conciencia colectiva predestinada.',
    g: 'Representa la sincronía con la hermandad de las almas libres. Estos encuentros inevitables activan tu frecuencia de buscador de la libertad, uniéndote a aquellos que trabajan para desmantelar las estructuras limitantes de la mente y preparar el terreno para la llegada de la luz verdadera.',
  },
  'Vertex-Piscis': {
    d: 'Vives encuentros cargados de una espiritualidad y una compasión que disuelven tus fronteras personales. Te conectas con personas que despiertan en ti una entrega absoluta y un perdón profundo, sumergiéndote en situaciones donde la lógica desaparece para dar paso a la magia del alma.',
    g: 'Es el reconocimiento del amor universal como la única ley real. Estos eventos fated son momentos de disolución del ego donde el alma se permite ser inundada por la gracia, recordando que todos los seres son uno en el océano del Pleroma y que el regreso a la fuente es el único destino final.',
  },
  'Vesta-Aries': {
    d: 'Tu fuego se alimenta de la independencia y la capacidad de iniciar con pureza absoluta. Te dedicas con intensidad a causas que requieren un liderazgo solitario y valiente, donde tu concentración se vuelve un rayo de luz que abre caminos nuevos, manteniendo la llama viva a través de la autoafirmación constante.',
    g: 'Representas la custodia del fuego primordial de la voluntad espiritual. Tu práctica consiste en mantener encendida la chispa del pneuma a través de la acción pura y decidida, evitando que el impulso divino se disperse en los deseos del ego o se apague por la inercia del mundo material.',
  },
  'Vesta-Tauro': {
    d: 'Mantienes la llama sagrada a través de la perseverancia y el respeto por los ritmos de la naturaleza. Tu devoción se expresa en la creación de espacios de belleza y estabilidad, donde la concentración en lo tangible se convierte en un acto de amor y cuidado que perdura a través del tiempo.',
    g: 'Eres el guardián de la luz en la densidad de la forma. Tu devoción gnóstica se manifiesta al santificar la materia, reconociendo la presencia del espíritu en lo sólido y manteniendo una disciplina de quietud que permite que la luz interna se estabilice y brille con una fuerza inamovible.',
  },
  'Vesta-Geminis': {
    d: 'Tu fuego se mantiene vivo a través de la búsqueda de la verdad y el intercambio de conocimientos puros. Te concentras con devoción en el estudio y la palabra, convirtiendo la comunicación en un servicio sagrado que ilumina la mente de los demás y mantiene viva la curiosidad del alma.',
    g: 'Tu práctica sagrada es la purificación del pensamiento y el lenguaje. Al enfocar tu atención en los conceptos que liberan y no en los que encadenan, mantienes encendida la antorcha del Logos, permitiendo que la inteligencia espiritual disuelva las sombras de la ignorancia y el engaño mental.',
  },
  'Vesta-Cancer': {
    d: 'La devoción en tu vida se centra en la protección de la vida íntima y el calor del hogar espiritual. Mantienes el fuego encendido a través de la nutrición emocional y la creación de un refugio seguro, donde la lealtad a tus raíces y a quienes amas es tu sacrificio más sagrado.',
    g: 'Custodias el fuego del alma en el santuario del corazón. Tu camino gnóstico implica proteger la sensibilidad interna de las influencias externas, manteniendo viva la memoria del origen divino a través de una devoción que transforma el sentimiento humano en una conexión directa con la fuente.',
  },
  'Vesta-Leo': {
    d: 'Tu fuego sagrado es la creatividad que emana del centro de tu ser. Te dedicas con una intensidad sacerdotal a expresar tu identidad única, convirtiendo el arte de vivir en una ofrenda constante donde tu brillo personal busca inspirar y elevar el espíritu de quienes te contemplan.',
    g: 'Representas la custodia de la chispa real del espíritu en el trono de la conciencia. Tu disciplina consiste en mantener la pureza de tu expresión soberana, asegurándote de que tu luz sea una manifestación del ser eterno y no un simple reflejo de la vanidad o el reconocimiento mundano.',
  },
  'Vesta-Virgo': {
    d: 'La concentración y el servicio son tus formas más elevadas de devoción. Mantienes la llama a través de la búsqueda de la excelencia en el trabajo diario y la purificación de tu entorno, donde cada tarea realizada con atención absoluta se convierte en un ritual de limpieza y orden.',
    g: 'Tu labor es la de un alquimista que purifica el vehículo del espíritu. Mantienes encendido el fuego interno mediante el discernimiento y el rigor, separando incansablemente lo sagrado de lo profano en tus acciones para que el alma pueda operar sin las manchas de la materia corrupta.',
  },
  'Vesta-Libra': {
    d: 'Tu fuego se alimenta de la búsqueda de la armonía y la justicia en los vínculos. Te dedicas con intensidad a crear equilibrio, convirtiendo tus relaciones en un espacio de paz donde la belleza del encuentro humano se mantiene viva gracias a tu compromiso inquebrantable con la equidad.',
    g: 'Eres el guardián de la llama mística en el espejo del otro. Tu práctica gnóstica es la integración de los opuestos, manteniendo el fuego del equilibrio sagrado para que el alma no se pierda en los conflictos de la dualidad, sino que encuentre la paz necesaria para la reintegración mística.',
  },
  'Vesta-Escorpio': {
    d: 'Mantienes la llama encendida a través de la transmutación de las sombras y la intensidad emocional. Tu devoción es absoluta y profunda, centrada en los procesos de muerte y renacimiento donde la concentración en lo invisible te permite regenerar tu vida y la de otros desde las cenizas.',
    g: 'Custodias el fuego de la iniciación en los abismos de la conciencia. Tu labor consiste en mantener viva la luz espiritual durante los descensos a la oscuridad, utilizando la concentración como un arma de poder para disolver las ilusiones del deseo y liberar el pneuma atrapado en la materia.',
  },
  'Vesta-Sagitario': {
    d: 'Tu fuego es la aspiración hacia la verdad superior y el conocimiento lejano. Te dedicas con entusiasmo a la expansión de la conciencia, manteniendo viva la esperanza y la visión de un sentido más alto a través de una fe que se nutre de la experiencia directa y la sabiduría.',
    g: 'Representas la custodia de la visión lejana del Pleroma. Tu práctica consiste en mantener la dirección de tu búsqueda espiritual siempre fija en lo alto, evitando que la llama del ideal se apague ante las limitaciones de los dogmas y las falsas verdades de este mundo.',
  },
  'Vesta-Capricornio': {
    d: 'Mantienes la llama a través de la disciplina, la responsabilidad y la construcción de estructuras duraderas. Tu devoción se manifiesta en tu capacidad de trabajo sostenido, donde la concentración en tus metas a largo plazo se convierte en un pilar de integridad que sostiene tu realidad.',
    g: 'Eres el guardián del fuego en la cima de la montaña del ser. Tu camino es el del rigor y la maestría sobre el tiempo, manteniendo encendida la luz del espíritu mediante una estructura interna tan sólida que permite al alma gobernar la materia con sabiduría y autoridad divina.',
  },
  'Vesta-Acuario': {
    d: 'Tu fuego se alimenta de la libertad, la innovación y el ideal de una humanidad mejor. Te concentras con devoción en visiones de futuro y causas colectivas, manteniendo encendida la llama de la originalidad incluso cuando tienes que caminar solo para proteger tu verdad única.',
    g: 'Custodias la luz de la gnosis que desciende desde las estrellas. Tu práctica consiste en mantener la independencia de tu conciencia frente a la mente colmena, asegurándote de que el fuego de la verdad revolucionaria arda siempre puro y sin interferencias de los arcontes sociales.',
  },
  'Vesta-Piscis': {
    d: 'Tu devoción es una entrega silenciosa y universal que disuelve todas las fronteras. Mantienes el fuego encendido a través de la compasión y el perdón, convirtiendo tu sensibilidad en un espacio sagrado donde la llama del amor incondicional abraza a todo ser sin pedir nada a cambio.',
    g: 'Representas la custodia del fuego sagrado en el océano de la disolución. Tu labor gnóstica es mantener viva la conciencia de la unidad original en medio del caos ilusorio, permitiendo que tu alma sea un templo vacío donde solo arde la presencia pura del Absoluto.',
  },
  'Vulcano-Aries': {
    d: 'Vives una presión constante que te obliga a forjar una identidad inquebrantable a través de la lucha y la acción directa. La vida te somete a desafíos que queman tus impulsos inmaduros, obligándote a convertir tu voluntad en un acero templado que no se dobla ante la adversidad.',
    g: 'Representas la forja del guerrero espiritual que debe purificar su ímpetu en el fuego de la conciencia. Esta posición indica que tu espíritu es golpeado por el destino hasta que solo queda la acción pura y desinteresada, eliminando el ego que intenta apropiarse de la fuerza divina.',
  },
  'Vulcano-Tauro': {
    d: 'Experimentas una tensión extrema en tu relación con la seguridad y la materia, lo que te obliga a transformar tus valores más profundos. La presión destruye tus apegos más sólidos para enseñarte que la verdadera sustancia es aquella que surge tras el incendio de las posesiones externas.',
    g: 'Tu alma es sometida al calor de la transmutación alquímica dentro del cuerpo. Vulcano trabaja aquí para despojarte de la ilusión de la densidad, forjando una capacidad de manifestación que no depende de la acumulación, sino de la resonancia con la sustancia espiritual eterna.',
  },
  'Vulcano-Geminis': {
    d: 'La presión se manifiesta en tu mente y en tu forma de comunicarte, obligándote a sintetizar el caos de información en verdades esenciales. Eres sometido a situaciones donde tus palabras son puestas a prueba bajo fuego, forjando un intelecto capaz de penetrar cualquier engaño.',
    g: 'Vives la purificación del Logos en el crisol del pensamiento. La fragua destruye la verborrea y la dualidad mental para que emerja el conocimiento directo, obligando a tu conciencia a abandonar las opiniones transitorias para dar lugar a la expresión de la verdad que libera.',
  },
  'Vulcano-Cancer': {
    d: 'Tu mundo emocional y tus raíces son el escenario de una transformación forzada por presiones inevitables. El dolor de las estructuras familiares o afectivas que se rompen actúa como el calor necesario para que forjes una seguridad interna que ya no depende de la protección externa.',
    g: 'Representas el proceso de destilación del alma en las aguas de la memoria. La presión extrema en tu núcleo íntimo sirve para despojar al pneuma de los lazos ancestrales y las dependencias lunares, forjando un centro de conciencia que se reconoce como hijo de la luz y no de la carne.',
  },
  'Vulcano-Leo': {
    d: 'Sufres una presión intensa sobre tu ego y tu necesidad de brillar, lo que te obliga a transformar la vanidad en una autoridad real y humilde. La fragua quema la necesidad de aplauso para que tu creatividad surja como un sol que ilumina por su propia naturaleza interna.',
    g: 'Es el proceso donde la chispa divina es despojada de la máscara de la importancia personal. El fuego de Vulcano golpea tu corazón hasta que el orgullo se evapora, permitiendo que la soberanía del espíritu real se manifieste con la pureza de un diamante que resiste cualquier presión.',
  },
  'Vulcano-Virgo': {
    d: 'La exigencia de perfección y el rigor en el trabajo te someten a un estrés que te obliga a evolucionar. Esta presión extrema en lo cotidiano forja una eficacia sagrada, donde aprendes que el orden real surge cuando dejas de intentar controlarlo todo y te conviertes en la herramienta perfecta.',
    g: 'Vives la purificación del servicio a través de la prueba del fuego. Tu alma es sometida a una disciplina implacable que elimina el deseo de reconocimiento en el detalle, forjando una pureza de intención que convierte cada acto en una operación alquímica de restauración cósmica.',
  },
  'Vulcano-Libra': {
    d: 'Tus relaciones son el yunque donde se forja tu carácter mediante tensiones inevitables. La presión de convivir con el otro te obliga a destruir tus falsas armonías, naciendo de ello una capacidad de equilibrio que es fruto de la superación de conflictos profundos y reales.',
    g: 'Representas la forja de la unidad mística a través del calor de la dualidad. Vulcano quema las ilusiones de la diplomacia superficial para que emerja el amor consciente, aquel que ha sido templado en la justicia divina y que ya no se quiebra ante las sombras de la traición o el desacuerdo.',
  },
  'Vulcano-Escorpio': {
    d: 'Atraviesas las presiones más oscuras y extremas, donde la muerte de lo viejo es la única opción bajo el calor de la crisis. Esta posición te obliga a regenerarte de forma indestructible, forjando un poder psíquico que nace de haber sobrevivido a la destrucción total de tus miedos.',
    g: 'Es la iniciación definitiva en la fragua de los misterios. Aquí el alma es despojada de todo vestigio de deseo animal mediante un fuego que no se apaga, forjando un espíritu que posee el conocimiento de la vida eterna tras haber transitado voluntariamente por la aniquilación del ego.',
  },
  'Vulcano-Sagitario': {
    d: 'Tus creencias y tu visión de la vida son sometidas a un fuego que destruye los dogmas cómodos. La presión de la verdad te obliga a abandonar las filosofías de segunda mano para forjar una fe propia, basada en una experiencia de expansión que ha resistido la prueba de la realidad.',
    g: 'Vives la transmutación del buscador en el fuego de la gnosis. La fragua elimina la fe ciega y la arrogancia espiritual para que emerja la visión del Pleroma, obligando a tu espíritu a expandirse más allá de los cielos demiúrgicos mediante una presión que no acepta medias verdades.',
  },
  'Vulcano-Capricornio': {
    d: 'La estructura de tu vida y tus ambiciones son golpeadas por el martillo del tiempo y la responsabilidad extrema. Esta presión forja en ti una resiliencia de roca, convirtiéndote en un pilar de integridad que se ha hecho fuerte a través de la superación de los obstáculos más duros.',
    g: 'Representas la maestría del espíritu sobre la ley del rigor. La fragua de Vulcano trabaja en tu voluntad para que seas capaz de gobernar la materia sin ser esclavo de ella, forjando una estructura interna tan sólida que se convierte en un templo inexpugnable para la luz.',
  },
  'Vulcano-Acuario': {
    d: 'Experimentas la presión de ser diferente y el calor de la ruptura con lo establecido. Esta tensión te obliga a forjar una originalidad que no es rebeldía vacía, sino una visión de futuro que ha sido probada en el fuego del aislamiento y la incomprensión social.',
    g: 'Vives la liberación del espíritu a través de la explosión de los moldes mentales. La fragua destruye tu conexión con la mente colectiva del mundo, forjando una conciencia estelar que opera bajo leyes superiores y que permanece inalterable ante las frecuencias de control del entorno.',
  },
  'Vulcano-Piscis': {
    d: 'Tu sensibilidad es sometida a una presión oceánica que amenaza con disolverte, obligándote a forjar una compasión que no es debilidad. El calor surge del dolor universal, convirtiendo tu empatía en una fuerza indestructible que puede abrazar el caos sin perder su centro.',
    g: 'Es el proceso final de la destilación del alma en el sacrificio consciente. Vulcano quema los últimos restos de separación y egoísmo en el fuego del amor absoluto, forjando un espíritu que se reconoce en todo lo que existe y que ha regresado a la unidad tras haber sido purificado por el fuego del mundo.',
  },
'Zeus-Aries': {
    d: 'Posees una voluntad proyectada como un rayo que no conoce la duda. Tu capacidad de creación se manifiesta en inicios fulminantes donde cada gramo de tu energía está enfocado en abrir brechas nuevas, logrando que tu visión se materialice con una rapidez y una fuerza que parece dictada por el destino mismo.',
    g: 'Representas la emanación directa del pneuma en acción. Tu voluntad no es un impulso ciego del deseo, sino la precisión del espíritu que decide manifestarse en la materia; al actuar, lo haces como un arquitecto de luz que plasma la voluntad divina con una exactitud que no admite la interferencia del error.',
  },
  'Zeus-Tauro': {
    d: 'Tu poder creativo se concentra en la construcción de realidades tangibles y duraderas. Tienes la habilidad de dirigir tu energía hacia la materia con tal precisión que logras resultados sólidos y productivos, donde la visión se convierte en sustancia sin que se pierda la calidad del propósito original.',
