  { key:'Niobe',      name:'Níobe',          g:'😭', id:71   },
  { key:'Pallas',     name:'Palas',          g:'⚴', id:2    },
  { key:'Pandora',    name:'Pandora',        g:'📦', id:55   },
  { key:'Pholus',     name:'Folo',           g:'🍾', id:5145 },
  { key:'Poseidon',   name:'Poseidón',       g:'🌊', id:'poseidon' },
  { key:'Priapus',    name:'Príapo',         g:'♂', id:'priapus' },
